in @prism
in @glass
in @mirror/store
in @mirror/store/crystal
in @code

# crystal-consumer fixture — Stage-2 GREEN witness for task #268.
#
# This shard EXERCISES the consumption surface of @mirror/store/crystal:
# it imports the sub-prism namespace, names `crystal` in a type-alias
# position, and references its typed fields through downstream type
# constructions. If crystal's substrate-decl is well-formed at the
# grammar altitude, this fixture tokenizes cleanly under the production
# mirror grammar (zero dark regions). If crystal's vocabulary leaves a
# gap the consumer's surface cannot reach, the gap surfaces here.
#
# Per the workflow's route-B Stage-2 RED: the substrate IS what the
# substrate parses through. The textual Stage-1 floor pinned the
# strings; this Stage-2 surface pins what those strings carry
# structurally — the consumption witness for the crystal carrier.

glass @crystal_consumer/witness {
  focus build_artifact
  project build_artifact
  split build_artifact
  shift build_artifact
  settle build_artifact
}

# build_artifact IS a crystal at the witness altitude. The type alias
# names the substrate carrier directly; downstream actions ride it.
type build_artifact = crystal

# polyglot_dag specializes the @code-altitude mosaic carrier — the
# same parametric form crystal's composition_graph field rides at
# @mirror/store/crystal. The witness names the carrier explicitly.
type polyglot_dag = mosaic(@code)

# inspect(b) — focus a build_artifact's substrate state. Returns the
# crystal directly; the obligation block stays open (deferred to a
# downstream consumer pull, per [[feedback-craft-not-deliver]]).
inspect(b: build_artifact) -> crystal { \ }

# graph_of(b) — project the build_artifact onto its composition_graph.
# The crystal's composition_graph field IS mosaic(@code); this surface
# projects the same carrier without invention.
graph_of(b: build_artifact) -> polyglot_dag { \ }

out @crystal_consumer/witness
out build_artifact
out polyglot_dag
out inspect
out graph_of
