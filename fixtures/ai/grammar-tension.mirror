-- Grammar with recognized and unrecognized parts.
-- Tests that dark dimensions are preserved.
in @mirror

type message = text | image | file

grammar @chat {
  in @mirror
  type channel(string)
  io send(channel, message) => imperfect
  io receive(channel) => imperfect
  action moderate(message) -> imperfect {
    focus message
    split |text| filter(text)
    zoom clean
    refract approved
  }
}

out message
out @chat
