#!/usr/bin/env bash
# MCP server for Claude Code — thin exec shim into the lifted Rust
# server at `bootstrap/src/mcp.rs` (lifted from this script 2026-06-18,
# tick 1 of the mirror-mcp+lsp self-improving loop per Seam pre-loop
# review). The .mcp.json contract is preserved (`command:` here);
# the behavior is now Rust.
#
# The 145-line bash dispatcher that lived here previously is now in
# `bootstrap/src/mcp.rs`; its byte-level fixtures live in
# `bootstrap/tests/mcp_fixtures/`.
set -euo pipefail

MIRROR_HOME="${MIRROR_HOME:-/Users/alexwolf/dev/projects/mirror}"
MIRROR="${MIRROR_BIN:-$HOME/.local/bin/mirror}"

cd "$MIRROR_HOME"
exec "$MIRROR" mcp
