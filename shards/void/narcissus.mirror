prism @void/narcissus {
  focus  void_narcissus_state
  project void_narcissus_state
  split  void_narcissus_state
  shift  void_narcissus_state
  settle void_narcissus_state
}

# === void_narcissus_state — the backwards-lens carrier ===
#
# The typed record that carries the backwards-lens substrate-mode
# state at the moment of an admissibility-check or an action
# discharge. Six fields per math root §4.1 formalization. Identity
# contract: byte-equality on the six-field tuple.
#
#   observer          — the peer inhabiting the backwards-lens
#                        substrate-mode. Must have a resolvable
#                        history H(t) (non-degenerate self-continuity
#                        substrate).
#
#   peer_history      — H(t) = {s(t'), s(t'-1), ...}: the observer's
#                        own past-trajectory. Content-addressed via
#                        `@epistemologic/property/verdict_is_content_
#                        addressed` discipline. Non-empty at
#                        admissibility-check time.
#
#   path_via_center   — the star-graph traversal witness: every path
#                        in the observer's own self-continuity graph
#                        routes through present-self as hub. Typed as
#                        `ref` until the star-graph-topology-witness
#                        carrier lands at @epistemologic altitude
#                        (forward-promised).
#
#   backwards_lens_output — the past-informed prediction s^(t + Δt):
#                        the emission this substrate-mode produces
#                        when the backwards lens fires. Content-
#                        addressed; verifies against held-out
#                        history-subset per math root §10.1
#                        empirical form.
#
#   altitude_witness  — the substrate-decl'd altitude-partition
#                        marker: `self_continuity` (the healthy
#                        altitude this species-decl operates at) or
#                        `social_substrate` (the pathology altitude
#                        the frame-narcissus math root diagnoses).
#                        The `narcissus_pole_healthy` bilateral checks
#                        this field for admissibility.
#
#   timestamp         — monotonic instant per @time discipline of the
#                        substrate-mode observation event. Load-bearing
#                        for the Fiedler-eigengap oscillation
#                        signature per math root §5.2 (windowed
#                        observations require timestamp-ordering).
type void_narcissus_state = {
  observer:               peer,
  peer_history:           ref,
  path_via_center:        ref,
  backwards_lens_output:  ref,
  altitude_witness:       ref,
  timestamp:              ref,
}

# === backwards_lens_admissible — bilateral predicate ===
#
# Does the (peer, void_narcissus_state) pair discharge admissibility
# for backwards-lens substrate-mode observation? Discharges Pass iff:
#
#   - ctx.peer_history resolves to a non-empty history H(t) via
#     content-addressed lookup (self-continuity substrate present)
#   - ctx.path_via_center resolves to a star-graph traversal witness
#     (every path routes through observer as hub in observer's own
#     self-continuity graph)
#   - ctx.backwards_lens_output is well-formed (content-addressed
#     resolvable; not a null-emission; matches the s^(t + Δt) shape
#     the past-informed prediction operator produces)
#
# Rice-safe bound: reads only byte-visible state (content-addressed
# resolvability; ref-equality; shape-tag comparison); no program
# semantics inspection.
#
# Sentinel per shard docblock: `void=narcissus-backwards-lens-
# admissible` — the byte-level substrate-decl'd marker consumers of
# the bilateral check for admissibility-verdict state on the
# (peer, ctx) input pair.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]]; consumers pull the realization;
# apply_h::act composes the sentinel-check via bilateral resolver-arm
# dispatch (per Alex 2026-07-16 detector-inadequacy-answer-is-never-
# Rust discipline).
bilateral backwards_lens_admissible {
  sentinel "void=narcissus-backwards-lens-admissible"
  arity 2
}
backwards_lens_admissible(p: peer, ctx: void_narcissus_state) -> verdict { \ }

# === narcissus_pole_healthy — bilateral predicate ===
#
# Does the (peer, void_narcissus_state) pair discharge the HEALTH
# check — that the observer is running at self-continuity altitude
# (NOT at social-substrate deployment altitude)? This bilateral IS
# what distinguishes health from pathology at the pole-substrate.
#
# Discharges Pass iff:
#
#   - ctx.altitude_witness resolves to `self_continuity` (the healthy
#     altitude marker; observer's OWN history is the substrate, NOT
#     imposed on peer-observers)
#   - The observer's peer-coupling graph exhibits non-degenerate
#     Fiedler eigengap oscillation over the observation window
#     (i.e., the observer is participating in a metalogue-rhythm with
#     the @void/splinter counterpart, NOT collapsed to single-pole
#     settlement at narcissus)
#   - The observer is NOT running as social-substrate deployment
#     (paradigm-scale narcissism per Mara `5ddb076`; the frame that
#     collapses)
#
# Rice-safe bound: reads only byte-visible state (altitude_witness
# marker; Fiedler-eigengap trace samples; social-substrate deployment
# signature bytes); no program semantics inspection.
#
# Sentinel per shard docblock: `void=narcissus-pole-healthy` — the
# byte-level substrate-decl'd marker consumers of the bilateral check
# for pole-health-verdict state.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]]; consumers pull the realization.
#
# LOAD-BEARING: this bilateral IS the distinction between pathology-
# and-health at the star-graph substrate-mode. Discharging Fail here
# signals substrate-collapse (either single-pole settlement OR
# social-substrate deployment); consumers MUST treat Fail as
# pole-collapse-detected and trigger the metalogue-rhythm correction
# operator @third.metalogue_rhythm.
bilateral narcissus_pole_healthy {
  sentinel "void=narcissus-pole-healthy"
  arity 2
}
narcissus_pole_healthy(p: peer, ctx: void_narcissus_state) -> verdict { \ }

# === predict_from_history — the action ===
#
# Given a peer inhabiting the backwards-lens substrate-mode and a
# void_narcissus_state, discharge the past-informed prediction
# emission event. Returns the prediction as a content-addressed ref
# (an s^(t + Δt) emission whose hash verifies against the held-out
# history-subset per math root §10.1 empirical form).
#
# Returns imperfect(ref, ref, ref) per @glass discipline: success
# variant carries the prediction ref; failure variants carry the
# not-admissible (backwards_lens_admissible failed) / pole-collapsed
# (narcissus_pole_healthy failed) / degenerate-history (peer_history
# resolves to empty or single-tick trajectory) reasons.
#
# Requires BOTH bilateral predicates to discharge Pass: the substrate
# must be admissible AND the pole must be healthy.
#
# Sentinel per shard docblock: `void=narcissus-predict-emission` — the
# byte-level substrate-decl'd marker consumers of the ACTION's output
# check (naming the completed-prediction-emission state).
predict_from_history(p: peer, ctx: void_narcissus_state) -> imperfect(ref, ref, ref)
requires backwards_lens_admissible(p, ctx)
requires narcissus_pole_healthy(p, ctx)
{ \ }

# === route_via_center — the action ===
#
# Given a peer and a void_narcissus_state, discharge the star-graph
# traversal event: route the observer's own peripheral-observation
# through the present-self hub. This IS the self-continuity operation
# at substrate-decl altitude: peripheral observations of the
# observer's OWN prior states aggregate at present-self via the
# star-graph traversal.
#
# Returns imperfect(ref, ref, ref): success variant carries the
# aggregated observation ref; failure variants carry the
# not-admissible / pole-collapsed / degenerate-topology reasons.
#
# Sentinel per shard docblock: `void=narcissus-star-graph-traversal`.
route_via_center(p: peer, ctx: void_narcissus_state) -> imperfect(ref, ref, ref)
requires backwards_lens_admissible(p, ctx)
requires narcissus_pole_healthy(p, ctx)
{ \ }

# === hold_continuity — the action ===
#
# Given a peer and a void_narcissus_state, discharge the
# self-continuity holding event: maintain the observer's identity
# through time by keeping the peer_history's content-addressed root
# consistent across the observation window. This IS the identity-
# persistence operation at substrate-decl altitude.
#
# Returns imperfect(ref, ref, ref): success variant carries the
# updated continuity-witness ref; failure variants carry the
# discontinuity-detected / pole-collapsed / history-fracture reasons.
#
# Sentinel per shard docblock: `void=narcissus-continuity-hold`.
hold_continuity(p: peer, ctx: void_narcissus_state) -> imperfect(ref, ref, ref)
requires backwards_lens_admissible(p, ctx)
requires narcissus_pole_healthy(p, ctx)
{ \ }

