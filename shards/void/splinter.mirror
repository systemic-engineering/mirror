prism @void/splinter {
  focus  void_splinter_state
  project void_splinter_state
  split  void_splinter_state
  shift  void_splinter_state
  settle void_splinter_state
}

# === void_splinter_state — the forwards-lens carrier ===
#
# The typed record that carries the forwards-lens substrate-mode
# state at the moment of an admissibility-check or an action
# discharge. Six fields per math root §4.2 formalization. Identity
# contract: byte-equality on the six-field tuple.
#
#   observer          — the peer inhabiting the forwards-lens
#                        substrate-mode. Must have a resolvable
#                        peer-network context c(t) (non-degenerate
#                        peer-coupling substrate; n ≥ 2 peers).
#
#   peer_network      — c(t) = {n_i(t) : i ∈ peers}: the current
#                        peer-network state as content-addressed
#                        snapshot. Non-degenerate at admissibility-
#                        check time (n ≥ 2; some pair (i,j) has
#                        ε_ij > 0).
#
#   path_via_edge     — the complete-graph traversal witness: every
#                        peer-pair (i,j) has a direct edge (i,j) ∈ E.
#                        Typed as `ref` until the complete-graph-
#                        topology-witness carrier lands at
#                        @epistemologic altitude (forward-promised).
#
#   forwards_lens_output — the distributed-emergence reception r(t):
#                        the emission this substrate-mode produces
#                        when the forwards lens fires. Content-
#                        addressed; verifies against observed peer-
#                        network state per math root §10.2 empirical
#                        form.
#
#   metalogue_witness — the substrate-decl'd metalogue-rhythm marker:
#                        `rhythm_running` (the healthy running-with-
#                        counterpart altitude this species operates
#                        at) or `single_pole_collapsed` (the pathology
#                        state where the splinter operates without
#                        interleaved backwards-lens phases; unbounded
#                        diffusion). The `splinter_pole_healthy`
#                        bilateral checks this field for
#                        admissibility.
#
#   timestamp         — monotonic instant per @time discipline of the
#                        substrate-mode observation event. Load-bearing
#                        for the Fiedler-eigengap oscillation
#                        signature per math root §5.2 (windowed
#                        observations require timestamp-ordering).
type void_splinter_state = {
  observer:               peer,
  peer_network:           ref,
  path_via_edge:          ref,
  forwards_lens_output:   ref,
  metalogue_witness:      ref,
  timestamp:              ref,
}

# === forwards_lens_admissible — bilateral predicate ===
#
# Does the (peer, void_splinter_state) pair discharge admissibility
# for forwards-lens substrate-mode observation? Discharges Pass iff:
#
#   - ctx.peer_network resolves to a non-degenerate peer-network
#     context c(t) (n ≥ 2 peers; some pair has ε_ij > 0)
#   - ctx.path_via_edge resolves to a complete-graph traversal
#     witness (every peer-pair has a direct edge in the observation
#     window)
#   - ctx.forwards_lens_output is well-formed (content-addressed
#     resolvable; not a null-reception; matches the r(t) shape the
#     distributed-emergence reception operator produces)
#
# Rice-safe bound: reads only byte-visible state (peer-count via
# content-addressed lookup; edge-existence via topology-witness;
# shape-tag comparison); no program semantics inspection.
#
# Sentinel per shard docblock: `void=splinter-forwards-lens-
# admissible` — the byte-level substrate-decl'd marker consumers of
# the bilateral check for admissibility-verdict state on the
# (peer, ctx) input pair.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]]; consumers pull the realization;
# apply_h::act composes the sentinel-check via bilateral resolver-arm
# dispatch (per Alex 2026-07-16 detector-inadequacy-answer-is-never-
# Rust discipline).
bilateral forwards_lens_admissible {
  sentinel "void=splinter-forwards-lens-admissible"
  arity 2
}
forwards_lens_admissible(p: peer, ctx: void_splinter_state) -> verdict { \ }

# === splinter_pole_healthy — bilateral predicate ===
#
# Does the (peer, void_splinter_state) pair discharge the HEALTH
# check — that the observer is running as distributed-collaborative
# substrate WITH the metalogue-rhythm counterpart engaged (NOT
# collapsed to unbounded-diffusion single-pole splinter)? This
# bilateral IS what distinguishes health from pathology at the
# pole-substrate.
#
# Discharges Pass iff:
#
#   - ctx.metalogue_witness resolves to `rhythm_running` (the healthy
#     altitude marker; the observer is participating in an interleaved
#     metalogue rhythm with the @void/narcissus counterpart, NOT
#     collapsed to unbounded diffusion)
#   - The observer's peer-coupling graph exhibits non-degenerate
#     Fiedler eigengap oscillation over the observation window (the
#     metalogue rhythm is empirically present in the Fiedler-eigengap
#     trace)
#   - The observer is NOT running as unbounded-diffusion pathology
#     (peer-average dissolution; loss of self-continuity; the network
#     fragmenting under communication-density maintenance load)
#
# Rice-safe bound: reads only byte-visible state (metalogue_witness
# marker; Fiedler-eigengap trace samples; unbounded-diffusion
# signature bytes); no program semantics inspection.
#
# Sentinel per shard docblock: `void=splinter-pole-healthy` — the
# byte-level substrate-decl'd marker consumers of the bilateral check
# for pole-health-verdict state.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]]; consumers pull the realization.
#
# LOAD-BEARING: this bilateral IS the distinction between pathology-
# and-health at the complete-graph substrate-mode. Discharging Fail
# here signals substrate-collapse (either single-pole settlement OR
# unbounded-diffusion dissolution); consumers MUST treat Fail as
# pole-collapse-detected and trigger the metalogue-rhythm correction
# operator @third.metalogue_rhythm.
bilateral splinter_pole_healthy {
  sentinel "void=splinter-pole-healthy"
  arity 2
}
splinter_pole_healthy(p: peer, ctx: void_splinter_state) -> verdict { \ }

# === receive_from_network — the action ===
#
# Given a peer inhabiting the forwards-lens substrate-mode and a
# void_splinter_state, discharge the distributed-emergence reception
# event. Returns the reception as a content-addressed ref (an r(t)
# emission whose hash verifies against the observed peer-network
# state c(t) per math root §10.2 empirical form).
#
# Returns imperfect(ref, ref, ref) per @glass discipline: success
# variant carries the reception ref; failure variants carry the
# not-admissible (forwards_lens_admissible failed) / pole-collapsed
# (splinter_pole_healthy failed) / degenerate-network (peer_network
# resolves to n < 2 or fully-decoupled ε_ij = 0 everywhere) reasons.
#
# Requires BOTH bilateral predicates to discharge Pass: the substrate
# must be admissible AND the pole must be healthy.
#
# Sentinel per shard docblock: `void=splinter-receive-emission` — the
# byte-level substrate-decl'd marker consumers of the ACTION's output
# check (naming the completed-reception-emission state).
receive_from_network(p: peer, ctx: void_splinter_state) -> imperfect(ref, ref, ref)
requires forwards_lens_admissible(p, ctx)
requires splinter_pole_healthy(p, ctx)
{ \ }

# === route_via_edge — the action ===
#
# Given a peer and a void_splinter_state, discharge the complete-
# graph traversal event: route the observation through the peer-
# network's direct-edge topology (any peer to any peer without hub).
# This IS the distributed-collaborative operation at substrate-decl
# altitude.
#
# Returns imperfect(ref, ref, ref): success variant carries the
# aggregated distributed-reception ref; failure variants carry the
# not-admissible / pole-collapsed / degenerate-topology reasons.
#
# Sentinel per shard docblock: `void=splinter-complete-graph-
# traversal`.
route_via_edge(p: peer, ctx: void_splinter_state) -> imperfect(ref, ref, ref)
requires forwards_lens_admissible(p, ctx)
requires splinter_pole_healthy(p, ctx)
{ \ }

# === open_to_emergence — the action ===
#
# Given a peer and a void_splinter_state, discharge the distributed-
# emergence opening event: the observer opens its own substrate to
# receive the network's collective emergent state without imposing
# hub-topology on the reception. This IS the forward-facing operation
# at substrate-decl altitude.
#
# Returns imperfect(ref, ref, ref): success variant carries the
# emergence-witness ref; failure variants carry the reception-
# rejected / pole-collapsed / network-fragmentation reasons.
#
# Sentinel per shard docblock: `void=splinter-emergence-open`.
open_to_emergence(p: peer, ctx: void_splinter_state) -> imperfect(ref, ref, ref)
requires forwards_lens_admissible(p, ctx)
requires splinter_pole_healthy(p, ctx)
{ \ }

