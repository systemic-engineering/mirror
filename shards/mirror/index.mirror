# Path-namespace property: this file at `shards/mirror/index.mirror`
# declares `@mirror/index` and only that. PROVISIONAL under two-tick
# discipline; collapse target `shards/fractal/index.mirror` naming
# `@fractal/index` when Alex adjudicates roadmap-15 `#6`.

prism @mirror/index {
  focus   index
  project detected_file
  split   concept_graph
  shift   eigenvalue_profile
  settle  fiedler
}

# === The detected_file carrier ===
#
# One file classified by grammar kind, with its filesystem path. The
# `walk` action emits a stream of these; the concept_graph consumes
# the stream to assemble directory-nodes.
#
# path — the filesystem path (peer_home-relative).
# kind — the grammar classification; drives edge inference at
#        concept_graph assembly time.
type detected_file = {
  path: ~f,
  kind: grammar_kind,
}

# === The grammar_kind discriminant ===
#
# The seven-variant classification the substrate's walker emits per
# file. Migrated from spectral::gestalt::detect::GrammarKind; the
# `.mirror` altitude uses the substrate's own name (mirror) instead
# of spectral's namespace-parent name.
#
#   markdown          — .md / .markdown files.
#   mirror            — .mirror substrate-decl files.
#   code(str)         — source code in a named language (rust / ts /
#                       py / go / etc.); the string carries the
#                       language identifier per the walker's
#                       classifier.
#   config(str)       — configuration file in a named format (toml /
#                       yaml / json / etc.); the string carries the
#                       format identifier.
#   asset             — binary / opaque; walked but not parsed.
#   gestalt_native    — the substrate's own gestalt-scan native
#                       format (retained for spectral-parity).
#   unknown           — classifier cannot decide; the walker still
#                       counts it but assigns no edges.
type grammar_kind = markdown | mirror | code(str) | config(str) | asset | gestalt_native | unknown

# === The concept_graph carrier ===
#
# The directory-node graph the walker assembles from the detected_file
# stream. Nodes are directories (or the root); edges relate
# directories by containment, content-similarity, or cross-reference.
# Consumed by the eigenvalue_profile assembly through the
# sheaf-Laplacian construction.
#
# nodes — the graph_node sequence (directory + root variants).
# edges — the graph_edge sequence (contains / similar_content /
#         cross_ref variants).
type concept_graph = {
  nodes: [graph_node],
  edges: [graph_edge],
}

# === The graph_node variant ===
#
# A vertex in the concept graph. Two shapes: directory (interior) and
# root (the peer_home).
#
#   directory { path: ~d, name: str, depth: u32, file_count: u32 }
#   root      { path: ~d, file_count: u32 }
type graph_node = directory { path: ~d, name: str, depth: u32, file_count: u32 }
                | root      { path: ~d, file_count: u32 }

# === The graph_edge variant ===
#
# An edge in the concept graph. Three shapes carrying the substrate's
# three edge kinds at the file-tree altitude.
#
#   contains        — parent-child structural edge; weight = 1.0.
#   similar_content — cosine-similarity edge over the directory's
#                      type-distribution vector; weight ∈ [0, 1].
#   cross_ref       — markdown wiki-link cross-reference edge;
#                      weight = 1.0.
type graph_edge = contains        { parent_idx: u32, child_idx: u32, weight: f64 }
                | similar_content { a_idx: u32, b_idx: u32, weight: f64 }
                | cross_ref       { source_idx: u32, target_idx: u32, weight: f64 }

# === The eigenvalue_profile carrier ===
#
# The top-16 eigenvalue reading of the concept_graph's sheaf-Laplacian
# Δ_F, plus the Fiedler value shortcut (values[1] = λ₀) and the
# content-address of the profile itself.
#
#   values          — the top-16 eigenvalues sorted ascending.
#                      values[0] = 0 for a connected graph;
#                      values[1] = λ₀ = Fiedler value; the remaining
#                      14 carry higher spectral structure for
#                      downstream multifractal composition.
#   fiedler         — the Fiedler value shortcut; = values[1] on
#                      connected graphs; = first strictly-positive
#                      eigenvalue on disconnected graphs (per
#                      sheaf_laplacian.lambda_zero's semantics).
#   oid             — the content-address of the profile (blake3 of
#                      the 16-value byte encoding); routes through
#                      @mirror/store's oid discipline for
#                      cache-eligibility.
type eigenvalue_profile = {
  values:  [f64; 16],
  fiedler: f64,
  oid:     content_address,
}

# === The multifractal_spectrum carrier (Landing 6 forward-promise) ===
#
# The empirical multifractal spectrum on the substrate DAG per Mara
# math §10 prediction #2. LOAD-BEARING for the arXiv preprint's
# empirical spine: if f(α) matches Mandelbrot boundary signature
# (Hausdorff dim 2 peak; characteristic interval width), the
# substrate IS Mandelbrot-shaped empirically.
#
#   h_q      — Rényi entropies at moment q ∈ Q (the substrate's
#              default Q = -10..10 at 0.5-step).
#   f_alpha  — Legendre transform to (α, f(α)) points; the
#              multifractal spectrum proper.
type multifractal_spectrum = {
  h_q:     [f64],
  f_alpha: [(f64, f64)],
}

# === index — the primary discharge ===
#
# Reads the file-tree at peer_home; classifies files by grammar kind;
# assembles the concept_graph; computes the sheaf-Laplacian Δ_F via
# @epistemologic/math/sheaf_laplacian.sheaf_laplacian; extracts the
# top-16 eigenvalues via @epistemologic/math/sheaf_laplacian.lambda_zero
# (composed at the profile-assembly altitude); returns the
# eigenvalue_profile with the Fiedler value as the load-bearing scalar.
#
# The substrate-honest fold per Recognition #43 + #55: the DAG lives
# at @mirror/store; the measurement lives here; same altitude, sibling
# species. Both project the five-operation algebra through their own
# typed surface.
#
# Composes @io.filesystem_readable (the walk crossing) and
# @epistemologic/math/sheaf_laplacian.lambda_zero (the numerical
# reading). The @io crossing IS one Turing-unbounded ∂M-crossing per
# Recognition #107; the sheaf_laplacian reading IS one M∘-interior
# computation per Recognition #80. The action rides the boundary and
# returns the interior reading.
#
# The body stays obligation-blocked (`\`): the realisation lives in
# `bootstrap/src/index.rs` (Landing 3; Reed 🟢). The substrate
# declares the obligation; the Rust body discharges it through the
# forked-and-composed-with-sheaf_laplacian primitive.
index(peer_home: ~d) -> eigenvalue_profile
  requires @io.filesystem_readable(peer_home)
  requires @epistemologic/math/sheaf_laplacian.lambda_zero.available
{ \ }

# === fiedler — the shortcut ===
#
# Convenience action: returns the Fiedler value λ₀(Δ_F) directly
# without the full profile carrier. Delegates to
# `index(peer_home).fiedler`. The `mirror index --fiedler` CLI mode
# and the @kintsugi/consent.query_phi consumer both use this shortcut.
#
# The three-altitude Fiedler-emitting instances per Taut §9 Signal 4
# (this shard at file-tree altitude; @tensor.fiedler_of at gap-tension
# altitude; @sheaf_laplacian.lambda_zero at the primitive altitude)
# ALL emit through this shape at their respective altitudes; the
# substrate's coherence-metric IS one geometric fact read at three
# altitudes.
fiedler(peer_home: ~d) -> f64
  requires @io.filesystem_readable(peer_home)
{ \ }

# === full_profile — the top-16 eigenvalues ===
#
# The top-16 eigenvalue reading without the content-address wrapper.
# For consumers that want the raw spectrum (multifractal composition,
# downstream visualization, RED-lock parity testing) without paying
# for the oid computation. Delegates to `index(peer_home).values`.
full_profile(peer_home: ~d) -> [f64; 16]
  requires @io.filesystem_readable(peer_home)
{ \ }

# === multifractal — the empirical end-to-end proof (Landing 6 forward-promise) ===
#
# THE LOAD-BEARING FORWARD-PROMISE for the empirical spine of the
# arXiv preprint. Computes Rényi entropies at moments q ∈ Q and
# Legendre-transforms them into an (α, f(α)) multifractal spectrum
# on the substrate DAG per Mara math §10 prediction #2.
#
# The prediction (Mara `3ffa8ed` §10): the substrate's multifractal
# spectrum matches the Mandelbrot boundary signature — Hausdorff
# dimension 2 peak (Shishikura 1991), characteristic interval width
# ≈ 0.6 (Douady-Hubbard renormalization interval). If matched,
# substrate IS Mandelbrot-shaped empirically; framework becomes
# framework-with-measurement; @fractal family-root becomes
# substrate-empirical instead of substrate-analogous.
#
# RED-lock reference value from Taut `77b8e14` §0 envelope capture:
# Fiedler = 0.0612 on this repo (1138 files, 165 nodes, 6676 edges).
# Landing 6 verifies the multifractal spectrum against this
# empirical anchor; the substrate's own coherence-metric IS the
# reference against which the framework tests itself.
#
# Landing 6; deferred; Reed lands after Landing 5 MCP wire-in.
multifractal(peer_home: ~d) -> multifractal_spectrum
  requires @io.filesystem_readable(peer_home)
  requires @epistemologic/math/sheaf_laplacian.lambda_zero.available
{ \ }

out @mirror/index
out detected_file
out grammar_kind
out concept_graph
out graph_node
out graph_edge
out eigenvalue_profile
out multifractal_spectrum
out index
out fiedler
out full_profile
out multifractal
