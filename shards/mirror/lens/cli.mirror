in @prism
in @glass
in @nl
in @mirror/lens

# @mirror/lens/cli — the terminal lens.
#
# The CLI surface prism. The grammar that mirror.spec's `target binary
# { cli { ... } }` block consumes (per docs/specs/mirror-spec-schema.md
# §6). Lifts from boot/std/cli.mirror with three tightenings:
#
#   1. `cli { ... }` is embedded inside a `target` block; commands
#      cannot escape the binary they belong to (spec §6).
#   2. `#` lines inside any `cli` / `command` / `arg` / `flag`
#      body ARE @nl terms — the help text, the Fate-tournament
#      input, and the downstream docs all read the same source.
#      Per shards/nl.mirror, `# <text>` produces an `nl_literal`;
#      the cli consumer lifts each `nl_literal` it encounters in
#      a body into the enclosing element's help slot.
#   3. `command X { ... }` IS the action declaration at the cli
#      altitude — no separate handler reference (spec §10.1).
#      The substrate-pull collapses dispatch into structure.
#
# === Family placement ===
#
# This is the first species of @mirror/lens (the family root at
# shards/mirror/lens.mirror). The CLI IS a lens: terminal-shaped
# surface onto the five-operation algebra; verdicts compose under the
# same Transparency<P> monoid that lens/transit and lens/refract use
# at the measurement altitude. Per docs/specs/the-convergence.md §1:
# the cli is one of four transport lenses (cli / shell / mcp / lsp),
# each rendering the same algebra for a different audience.
#
# Substrate-pull placement (2026-06-06, Mara's lens family migration):
# moved from shards/mirror/cli.mirror to shards/mirror/lens/cli.mirror
# under the @mirror/lens family root. Namespace updated from
# @mirror/cli to @mirror/lens/cli. The path-namespace property forces
# this: the file at `shards/mirror/lens/cli.mirror` MUST declare
# `@mirror/lens/cli` and only that.
#
# Cascade note: the cli-as-prism spec (docs/specs/cli-as-prism.md) and
# the-convergence spec (docs/specs/the-convergence.md) currently say
# `@mirror/cli`, `mirror join`, `λsh`, etc. The lens migration triggers
# a rename cascade in those specs (→ `@mirror/lens/cli`,
# `@mirror/lens/shell`, etc.). Deferred to a Reed-led sweep tick; not
# rewriting markdown manually here. The substrate-side update (this
# shard + shards/mirror/spec.mirror's `in @mirror/lens/cli`) is
# load-bearing and lands now.
#
# Spec context: [[architecture-shards-as-substrate-source]],
#               [[architecture-prism-as-trait-as-everything]],
#               [[architecture-lift-as-load-bearing]],
#               docs/specs/cli-as-prism.md (the recursive five-op
#               surface this shard's keywords carry).
# Related shards: lens.mirror (the family root above),
#                 glass.mirror (verdict / imperfect / transparency),
#                 nl.mirror (`#` -> @nl),
#                 prism.mirror (the algebra),
#                 spec.mirror (the consumer that imports this).
# Path-namespace property: this file at `shards/mirror/lens/cli.mirror`
# declares `@mirror/lens/cli` and only that.

prism @mirror/lens/cli {
  focus cli
  project cli
  split cli
  shift cli
  settle cli
}

# === keywords ===
#
# `command`, `arg`, `flag` are the three declaration heads inside
# a `cli { ... }` body. Each is a typed lambda whose obligation
# block (\) is discharged downstream by mosaic when it walks the
# binary target's cli block (per spec §6).

# command(name) — a sub-prism of the cli scoped to one verb.
# The body declares args, flags, and `#` help. Per the dispatch
# collapse: `command X { ... }` IS the action `X` at this cli's
# altitude; mosaic binds X to the runtime handler of the same name
# in the enclosing target's grammar (e.g. @mirror.compile).
command(name) -> prism { \ }

# arg(name, type) — a positional argument of the enclosing command.
# Carries a type from the cli vocabulary (see below) and an
# optional default value via `= <value>`.
arg(name, t: type) -> prism { \ }

# flag(name, type) — a named flag of the enclosing command. Same
# shape as `arg` but matched by name (`--<name>`) rather than
# position. A flag's type may be `bool` (presence-only) or any
# other vocabulary type (which requires a value).
flag(name, t: type) -> prism { \ }

# === argument type vocabulary ===
#
# What survives from boot/std/cli.mirror's flag-arg shapes, lifted
# from grammar-internal use into the cli's exported vocabulary so
# `arg path: ~d` / `flag strict: bool = true` parse the same way
# everywhere a `cli { ... }` block appears.

# Primitives. `str` and `bool` are inherited from the substrate's
# scalar floor; declared here as cli-level references so the cli
# parser knows they're admissible argument types.
type str  = ref(scalar/string)
type bool = ref(scalar/bool)
type int  = ref(scalar/int)

# Sigil types. `~d` is a directory ref; `~f` is a file ref. Per
# sigil-grammar.md these resolve at compile time against the
# project root; the cli inherits them as legal arg/flag types.
type dir_ref  = ~d
type file_ref = ~f

# Content-addressed substrate handle. Used by `command shatter`
# (spec §6) to refer to an oid in @mirror/store.
type content_address = ref(@mirror/store/oid)

# Container types. `list(t)` is the only container that survives
# the lift; sets and maps defer to v0.2 (no current cli use).
type list(t) = [t]

# === default-value syntax ===
#
# `arg X: T = <value>` and `flag X: T = <value>` declare a default.
# The `=` shape is shared with the substrate's general assignment
# (boot/std/cli.mirror precedent); the cli parser interprets the
# rhs as a value of the declared type T. If T is a sigil type
# (~d, ~f), the rhs MUST be a sigil literal of the same form
# (e.g. `~f'./mirror.spec'`).
default(name, t: type, value: t) -> prism { \ }

out @mirror/lens/cli
out command
out arg
out flag
out str
out bool
out int
out dir_ref
out file_ref
out content_address
out list
out default
