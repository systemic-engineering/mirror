---

in @prism
in @meta
in @glass
in @mirror/store

# === The @mirror/store/action_cache sub-prism ===
#
# Per @mirror/store/git's `prism <name> <= @mirror/store` and
# @mirror/store/crystal's `glass <name>` precedents: sub-prisms
# under @mirror/store may use `prism <= @mirror/store` (species
# with its own wire vocabulary specializing the family six-op
# surface) or `glass` (sub-prism whose actions ride the parent's
# surface directly). This species follows @mirror/store/git's
# `prism <= @mirror/store` shape because cache_read / cache_write
# / cache_exists are wire-altitude verbs that DISCHARGE against
# the family-root six-op surface (read / write / exists / walk).
# The five-operation gauge action at this species' altitude
# operates over `action_cache` — the typed handle for one open
# ActionCache instance.
prism @mirror/store/action_cache <= @mirror/store {
  focus action_cache
  project action_cache
  split action_cache
  shift action_cache
  settle action_cache
}

# === The action_cache handle ===
#
# A typed reference per [[feedback-no-bare-types]] naming one open
# ActionCache instance keyed on `(spec_oid, target_oid,
# inputs_oid) -> verdict`. The realisation layer (N3 Rust wiring
# at `bootstrap/src/lib.rs`) implements the carrier; the
# substrate altitude declares the typed handle the cache actions
# take and return.
#
# Construction: via the family-root's `settle` at this altitude
# once a crystal head is bound; the action_cache is the
# projection of `crystal.derived_predicates` as an addressable
# key/value surface. Equality is realisation-instance identity;
# the underlying derived_predicates carrier is content-addressed
# (each cache_write emits a new derived_predicates oid).
type action_cache = ref

# === cache_read — the memoization lookup ===
#
# THE HIT-PATH ACTION. Given the three-OID triple that keys a
# verdict per N1's `verdict_is_content_addressed` predicate,
# fetch the cached verdict if present.
#
# The wire's standard imperfect return per @glass's `imperfect(a,
# e, l)` floor:
#
#   success(v: verdict)      — HIT. The cached verdict for the
#                              triple is returned; the caller
#                              (N3 `cmd_kintsugi_spec`) skips
#                              cargo and re-emits.
#   partial(opacity_map)     — STALE-CACHE HINT. The triple
#                              matched but confidence is degraded
#                              (rare; documented at
#                              @mirror/store six-op semantics).
#                              Caller may treat as hit-with-warning
#                              or fall through to re-issue.
#   failure(reason: miss)    — MISS. No matching entry in the
#                              crystal's derived_predicates.
#                              Caller runs the kintsugi loop and
#                              calls cache_write to record the
#                              fresh verdict.
#
# Discharges through the six-op surface: `walk` the crystal head
# to the derived_predicates carrier; `read` the carrier's oid;
# linear-scan the [property_verdict] entries for one whose
# `where` location matches the triple. Body is an obligation
# block; the realisation layer binds through @io + fragmentation
# dispatchers.
cache_read(spec_oid: oid, target_oid: oid, inputs_oid: oid) -> imperfect { \ }

# === cache_write — the memoization populate ===
#
# THE POPULATE-PATH ACTION. Given the same three-OID triple plus
# a freshly-issued verdict (from a kintsugi loop pass), append
# the (verdict, where=triple) entry into the crystal's
# derived_predicates carrier and return the verdict passed in.
#
# Idempotent by content-address discipline (per N1's total-
# function invariant): re-writing the same triple with the same
# verdict emits a byte-equal new derived_predicates oid; two
# cache_write calls with the same (triple, verdict) tuple against
# the same starting crystal produce byte-identical output oids.
# This is the substrate-altitude statement of N1's memoization-
# by-construction claim: the cache's state is a total function
# of the sequence of (triple, verdict) writes.
#
# Verdict return per @glass:
#
#   pass                 — write succeeded; new derived_predicates
#                          oid is live; crystal head ref updated.
#   partial(confidence)  — write succeeded but ref-update was
#                          contended (rare; documented at
#                          @mirror/store.write semantics).
#   failure(reason)      — I/O failure at the derived_predicates
#                          carrier's storage layer; caller
#                          retries or bails.
#
# Discharges through the six-op surface: `walk` to find the
# derived_predicates carrier; `read` the existing entries;
# append the new property_verdict; `write` the new carrier bytes
# and obtain the new oid; update the crystal head ref via the
# underlying wire (@mirror/store/git's set_ref when the wire is
# git-backed).
cache_write(spec_oid: oid, target_oid: oid, inputs_oid: oid, v: verdict) -> verdict { \ }

# === cache_exists — the presence check ===
#
# THE HIT/MISS CHECK WITHOUT FULL READ. Given the three-OID
# triple, return a verdict indicating whether the cache carries
# an entry for this key. Distinct from cache_read: does not
# fetch the verdict payload; only checks presence.
#
# Useful for the N3 pre-commit hook's stat-only path: cheaper
# than cache_read when the caller only needs to know if a fresh
# kintsugi loop pass is required, without wanting to emit the
# hit verdict yet.
#
#   pass                 — HIT. Entry present for the triple.
#   partial(confidence)  — Entry present in a cache layer but
#                          canonical carrier not yet confirmed
#                          (rare; parallels @mirror/store.exists).
#   failure(reason)      — MISS. No entry for the triple; caller
#                          must run kintsugi loop.
#
# Discharges through the family-root six-op surface's `exists`
# at the derived_predicates carrier; body is an obligation block.
cache_exists(spec_oid: oid, target_oid: oid, inputs_oid: oid) -> verdict { \ }

out @mirror/store/action_cache
out action_cache
out cache_read
out cache_write
out cache_exists
