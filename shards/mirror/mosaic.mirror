in @prism
in @meta
in @property
in @io
in @glass
in @nl
in @mirror/spec

# @mirror/mosaic — the build system as a prism over the project manifold.
#
# The recognition (per docs/specs/mosaic.md): build IS settlement.
# Mosaic IS the five operations applied to `mirror.spec`. Same algebra
# as everything else; the manifold is what changes:
#
#   @mirror             settles a grammar's MirrorAST into a graph;
#   @mirror/mosaic      settles a project's mirror.spec into au(altitude).
#
# Same verb (settle). Same lattice (transparency over check properties).
# Same proof obligation (eⁿ⁺¹ < eⁿ). The kintsugi loop and mosaic's
# loop are the same loop at the build altitude (mosaic.md §6).
#
# === Phase note (option α, the path-namespace choice) ===
#
# mosaic.md §2 frames mosaic as a `glass @mirror/mosaic { ... }` inside
# `prism @mirror { ... }`. The parent `shards/mirror.mirror` is Phase D
# work and does not yet exist as a declared root prism. Per the
# path-namespace property (epistemologic B5: shards/mirror/mosaic.mirror
# declares @mirror/mosaic and only that), this shard declares the
# prism at the @mirror/mosaic namespace directly — same shape as
# shards/mirror/cli.mirror (C1), substrate-pull-correct given there's
# no @mirror parent prism to nest under yet.
#
# Forward (Phase D): when `shards/mirror.mirror` lands, the parent
# prism MAY add `glass @mirror/mosaic { ... }` as a re-export view of
# this same surface — the path-namespace declaration remains canonical
# (one substrate fact, one declaration site); the parent's glass
# block is a view onto it.
#
# Spec context: docs/specs/mosaic.md, docs/specs/mirror-spec-schema.md
# (the manifold @mirror/spec produces), docs/specs/transparency.md
# (the loss carrier mosaic emits).
# Substrate decisions: [[architecture-shards-as-substrate-source]],
#                      [[architecture-prism-as-trait-as-everything]],
#                      [[architecture-lift-as-load-bearing]].
# Related shards: glass.mirror (verdict / imperfect / transparency / au),
#                 cli.mirror (the @mirror/* shard precedent).
# Path-namespace property: this file at `shards/mirror/mosaic.mirror`
# declares `@mirror/mosaic` and only that.

prism @mirror/mosaic {
  focus   spec        # mirror.spec        -> manifold
  project targets     # manifold + targets -> resolved
  split   shards      # resolved           -> [shard]
  shift   altitudes   # [shard] + altitude -> emitter
  settle  emitter     # emitter            -> au(altitude)
}

# === au at an altitude — the parametric verdict ===
#
# `au` is the substrate's settled-gold form (per glass.mirror's
# transparency / imperfect floor). At the build altitude, au is
# parametric on the altitude it settled at: au(@code/rust),
# au(@ci/github), au(@release). The `imperfect(au, e, transparency)`
# functor from @glass carries the partial-settlement case.
type au(altitude) = settle(altitude)

# === the five operations on the build manifold (mosaic.md §3) ===

# focus  spec -> manifold
#
# Read `mirror.spec`. Evaluate it as a @mirror/spec grammar. Produce
# the build manifold: the typed graph of source / legacy / target /
# settle_on nodes connected by altitude and dependency.
# Read-only; failure here is a syntax failure on the spec
# (transparency = failure(opacity_map); mosaic halts pre-I/O).
focus(spec: ref) -> manifold { \ }

# project  targets -> resolved
#
# Filter the manifold to the requested target set; resolve `source`
# and `legacy` directives into concrete file sets; resolve cross-
# target dependency. Structural; no I/O beyond glob resolution.
project(manifold, targets: [target]) -> resolved { \ }

# split  shards -> [shard]
#
# The variety-preservation move. Parse each .mirror shard into a
# MirrorAST; content-address it; emit the list. Each shard carries
# its own transparency<p> from its own compile. No cross-shard
# dependencies at this stage — the parallelizable phase.
split(resolved) -> [shard] { \ }

# shift  altitudes -> emitter
#
# For each target, shift the resolved shards from their declared
# altitude DOWN to the target's altitude. Shift is where @io
# crossings happen: an altitude that requires an external tool
# (cargo, llc, opencl, gh) delegates THROUGH the altitude grammar
# (substrate-pull goes through @code/rust, not through mosaic).
# Per [[architecture-lift-as-load-bearing]] this is the same `shift`
# verb (formerly `zoom`) the floor algebra uses.
shift(resolved, altitude) -> emitter { \ }

# settle  emitter -> au(altitude)
#
# Run the emitter; capture the verdict; produce au(altitude). If
# the emitter terminates clean, success — emit au. Otherwise emit
# imperfect(au, e, transparency<p>) — the located opacity map is
# what kintsugi reads to pick the next focus.
settle(emitter) -> imperfect(au, error, transparency) { \ }

# === cargo @io contract — the @code/rust delegation sketch ===
#
# Per mosaic.md §4: when shift hits @code/rust, the altitude grammar
# (@code/rust, NOT mosaic) delegates to cargo through @io. Mosaic
# does not know about cargo — it knows about @code/rust, which knows
# about cargo. The substrate-pull goes through the altitude.
#
# Phase-bounded (mosaic.md §8): the @io.cargo footprint shrinks
# release over release; v1.0 has no cargo @io call (mosaic IS the
# build). Sketch only — full cargo invocation is Phase D work.
shift @code/rust(resolved) -> rust_emitter {
  workspace: project_workspace(resolved),
  invocation: @io.cargo.build {
    manifest: workspace.cargo_toml,
    env:      env_of(resolved),
    profile:  resolved.profile,
  },
  \
}

settle rust_emitter -> au(@code/rust) {
  verdict: run(emitter.invocation),
  result: imperfect_of(verdict, emitter.workspace.artifact_path),
  \
}

# === settlement criteria (mosaic.md §5) ===
#
# Mosaic reads the `settle_on { ... }` block from mirror.spec
# (declared by @mirror/spec; mosaic only checks). All targets must
# produce au; the composed transparency over the whole build must
# weigh zero. Partial is still a settlement (reports + continues);
# only `failure(opacity_map)` halts.
settle_on(resolved) -> transparency(target) { \ }

# === .shatter projection (mosaic.md §7) ===
#
# Fragmentation store is canonical; .shatter on disk is the optional
# AST projection. For each target, mosaic CAN write target.shatter
# next to the source — the projected AST, the transparency<p>, the
# proof block, the eigenvalue trajectory, the altitude. Reading the
# .shatter reconstructs what mosaic settled without the store.
#
# Per mosaic.md §10.6 the policy is explicit-emit only
# (`mirror kintsugi --emit shatter`); the lift below is the
# projection itself, not its trigger.
shatter(au, transparency) -> ref { \ }

out @mirror/mosaic
out au
out focus
out project
out split
out shift
out settle
out settle_on
out shatter
