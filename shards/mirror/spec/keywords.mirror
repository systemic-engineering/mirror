in @prism

# @mirror/spec keyword bindings.
#
# Companion to shards/mirror/spec.mirror (which declares the @mirror/spec
# prism + the typed lambdas for each directive). The bootstrap's keyword
# harvester reads `<op> <keyword>` 2-word lines inside a `grammar { ... }`
# block to build the tokenizer's keyword table; this file is the
# substrate-altitude declaration of those bindings.
#
# Same precedent as shards/mirror/glass/ast/token.mirror (companion to
# the legacy @mirror/grammar), tracked by
# `companion_keyword_sources` in bootstrap/src/grammar.rs.
#
# Without these bindings, the tokenizer would surface every spec-level
# block — `project NAME { ... }`, `target NAME { ... }`, `settle_on { ... }` —
# as a Dark region (an unknown construct with a `{ ... }` body), and the
# AST walker would have nothing structural to walk. The bindings let the
# existing tokenize+parse infrastructure produce a typed AST that the
# `mirror kintsugi <spec>` dispatcher walks directly.
#
# Kinds chosen so the tokenizer's existing per-kind path produces the
# right shape:
#
#   focus    — opens a recursively-scanned brace block. Top-level
#              `project NAME { ... }` and per-target `target NAME { ... }`
#              + `cli { ... }` use this so their inner directives parse as
#              child AST nodes.
#   settle   — also opens a recursively-scanned brace block. `settle_on`
#              uses this so each predicate inside lifts as a child node.
#   project  — single-line directive that consumes one identifier/ref as
#              its `name` field, no brace block. Used for `source ~d'...'`,
#              `altitude @ref`, `emit ident`, etc. Identifier-shaped
#              values land in the AST node's name field cleanly;
#              string-literal and `~path'...'` carriers are a known
#              substrate gap (the action declarations in spec.mirror
#              declare `value: str` / `paths: [dir_ref]` but the bootstrap
#              tokenizer doesn't yet capture them as typed values — see
#              [[architecture-shards-as-substrate-source]]).
#
# These bindings are the dispatch surface the bootstrap reads today;
# spec.mirror's typed lambdas (e.g. `project(name) -> prism { \ }`) are
# the substrate's settled declaration of what each keyword IS. Both
# surfaces coexist during the kintsugi-formatter transition; when the
# substrate's action-declaration evaluator lands, the typed lambdas
# carry the meaning and these bindings retire.

grammar @mirror/spec("spec") {
  # === boundary terminals (matches @mirror/grammar's `in` / `out`
  # bindings; spec files use `in @ref` at the top to declare
  # grammar/property imports). ===
  project in
  project out

  # === top-level blocks (recursively scanned bodies) ===
  focus project
  focus system
  focus target
  focus cli
  # === VSM sub-directive blocks (recursively scanned; per
  # shards/mirror/spec/system.mirror this-tick grammar species-decl;
  # each admits a nested body per Beer 1972-1984 VSM structure)
  focus s1
  focus s2
  focus s3
  focus s4
  focus s5
  focus feedback_loops
  focus kintsugi_tooling
  settle settle_on

  # === toolchain declarations (Reed 2026-09-02 Task #396) ===
  #
  # `tools { rust { rustflags <value> } }` block at mirror.spec
  # altitude. Declares mirror-owned rustc invocation flags. Retires
  # rust/.cargo/config.toml workaround via mirror craft owning the
  # cargo Command env-set.
  focus tools
  focus rust

  # === single-line directives ===
  project source
  project legacy
  project name
  project altitude
  project emit
  project manifest
  project needs

  # `check IDENT` — names which @io/cargo (or future altitude) action
  # the target dispatches. Optional; when present, the dispatcher uses
  # the named action (cargo's subcommand) instead of the default
  # (`cargo check`). Per shards/io/cargo.mirror's declared actions:
  # `check` / `test` / `build` exist today; `fmt_check` / `clippy` /
  # `audit` extend the surface to cover the pre-commit chain
  # (recognition #43, the build-system substrate-pull).
  project check

  # === toolchain directives (Reed 2026-09-02 Task #396) ===
  #
  # `rustflags <value>` inside `tools { rust { ... } }` block.
  # `inherit_from_env` is a substrate-declared literal meaning
  # "read env's RUSTFLAGS at craft-time". Value tokens parse as
  # identifiers per project-keyword semantics.
  project rustflags
}
