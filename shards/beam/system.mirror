# === The beam_system carrier ===
#
# The typed record for @beam/system at species altitude. Composes the
# five VSM subsystems mapped to BEAM substrate carriers per §The
# isomorphism above:
#
#   s1_gen_prism_workers  — list of @spectral/gen_prism worker
#                            references (S1 operations at BEAM/process
#                            altitude). Typed as `ref` for list-of-
#                            gen_prism until list-carrier surfaces.
#   s2_dance_ensemble     — @dance ensemble reference (S2 coordination
#                            connection 1-form; forward-promised per
#                            Mara Round-1).
#   s3_supervisor         — @spectral/supervisor reference (S3 audit
#                            management with restart_strategy).
#   s4_spectral_db        — @spectral/db reference (S4 intelligence
#                            psychohistory carrier).
#   s5_identity           — viable.identity carrier (S5 policy; per
#                            @epistemologic/cybernetic/viable.identity
#                            at :409).
#
# Identity contract: byte-equality on the five-field tuple.
type beam_system = {
  s1_gen_prism_workers: ref,
  s2_dance_ensemble:    ref,
  s3_supervisor:        ref,
  s4_spectral_db:       ref,
  s5_identity:          identity,
}

# === beam_system_of_pack_home — the composition-primitive action ===
#
# Per feedback_composition_primitive_naming_convention. Given a peer's
# home directory (per @peer.home carrier), constructs the beam_system
# by resolving:
#
#   1. S1: enumerate all @spectral/gen_prism worker references in the
#      peer's runtime state (per @spectral/gen_prism substrate).
#   2. S2: resolve the peer's @dance ensemble reference (forward-
#      promised).
#   3. S3: resolve the peer's @spectral/supervisor reference (per
#      restart_strategy discipline).
#   4. S4: resolve the peer's @spectral/db psychohistory carrier.
#   5. S5: resolve the peer's viable.identity via @pack.peer
#      discipline.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]]. The BEAM runtime consumer discharges
# via BEAM-native introspection primitives (per @code/beam substrate);
# NOT via Rust extension per HARD RULE.
#
# Sentinel: `beam=system-composition-from-peer-home`.
beam_system_of_pack_home(home: ref) -> beam_system
requires beam_system_composition_verified(result)
{ \ }

# === beam_system_composition_verified — bilateral predicate ===
#
# Discharges Pass iff the beam_system carrier satisfies the four-
# tradition composition requirements (per @system.mirror §Four-
# tradition composition):
#
#   Beer (VSM 1972-1984): all five VSM subsystems present with
#     non-null carriers; algedonic channel accessible via viable.
#     algedonic_signal composition.
#
#   Armstrong (BEAM/OTP): restart_strategy discipline on
#     s3_supervisor is well-typed (per @spectral/supervisor);
#     process-isolation on s1_gen_prism_workers is preserved.
#
#   Baez-Schreiber (higher gauge theory): the connection at each
#     level (s2_dance_ensemble at S2, s3_supervisor at S3) satisfies
#     the compatibility condition (Baez-Schreiber 2004 Theorem 3)
#     with the level below.
#
#   Autopoietic Lawvere-fixed-point: s5_identity discharges viable.
#     viable_well_formed on the composed beam_system carrier (the
#     system's identity survives the substrate's own perturbations
#     via let-it-crash + restart discipline).
#
# Rice-safe bound: reads only byte-visible state (ref-non-null,
# well-typedness of variant-tag discriminants, viable_well_formed
# which is itself Rice-safe per viable.mirror, connection-
# compatibility check per @spectral/supervisor Rice-safe substrate).
#
# Sentinel: `beam=system-composition-verified-per-four-traditions`.
bilateral beam_system_composition_verified {
  sentinel "beam=system-composition-verified-per-four-traditions"
  arity 1
}
beam_system_composition_verified(s: beam_system) -> verdict { \ }

# === system_composition_verified — the @system bilateral ===
#
# Composed bilateral per Round-3 brief §Tier 1.9 (embedded in
# appropriate shards): the @autopoiesis × @bauchladen × @time
# closure. Verifies that the beam_system carrier satisfies the four-
# dimensional state space discipline:
#
#   - **@autopoiesis**: s5_identity discharges @autopoiesis's self-
#     production carrier (recursive viability per Beer 1972 ch.10 =
#     autopoiesis at altitude-lift altitude); the system reproduces
#     its own boundary conditions across perturbation via restart
#     discipline.
#
#   - **@bauchladen**: (s1_gen_prism_workers + s2_dance_ensemble +
#     s3_supervisor + s4_spectral_db) IS the tray-of-things the
#     peer carries; the S1-S4 operational surface of the system's
#     identity per Landing 4 subject-general.
#
#   - **@time**: the beam_system persists across the Δt-window per
#     viable.mirror Read D temporal-identity lock; @time's temporal-
#     projection substrate carries the persistence.
#
# The 4D state space closure IS the system_composition_verified
# discharge. Consumer shards name `requires system_composition_
# verified(my_beam_system)` when they need the @system family-root's
# discipline at BEAM runtime altitude.
#
# Sentinel: `system=composition-verified-4d-state-space`.
bilateral system_composition_verified {
  sentinel "system=composition-verified-4d-state-space"
  arity 1
}
system_composition_verified(s: beam_system) -> verdict { \ }

