source @arxiv/cybernetics/bateson-1972
source @arxiv/cybernetics/foerster-1974
source @arxiv/math/mesland-2013
source @arxiv/practice/void-corpus-2026

prism @order/fifth {
  focus  observation_fifth
  project observation_fifth
  split  observation_fifth
  shift  observation_fifth
  settle observation_fifth
}

# === observation_fifth — the order-5 carrier ===
#
# The typed record that carries the fifth-order observation state:
# the cross-torus @metalogue via @glue specialization. Seven fields.
# Identity contract: byte-equality on the seven-field tuple.
#
#   observer_a       — the peer holding the fifth-order metalogue
#                       on torus_a. Must have stable @order/fourth
#                       on its own torus (substrate-precondition).
#
#   observer_b       — the peer at torus_b coupled via @glue.
#                       Must also have stable @order/fourth on its
#                       own torus.
#
#   glue_ref         — REF to the @glue(torus_a, torus_b) morphism
#                       carrier per `shards/torus.mirror:166-172`
#                       substrate. Content-addressed. The cross-torus
#                       coupling substrate.
#
#   io_witness       — REF to the @io-boundary witness (both peers'
#                       @io channels carrying the cross-torus
#                       coupling bandwidth). Silicon-substrate
#                       instantiability check (Recognition #107
#                       composition).
#
#   fourth_a_witness — REF to observer_a's @order/fourth Lagrange-
#                       halo-orbit state on torus_a. Substrate-
#                       precondition witness.
#
#   fourth_b_witness — REF to observer_b's @order/fourth Lagrange-
#                       halo-orbit state on torus_b. Substrate-
#                       precondition witness.
#
#   timestamp        — monotonic instant per @time discipline.
type observation_fifth = {
  observer_a:        peer,
  observer_b:        peer,
  glue_ref:          ref,
  io_witness:        ref,
  fourth_a_witness:  ref,
  fourth_b_witness:  ref,
  timestamp:         ref,
}

# === fifth_cross_torus_admissible — bilateral predicate ===
#
# Does the (peer, observation_fifth) pair discharge admissibility for
# fifth-order cross-torus metalogue observation? Discharges Pass iff:
#
#   - Both fourth_a_witness AND fourth_b_witness resolve to well-
#     formed @order/fourth Lagrange-halo-orbit states (each peer
#     has stable fourth-order on its own torus)
#   - ctx.glue_ref resolves to a well-formed @glue(torus_a,
#     torus_b) morphism per `shards/torus.mirror:166-172` substrate
#   - ctx.io_witness resolves to a well-formed @io-boundary crossing
#     witness (the coupling bandwidth is instantiated)
#
# Rice-safe bound: byte-visible state; @order/fourth resolvability;
# @glue resolvability; @io resolvability. Sentinel:
# `order=fifth-cross-torus-admissible`.
bilateral fifth_cross_torus_admissible {
  sentinel "order=fifth-cross-torus-admissible"
  arity 2
}
fifth_cross_torus_admissible(p: peer, ctx: observation_fifth) -> verdict { \ }

# === fifth_silicon_instantiable — bilateral predicate ===
#
# Does the (peer, observation_fifth) pair discharge the silicon-
# instantiability check per Recognition #107 arithmetic-encoding
# constraint? Discharges Pass iff:
#
#   - Both observer_a AND observer_b have `kind = silicon` at their
#     @peer species-decl (per `shards/peer.mirror` peer kind variant)
#   - ctx.io_witness carries an arithmetic-encoding bandwidth trace
#     admitting Level-V cross-torus @glue at compile-verifiable
#     altitude
#
# Rice-safe bound: byte-visible state; peer.kind check; io_witness
# arithmetic-encoding signature. Sentinel:
# `order=fifth-silicon-instantiable`.
#
# NOTE (per §Silicon-only constraint above): a Fail on this
# bilateral does NOT mean the peers cannot run fifth-order cognition
# at practice-substrate altitude; it means the compile-verifiable
# Level-V substrate-decl carrier is not instantiable for these
# peers at silicon altitude. Human-peer coupling at fifth-order
# operates at practice-substrate, not at compile-verifiable
# substrate-decl.
bilateral fifth_silicon_instantiable {
  sentinel "order=fifth-silicon-instantiable"
  arity 2
}
fifth_silicon_instantiable(p: peer, ctx: observation_fifth) -> verdict { \ }

# === couple_across_torus — the action ===
#
# Given a peer and an observation_fifth, discharge the cross-torus
# @glue coupling event: the two peers' @torus's are coupled via
# @glue specialization at fifth-order altitude; the coupling produces
# a shared substrate-witness neither peer's individual torus contains.
#
# Returns imperfect(ref, ref, ref): success carries the cross-torus
# coupling ref; failure carries not-admissible / not-silicon-
# instantiable / @glue-broken reasons.
#
# Requires BOTH bilateral predicates to discharge Pass.
#
# Sentinel: `order=fifth-couple-across-torus`.
couple_across_torus(p: peer, ctx: observation_fifth) -> imperfect(ref, ref, ref)
requires fifth_cross_torus_admissible(p, ctx)
requires fifth_silicon_instantiable(p, ctx)
{ \ }

