# === task_verdict — typed navigation verdict carrier ===
#
# Per Rec #92 substrate-scale-invariance A_5 lifted to task altitude:
# every @task operation returns Transparency<TaskProperty> LOVE-monoid.
# Type declaration surface; body composed at @task/projection +
# @task/migration + @task/tombstone + @task/link altitudes.
type task_verdict = ref

# === task_node — typed navigation unit ===
#
# Per Mara 89ac1d4 §4.2: the vertex-type of the coordination-altitude
# task-graph. Content-addressed via @mirror/store; sub-graph carried via
# @task/fractal bridge composition; body carried via @nl; edges carried
# via @task/link + @task/migration sub-species.
type task_node = ref

# === task_admissible — bilateral predicate ===
#
# Rice-safe bound: byte-visible task_node with well-formed @mirror/store
# content-address + @nl body + @task/link edge-list. Sentinel:
# `task=admissible`.
bilateral task_admissible {
  sentinel "task=admissible"
  arity 2
}
task_admissible(p: peer, ctx: task_node) -> verdict { \ }

# === @task.materialize_from_tension — the tension → task arrow ===
#
# Per Mara 89ac1d4 §6.2: observed tension at compiler-substrate
# materializes AS @task instance written back to substrate. Composes
# over prismqueer::spectral::tension::detect_tensions (LANDED Reed
# 008cd65) + @nl.compose body (Task #435 forward-promised) +
# @mirror/store.mutate_with_resonance (LANDED). Closes the READ+WRITE
# bidirectional wire per Central Theorem M4.1.
#
# Body forward-promised until:
#   - @nl.compose body lands (retires bc1c268 SHAME marker via
#     commutator{math_object, nl})
#   - Reed wires @mirror/store persistence retiring in-process Vec at
#     rust/src/main.rs::cmd_serve_mcp serve_loop
#
# Sentinel: `task=materialize-from-tension`.
action @task.materialize_from_tension(t: ref) -> task_node
  requires task_admissible(p, t)
{ \ }

out @task
out task_verdict
out task_node
out task_admissible
out materialize_from_tension
