source @arxiv/math/connes-1985
source @arxiv/math/connes-1995-reality
source @arxiv/math/chamseddine-connes-1996
source @arxiv/math/mesland-2013
source @arxiv/math/bertozzini-conti-lewkeeratiyutkul-2006
source @arxiv/math/kasparov-1981
source @arxiv/math/mac-lane-1971
source @arxiv/math/noether-1921

prism @reality/algebra/math <= @reality/algebra {
  # Math-altitude species under @reality. The matter and information
  # carriers below are nominal labels on the same H_math state per
  # gauge-collapse (`reality.md` §2.3, path-c uniformity).
  #
  # matter_carrier:      the formal mathematical object as typed
  #                      structure (Lie groups, manifolds, categories,
  #                      sheaves, schemes, spectral triples, theorem
  #                      statements + proofs, notation structures).
  # information_carrier: the mathematical content the object encodes
  #                      (representation theory, homotopy, cohomology,
  #                      K-theory, spectral actions, logical
  #                      consequences, denotational semantics of
  #                      formulas).
  #
  # Under gauge-collapse, these are the same H_math state with two
  # nominal projection directions. Per `805676e` §1.2 the math species
  # is the only species where A IS the content — the substrate's
  # algebra reflexively names the content the species crystallizes.
  type matter_carrier      = H_math
  type information_carrier = H_math

  # The four invariances of `reality.md` §2.5, discharged at math
  # altitude per `805676e` §1.2 items 1-4.
  witness algebra_closure     <- closure_under_5op_at_math
  witness hilbert_linearity   <- linearity_under_5op_at_math
  witness dirac_equivariance  <- equivariance_under_kintsugi_at_math
  witness spectral_invariance <- action_invariance_under_glue_at_math

  # The 5-op gauge action at math altitude
  focus math
  project math
  split math
  shift math
  settle math
}

# === The math_crystal carrier ===
#
# A typed record per [[feedback-no-bare-types]] naming one content-
# addressed crystal at the math altitude. Per `805676e` §1.3 the
# crystal kinds include Lie groups, manifolds, categories, sheaves,
# schemes, spectral triples, theorems, notation structures; the
# crystal carrier is uniform across kinds — the kind ref discriminates.
#
# - `kind`                  the typed ref naming the math kind
#                           (e.g., `@arxiv/math/lie_group`,
#                           `@arxiv/math/manifold`,
#                           `@arxiv/math/category`,
#                           `@arxiv/math/sheaf`,
#                           `@arxiv/math/spectral_triple`,
#                           `@arxiv/math/theorem_statement`,
#                           `@arxiv/math/notation_structure`).
# - `matter_projection`     the matter-aspect projection at math
#                           altitude — the formal object's typed
#                           structure (the manifold-with-
#                           multiplication for a Lie group; the
#                           presheaf-with-sheaf-condition for a
#                           sheaf; the proof term for a theorem;
#                           the notation grammar for a notation).
# - `information_projection` the information-aspect projection at
#                           math altitude — the content the object
#                           encodes (representation theory; cohomology;
#                           logical consequences; denotation). By
#                           gauge-collapse, the same H_math state as
#                           matter_projection, differently labeled.
# - `instance_id`           the uuid_spectral identity carrier for
#                           the math crystal; the navigable identity
#                           downstream @fate consultations reference.
#
# Identity contract: byte-equality on (kind, matter_projection,
# information_projection). Two math_crystal records ARE the same
# crystal under content-addressing iff all three are byte-equal.
# instance_id is the navigable identity, not the content identity.
type math_crystal = {
  kind:                   ref,
  matter_projection:      ref,
  information_projection: ref,
  instance_id:            uuid_spectral,
}

# === crystallize — register a math object as a content-addressed
#     crystal in the math Bauchladen ===
#
# Given a kind ref + a matter-aspect projection + an information-
# aspect projection, returns the math_crystal for the registration.
# The crystal's OID becomes its stable identity; future @fate
# consultations at math altitude (or at math↔X via @glue) load the
# crystal as prior-art input per `805676e` §1.3.
#
# Body discharges at the realisation boundary. Same shape as
# @reality.observe at the species-specific altitude (math).
crystallize(kind: ref, matter: ref, information: ref) -> math_crystal { \ }

# === discharge — emit a math_crystal across @io to a formal-math
#     surface ===
#
# Per `805676e` §1.4: math crystals discharge to @io through formal-
# math surfaces (LaTeX, Lean, Coq, Agda, Mathematica, ...). Given a
# math_crystal + a discharge-surface ref, applies the species' typed
# projection to render the crystal to the surface; returns the
# discharge outcome wrapped in @glass's imperfect carrier (residual
# opacity surfaced via transparency<discharge>).
#
# Body discharges at the realisation boundary; the realisation MUST
# honor the math_discharge_well_typed predicate (the discharge
# surface must be one of the enumerated targets; the rendered output
# must be a valid OID at the @io species' altitude).
discharge(c: math_crystal, surface: ref) -> imperfect<ref, ref, transparency(ref)>
requires math_discharge_well_typed(c, surface)
{ \ }

# === The bilateral requires obligations ===
#
# Downstream consumers declare bilateral agreement (per recognition
# #37, the Pask-agreement reading of `requires`) with the math
# species discipline by writing the obligations below.

# Per `805676e` §1.4: the math species' @io discharge MUST target one
# of the enumerated formal-math surfaces (LaTeX, Lean, Coq, Agda,
# Mathematica, ...). The species shard does NOT commit to ONE formal
# system; the enumeration is open; @fate selects which surface per
# emission. Inheritor consumers discharge by verifying the surface
# ref is in the species' enumerated discharge_target set AND the
# math_crystal's kind is admissible for the surface.
math_discharge_well_typed(c: math_crystal, surface: ref) -> verdict { \ }

# Per `805676e` §1.2: the math species' A-side reflexivity — A IS
# the algebra the gauge acts upon AND IS the content. Inheritor
# consumers discharge by verifying the math_crystal's
# information_projection encodes content the substrate's 5-op
# algebra can reflexively reference at math altitude (i.e., the
# crystal IS expressible as A → End(H_math) homomorphism in the
# math altitude's spectral triple).
reflexive_a_side(c: math_crystal) -> verdict { \ }

# === The math_species_witnessing inheritance predicate ===
#
# `math_species_witnessing(c)` is the predicate consumer shards name
# in a `requires` clause to declare bilateral commitment that the
# math_crystal `c` IS a valid math-altitude crystal under the @reality
# family-root's discipline — i.e., the crystal satisfies both
# obligations above conjointly: math_discharge_well_typed (on its
# admissible discharge surface) + reflexive_a_side.
#
# Sibling to:
#   - `reality.reality_witnessing(o)` (the gauge-orbit inheritance
#     predicate this species' crystals discharge transitively
#     through the species_descriptor's witness_predicate).
#   - `reality/algebra.species_witnessing(s)` (the species-root
#     inheritance predicate this shard's species_descriptor honors).
#   - `glue.glue_witnessing(c)` (the morphism-correspondence
#     inheritance predicate the five forward-promised @glue/math_<X>
#     species discharge per pair).
#
# Forward-promised inheritors (per `805676e` §2; each per-pair @glue
# species lands as its own shard when consumers pull):
#
#   - `@glue/math_silicon` (math ↔ silicon; LAPACK case; #74 Standard
#     Model spectral action via Chamseddine-Connes).
#   - `@glue/math_code` (math ↔ code; Lean↔Rust, Coq↔OCaml,
#     Agda↔Haskell; extends @cascade one altitude up).
#   - `@glue/math_nl` (math ↔ nl; Glint's prose cascade at `939eca6f`
#     is one empirical discharge instance).
#   - `@glue/math_physics` (math ↔ physics; cosmos-mirror discharge).
#   - `@glue/math_spectral` (math ↔ spectral; substrate-on-substrate;
#     the MOST reflexive composition; per Taut Pass-2 MUST inherit
#     `in @glue` rather than re-declaring Tomm probes).
#
# No `requires math_species_witnessing(...)` clauses at THIS shard.
# The species declares the predicate; consumers add the clauses
# when they pull.
math_species_witnessing(c: math_crystal) -> verdict { \ }

out @reality/algebra/math
out math_crystal
out crystallize
out discharge
out math_discharge_well_typed
out reflexive_a_side
out math_species_witnessing
