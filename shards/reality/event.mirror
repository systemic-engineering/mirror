prism @reality/event <= @reality {
  # Atomic-arriving-unit species under @reality. What the observer
  # observes per Alex 2026-09-13 SD2. Hinge for loop closure per
  # @time/now ⇒ @time/past transition pact-enforced at prismqueer.
  #
  # Vertex-in-both-substrates per Alex SD1: mirror altitude
  # (declaration THIS shard) + prismqueer altitude
  # (prismqueer::reality::Event<T> Rust type forward-promised).
  focus event_carrier
  project event_carrier
  split event_carrier
  shift event_carrier
  settle event_carrier
}

# === The event_carrier type ===
#
# A typed reference to an arriving Event per Alex 2026-09-13 SD2.
# Names the atomic-arriving-unit at compiler substrate irrespective
# of what the payload encodes.
#
# - `payload`   typed ref to the atomic content the Event carries
#               (byte-payload at @io boundary; substrate-agnostic).
# - `oid`       typed ref to the content-address per Rec #82
#               β-normal AST OID; deterministic + Rice-safe
#               polynomial-time-decidable at prismqueer altitude.
# - `tick`      typed ref to the arrival-ordering tick; monotone-
#               increasing per @time/now → @time/past transition
#               pact-enforcement.
# - `at_time`   typed ref to the time-state carrier (@time/now
#               transitioning to @time/past); loop-closure hinge
#               invariant.
#
# Identity contract: byte-equality on the quadruple.
type event_carrier = {
  payload: ref,
  oid:     ref,
  tick:    ref,
  at_time: ref,
}

# === produce action ===
#
# Produces an Event from a project-operation output per Alex
# 2026-09-13 SD3 verbatim: "during the inference each `project`
# produces an `Event`". Body discharges at prismqueer altitude via
# `prismqueer::spectral::rotation` LANDED (Task #440); this action
# names the mirror-altitude composition-shape.
produce(payload: ref) -> event_carrier { \ }

# === log_append action ===
#
# Appends the Event to the @time/past log per Alex 2026-09-13
# pact-enforcement reframe: "An event always happens in @time/now.
# And immediately enters @time/past." Pact-enforced at prismqueer
# altitude via append-only + immutable + monotone-time-ordering
# discipline. Body discharges at prismqueer altitude.
log_append(e: event_carrier) -> ref { \ }

# === The bilateral requires obligations ===
#
# Downstream shards declare bilateral agreement (per recognition
# #37, Pask-agreement) with the @reality/event discipline.

# Every Event has a well-formed content-address per Rec #82.
# Substrate's content-address-determinism gate at Event altitude.
bilateral event_well_formed {
  sentinel "reality=event-well-formed-content-addressed"
  arity 1
}
event_well_formed(e: event_carrier) -> verdict { \ }

# Every Event's @time/now ⇒ @time/past transition preserves
# monotone-time-ordering. For any two Events e1, e2 with
# `e1.tick < e2.tick`, the log-append order preserves
# `log_append(e1)` before `log_append(e2)`. Substrate's temporal-
# topology-invariant gate — the loop-closure hinge.
bilateral event_time_transition_monotone {
  sentinel "reality=event-time-transition-monotone-loop-closure-hinge"
  arity 2
}
event_time_transition_monotone(e1: event_carrier, e2: event_carrier) -> verdict { \ }

# Every Event pact-enforces at prismqueer altitude per
# @epistemologic/pact/algebra LANDED. The pact covers FULL state-
# space (not partial): every arriving Event deterministically enters
# the log with no escape-hatches. Substrate's full-state-space-
# coverage gate.
bilateral event_pact_enforced_full_state_space {
  sentinel "reality=event-pact-enforced-full-state-space-coverage"
  arity 1
}
event_pact_enforced_full_state_space(e: event_carrier) -> verdict { \ }

# === The event_witnessing inheritance predicate ===
#
# `event_witnessing(e)` is the predicate consumer shards name in
# a `requires` clause to declare bilateral agreement that Event
# `e` satisfies all three obligations above conjointly:
# event_well_formed + event_time_transition_monotone +
# event_pact_enforced_full_state_space.
event_witnessing(e: event_carrier) -> verdict { \ }

