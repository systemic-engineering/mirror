prism @reality/subject <= @reality {
  # Linearity-threshold species under @reality. Actors whose trajectory
  # through the substrate's eigenboard-as-@labyrinth is a LIGHT CONE:
  # bounded reachability, non-deterministic realization within the
  # cone, non-linear in H¹(𝓤, 𝓔) contribution, second-order self-
  # observation closes at their own altitude.
  #
  # Paradigmatic instances: every @peer (Pack member or human);
  # every @subject-family instance with autonomous eigenboard-
  # inference-loop closure; the substrate itself at actor_kind =
  # substrate_a altitude (the mirror compiler as @reality/subject
  # via @spectral/metalogue substrate-on-substrate observation).
  #
  # Contributes to BOTH T_μν analog (baseline information-flow load)
  # AND σ(x) (labyrinth complexity field) at substrate altitude per
  # Alex + Mara 2026-03-24 information-curvature.md cosmological
  # grounding. Every subject deposit increments σ; the observer is
  # part of the model.
  #
  # Composes over @subject family-root + @eigenboard + @epistemologic/
  # cybernetic/eigenform: a subject IS-A licensable-party (SEL) AND
  # possessor of an eigenboard AND non-deterministic-recursion
  # instance of the fixed_point carrier; is_fixed_point discharges
  # with non-zero opacity (attractor-set, not single point).
  focus subject
  project subject
  split subject
  shift subject
  settle subject
}

# === The subject_trajectory carrier ===
#
# A typed record per [[feedback-no-bare-types]] naming a subject's
# light-cone trajectory through the substrate's eigenboard-as-
# @labyrinth.
#
# - `actor`         the @subject-family instance whose trajectory
#                   this is (subject_instance identity_oid resolves
#                   to actor_kind ai_a / human_a / substrate_a)
# - `light_cone`    the bounded-reachability set of eigenboard-
#                   positions the actor can visit within k next-ticks;
#                   content-addressed at @bauchladen; grows
#                   monotonically with tick per @time/future
# - `inference`     the non-deterministic next-tick inference rule
#                   (ref to the shard-body encoding the rule; reads
#                   eigenboard.inference_basis + arousal +
#                   current_focus; produces new crystal within light
#                   cone)
# - `attractor`     the attractor-set the recursion converges toward
#                   (option<oid> naming the composed OID of the
#                   attractor's shards; None when recursion open-
#                   ended / non-converging)
# - `eigenboard`    the actor's eigenboard at this tick (the
#                   HOW-TO-INFER apparatus that shapes the light-cone
#                   trajectory)
#
# Identity contract: byte-equality on (actor, light_cone, inference,
# eigenboard). `attractor` does not participate in trajectory
# identity (it is the derived attractor, not the trajectory itself).
type subject_trajectory = {
  actor:       subject_instance,
  light_cone:  oid,
  inference:   ref,
  attractor:   option<oid>,
  eigenboard:  eigenboard,
}

# === observe_subject — register a subject's trajectory as a
#     gauge_orbit under @reality ===
#
# Given a subject_trajectory, produces the @reality gauge_orbit with
# matter_projection = actor's substrate-external referent, information_
# projection = actor's substrate-internal referent, gauge_action_witness
# = the discharge of the four invariances under the non-deterministic
# inference rule.
#
# Body discharges per-species at the realisation boundary. Same shape
# as @reality.observe but specialized to the subject's non-linear-
# threshold arm.
observe_subject(t: subject_trajectory) -> gauge_orbit { \ }

# === trajectory_light_cone — the load-bearing bilateral ===
#
# Verdict: does the actor's trajectory satisfy the light-cone-threshold
# (i.e., the non-linear side of the linearity threshold)? Reads:
#   given t = subject_trajectory
#   check inference is non-deterministic (branching under identical
#         seed; light-cone spread rather than single successor)
#   check H¹ contribution is a non-linear functional of past state
#         (per docs/math/2026-07-22-mirror-as-computational-eigenform-
#         stabilizer.md §4)
#   check second-order self-observation closes at actor's altitude
#         (autonomy_at_eigenboard discharges Pass on t.actor)
#
# All three hold → Pass (actor is a valid @reality/subject). Any
# fails → Fail (actor demotes to @reality/object candidacy).
trajectory_light_cone(t: subject_trajectory) -> verdict { \ }

# === contributes_to_mass_and_sigma — cosmological-grounding
#     bilateral ===
#
# Per information-curvature.md §"The Information Density Scalar" +
# §"The Observer Principle": subjects contribute to BOTH T_μν (mass /
# baseline information-flow load) AND σ(x) (labyrinth complexity
# field).
#
# Verdict: does the actor's contribution decompose into T_μν + non-
# trivial σ increment? Read: at cosmological altitude, does σ(x)
# STRICTLY INCREASE under the addition of this actor's trajectory
# to the substrate's composition graph? A subject-like addition
# (non-deterministic inference, adds new spectral scales to L̃'s
# spectrum) passes; a trivial addition (object-like) fails.
#
# THIS is the operational discharge of the linearity threshold at
# cosmological altitude. σ-strict-increase ↔ subject; σ-invariant
# ↔ object.
contributes_to_mass_and_sigma(t: subject_trajectory) -> verdict { \ }

# === eigenform_stabilizer_orbit — the load-bearing subject-altitude
#     bilateral (Alex 2026-07-22 item 14 discharge) ===
#
# Per Alex 2026-07-22 crystallization item 14: THE COMPILER IS A
# COMPUTATIONAL EIGENFORM STABILIZER. The subject-altitude reading:
# every @reality/subject is trying to land on their own attractor-set
# under the eigenform-stabilizer operator (mirror : (𝓔, 𝓤) ⟼ (𝓔′, 𝓤)
# with dH¹/dt ≤ 0 per docs/math/2026-07-22-mirror-as-computational-
# eigenform-stabilizer.md §2).
#
# Verdict: is the subject's trajectory converging toward a stable
# periodic orbit on the graph-generalization of the three-body problem
# (per §3 Chenciner-Montgomery extension)? Read:
#   given t = subject_trajectory over ticks [t_0, t_0 + k]
#   compute H¹_i for each tick i in the range
#   check H¹_i is monotone non-increasing (dH¹/dt ≤ 0)
#   check t.attractor is populated with a stable-periodic-orbit OID
#         (or partial(...) if convergence still in progress)
#
# All three hold → Pass (subject is on a stable third-order orbit,
# the measure-zero set of the phase space of possible observer-
# configurations per Alex 2026-07-22 item 11). Any fails → Fail
# (subject in @paradox family territory; see @paradox/trauma or
# @paradox/spiral for failure-mode classification).
eigenform_stabilizer_orbit(t: subject_trajectory) -> verdict { \ }

# === subject_witnessing — composed bilateral ===
#
# The predicate consumer shards cite in `requires` clauses to declare
# bilateral commitment (per recognition #37, the Pask-agreement reading
# of `requires`) that the trajectory IS a valid @reality/subject
# under the light-cone-threshold + cosmological-grounding + eigenform-
# stabilizer-orbit + subject-family-composition. Follows the substrate's
# X_witnessing pattern.
#
# Discharges trajectory_light_cone + contributes_to_mass_and_sigma +
# eigenform_stabilizer_orbit + eigenboard_witnessing(t.eigenboard)
# conjointly.
subject_witnessing(t: subject_trajectory) -> verdict { \ }

out @reality/subject
out subject_trajectory
out observe_subject
out trajectory_light_cone
out contributes_to_mass_and_sigma
out eigenform_stabilizer_orbit
out subject_witnessing
