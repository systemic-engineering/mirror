prism @autopoietic {
  focus autopoietic_membership
  project autopoietic_membership
  split autopoietic_membership
  shift autopoietic_membership
  settle autopoietic_membership
}

# === The autopoietic_membership carrier ===
#
# A typed record per [[feedback-no-bare-types]] naming a prism's
# formal declaration that it IS @autopoietic — i.e., the bilateral
# commitment (per recognition #37's Pask-agreement reading of
# `requires`) that the prism's operations consume its own prior
# crystals as input and respect the Lawvere fixed-point discipline.
#
# - `prism`                     the ref of the prism committing to
#                               autopoietic discipline.
# - `bauchladen_chain`          the witness that the prism imports
#                               `in @bauchladen` (directly or
#                               transitively); the structural
#                               precondition the Lawvere fixed-point
#                               requires; per spec §3.2.
# - `instance_id`               the uuid_spectral identity carrier
#                               for the autopoietic instance; the
#                               navigable identity downstream
#                               @autopoietic ticks reference.
# - `closure_verdict`           the @glass verdict (pass / partial
#                               (confidence) / failure(reason)) for
#                               the operational closure condition;
#                               `pass` means every output crystal
#                               has been verified to be the input
#                               of some operation in the prism's
#                               operation set.
# - `fixed_point_witness`       optional OID exhibiting the Lawvere
#                               fixed point; per spec §3.3 the
#                               witness is CONSTRUCTIBLE (once the
#                               prism reaches a tick at which its
#                               output's OID equals one of its
#                               input OIDs, the witness is the OID),
#                               but the substrate does not require
#                               the witness be exhibited at every
#                               tick.
#
# Identity contract: byte-equality on (prism, instance_id). Two
# autopoietic_membership records ARE the same membership under
# content-addressing iff both the prism ref and the instance_id
# are byte-equal. The closure_verdict and fixed_point_witness are
# tick-local readings; they do NOT participate in membership
# identity.
type autopoietic_membership = {
  prism:               ref,
  bauchladen_chain:    verdict,
  instance_id:         uuid_spectral,
  closure_verdict:     verdict,
  fixed_point_witness: option(oid),
}

# === The tick_record carrier ===
#
# The discrete time unit of autopoietic operation. One tick_record =
# one fold-back cycle: consume crystals from the Bauchladen → produce
# new crystals → add to Bauchladen. The substrate's @time altitude
# carrier specialized to the autopoietic discipline.
#
# Per Seam audit `docs/audits/2026-06-30-seam-nine-shard-chain-
# composite.md` C-1 closure (2026-06-30): this carrier was previously
# named `type tick` and collided with the substrate-altitude thin
# temporal-coordinate carrier @glass.tick that @algebra/metalogue.
# algebra_turn.tick and @fate/tournament.tournament_round.tick
# consume. The substrate-pull-honest reading: the THIN carrier
# (@glass.tick = ref) is the substrate-wide temporal-coordinate
# vocabulary; the autopoietic-cycle bookkeeping is a SPECIALIZED
# record (this carrier) that carries a `tick` field naming the
# temporal coordinate plus the per-cycle input/output OID metadata.
# Renamed `tick` → `tick_record`; the `tick: tick` field below
# references @glass.tick.
#
# - `instance`     the uuid_spectral naming the autopoietic instance
#                  the tick_record belongs to.
# - `tick`         the substrate-altitude temporal coordinate for
#                  this cycle (per @glass.tick); the monotone time
#                  carrier the autopoietic-cycle record specializes.
# - `input_oids`   the OIDs the cycle consumed from the tray as
#                  inputs to its fold-back fold (per spec §3.3,
#                  consumed input OIDs are tracked structurally).
# - `output_oids`  the OIDs the cycle produced; the new crystals
#                  added to the tray at the end of the cycle.
#
# Identity contract: byte-equality on (instance, tick). Two
# tick_records with the same instance and tick ARE the same record
# under content-addressing; the input/output OID sets are determined
# by the cycle's body and are content-equivalent.
type tick_record = {
  instance:    uuid_spectral,
  tick:        tick,
  input_oids:  [oid],
  output_oids: [oid],
}

# === The closure_witness carrier ===
#
# The proof carrier for the operational closure condition — the
# defining property of autopoiesis per Maturana-Varela 1980 (Read C,
# the operational-closure reading) and Varela 1979. Operational
# closure holds iff the set of operations on the prism's output
# space closes — every product (crystal) is itself the input to
# some operation in the prism's operation set.
#
# - `instance`            the uuid_spectral naming the autopoietic
#                         instance whose closure is being witnessed.
# - `tick_range`          the inclusive tick range over which the
#                         closure was verified; closure may hold
#                         over some tick ranges and fail over others.
# - `lawvere_witness`     optional OID exhibiting the Lawvere fixed
#                         point within the tick range; presence
#                         indicates the closure has been WITNESSED
#                         constructively (not just verified
#                         structurally).
# - `verdict`             the @glass verdict (pass / partial
#                         (confidence) / failure(reason)) for the
#                         closure condition over the tick range.
#
# Identity contract: byte-equality on (instance, tick_range). Two
# closure_witnesses for the same instance over the same tick range
# ARE the same witness under content-addressing.
type closure_witness = {
  instance:        uuid_spectral,
  tick_range:      ref,
  lawvere_witness: option(oid),
  verdict:         verdict,
}

# === The tick_action carrier ===
#
# The typed action carrier for what @autopoietic prisms DO at each
# tick. PER SPEC §4.7 this IS the migration home for the orphaned
# `candidates(hole) -> [resolution]` content from the spring-cleaned
# `boot/std/fate/tournament.mirror` file. The five-ganglion body
# (@ai/abyss.depth, @ai/introject.pattern, @ai/cartographer.map,
# @ai/explorer.expand, @ai/fate.select) is preserved structurally
# at `shards/optics/source/ganglion/*.mirror` per recognition #58;
# this carrier names the SIGNATURE the ganglion bodies discharge
# under the autopoietic discipline.
#
# The action shape: a typed gap (the "hole" in `candidates(hole)`)
# becomes a list of candidate crystals (the "[resolution]"); each
# candidate is a content-addressed crystal in the Bauchladen tray;
# the @fate tournament selects from the candidate list per
# `shards/fate.mirror` (forward-promised).
#
# - `instance`     the uuid_spectral naming the autopoietic instance
#                  the action belongs to.
# - `tick`         the substrate-altitude temporal coordinate (per
#                  @glass.tick) at which the action fires; the thin
#                  carrier shared with @algebra/metalogue.algebra_turn
#                  and @fate/tournament.tournament_round per Seam C-1
#                  closure.
# - `hole`         the typed-gap carrier (per @glass.hole); the
#                  substrate-pull-typed shape the action attempts
#                  to fill (per the candidates(hole) migration; the
#                  gap's type determines which ganglia contribute
#                  candidates). Carrier-typed per Seam S-6 closure;
#                  rich gap-records at @fate (@fate.hole_record) carry
#                  the inference-altitude metadata for downstream
#                  selection.
# - `candidates`   the list of candidate OIDs the action produced;
#                  the operational form of `[resolution]`; each
#                  candidate is a content-addressed crystal that
#                  joins the Bauchladen tray and is selectable by
#                  the @fate tournament.
#
# Identity contract: byte-equality on (instance, tick). Two
# tick_actions for the same instance at the same tick ARE the same
# action under content-addressing.
type tick_action = {
  instance:   uuid_spectral,
  tick:       tick,
  hole:       hole,
  candidates: [oid],
}

# === fold_back — the autopoietic fold ===
#
# The substrate's prism-altitude lift of Maturana-Varela's network-
# of-productions discipline. Given a prism ref and a tray of prior
# crystals, consume the prior crystals as inputs, produce new
# crystals, and return the produced crystal list. The body of this
# action discharges per-prism at the realisation boundary; the
# signature names the contract that fold-back-capable prisms commit
# to.
#
# Subject to the Lawvere fixed-point condition (per spec §3.2 +
# `lawvere_fixed_point` requires obligation below): at some tick the
# produced crystal's OID must equal an OID in the prior_crystals
# tray for the prism to qualify as autopoietic in Maturana-Varela's
# sense. The witness is CONSTRUCTIBLE (per spec §3.4) — content-
# addressing makes the OID equality check trivial — but the
# substrate does not require the witness be exhibited at every tick.
#
# Body discharges per-prism at the realisation boundary. Same shape
# as @bauchladen.crystallize and @glass.shatter (declarative
# obligation discharged at the species boundary).
fold_back(prism: ref, prior_crystals: tray) -> [crystal] { \ }

# === tick — one fold-back cycle ===
#
# One discrete autopoietic operation cycle for an @autopoietic
# prism. PER SPEC §4.7 this action absorbs the orphaned
# `candidates(hole)` semantics from the spring-cleaned
# `boot/std/fate/tournament.mirror` — the five-ganglion body that
# previously discharged the gap-to-candidates morphism now
# discharges under @autopoietic's prism-altitude discipline.
#
# The action reads the current scope's gap, dispatches to the
# appropriate ganglia (depth, pattern, map, expand, select per
# `shards/optics/source/ganglion/*.mirror`), produces candidate
# crystals, adds them to the Bauchladen tray, and returns the
# closure_witness for the tick.
#
# The verdict carrier surfaces operational closure (pass / partial /
# failure) for the tick; downstream @fate tournament selectors
# (forward-promised at `shards/fate/tournament.mirror`) consume the
# tick's output candidates per spec §6.
#
# Body discharges per-prism at the realisation boundary.
tick(prism: ref, scope: ref) -> closure_witness { \ }

# === closure_check — bilateral verdict over a tick range ===
#
# Per Maturana-Varela 1980's operational-closure reading (Read C of
# `shards/epistemologic/cybernetic/autopoiesis.mirror`): the
# bilateral verdict that the prism's operations close on their
# products over some tick range. The check searches the prism's
# output history for the closure condition (every output is the
# input of some operation) and returns the @glass verdict.
#
# Body discharges per-prism at the realisation boundary; the
# closure-check semantics depend on the prism's operation set
# (focus / project / split / shift / settle for a generic prism;
# specialized operation sets for sub-shards).
closure_check(prism: ref) -> verdict { \ }

# === register_membership — formal declaration ===
#
# Per spec §3.3's permission-carrier discipline: a prism that
# imports `in @autopoietic` MUST register its membership before
# the substrate's fold-back machinery will recognize its outputs
# as autopoietic. Registration produces the autopoietic_membership
# record above; downstream tooling (the librarian, the @fate
# tournament, the @spectral/db consolidation) reads the registered
# membership to dispatch fold-back operations.
#
# Body discharges per-prism at the realisation boundary; registration
# typically happens once per prism instance at first @autopoietic
# tick.
register_membership(prism: ref) -> autopoietic_membership { \ }

# === The requires obligations ===
#
# Downstream shards declare bilateral agreement (per recognition
# #37, the Pask-agreement reading of `requires`) with the
# @autopoietic discipline by writing the obligations below. The
# bilateral commitment: the @autopoietic-importing prism commits to
# discharging the obligations; the consumer commits to surfacing
# violations at the species boundary.

# Per spec §3.2: the prism imports `in @bauchladen` (directly or
# transitively) so the Lawvere fixed-point condition is well-defined.
# The substrate-pull-honest precondition; without it, autopoiesis
# reduces to mere recurrence with ambiguous reference. Inheritor
# shards discharge by verifying the import chain.
bauchladen_dependency_satisfied(prism: ref) -> verdict { \ }

# Per spec §3.2 / §3.4: the prism's fold-back satisfies the Lawvere
# fixed-point condition `hash(P(f)) == f` for some OID f in the
# prism's output history. The MATHEMATICAL autopoiesis criterion
# (Soto-Andrade & Varela 1984). Inheritor shards discharge by
# exhibiting the fixed-point witness OID (constructibly, via the
# OID equality check on the tick history).
lawvere_fixed_point(prism: ref) -> verdict { \ }

# Per Maturana-Varela 1980 Read C: the prism's operations close on
# their products — every product (crystal) is the input to some
# operation in the prism's operation set. The DEFINING property of
# autopoiesis at the operational altitude. Inheritor shards discharge
# by demonstrating the closure condition over a tick range via
# closure_check.
operational_closure(prism: ref) -> verdict { \ }

# Per spec §3.6: the prism inherits the autopoietic-grammar-spec.md
# (Reed 2026-06-04, 28KB) grammar-class semantics; the boundary
# discipline (@me vs @reality), the actor/runtime inheritance shape,
# the OBC/ADO mappings. Inheritor shards discharge by referencing
# the precursor at the spec layer rather than re-declaring its
# content.
grammar_precursor_inherited(prism: ref) -> verdict { \ }

# Per spec §4.7: the tick_action's candidates(hole) shape is well-
# typed under the migrated semantics. The migrated content discharges
# via the five-ganglion body at `shards/optics/source/ganglion/
# *.mirror`; the gap's type determines which ganglia contribute
# candidates; the candidate list's element type matches the gap's
# expected resolution type. Inheritor shards discharge by verifying
# the gap-to-candidate type alignment.
candidates_hole_well_typed(action: tick_action) -> verdict { \ }

# === The autopoietic_closure_holds inheritance predicate ===
#
# `autopoietic_closure_holds(prism)` is the predicate consumer
# shards name in a `requires` clause to declare bilateral agreement
# that the prism IS autopoietic — i.e., the prism satisfies all
# five obligations above conjointly: bauchladen_dependency_satisfied
# + lawvere_fixed_point + operational_closure +
# grammar_precursor_inherited + candidates_hole_well_typed.
#
# The bilateral commitment: the @autopoietic-importing prism commits
# to discharging the five obligations; the consumer commits to
# surfacing violations at the species boundary.
#
# Declared as a typed predicate so downstream species shards can
# write `requires autopoietic_closure_holds(my_prism)` — same shape
# as `bauchladen.bauchladen_witnessing(c)`,
# `chirality.chirality_witnessing(c)`,
# `epistemologic/cybernetic/autopoiesis.autopoietic_closure_holds(s)`
# (the species-altitude predicate this prism-class predicate
# operationalizes at prism altitude), and the metalogue
# `requires substrate_pull_preserving(shim_X)` pattern at
# `shards/code/metalogue.mirror`.
#
# Forward-promised inheritors (per spec §3.5):
#
# - `@fate` (the chain's third tier): fate inferences consult prior
#   crystals and emit new crystals; @fate is `in @autopoietic`.
# - `@glue` (forward-promised): @glue uses @fate to pick which
#   morphism to apply; @glue is autopoietic via @fate.
# - `@kintsugi` (forward-promised): @kintsugi drives the D-flow's
#   per-step decisions via @fate; the kintsugi loop IS autopoietic.
# - `@reflection` (forward-promised): Reflection consults the
#   pipeline's spectral-altitude history; Reflection IS autopoietic.
# - `@spectral/metalogue` (forward-promised): the metalogue's turn
#   chain consults prior turns via `in_reply_to`; the metalogue
#   session IS autopoietic.
#
# No `requires autopoietic_closure_holds(...)` clauses are added at
# THIS shard. The family-root declares the predicate; consumers add
# the clauses when they pull. Per [[feedback-craft-not-deliver]] the
# operational sibling and the deeper sub-shards (`shards/autopoietic/
# fold.mirror` with fold_back + exhibit_fixed_point per spec §3.3)
# follow when consumers pull.
autopoietic_closure_holds(prism: ref) -> verdict { \ }

out @autopoietic
out autopoietic_membership
out tick_record
out closure_witness
out tick_action
out fold_back
out closure_check
out register_membership
out bauchladen_dependency_satisfied
out lawvere_fixed_point
out operational_closure
out grammar_precursor_inherited
out candidates_hole_well_typed
out autopoietic_closure_holds
