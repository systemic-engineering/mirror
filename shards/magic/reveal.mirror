# `@epistemologic/pact/path_matches_namespace`.

source @arxiv/distributed/armstrong-2003
source @arxiv/concurrent/herlihy-1991
source @arxiv/software/lehman-belady-1985

prism @magic/reveal {
  focus reveal
  project reveal
  split reveal
  shift reveal
  settle reveal
}

# === reveal_event carrier ===
#
# A typed record per [[feedback-no-bare-types]] naming an atomic
# mechanism replacement. Records the substrate-political receipt of
# a controlled disclosure across the contract boundary:
#
# - `contract`       the magic_contract that holds the mechanism.
# - `old_mechanism`  the mechanism present before reveal.
# - `new_mechanism`  the mechanism present after reveal.
# - `witness`        substrate-typed witness ref naming evidence of
#                    invariant preservation across the swap.
#
# Identity contract: byte-equality on the quadruple.
type reveal_event = {
  contract:      magic_contract,
  old_mechanism: magic_mechanism,
  new_mechanism: magic_mechanism,
  witness:       ref,
}

# === reveal action ===
#
# THREE NON-DECORATIVE `requires` CLAUSES per tick 14 + tick 21 Seam
# consolidation gap #3 closure. The substrate-vocabulary action that
# atomically replaces a contract's mechanism while preserving its
# surface and contract invariants — with BILATERAL discipline on BOTH
# sides of the swap.
#
# requires audited(c): contract audited before reveal proceeds.
# requires mechanism_intact(c.mechanism): the OLD mechanism is
# tamper-evidence intact before swap.
# requires mechanism_intact(new_m): the NEW mechanism is also
# tamper-evidence intact before swap. Per Seam tick 12-19
# retrospective: without this, atomic-swap was one-sided. The
# substrate-pull-correct atomic swap discipline is bilateral; both
# old and new must satisfy the invariant.
#
# Together: the substrate-pull-correct runtime-safe atomic replacement
# primitive with bilateral integrity. Per recognition #81: reveal IS
# the runtime-altitude realization of @magic's controlled disclosure.
#
# At Clarke's-law altitude: reveal IS the magician's controlled reveal
# — the mechanism is replaced; the surface IS unchanged; the contract
# IS honored; BOTH the old trick and the new trick must be intact for
# the substitution to honor the audience's trust.
#
# Body discharges at the realisation boundary; per-species bodies
# implement the actual atomic swap with appropriate fencing.
reveal(c: magic_contract, new_m: magic_mechanism) -> magic_contract
requires audited(c)
requires mechanism_intact(c.mechanism)
requires mechanism_intact(new_m)
{ \ }

# === unsealed_during_reveal predicate ===
#
# Bilateral verdict per recognition #37 (Pask agreement). Consumer
# shards name `requires unsealed_during_reveal(event)` to commit to
# verifying the reveal sequence respected the contract's surface
# invariants throughout the swap (not just before and after, but
# also at the swap instant).
unsealed_during_reveal(event: reveal_event) -> verdict { \ }

out @magic/reveal
out reveal_event
out reveal
out unsealed_during_reveal
