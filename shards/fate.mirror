prism @fate {
  focus inference
  project inference
  split inference
  shift inference
  settle inference
}

# === The inference carrier ===
#
# A typed record per [[feedback-no-bare-types]] naming a single
# @fate operation: one dice-roll within the restricted state space.
# The inference is the substrate-decl atom of @fate; each tick of
# @fate emits one inference; the inference's `result` field carries
# the typed geometric formalization that lands as a crystal in the
# @bauchladen tray.
#
# - `instance`           the uuid_spectral naming the @fate instance
#                        the inference belongs to (sibling-shape to
#                        @autopoietic's `instance_id` carrier).
# - `space`              the typed restricted_state_space the
#                        inference rolls within; the (A, H, D, γ,
#                        J, tray) constraint structure for this
#                        roll.
# - `hole`               the typed hole the inference fills; same
#                        shape as @autopoietic's `tick_action.hole`
#                        per the spec §4.7 migration; the inference
#                        altitude consumption point.
# - `result`             the typed geometric_formalization the roll
#                        produced; the crystal payload that joins
#                        the @bauchladen tray under `@fate/algebra/
#                        *` per spec §5.
# - `altitude`           the compile-time / runtime dispatch
#                        discriminator; per the bilateral altitude
#                        discipline (spec §4.1); structurally
#                        determined at inference-construction time.
#
# Identity contract: byte-equality on (instance, hole, altitude).
# Two inferences for the same instance consuming the same hole at
# the same altitude ARE the same inference under content-addressing;
# the dice's result is determined by the space + tray + symmetries
# and is content-equivalent. The space and tray are bookkeeping; the
# identity is what hole gets filled at what altitude.
type inference = {
  instance:  uuid_spectral,
  space:     restricted_state_space,
  hole:      hole,
  result:    geometric_formalization,
  altitude:  ref,
}

# NB: the `hole: hole` field above references @glass.hole (the thin
# substrate-altitude gap carrier per Seam S-6 closure). The rich
# inference-altitude metadata (expected_type / context_oids /
# altitude) lives on this shard's `hole_record` declared further
# below; sub-shards that need the rich metadata consume
# `hole_record`, the inference action signature carries the thin
# `hole` so the carrier composes with @autopoietic.tick_action.hole
# at the chain altitude.

# === The restricted_state_space carrier ===
#
# The typed restriction the dice rolls within. Names the (A, H, D,
# γ, J, tray) jointly per the constrained-inference framing (spec
# §4.2). The dice may only land within the space these constraints
# admit.
#
# - `algebra`            the ref of the algebra A — the operations
#                        the inference may select from; per
#                        [[architecture-operations-as-linear-
#                        algebra]] the five operations specialize
#                        this for the substrate's typical case.
# - `hilbert`            the ref of the state space H — the
#                        Hilbert space the dice's outcome lives in;
#                        per [[reference-void-document]] the
#                        void-document IS the substrate's H.
# - `flow`               the ref of the Dirac operator D — the
#                        flow the inference advances along; per
#                        [[architecture-connes-spectral-triple]]
#                        the kintsugi loop IS the substrate's D.
# - `gamma`              the chirality grading γ that restricts
#                        accessible subspaces by parity (per
#                        recognition #101); the form / process
#                        partition the dice respects.
# - `j`                  the charge_conjugation involution J that
#                        restricts the state space by time-reversal
#                        symmetry (per recognition #102); the
#                        reference ↔ reflection partition the dice
#                        respects.
# - `tray_scope`         the ref of the @bauchladen tray slice that
#                        conditions the roll (the autopoietic
#                        constraint — prior crystals shape the
#                        dice).
#
# Identity contract: byte-equality on the six fields. Two
# restricted_state_spaces with byte-equal fields ARE the same space
# under content-addressing; the space's identity is its constraint
# structure.
type restricted_state_space = {
  algebra:    ref,
  hilbert:    ref,
  flow:       ref,
  gamma:      chirality,
  j:          charge_conjugation,
  tray_scope: ref,
}

# === The geometric_formalization carrier ===
#
# The typed output of an @fate inference. Lands as a crystal in
# the @bauchladen tray under the `@fate/algebra/*` path-namespace
# (forward-promised sub-prism per spec §5). The geometric vocabulary
# is altitude-specific:
#
#   - At the morphism-selection altitude: a morphism declaration
#     in the Mesland category (cross-altitude) or a local category
#     (within-altitude).
#   - At the altitude-selection altitude: a Bateson level name.
#   - At the algebraic-specialization altitude: an algebra element
#     a ∈ A.
#   - At the Hilbert-state-selection altitude: a state vector
#     |ψ⟩ ∈ H.
#
# - `crystal_oid`        the content-address of the formalization
#                        once it joins the tray; the @bauchladen
#                        crystal's OID per `shards/bauchladen.
#                        mirror`'s `crystal.oid` carrier.
# - `algebra_subpath`    the `@fate/algebra/*` sub-path naming the
#                        geometric vocabulary; per spec §5 (e.g.,
#                        `@fate/algebra/morphism`, `@fate/algebra/
#                        altitude`, `@fate/algebra/element`).
# - `payload`            the typed geometric content; the substrate-
#                        ref naming what the dice selected, in the
#                        sub-path's vocabulary.
# - `transparency`       the residual opacity per @glass's
#                        `transparency<altitude>` carrier; reports
#                        any opacity introduced by the formalization
#                        (e.g., property-chain residuals).
#
# Identity contract: byte-equality on `crystal_oid` alone (sibling
# to @bauchladen's `crystal` identity contract — the OID IS the
# identity; payload + algebra_subpath are determined by the
# content that hashes to crystal_oid).
type geometric_formalization = {
  crystal_oid:     oid,
  algebra_subpath: ref,
  payload:         ref,
  transparency:    transparency(altitude),
}

# === The dice_roll carrier ===
#
# The constrained-probabilistic decision @fate emits. Bilateral
# (compile-time + runtime, per the spec §4.1 altitude discipline).
# The roll names the SELECTION: which candidate from the typed
# restriction the dice landed on.
#
# - `instance`           the uuid_spectral naming the @fate instance
#                        the roll belongs to.
# - `space`              the restricted_state_space the roll happened
#                        within (the structural witness of the typing
#                        constraint).
# - `selected_oid`       the OID of the candidate the dice selected;
#                        the candidate is a crystal already in the
#                        @bauchladen tray (per spec §4.7 — the
#                        candidates list is produced by @autopoietic's
#                        tick_action; @fate selects one).
# - `altitude`           the compile-time / runtime altitude the roll
#                        was dispatched at.
# - `verdict`            the @glass verdict (pass / partial
#                        (confidence) / failure(reason)) reporting
#                        whether the roll's outcome is in the
#                        restricted state space (the dice_roll_
#                        constrained obligation below).
#
# Identity contract: byte-equality on (instance, space, altitude).
# Two dice_rolls for the same instance within the same space at the
# same altitude ARE the same roll under content-addressing; the
# selected_oid + verdict are determined by the (instance, space,
# altitude) triple plus the substrate's tray at roll time and are
# content-equivalent.
type dice_roll = {
  instance:     uuid_spectral,
  space:        restricted_state_space,
  selected_oid: oid,
  altitude:     ref,
  verdict:      verdict,
}

# === The hole_record carrier ===
#
# The rich inference-altitude record specializing the substrate's
# thin gap carrier @glass.hole. Absorbs the candidates(hole) semantics
# from the orphaned boot-floor file `boot/std/fate/tournament.mirror`
# per spec §4.7. Consumed at the inference altitude where the @fate
# selection machinery needs the typed-gap metadata (expected_type +
# context_oids + altitude); upstream @autopoietic.tick_action carries
# the thin @glass.hole and downstream consumers (this shard's
# inference actions) consume the thin carrier directly while sub-
# shards that need the full inference-altitude metadata work with
# this specialized record.
#
# Per Seam audit `docs/audits/2026-06-30-seam-nine-shard-chain-
# composite.md` S-6 closure (2026-06-30): the prior `type hole` rich
# record collided with @autopoietic.tick_action.hole (typed `ref`).
# The substrate-pull-honest reading parallels C-1: declare the thin
# carrier (@glass.hole = ref) at substrate altitude; rename the rich
# record to `hole_record` so upstream @autopoietic and downstream
# @fate share the SAME thin carrier in their action signatures while
# this shard's sub-prisms retain the rich-record vocabulary where
# inference-altitude metadata is required.
#
# - `expected_type`      the typed-ref naming the shape the inference
#                        must produce (the candidate's type signature;
#                        the dice may only land on a candidate whose
#                        OID resolves to content of this type).
# - `context_oids`       the OIDs of the surrounding context the
#                        inference operates within (the substrate
#                        state at the inference site; the structural
#                        witness of "where in the substrate this
#                        hole appeared").
# - `altitude`           the altitude the hole appeared at (compile-
#                        time gap in a `\` discharge / runtime gap
#                        in a gen_prism dispatch / spectral-metalogue
#                        gap at the Tomm-probe altitude).
#
# Identity contract: byte-equality on the three fields. Two hole_
# records with byte-equal expected_type, context_oids, and altitude
# ARE the same record under content-addressing.
type hole_record = {
  expected_type: ref,
  context_oids:  [oid],
  altitude:      ref,
}

# === roll — the constrained-inference action ===
#
# The substrate's prism-altitude lift of the dice-roll-within-typed-
# restriction operator. Given a restricted_state_space and a hole,
# returns the dice_roll naming the selection. The dice IS @fate's
# optical inference per recognition #58; the roll is constrained by
# the (A, H, D, γ, J, tray) structure of the space.
#
# Bilateral altitude: dispatches to compile-time vs runtime
# inference machinery per the hole's altitude field (spec §4.1).
# The dispatch is type-consistent (per the
# `bilateral_well_typed(action, altitude)` requires obligation
# below) — same inference contract at both altitudes.
#
# Body discharges per-realisation at the inference boundary. Same
# shape as @autopoietic.tick and @bauchladen.crystallize
# (declarative obligation discharged at the species boundary).
#
# Per Seam audit `docs/audits/2026-06-30-seam-nine-shard-chain-
# composite.md` M-5 closure (2026-06-30): roll honors yesterday's
# bilateral discipline from #101 (γ chirality) + #102 (J charge
# conjugation) at the discharge site. The two requires clauses
# enforce that the restricted_state_space's γ + J fields carry
# witnesses satisfying their respective bilaterals before the dice
# may roll within the restricted state space.
roll(space: restricted_state_space, hole: hole) -> dice_roll
requires chirality_witnessing(space.gamma)
requires j_witnessing(space.j)
{ \ }

# === infer — produces the typed result + crystallizes ===
#
# Composite action: rolls the dice + lifts the selected outcome to
# a geometric_formalization + crystallizes the formalization into
# the @bauchladen tray under the appropriate `@fate/algebra/*`
# sub-path.
#
# The composition is:
#
#   1. dr = roll(space, hole)
#   2. payload = the substrate ref resolved from dr.selected_oid
#   3. formalization = the geometric_formalization wrapping payload
#      at the appropriate algebra_subpath
#   4. crystallize the formalization via @bauchladen.crystallize
#      (under @fate's provenance_record); the crystal joins the
#      tray at altitude `@fate/algebra/*`
#
# Body discharges per-realisation at the inference boundary; the
# realisation MUST honor the `optical_inference_grounded(infer)`
# requires obligation — the infer action realizes @fate-IS-optical-
# inference (recognition #58); the dice IS the optical inference.
infer(space: restricted_state_space, hole: hole) -> geometric_formalization { \ }

# === restrict — apply the symmetry restrictions ===
#
# Constructs a restricted_state_space from a base state ref + the
# chirality γ + the charge_conjugation J. Names the act of
# RESTRICTING the state space to the symmetry-preserving moves —
# per recognitions #101 + #102, only the moves that γ and J admit
# remain accessible to the dice.
#
# The action's body composes the four prior restrictions (A from
# the substrate's permitted operations, H from the void-document,
# D from the kintsugi flow) with the two symmetry restrictions (γ
# from chirality, J from charge_conjugation) plus the tray scope
# (the autopoietic constraint from prior crystals).
#
# Body discharges per-realisation at the inference boundary.
restrict(state: ref, gamma: chirality, j: charge_conjugation) -> restricted_state_space { \ }

# === bilateral_dispatch — compile-time vs runtime selector ===
#
# Per spec §4.1's bilateral altitude discipline (Alex's correction
# to Taut's earlier framing): @fate operates at BOTH compile-time
# AND runtime. This action names the dispatch between the two
# altitudes — given a hole and an altitude, returns the dice_roll
# emitted at that altitude.
#
# The dispatch is type-consistent (per the
# `bilateral_well_typed(action, altitude)` requires obligation
# below). The same inference contract holds at both altitudes; the
# dispatch is a routing decision, not a re-implementation. The
# two altitudes share the @bauchladen tray.
#
# Body discharges per-realisation at the inference boundary.
#
# Per Seam audit `docs/audits/2026-06-30-seam-nine-shard-chain-
# composite.md` C-2 closure (2026-06-30): the `altitude: altitude`
# typing was undeclared (no `type altitude` in the substrate); the
# substrate-pull-honest carrier for altitudes is the substrate's
# universal `ref` per the existing altitude field-typings across
# @fate.inference.altitude, @fate.dice_roll.altitude, @bauchladen.
# crystal.altitude, @algebra.algebra_carrier.altitude. Field-typed
# `altitude: ref` to match.
bilateral_dispatch(hole: hole, altitude: ref) -> dice_roll { \ }

# === The requires obligations ===
#
# Downstream shards declare bilateral agreement (per recognition
# #37, the Pask-agreement reading of `requires`) with the @fate
# discipline by writing the obligations below. The bilateral
# commitment: the @fate-importing prism commits to discharging
# the obligations; the consumer commits to surfacing violations
# at the species boundary.

# @fate IS-A @autopoietic; the @fate instance inherits the
# autopoietic closure discipline. Per spec §1.1 / §4: @fate's
# inferences accumulate; future inferences consult prior crystals;
# the read-write cycle on the tray IS fold-back. Inheritor shards
# discharge by verifying the autopoietic_closure_holds predicate
# on the fate instance per `shards/autopoietic.mirror`'s
# inheritance predicate.
autopoietic_membership_held(fate_instance: ref) -> verdict { \ }

# @fate's geometric formalization outputs land as crystals in the
# @bauchladen tray. Per spec §5: each output IS a content-addressed
# crystal under `@fate/algebra/*`. Inheritor shards discharge by
# verifying the bauchladen_witnessing predicate per `shards/
# bauchladen.mirror` on every emitted formalization.
bauchladen_membership_held(fate_instance: ref) -> verdict { \ }

# Per spec §4.2: the dice_roll's outcome IS in the restricted state
# space — no rolls outside the symmetry-preserving moves the (A, H,
# D, γ, J, tray) constraints admit. This is the substrate-pull-
# honest discipline that distinguishes @fate's typed-random
# inference from arbitrary randomness. Inheritor shards discharge
# by verifying the roll's selected_oid resolves to content in the
# admitted subspace (γ-parity-preserving + J-time-reversal-
# preserving + within-tray-scope).
dice_roll_constrained(roll: dice_roll, space: restricted_state_space) -> verdict { \ }

# Per spec §4.1: the compile-time vs runtime dispatch is type-
# consistent. The same inference contract holds at both altitudes;
# the bilateral dispatch is a routing decision, not a re-
# implementation. Inheritor shards discharge by verifying the
# action's signature is altitude-invariant — the input + output
# types match across compile-time and runtime invocations.
bilateral_well_typed(action: ref, altitude: ref) -> verdict { \ }

# Per recognition #58 ([[architecture-fate-is-optical-inference]]):
# the infer action realizes @fate-IS-optical-inference. The dice
# IS the optical inference (5-layer D²NN + Fabry-Perot resonator
# + Reck/Clements unitary mesh). Inheritor shards discharge by
# verifying the realisation invokes the optical-source ganglion
# machinery at `shards/optics/source/ganglion/*.mirror` per the
# spec §4.7 migration mapping — the operational realization of
# the autopoietic-tick's components per [[architecture-fate-is-
# optical-inference]]'s three independent witnesses.
optical_inference_grounded(infer: ref) -> verdict { \ }

# === The fate_witnessing inheritance predicate ===
#
# `fate_witnessing(roll)` is the predicate consumer shards name in
# a `requires` clause to declare bilateral commitment (per
# recognition #37, the Pask-agreement reading of `requires`) that
# the dice_roll `roll` IS substrate-pull-honest @fate inference —
# i.e., the roll satisfies all five obligations above conjointly:
# autopoietic_membership_held + bauchladen_membership_held +
# dice_roll_constrained + bilateral_well_typed +
# optical_inference_grounded.
#
# Sibling to:
#   - `autopoietic.autopoietic_closure_holds(prism)` (the prism-
#     class inheritance predicate this shard's instances honor
#     via `in @autopoietic`).
#   - `bauchladen.bauchladen_witnessing(crystal)` (the crystal-
#     altitude inheritance predicate this shard's emitted
#     formalizations honor transitively).
#   - `chirality.chirality_witnessing(c)` (the γ-grading inheritance
#     predicate the restricted_state_space's gamma field honors).
#   - `charge_conjugation.j_witnessing(j)` (the J-involution
#     inheritance predicate the restricted_state_space's j field
#     honors).
#
# Forward-promised inheritors:
#
#   - `@fate/tournament` (the selection-over-tray sub-shard;
#     forward-promised per spec §6): tournament selections ARE
#     dice_rolls aggregated across the tray; the tournament
#     discharges fate_witnessing for each selection.
#   - `@fate/algebra/*` (the geometric-formalization sub-shards;
#     forward-promised per spec §5): each algebra sub-path's
#     crystals are emitted by @fate inferences; the sub-shards
#     discharge fate_witnessing for the emissions.
#   - `@glue` (forward-promised per spec §4.5): @glue uses @fate
#     to pick which morphism to apply; @glue's selection IS a
#     dice_roll; @glue discharges fate_witnessing.
#   - `@kintsugi` (forward-promised per spec §4.6): @kintsugi's
#     D-flow per-step decisions ARE dice_rolls; @kintsugi
#     discharges fate_witnessing at each step.
#   - `@reflection` (forward-promised per spec §4.6 + [[architecture-
#     reflection-thinks-in-spectral-questions]]): Reflection's
#     altitude selection IS @fate's dice roll at the meta-pipeline
#     altitude; Reflection discharges fate_witnessing.
#   - `@spectral/metalogue` (forward-promised per recognition #100):
#     Tomm probes ARE @fate's selection species at the spectral-
#     metalogue altitude; the metalogue's [D_F, a] computations
#     discharge fate_witnessing at the spectral altitude.
#
# No `requires fate_witnessing(...)` clauses are added at THIS
# shard. The family-root declares the predicate; consumers add the
# clauses when they pull. Per [[feedback-craft-not-deliver]] the
# sub-shards (`@fate/tournament` per spec §6; `@fate/algebra/*`
# per spec §5) follow when consumers pull.
fate_witnessing(roll: dice_roll) -> verdict { \ }

out @fate
out inference
out restricted_state_space
out geometric_formalization
out dice_roll
out hole_record
out roll
out infer
out restrict
out bilateral_dispatch
out autopoietic_membership_held
out bauchladen_membership_held
out dice_roll_constrained
out bilateral_well_typed
out optical_inference_grounded
out fate_witnessing
