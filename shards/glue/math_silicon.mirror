prism @glue/math_silicon <= @glue {
  # The math ↔ silicon @glue species. Declares the Mesland
  # correspondence between @reality/algebra/math source-side
  # mathematical structures and @reality/algebra/silicon target-
  # side executable realizations (LAPACK kernels, FFI bindings,
  # Fortran-compiled routines).
  #
  # The species inherits from @glue via `<= @glue`; the correspondence,
  # morphism, and translation_outcome carriers are re-used from the
  # family-root; the species specializes the morphism_kind ref to
  # `@arxiv/math/*.lapack_realization` and the restriction to
  # LAPACK's native ABI (column-major, well-conditioned, f32/f64/
  # complex).
  focus correspondence_math_silicon
  project correspondence_math_silicon
  split correspondence_math_silicon
  shift correspondence_math_silicon
  settle correspondence_math_silicon
}

# === The math_silicon_translation carrier ===
#
# A typed record per [[feedback-no-bare-types]] specializing the
# @glue family-root's translation_outcome to the math ↔ silicon
# pair. The carrier binds the (math input, LAPACK realization,
# silicon output, residual-opacity) tuple that a single
# @glue.translate(c_math_silicon, payload) invocation produces.
#
# - `correspondence`     the ref of the c_math_silicon correspondence
#                        the translation was performed under; carries
#                        (source_prism = @reality/algebra/math,
#                        target_prism = @reality/algebra/silicon,
#                        morphism_kind, restriction).
# - `selected_morphism`  the OID of the LAPACK realization @fate
#                        selected — e.g., dpotrf for real Cholesky
#                        with column-major layout; the substrate-
#                        altitude form of the LAPACK routine name.
# - `math_input`         ref naming the source-side math crystal
#                        (e.g., an spd_matrix instance from
#                        @epistemologic/math/cholesky).
# - `silicon_output`     ref naming the target-side silicon crystal
#                        (e.g., a lower_triangular_matrix silicon
#                        crystal + LAPACK info parameter).
# - `transparency`       residual opacity per @glass's
#                        `transparency<correspondence>` carrier;
#                        reports LAPACK info-parameter warnings
#                        (info != 0), precision loss on ill-
#                        conditioned inputs, ABI-marshalling residuals.
#
# Identity contract: byte-equality on (correspondence, selected_
# morphism, math_input, silicon_output). Two math_silicon_translation
# records with byte-equal fields ARE the same crystal under
# content-addressing.
type math_silicon_translation = {
  correspondence:    ref,
  selected_morphism: oid,
  math_input:        ref,
  silicon_output:    ref,
  transparency:      transparency(correspondence),
}

# === translate — the load-bearing action at species altitude ===
#
# THE LOAD-BEARING ACTION. Given a math_input ref (an spd_matrix
# instance from @epistemologic/math or a math_crystal from
# @reality/algebra/math) + the c_math_silicon correspondence ref,
# consults @fate to select which LAPACK realization to apply
# within the correspondence's restriction; applies the selected
# realization via FFI to the math_input; returns the
# math_silicon_translation wrapped in imperfect (residual opacity).
#
# Structurally this action IS @glue.translate specialized to the
# math ↔ silicon pair. The specialization is minimal:
#
#   - The correspondence's source_prism is fixed at @reality/algebra
#     /math.
#   - The correspondence's target_prism is fixed at @reality/algebra
#     /silicon.
#   - The restriction is fixed at (precision, conditioning, layout)
#     per §3.3.1.
#   - The morphism_kind is drawn from `@arxiv/math/*.lapack_
#     realization` per the OPEN enumeration.
#
# The body MUST invoke @fate.roll for the morphism selection (per
# `translation_uses_fate` inherited from @glue); MUST honor the
# restriction (per `restriction_preserved` inherited from @glue);
# MUST discharge to the LAPACK FFI at @io/silicon (per
# `shards/reality/algebra/silicon.mirror` §"@io discharge surfaces").
#
# Body discharges at the realisation boundary. Reed's next-tick
# dpotrf FFI binding IS the first realisation.
translate(c: ref, math_input: ref) -> imperfect<math_silicon_translation, ref, transparency(ref)>
requires morphism_kind_in_lapack_family(c)
requires restriction_matches_lapack_abi(c)
requires math_input_is_reality_algebra_math(math_input)
{ \ }

# === propose — enumerate the LAPACK realizations for a math input ===
#
# Given a math_input ref, returns the family of correspondences
# admissible for the input's shape. The enumeration is typed per
# the input's field (real vs complex → dpotrf vs zpotrf) and
# structural predicate (SPD → Cholesky; general square → LU; etc.);
# each returned correspondence carries the (morphism_kind,
# restriction) tuple naming the LAPACK realization + its ABI bound.
#
# Multiple correspondences may exist for the same input (Cholesky
# vs LU vs QR for a general SPD, though Cholesky is preferred by
# conditioning). The propose action returns the full family; the
# downstream translate consultation via @fate selects one.
#
# Body discharges at the realisation boundary. Sibling shape to
# @glue.propose specialized to math ↔ silicon.
propose(math_input: ref) -> [ref]
requires math_input_is_reality_algebra_math(math_input)
{ \ }

# === The bilateral requires obligations ===
#
# Downstream consumers declare bilateral agreement (per recognition
# #37, Pask-agreement) with the math ↔ silicon species discipline
# by writing the obligations below.

# Per §3.3.1: the correspondence's morphism_kind MUST be a member
# of `@arxiv/math/*.lapack_realization` — Cholesky, eigen-, SVD,
# LU, QR, Chamseddine-Connes spectral action numerical, etc.
# Inheritor consumers discharge by verifying the morphism_kind
# ref's namespace.
morphism_kind_in_lapack_family(c: ref) -> verdict { \ }

# Per §3.3.1: the correspondence's restriction MUST match LAPACK's
# native ABI — column-major layout AND (f32 | f64 | complex64 |
# complex128) precision AND well-conditioned inputs (κ(A) ≤ 1/√ε).
# Inheritor consumers discharge by verifying each restriction slot.
restriction_matches_lapack_abi(c: ref) -> verdict { \ }

# The math_input ref MUST name a crystal at @reality/algebra/math
# altitude (a math_crystal instance per `shards/reality/algebra/
# math.mirror`, OR a predicate carrier from @epistemologic/math/*
# — spd_matrix, symmetric_matrix, etc.). Inheritor consumers
# discharge by verifying the ref's altitude.
math_input_is_reality_algebra_math(math_input: ref) -> verdict { \ }

# === The math_silicon_witnessing inheritance predicate ===
#
# `math_silicon_witnessing(t)` is the predicate consumer shards
# name in a `requires` clause to declare bilateral commitment that
# a math_silicon_translation `t` is a valid math ↔ silicon
# translation under the species' discipline — i.e., t satisfies
# all three obligations above conjointly.
#
# Sibling to:
#   - `glue.glue_witnessing(c)` (the family-root bilateral;
#     math_silicon_witnessing IS a specialization of glue_
#     witnessing to the math ↔ silicon pair).
#   - `reality/algebra/math.math_species_witnessing(c)` (the
#     source-species bilateral; the math_input must satisfy this
#     for the translation to originate at math altitude).
#   - `reality/algebra/silicon.silicon_species_witnessing(c)` (the
#     target-species bilateral; the silicon_output must satisfy
#     this for the translation to land at silicon altitude).
#   - `epistemologic/math/cholesky.cholesky_witnessing(d)` (the
#     predicate bilateral; the Cholesky arc's first empirical
#     crystal discharges this at input side).
#
# Forward-promised inheritors:
#
#   - Reed's dpotrf FFI binding (the next-tick empirical discharge);
#     the first translate invocation lands the first
#     math_silicon_translation crystal in the Bauchladen tray under
#     `@fate/algebra/morphism/math_silicon`.
#   - The Standard Model spectral action numerical discharge (the
#     #74 candidate); when the Chamseddine-Connes morphism_kind
#     lands as an addition to the OPEN enumeration, the empirical
#     crystal for the coupling constants discharges via this species.
#   - The eigenvalue / SVD / LU / QR forward-promised
#     morphism_kinds (per the OPEN enumeration); each lands as a
#     Bauchladen crystal + a species-shard amendment when
#     consumers pull.
#
# No `requires math_silicon_witnessing(...)` clauses at THIS shard.
# The species declares the predicate; consumers add the clauses
# when they pull specific translations.
math_silicon_witnessing(t: math_silicon_translation) -> verdict { \ }

out @glue/math_silicon
out math_silicon_translation
out translate
out propose
out morphism_kind_in_lapack_family
out restriction_matches_lapack_abi
out math_input_is_reality_algebra_math
out math_silicon_witnessing
