# NOT a mintable family-root, NOT a species-decl candidate).
#
# Per math §8.2 K5 individual-kernel analysis: polynomial-bounded
# by O(N^3) for Boolean-matrix cube via MPS matmul; sub-Turing
# preserving per Corollary 8.2.1.
#
# requires kernel_ir_polynomial_bounded(ir, p).
# requires fate_composition_preserved(handle, p).
#
# Body discharges at the realisation boundary.
dispatch_ricci_flow_step(handle: metal_runtime_handle, ir: kernel_ir, p: perturbation) -> typed_buffer
requires kernel_ir_polynomial_bounded(ir, p)
requires fate_composition_preserved(handle, p)
{ \ }

# === dispatch_signature_beat action (K6) ===
#
# Dispatch the signature-beat propagation kernel: SIMD complex-
# phase update for Kuramoto order parameter r(t) across peer-foam
# edges per math §3.5 trophallaxis chain + Proposition 3.5.
#
# Composes with @spectral/signature.compute; five-species Laplacian
# extension per math §3.4 (if [ALEX-Q5] species-decls land).
#
# Per math §8.2 K6 individual-kernel analysis: polynomial-bounded
# by O(|E|) per beat propagation tick, SIMD-parallel across edges.
#
# requires kernel_ir_polynomial_bounded(ir, p).
# requires fate_composition_preserved(handle, p).
#
# Body discharges at the realisation boundary.
dispatch_signature_beat(handle: metal_runtime_handle, ir: kernel_ir, p: perturbation) -> typed_buffer
requires kernel_ir_polynomial_bounded(ir, p)
requires fate_composition_preserved(handle, p)
{ \ }

# === dispatch_eigenboard_render action (K7) ===
#
# Dispatch the eigenboard-render kernel: WGSL fragment shader
# producing the @gestalt @io render surface via VAD sphere +
# Gaussian splat + Ricci-flow surface deformation per Reed
# 2026-05-07 eigenboard 3D rendering spec Section-4 + Section-5.
#
# **This IS the compile-render duality** (per math Thm 8.3): the
# eigendecomposition K2-K6 use for compilation ALSO produces the
# render surface. One buffer, two channel outputs. Content channel
# (kernel_ir name + docblock prose) and relationship channel
# (rendered pixels ARE the eigenvectors) indissoluble via one
# apply_h::act call per spec §12.6.
#
# Per math §8.2 K7 individual-kernel analysis + Corollary 8.3.1:
# polynomial-bounded by O(pixels * eigenmodes) per fragment shader
# dispatch.
#
# requires kernel_ir_polynomial_bounded(ir, p).
# requires fate_composition_preserved(handle, p).
# requires compile_render_share_buffer(handle, ir, p): discharges
# the compile-render duality (buffer-handle-identity check per math
# §8.7 P6 falsifiable prediction).
#
# Body discharges at the realisation boundary.
dispatch_eigenboard_render(handle: metal_runtime_handle, ir: kernel_ir, p: perturbation) -> rgba8_buffer
requires kernel_ir_polynomial_bounded(ir, p)
requires fate_composition_preserved(handle, p)
requires compile_render_share_buffer(handle, ir, p)
{ \ }

# ============================================================
# §3 The three bilaterals
# ============================================================

# === kernel_ir_polynomial_bounded bilateral ===
#
# Substrate-typed commitment that a kernel_ir describes a
# polynomial-bounded computation per math Corollary 8.2.1
# individual-kernel analysis. Rice-safety bounded by fate's Metal
# command-buffer timeout per math Proposition 9.3; sub-Turing
# preserving.
#
# Splinter-pole: kernel_ir bounds satisfy the per-kernel polynomial
# bound (K1: O(N*H); K2: O(N^2.373); K3: O(|cover|*log|cover|);
# K4: O(N^2); K5: O(N^3); K6: O(|E|); K7: O(pixels*eigenmodes)).
# Narcissus-pole: kernel_ir specifies bounds exceeding fate's Metal
# command-buffer timeout (unbounded loop; missing workgroup size).
#
# Body discharges at the realisation boundary.
kernel_ir_polynomial_bounded(ir: kernel_ir, p: perturbation) -> verdict { \ }

# === compile_render_share_buffer bilateral ===
#
# Substrate-typed commitment that a K2..K6 compilation dispatch
# and a K7 render dispatch share the SAME GPU buffer (compile-
# render duality per math Thm 8.3). Buffer-handle-identity check
# per math §8.7 P6 falsifiable prediction.
#
# This bilateral IS the two-channel indissolubility discharge at
# GPU altitude per spec §12.6: the render surface pixels ARE the
# eigenvectors the compilation dispatch produced; buffer-handle-
# identity check confirms no serialization boundary between
# compilation-state and rendered-visualization.
#
# Splinter-pole: buffer handles match; single shared allocation
# on GPU; zero serialization crossing.
# Narcissus-pole: separate buffer allocations; render dispatch
# reads a snapshot copy rather than the live eigendecomposition
# state (two-channel structure BROKEN; would refute R2 novelty
# claim empirically).
