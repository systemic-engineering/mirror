prism @ui/gpu/compute {
  focus  kernel_ir
  project metal_runtime_handle
  split  kernel_ir
  shift  kernel_ir
  settle metal_runtime_handle
}

# ============================================================
# §1 The carriers
# ============================================================

# === kernel_ir carrier ===
#
# Symbolic intermediate representation for a kernel-tower operation
# prior to Metal MSL codegen. Per math §9.4 kernel-tower Metal MSL
# codegen path: kernel_ir is the input to codegen_metal_kernel(name,
# kernel_ir), which emits MSL source text as a companion to fate's
# existing codegen_metal in build.rs.
#
# Carries kernel identity (K1..K7), input buffer references, output
# buffer reference, workgroup size, and per-kernel parameters (rank
# for Sherman-Morrison; species-count for signature_beat propagation;
# eigenvalue-count for eigenboard_render fragment shader).
#
# Identity contract: byte-equality on the underlying ref (the
# kernel_ir IS its (kernel_name, input_bufs, output_buf, workgroup,
# params) tuple).
type kernel_ir = ref

# === metal_runtime_handle carrier ===
#
# Opaque reference to fate's MetalRuntime instance obtained via
# fate::metal_runtime::MetalRuntime::new(). Per @io family-root
# Glass Wall discipline: substrate carries the ref, not the runtime.
#
# The handle is stable for the runtime's lifetime; MetalRuntime::
# run_batch(inputs, count) invocations use this handle to dispatch
# the kernel-tower operations on GPU.
#
# Per math §9.3 fate-composition contract: this handle IS the B1
# (kernel-substrate) boundary — mirror invokes fate's MetalRuntime
# via this handle without modifying fate/.
#
# Identity contract: byte-equality on the underlying ref.
type metal_runtime_handle = ref

# ============================================================
# §2 The seven kernel-tower dispatch actions
# ============================================================

# === dispatch_substrate_load action (K1) ===
#
# Dispatch the substrate-load kernel: parallel per-shard content-
# address computation via SHA-256 or CoincidenceHash<3>. Composes
# with @spectral/signature.compute; produces the initial peer-foam
# graph vertex-label assignment for the six subsequent kernels.
#
# Per math §8.2 K1 individual-kernel analysis: polynomial-bounded
# by O(N * H) where N is the number of shards and H is the hash-
# computation cost per shard.
#
# requires kernel_ir_polynomial_bounded(ir, p): discharges the K1
# individual polynomial bound (composes with math Corollary 8.2.1).
# requires fate_composition_preserved(handle, p): discharges the
# no-fate-modifications contract (composes with math Proposition
# 9.3).
#
# Body discharges at the realisation boundary (Gate-2 Rust cascade
# per spec §11.8).
dispatch_substrate_load(handle: metal_runtime_handle, ir: kernel_ir, p: perturbation) -> typed_buffer
requires kernel_ir_polynomial_bounded(ir, p)
requires fate_composition_preserved(handle, p)
{ \ }

# === dispatch_apply_h_act action (K2) ===
#
# Dispatch the apply_h::act reflective-evaluator kernel: cuBLAS
# gemv on CUDA / MPS matmul on Apple silicon. Produces per-arm
# verdict output for the bilateral resolution across the entire
# peer-foam simultaneously (per math §8.2 K2 dispatch-tower
# analysis).
#
# Composes with @kintsugi/roomba walker; the reflective-evaluator
# discharge at GPU altitude for the geometric-roomba §4.2 four-step
# protocol per parent spec.
#
# Per math §8.2: polynomial-bounded by O(N^2.373) via
# Coppersmith-Winograd matmul; MPS/cuBLAS use practical O(N^3)
# with strong constant factors.
#
# requires kernel_ir_polynomial_bounded(ir, p).
# requires fate_composition_preserved(handle, p).
#
# Body discharges at the realisation boundary.
dispatch_apply_h_act(handle: metal_runtime_handle, ir: kernel_ir, p: perturbation) -> typed_buffer
requires kernel_ir_polynomial_bounded(ir, p)
requires fate_composition_preserved(handle, p)
{ \ }

# === dispatch_verdict_sheaf action (K3) ===
#
# Dispatch the verdict-sheaf coherence-check kernel: CUDA Thrust
# reduce / Metal SIMDgroup-reduce for verdict-section computation
# across the open cover. Composes with @subject/visibility/sheaf +
# kintsugi/verdict.eq.
#
# Per math §8.2 K3 individual-kernel analysis: polynomial-bounded
# by O(|cover| * log |cover|) via parallel-tree reduction.
#
# requires kernel_ir_polynomial_bounded(ir, p).
# requires fate_composition_preserved(handle, p).
#
# Body discharges at the realisation boundary.
dispatch_verdict_sheaf(handle: metal_runtime_handle, ir: kernel_ir, p: perturbation) -> typed_buffer
requires kernel_ir_polynomial_bounded(ir, p)
requires fate_composition_preserved(handle, p)
{ \ }

# === dispatch_ouroboros_monotone action (K4) ===
#
# Dispatch the ouroboros_monotone rank-1 update kernel: Sherman-
# Morrison rank-1 update on GPU for the ouroboros_monotone property
# discharge (per @epistemologic/property/ouroboros_monotone.mirror).
#
# Per math §8.2 K4 individual-kernel analysis: polynomial-bounded
# by O(N^2) per rank-1 update via Sherman-Morrison identity.
#
# This kernel IS the D1 (structural monotonicity) Impeccability
# discharge at GPU altitude (per spec §11.6 D1 discharged by
