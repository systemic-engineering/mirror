#
# requires kernel_ir_polynomial_bounded(ir, p).
# requires fate_composition_preserved(handle, p).
#
# Body discharges at the realisation boundary.
dispatch_ouroboros_monotone(handle: metal_runtime_handle, ir: kernel_ir, p: perturbation) -> verdict
requires kernel_ir_polynomial_bounded(ir, p)
requires fate_composition_preserved(handle, p)
{ \ }

# === dispatch_ricci_flow_step action (K5) ===
#
# Dispatch the Ricci-flow evolution-step kernel: Boolean-matrix
# cube for triangle-count via MPS matmul; Forman-Ricci flow
# evolution step per math §4.5 Theorem 4.5.
#
# Composes with @roomba + @signature_beat + @kintsugi/mend per the
