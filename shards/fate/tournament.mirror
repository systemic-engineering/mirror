prism @fate/tournament {
  focus tournament_round
  project tournament_round
  split tournament_round
  shift tournament_round
  settle tournament_round
}

# === The tournament_round carrier ===
#
# A typed record per [[feedback-no-bare-types]] naming a single
# tournament selection. One round IS one @fate inference at the
# tournament altitude: the dice roll selects a winner from the
# candidate set the tournament browsed. The round is the substrate-
# decl atom of @fate/tournament; each invocation of `select` emits
# one round; the round's `winner` field carries the OID of the
# selected crystal that joined (or already lived in) the @bauchladen
# tray.
#
# - `instance`           the uuid_spectral naming the @fate/tournament
#                        instance the round belongs to (sibling-shape
#                        to @fate's `inference.instance` carrier).
# - `hole`               the typed hole the round filled; the same
#                        carrier @fate.hole declares; the inference-
#                        altitude consumption point.
# - `candidates_browsed` the candidate_set the tournament read from
#                        the tray (cache-hit path) or constructed
#                        fresh via @fate.roll (cache-miss path).
# - `winner`             the OID of the candidate the round selected
#                        as the tournament's outcome; resolves to a
#                        crystal in the @bauchladen tray.
# - `tick`               the substrate-ref naming the tick the round
#                        fired at; the @time-altitude carrier
#                        downstream consumers reference.
#
# Identity contract: byte-equality on (instance, hole, tick). Two
# tournament_rounds for the same instance consuming the same hole at
# the same tick ARE the same round under content-addressing; the
# candidates_browsed and winner are determined by the tray state at
# round time and are content-equivalent.
type tournament_round = {
  instance:           uuid_spectral,
  hole:               hole,
  candidates_browsed: candidate_set,
  winner:             oid,
  tick:               ref,
}

# === The candidate_set carrier ===
#
# The typed set of crystals from the @bauchladen tray the tournament
# browses for a given round. Per spec §6.1's four-step pattern,
# step 2 reads the tray for prior crystals at the round's altitude;
# the candidate_set IS that read's typed result.
#
# - `tray_scope`     the substrate-ref naming the tray slice the
#                    candidates were drawn from; the scope is
#                    altitude-parametric per @bauchladen's enumerate
#                    action.
# - `members`        the list of crystal OIDs in the candidate set;
#                    each OID resolves to a crystal in the tray; the
#                    list is ordered per the tournament's selection_
#                    rule (e.g., elite(k) sorts by score).
# - `freshness`      the @glass verdict naming whether members were
#                    drawn from the tray (cache-hit-eligible) or
#                    constructed fresh (cache-miss path); the
#                    discriminator the cache_hit verdict reads.
#
# Identity contract: byte-equality on (tray_scope, members). Two
# candidate_sets with the same tray_scope and members ARE the same
# set under content-addressing; freshness is metadata about the set's
# construction history, not part of its identity.
type candidate_set = {
  tray_scope: ref,
  members:    [oid],
  freshness:  verdict,
}

# === The selection_witness carrier ===
#
# The proof carrier that the tournament's selection respects all the
# restrictions the round operated under: the @fate restrictions (γ,
# J per recognitions #101 + #102; tray scope per autopoietic closure),
# the @fate/tournament restrictions (the selection_rule's per-rule
# discipline), and the autopoietic closure obligation (the winner's
# OID joins the tray on the cache-miss path; the round's outcome IS
# admissible as input to future rounds).
#
# - `round`               the tournament_round whose selection the
#                         witness attests.
# - `fate_witness`        the verdict that the round's dice roll
#                         satisfies @fate.fate_witnessing (the
#                         family-root inheritance predicate).
# - `rule_witness`        the verdict that the round's winner is the
#                         per-rule-correct selection from
#                         candidates_browsed.members under the
#                         selection_rule the round operated under.
# - `autopoietic_witness` the verdict that the round's outcome was
#                         admitted to the tray on the cache-miss path
#                         (or correctly identified as a cache-hit on
#                         a prior tray member; either path closes the
#                         autopoietic loop).
#
# Identity contract: byte-equality on (round). The three witness
# verdicts are determined by the round + the tray state and are
# content-equivalent given the round's identity.
type selection_witness = {
  round:               tournament_round,
  fate_witness:        verdict,
  rule_witness:        verdict,
  autopoietic_witness: verdict,
}

# === The rule carrier ===
#
# The typed selection-rule vocabulary the tournament admits per round.
# PRESERVED VERBATIM from the killed boot/std/fate/tournament.mirror
# precursor per the migration mapping documented above; the rule
# vocabulary is stable across the boot-altitude → substrate-decl-
# altitude lift per spec §6.4.
#
# Each rule discharges per-round at the realisation boundary; the
# rule's selection semantics live in the forward-promised per-rule
# sub-shards (`shards/fate/tournament/{greedy,beam,elite,halving,
# tabu,anneal,ucb}.mirror`) per spec §6.4.
#
# - `greedy`         pick the single best candidate by score; no
#                    exploration.
# - `beam(k)`        keep the top-k candidates at each step; bounded-
#                    width best-first per Lowerre & Reddy 1976.
# - `elite(k)`       reserve k slots for the top scorers; combine
#                    with other rules.
# - `halving(eta)`   successive halving with budget-ratio eta per
#                    Karnin-Koren-Somekh 2013.
# - `tabu(tenure)`   tabu search with the given tenure per Glover
#                    1986; exclude recently-selected candidates.
# - `anneal(T)`      simulated annealing with temperature T per
#                    Kirkpatrick-Gelatt-Vecchi 1983.
# - `ucb(c)`         upper-confidence-bound with exploration constant
#                    c per Auer-Cesa-Bianchi-Fischer 2002.
#
# Identity contract: byte-equality on the rule constructor + its
# parameter (where parameterized). Two rules with the same
# constructor and parameter ARE the same rule under content-
# addressing.
type rule =
  | greedy
  | beam(ref)
  | elite(ref)
  | halving(ref)
  | tabu(ref)
  | anneal(ref)
  | ucb(ref)

# === The tournament_query carrier ===
#
# The typed query the consumer constructs to invoke a tournament
# round. Per spec §6.1's substrate-decl shape; carries the candidate
# fan-in, the altitude to browse, and the selection rule.
#
# - `candidates`     the initial @fate.roll output (the candidate set
#                    the tournament starts from; may be refined by
#                    the cache-hit path or replaced on cache-miss).
# - `altitude`       the substrate-ref naming the tray altitude to
#                    browse for prior crystals to match against.
# - `selection_rule` the rule the round operates under (greedy /
#                    beam / elite / halving / tabu / anneal / ucb);
#                    determines the per-rule selection semantics.
#
# Identity contract: byte-equality on the three fields.
type tournament_query = {
  candidates:     candidate_set,
  altitude:       ref,
  selection_rule: rule,
}

# === The tournament_result carrier ===
#
# The typed outcome of a tournament round. Per spec §6.1's
# substrate-decl shape; carries the refined selection, the cache-hit
# discriminator, and the consulted-OIDs provenance trail.
#
# - `refined_selection` the crystal the tournament selected as the
#                       round's winner; lives in the @bauchladen tray
#                       (either pre-existing on cache-hit or newly
#                       admitted on cache-miss).
# - `cache_hit`         the @glass verdict naming whether the result
#                       came from the tray (cache-hit) or required
#                       fresh @fate.roll (cache-miss); the operational
#                       mode discriminator per spec §6.3.
# - `consulted_oids`    the OIDs of the prior crystals the round
#                       consulted to refine the selection; the
#                       provenance trail downstream tooling reads to
#                       audit the round's reasoning.
#
# Identity contract: byte-equality on `refined_selection`. The cache_
# hit verdict and consulted_oids are determined by the tray state and
# are content-equivalent given the refined_selection.
type tournament_result = {
  refined_selection: crystal,
  cache_hit:         verdict,
  consulted_oids:    [oid],
}

# === browse — tray lookup; returns the typed candidate set ===
#
# Per spec §6.1 step 2: the tournament reads the @bauchladen tray for
# prior crystals at the round's altitude. This action wraps the
# @bauchladen.enumerate operation in the tournament's typed
# candidate_set carrier; the scope ref selects the tray slice.
#
# The returned candidate_set's `freshness` verdict is `partial(0.0)`
# for tray reads (cache-hit-eligible) and `partial(1.0)` for fresh
# constructions (cache-miss path output); the cache_hit verdict reads
# this discriminator.
#
# Body discharges per-round at the realisation boundary. Same shape
# as @bauchladen.enumerate (declarative obligation discharged at the
# species boundary).
browse(hole: hole, scope: ref) -> candidate_set { \ }

# === select — the round's selection action ===
#
# The tournament's primary action; the substrate-decl form of the
# orphan precursor's `tournament(rules, [hole]) -> [resolution]`
# action per the migration mapping documented above. Given a typed
# query (candidates + altitude + selection_rule) and the restricted
# state space the @fate family-root's restrictions admit, returns the
# dice_roll naming the round's winner.
#
# Per spec §6.2: this action IS itself an @fate inference; the
# tournament's selection IS a dice roll at the tournament altitude.
# The select action discharges to @fate.roll under the hood at the
# cache-miss path; at the cache-hit path it returns the prior
# crystal's OID directly as the dice_roll's selected_oid.
#
# Body discharges per-round at the realisation boundary.
select(candidates: candidate_set, restricted: restricted_state_space) -> dice_roll { \ }

# === record — admit the round's outcome to the tray ===
#
# Per spec §6.3 cache-miss path step 4: the round's new crystal is
# ADDED to the @bauchladen tray; future queries may now cache-hit on
# this crystal. This action wraps the @bauchladen.crystallize
# operation in the tournament's record discipline; the crystal joins
# the tray under the producing-prism = `@fate/tournament` provenance.
#
# The autopoietic fold-back closure: recording the round's outcome
# adds to the tray; the next round may consult this crystal as a
# prior selection; the recursion has no bottom.
#
# Body discharges per-round at the realisation boundary. Same shape
# as @bauchladen.crystallize.
record(round: tournament_round) -> crystal { \ }

# === cache_hit — bilateral verdict over a (hole, scope) pair ===
#
# Per spec §6.3 the cache-hit / cache-miss disambiguation: returns
# the @glass verdict whether the @bauchladen tray already has a
# winning candidate for the (hole, scope) pair the query identifies.
# pass = cache-hit eligible; failure = cache-miss required.
#
# Inheritor shards discharge by browsing the tray at scope, filtering
# by hole's expected_type, and returning pass iff at least one crystal
# matches under the selection_rule the query would apply.
#
# Body discharges per-round at the realisation boundary.
cache_hit(hole: hole, scope: ref) -> verdict { \ }

# === compose — associative rule composition ===
#
# PRESERVED VERBATIM from the killed boot/std/fate/tournament.mirror
# precursor per the migration mapping. Per spec §6.4: `elite(1).
# beam(8).halving(3)` composes left-to-right; the composition is
# associative per the boot-altitude grammar's declared associativity.
#
# Two rules compose into a single rule whose selection semantics are
# the categorical product of the components (apply the first rule
# first, then the second to the survivors). Inheritor shards discharge
# the per-rule composition semantics per the per-rule sub-shards
# forward-promised at `shards/fate/tournament/{greedy,beam,elite,
# halving,tabu,anneal,ucb}.mirror`.
#
# Body discharges per-round at the realisation boundary.
compose(left: rule, right: rule) -> rule { \ }

# === The requires obligations ===
#
# Downstream shards declare bilateral agreement (per recognition
# #37, the Pask-agreement reading of `requires`) with the
# @fate/tournament discipline by writing the obligations below. The
# bilateral commitment: the @fate/tournament-importing prism commits
# to discharging the obligations; the consumer commits to surfacing
# violations at the species boundary.

# Per spec §6.1: tournaments ARE @fate instances; the tournament_
# round's instance carrier IS a uuid_spectral naming an @fate
# membership the round is registered against. Inheritor shards
# discharge by verifying the @fate family-root's fate_witnessing
# predicate on the round's instance.
fate_membership_held(tournament_instance: ref) -> verdict { \ }

# Per spec §6.1 step 2: the browse action returns crystals from the
# proper @bauchladen tray scope; no crystals leak across scopes. The
# substrate-pull-honest typing discipline: the candidate_set the
# tournament browses is well-typed under the tray's altitude
# parametricity. Inheritor shards discharge by verifying the
# browse-action realisation respects the @bauchladen.enumerate
# typing contract.
bauchladen_browse_well_typed(browse: ref, scope: ref) -> verdict { \ }

# Per spec §6.2 + spec §4.2: the tournament's selection respects the
# restrictions the @fate family-root's restricted_state_space
# enumerates: the algebra A's admissible operations; the Hilbert H's
# state-space membership; the Dirac D's flow-step admissibility; γ's
# parity preservation per recognition #101; J's time-reversal
# preservation per recognition #102; the @bauchladen tray scope's
# autopoietic closure constraint. Inheritor shards discharge by
# verifying the round's winner OID resolves to content in the
# admitted subspace.
selection_respects_restrictions(select: ref, restricted: restricted_state_space) -> verdict { \ }

# Per spec §6.3 cache-miss path step 4: recording the round's outcome
# adds to the @bauchladen tray; the new crystal is admissible as
# input to future rounds; the autopoietic loop closes. Inheritor
# shards discharge by verifying the record-action realisation invokes
# @bauchladen.crystallize with the @fate/tournament provenance.
tournament_autopoietic(record: ref) -> verdict { \ }

# === The tournament_well_formed inheritance predicate ===
#
# `tournament_well_formed(round)` is the predicate consumer shards
# name in a `requires` clause to declare bilateral commitment (per
# recognition #37, the Pask-agreement reading of `requires`) that
# the tournament_round `round` IS substrate-pull-honest @fate/
# tournament selection — i.e., the round satisfies all four
# obligations above conjointly: fate_membership_held +
# bauchladen_browse_well_typed + selection_respects_restrictions +
# tournament_autopoietic.
#
# Sibling to:
#   - `fate.fate_witnessing(roll)` (the family-root inheritance
#     predicate the tournament_round's selection honors).
#   - `autopoietic.autopoietic_closure_holds(prism)` (the prism-class
#     inheritance predicate transitively inherited via @fate).
#   - `bauchladen.bauchladen_witnessing(crystal)` (the crystal-
#     altitude inheritance predicate the tournament's recorded
#     crystals honor on the cache-miss path).
#
# Forward-promised inheritors (per spec §6.4):
#
#   - `@fate/tournament/greedy` — the greedy selection rule's
#     selection semantics.
#   - `@fate/tournament/beam` — the beam(k) selection rule per
#     Lowerre-Reddy 1976.
#   - `@fate/tournament/elite` — the elite(k) selection rule.
#   - `@fate/tournament/halving` — the halving(eta) rule per
#     Karnin-Koren-Somekh 2013.
#   - `@fate/tournament/tabu` — the tabu(tenure) rule per Glover
#     1986.
#   - `@fate/tournament/anneal` — the anneal(T) rule per Kirkpatrick-
#     Gelatt-Vecchi 1983.
#   - `@fate/tournament/ucb` — the ucb(c) rule per Auer-Cesa-Bianchi-
#     Fischer 2002.
#   - `@kintsugi` (per spec §4.6): @kintsugi invokes the tournament
#     at each morphism-selection step; the kintsugi merge-altitude
#     tournament per `docs/specs/kintsugi-tournament.md` discharges
#     tournament_well_formed for each round.
#   - `@reflection` (per spec §4.6 + [[architecture-reflection-
#     thinks-in-spectral-questions]]): Reflection's altitude
#     selection IS a tournament over altitude candidates;
#     Reflection discharges tournament_well_formed at the meta-
#     pipeline altitude.
#
# No `requires tournament_well_formed(...)` clauses are added at THIS
# shard. The sub-prism declares the predicate; consumers add the
# clauses when they pull. Per [[feedback-craft-not-deliver]] the
# per-rule sub-shards follow when consumers pull.
tournament_well_formed(round: tournament_round) -> verdict { \ }

out @fate/tournament
out tournament_round
out candidate_set
out selection_witness
out rule
out tournament_query
out tournament_result
out browse
out select
out record
out cache_hit
out compose
out fate_membership_held
out bauchladen_browse_well_typed
out selection_respects_restrictions
out tournament_autopoietic
out tournament_well_formed
