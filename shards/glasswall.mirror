# === The glasswall_traversal carrier ===
#
# Typed record per [[feedback-no-bare-types]] naming ONE membrane
# traversal event at glasswall altitude. Parallel to precedents at
# @algebra/metalogue.algebra_turn + @aikido.aikido_state; refined
# to the type-membrane altitude.
#
# - `direction`   `noumenal_to_phenomenal` (prismqueer → mirror) OR
#                 `phenomenal_to_noumenal` (mirror → prismqueer).
# - `input_oid`   uuid_spectral content-address of the input at
#                 pre-membrane substrate.
# - `output_oid`  uuid_spectral content-address of the output at
#                 post-membrane substrate.
# - `gauge_pre`   usize choice-count at pre-membrane per Foerster
#                 gauge.
# - `gauge_post`  usize choice-count at post-membrane per Foerster
#                 gauge. Invariant: gauge_post ≥ gauge_pre per
#                 magic.rs::foerster_gauge_preserved.
# - `verdict`     transparency(traversal_property) — Rec #92
#                 LOVE-monoid coordinate-decomposition of the four
#                 glasswall invariants (i)-(iv) above.
# - `tick`        canonical substrate monotonic clock per
#                 @epistemologic/reality/time.
#
# Identity contract: byte-equality on the seven-tuple.
type glasswall_traversal = {
  direction:   traversal_direction,
  input_oid:   uuid_spectral,
  output_oid:  uuid_spectral,
  gauge_pre:   usize,
  gauge_post:  usize,
  verdict:     transparency(traversal_property),
  tick:        tick,
}

type traversal_direction = {
  noumenal_to_phenomenal: unit,
  phenomenal_to_noumenal: unit,
}

# === The traversal_property discriminator ===
#
# Substrate-location type parameter for Transparency<P> per Rec
# #92 substrate-location typing. Names the four invariants any
# glasswall_traversal MUST satisfy simultaneously as coordinates
# of the LOVE-monoid.
#
# NOT a family-root; NOT a fresh species; delightfully-boring
# discriminator enum.
type traversal_property = {
  anna_wolf_observation_preservation: unit,
  rice_safety:                        unit,
  foerster_gauge_preserved:           unit,
  is_kleinos_at_altitude_plus_1:      unit,
}

# === traverse_glasswall action ===
#
# The membrane-traversal primitive itself. Takes a
# traversal_direction + input_oid and returns a glasswall_traversal
# carrying the verdict per LOVE-monoid coordinate-decomposition of
# the four invariants.
#
# Body-composition discipline (LOAD-BEARING per HARD RULE
# [[feedback-if-else-is-substrate-smell-for-unfound-fractal-
# composition]] Alex 2026-08-29 + Mara 2026-09-01 amendment §16
# extended-scope): body MUST NOT dispatch if-else / match-arm on
# traversal_property verbs. Verification body composes ONE
# membrane-morphism check producing a Transparency<traversal_
# property> LOVE-monoid verdict; the four invariants are
# coordinates of the LOVE-monoid.
#
# Body discharges at the realisation boundary composing over the
# seven LANDED parts (@io/* + phone.rs + wire.rs + apply_h::act +
# magic.rs + @liquid + Rec #82 + Rec #92).
traverse_glasswall(direction: traversal_direction, input_oid: uuid_spectral) -> glasswall_traversal { \ }

# === glasswall_invariant_pass predicate ===
#
# Bilateral verdict (per recognition #37 Pask-agreement) that a
# specific invariant of the glasswall_traversal Passes. Discriminated
# by `traversal_property` (the substrate-location per Rec #92 typing).
#
# Body discharges per-invariant at the realisation boundary.
glasswall_invariant_pass(verdict: transparency(traversal_property), which: traversal_property) -> verdict { \ }

# === The bilateral requires obligations ===
#
# Per the canonical substrate discipline: consumer shards declare
# bilateral agreement by writing the obligations below.

# The glasswall_traversal satisfies all four invariants
# simultaneously as coordinates of the LOVE-monoid. Inheritor shards
# discharge by ensuring their glasswall-traversal invocations
# produce Transparency::Clear when the four coordinates all Pass.
glasswall_inherits_four_invariants(t: glasswall_traversal) -> verdict { \ }

# Rice-safety: every glasswall_traversal is sub-Turing polynomial-
# time bounded per Rec #90 §5.4 sub-Turing FLOOR discipline. No
# semantic-property-decision-of-arbitrary-programs escapes.
# Discipline obligation.
glasswall_traversal_rice_safe(t: glasswall_traversal) -> verdict { \ }

# Anna Wolf 2012 observation-without-perturbation: every membrane
# traversal preserves the observed substrate structurally; input_oid
# and output_oid content-addresses reflect observation-non-
# perturbation across the membrane. Discipline obligation per HARD
# RULE [[project-anna-wolf-2012-observation-without-perturbation]].
glasswall_anna_wolf_2012_observation_preserved(t: glasswall_traversal) -> verdict { \ }

# Foerster-gauge preserved at membrane: t.gauge_post ≥ t.gauge_pre
# per magic.rs::foerster_gauge_preserved. Choice-count monotonically
# preserved (or strictly increased) across every membrane traversal.
glasswall_foerster_gauge_preserved(t: glasswall_traversal) -> verdict { \ }

