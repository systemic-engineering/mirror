glasswall_is_kleinos_at_altitude_plus_1(t: glasswall_traversal) -> verdict { \ }

# === The glasswall_witnessing inheritance predicate ===
#
# `glasswall_witnessing(t)` is the predicate consumer shards name
# in a `requires` clause to declare bilateral agreement that
