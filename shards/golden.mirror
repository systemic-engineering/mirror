# === golden_ratio carrier ===
#
# The content-addressed φ-constant carrier per math §2.1 notation.
# φ = (1 + √5) / 2 ≈ 1.6180339887...; positive root of x² = x + 1.
#
# Identity contract: byte-equality on the underlying ref (φ-constant
# content-hashed per Rec #82 β-normal AST canonicalization at
# prismqueer::oid::Addressable).
type golden_ratio = ref

# === golden_angle carrier ===
#
# The content-addressed α_φ-constant carrier per math §2.1 notation.
# α_φ = 2π/φ² ≈ 137.5077640500°; the Vogel-1979 phyllotactic
# divergence-angle optimum.
#
# Identity contract: byte-equality on the underlying ref.
type golden_angle = ref

# === rotation_number carrier ===
#
# The content-addressed rotation-number carrier per KAM-invariance
# discipline. Rational or irrational winding-number ω ∈ [0, 1] per
# Kolmogorov-Arnold-Moser 1954-1963-1962 dynamical-systems altitude.
#
# Identity contract: byte-equality on the underlying ref.
type rotation_number = ref

# === phi_widen action ===
#
# The Foerster-widening template-selection at φ-ratio primitive per math
# §9.2 Def M9.1. Given a candidates-list and a rotation-parameter, return
# the candidate whose rotation-number ω is closest to φ per KAM-invariance
# discipline (Theorem M4.1).
#
# Selection metric: argmin_{c ∈ candidates} |rotation_number(c) − φ|
# where rotation_number : ref → rotation_number is the LANDED
# prismqueer::spectral::rotation function.
#
# Composition role: composes over @nl.compose spectral_commutator_rank
# ranking-apparatus per Mara 2026-09-09 spec §6 to add φ-widen selection
# at Foerster-widening ratio-altitude.
#
# Body discharges at the realisation boundary composing over LANDED
# prismqueer::spectral::rotation + LANDED prismqueer::oid::Addressable.
phi_widen(candidates: ref, rotation: rotation_number) -> ref { \ }

# === phi_widen_admissible bilateral ===
#
# Bilateral verdict that Foerster-widening at φ-ratio is admissible for
# the candidate family per math §9.4 Theorem M9.3 four-property proof:
#
# 1. KAM-invariance (Theorem M4.1): the selected candidate survives
#    adversarial perturbation of the ranking-source MOST.
# 2. Phyllotactic-optimum (Theorem M4.2): the selected candidate places
#    at α_φ divergence-angle from prior ranked candidates.
# 3. Aperiodic-order (Theorem M4.3): the selected candidate respects
#    aperiodic-order at composition altitude.
# 4. Diophantine-worst-approximable (Theorem M4.4): the selected
#    candidate converges MOST-SLOWLY to averaging.
#
# Body discharges per-species at the realisation boundary.
phi_widen_admissible(candidates: ref, selected: ref, rotation: rotation_number)
  -> verdict { \ }

# === golden_ratio_well_formed bilateral ===
#
# Bilateral verdict that a golden_ratio carrier is structurally well-
# formed: content-addressed via prismqueer::oid; numeric value within
# tolerance ε of (1 + √5)/2 per Hurwitz sharp bound; continued-fraction
# expansion [1;1,1,1,...] beyond tolerance-depth.
golden_ratio_well_formed(g: golden_ratio) -> verdict { \ }

# === golden_angle_well_formed bilateral ===
#
# Bilateral verdict that a golden_angle carrier is structurally well-
# formed: content-addressed via prismqueer::oid; numeric value within
# tolerance ε of 2π/φ² per Vogel-1979 phyllotactic-optimum.
golden_angle_well_formed(a: golden_angle) -> verdict { \ }

