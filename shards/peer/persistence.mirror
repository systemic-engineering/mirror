source @arxiv/topology/hansen-ghrist-2018
source @arxiv/law/sel-v1.1
source @arxiv/practice/wolf-2026-07-14-ssh-signing-design-intent

prism @peer/persistence {
  focus  peer_home
  project peer_home
  split  peer_home
  shift  peer_home
  settle peer_home
}

# === The peer_home carrier ===
#
# Landing A §2 canonical spec verbatim: the seven-field record
# holding a materialized peer's projected state. Every Pack peer
# possesses AT MOST ONE peer_home at any tick; peer_home-per-peer
# is substrate-decl'd invariant per home_content_addressed bilateral
# below.
#
# Seven fields (per Landing A §2):
#
#   peer                — the subject_instance whose home this is.
#                          Landing 3 two-witness carrier (SSH +
#                          @spectral/signature). The peer's identity
#                          IS the identity of their home.
#
#   home_path           — filesystem path (ref resolves via @io) at
#                          which the projection lives. Per §7 A1
#                          adjudication: one-per-peer convention
#                          (~/.mara/, ~/.reed/, etc).
#
#   projection_at       — timestamp of materialize() invocation.
#
#   harvest_at          — option<timestamp>; Some(t) when a harvest
#                          cycle has run; None until first harvest.
#
#   bauchladen_manifest — list of `crystal:<name>` OIDs enumerated
#                          from the peer's bauchladen tray.
#
#   signature_snapshot  — rolling_signature at projection-time. Load-
#                          bearing for boot_state_coherent bilateral:
#                          the eigenboard resumed from boot_state MUST
#                          have inference_basis matching this snapshot.
#
#   boot_state          — option<eigenboard>. Some(e) when the home was
#                          populated by a prior session's checkpoint.
#
# Identity contract: byte-equality on all seven fields.
type peer_home = {
  peer:                ref,
  home_path:           ref,
  projection_at:       ref,
  harvest_at:          ref,
  bauchladen_manifest: ref,
  signature_snapshot:  ref,
  boot_state:          ref,
}

# === projection_visibility_respected — bilateral predicate ===
#
# Landing A §4.1 verbatim: does the projected filesystem state respect
# the visibility_filter that was applied at materialize? For every
# crystal in home.bauchladen_manifest, is the crystal's visibility_
# scope.visibility ≥ visibility_filter (in the elevation lattice
# private < protected < public)?
#
# Rice-safe bound: reads only byte-visible state (crystal visibility_
# scope; ACL byte structure; elevation lattice membership); no program
# semantics inspection.
#
# Sentinel per shard docblock: `visibility=filter-respected` — the
# byte-level substrate-decl'd marker the resolver checks. When the
# filesystem projection matches the filter's admitted set, the
# realization layer stamps the sentinel; discharge is byte-equality.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]]; Arc-2.3 landing composes this via
# `apply_h::act` sentinel-check.
projection_visibility_respected(home: peer_home,
                                visibility_filter: ref) -> verdict { \ }

# === harvest_consent_verified — bilateral predicate ===
#
# Landing A §4.2 verbatim: for every crystal in the harvest result,
# does its visibility_scope have a valid consent-discharge chain?
# I.e., for any crystal whose visibility differs from the containing
# directory's implied default, did @kintsugi/consent.query_phi return
# Pass for the implied elevation morphism?
#
# Rice-safe bound: reads only byte-visible state (crystal visibility_
# scope; consent-chain byte record from @kintsugi/consent.query_phi
# result); no program semantics.
#
# Sentinel per shard docblock: `consent=chain-verified` — the byte-
# level substrate-decl'd marker the resolver checks. When @kintsugi/
# consent.query_phi returned Pass for every elevation morphism the
# harvest surfaced, the realization layer stamps the sentinel;
# discharge is byte-equality.
#
# Body discharges per-realisation. `\`-obligation-blocked.
harvest_consent_verified(home: peer_home, new_crystals: ref) -> verdict { \ }

# === boot_state_coherent — bilateral predicate ===
#
# Landing A §4.3 verbatim: does the booted eigenboard's inference_
# basis match home's signature_snapshot? Load-bearing anti-drift
# guarantee: a peer resumed from home MUST resume with the same
# inference basis they had at projection; drift is a substrate
# violation.
#
# Load-bearing algedonic-bypass per Landing A §13 (Bateson VSM
# reading): if boot detects mismatch between home.signature_snapshot
# and the eigenboard restored from home.boot_state, the boot MUST
# fire an algedonic signal (equivalent to `@cyberpunk/algedonic.
# sample_pain` at pain=1.0) that halts the boot and surfaces to
# metalogue.
#
# Rice-safe bound: reads only byte-visible state (rolling_signature
# byte-equality between the eigenboard's inference_basis and the
# home's signature_snapshot); no program semantics.
#
# Sentinel per shard docblock: `basis=snapshot-matched` — the byte-
# level substrate-decl'd marker the resolver checks. When byte-equality
# holds, the realization layer stamps the sentinel; discharge is
# byte-equality.
#
# Body discharges per-realisation. `\`-obligation-blocked.
boot_state_coherent(home: peer_home, e: ref) -> verdict { \ }

# === home_content_addressed — bilateral predicate ===
#
# Landing A §4.4 + §5 verbatim: every OID in home.bauchladen_manifest
# is content-addressed and resolvable via @kintsugi/store/git.exists.
# The refinement-type expression per Landing A §9.2:
#
#   peer_home : Type
#      requires (∀ oid ∈ bauchladen_manifest : @kintsugi/store/git.exists(oid))
#
# Substrate-decl'd invariant. Any peer_home value whose manifest carries
# an unresolvable OID is type-ill-formed; the substrate cannot construct
# one at Landing C.
#
# Rice-safe bound: reads only byte-visible state (OID list membership;
# @kintsugi/store/git.exists returns byte-boolean); no program semantics.
#
# Sentinel per shard docblock: `manifest=oids-resolvable` — the byte-
# level substrate-decl'd marker the resolver checks. When every OID
# in the manifest resolved through @kintsugi/store/git.exists at
# realization time, the layer stamps the sentinel; discharge is
# byte-equality.
#
# Body discharges per-realisation. `\`-obligation-blocked.
home_content_addressed(home: peer_home) -> verdict { \ }

# === home_witnessing — composed bilateral ===
#
# Landing A §4.5 verbatim: the composed predicate consumers cite in
# `requires` clauses. Passes iff projection_visibility_respected AND
# harvest_consent_verified (for any harvest that has occurred) AND
# home_content_addressed. When boot_state is Some(e): also AND
# boot_state_coherent(home, e).
#
#   home_witnessing(home) :=
#     home_content_addressed(home)
#     ∧ projection_visibility_respected(home, home.visibility_filter)
#     ∧ (harvest_at.is_some() ⇒ harvest_consent_verified(home, ...))
#     ∧ (boot_state.is_some() ⇒ boot_state_coherent(home, boot_state))
#
# Rice-safe bound: composition of the four Rice-safe bilaterals above;
# no additional program semantics inspection.
#
# Sentinel per shard docblock: `witnessing=all-four-pass` — the byte-
# level substrate-decl'd marker the resolver checks. When all four
# sub-bilaterals discharge Pass at realization time, the layer stamps
# the sentinel; discharge is byte-equality.
#
# Load-bearing structural claim: home_witnessing Pass is the substrate-
# decl form of "this peer_home is a valid persistent-peer projection
# per Landing A §5 substrate-integrity guarantee."
#
# Body discharges per-realisation. `\`-obligation-blocked.
home_witnessing(home: peer_home) -> verdict { \ }

out @peer/persistence
out peer_home
out projection_visibility_respected
out harvest_consent_verified
out boot_state_coherent
out home_content_addressed
out home_witnessing
