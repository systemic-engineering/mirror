# === prism @peer/holon — the species declaration ===
#
# Inherits the five-op prism block from @peer at family-root
# altitude. Specialization: each operation reads the holon's
# fractal structure (interior + exterior @dance-ensemble edges).
prism @peer/holon {
  focus holon
  project holon
  split holon
  shift holon
  settle holon
}

# === The altitude carrier ===
#
# Closed variant naming the recursion altitude at which THIS holon
# operates. Per OTCA metapixel + Mandelbrot fractal + Koestler
# whole/part discipline: the altitude is finite (physical peers
# terminate at atomic altitude); the recursion admits scale-
# labeling for cross-altitude composition arithmetic.
#
#   atomic     — a peer with no sub-peers; the leaf-holon;
#                @peer.audhd K-track ensemble runs at intra-peer
#                altitude WITHIN this holon, but there are no
#                sub-@peer/holon children.
#   colony     — a holon composed of atomic peers (or lower-
#                altitude holons); one aggregation level up.
#   supercolony — a holon composed of colonies; two aggregation
#                levels up. Per Hölldobler-Wilson 2008 empirical
#                witness at ant altitude.
#   foam       — a holon composed of supercolonies; three levels
#                up; the whole-game-of-life-foam altitude per
#                Alex 2026-07-31 verbatim.
#
# Identity contract: byte-equality on the variant tag.
type altitude = | atomic | colony | supercolony | foam

# === The holon carrier ===
#
# Four-field record at species altitude:
#
#   base_peer     — the underlying @peer this holon lifts to holon
#                   altitude. Composes with @peer.peer at family-
#                   root altitude (three-field {home, lead_of, kind}).
#                   Substrate-typed as `ref`.
#   altitude      — the recursion altitude enum above.
#   interior      — the interior @dance ensemble (K sub-peers or
#                   sub-holons this holon carries). Substrate-typed
#                   as `ensemble` from @dance carrier.
#   aggregate_ref — the content-addressed aggregate-state ref;
#                   the composition of sub-peers' states into ONE
#                   substrate value at THIS altitude. Per @mirror/
#                   store content-addressing discipline (byte-
#                   equality on the OID).
#
# Identity contract: byte-equality on the four-field tuple. Two
# holons with same base_peer + altitude but different interior
# ensemble OR different aggregate_ref are distinct (the fractal
# composition is load-bearing).
type holon = {
  base_peer:     ref,
  altitude:      altitude,
  interior:      ensemble,
  aggregate_ref: ref,
}

# === compose_holon — the lifting action ===
#
# Given K sub-peers (or lower-altitude sub-holons) + a coupling
# matrix, compose them into ONE holon at the next altitude up.
# The interior ensemble is populated; @dance.phase_lock is invoked
# at the interior; the settled aggregate state is content-
# addressed via @mirror/store and the ref is populated.
#
# requires dance_locked(interior, coupling, order_param): the
# interior @dance ensemble MUST discharge the family-root's
# composed bilateral before the holon can lift. Fractal composition
# at broken coherence altitude is not admissible.
#
# Splinter-pole: interior phase-locks; aggregate_ref computed;
# holon lifted to next altitude; ready for consumption as ONE
# member of exterior @dance ensemble.
# Narcissus-pole: interior fails phase-lock; holon lift refused;
# @fate re-selects per @kintsugi discipline.
#
# Body `\` per consumer-pull; the FLOOR resolver at [substrate-
# floor:@io-boundary] discharges the composition.
compose_holon(sub_peers: ref, coupling: coupling, p: perturbation)
  -> holon
requires dance_locked(sub_peers, coupling, p) { \ }

# === decompose_holon — the projection action ===
#
# Given a holon, project back to its interior ensemble (the K
# sub-peers) + coupling matrix. The dual of compose_holon.
#
# Composes with @labeled.unlabel discipline (the holon IS a
# labeled-composition of substrate-value {base_peer, aggregate_ref}
# with metadata {altitude, interior}).
#
# Body `\` per consumer-pull; the FLOOR resolver discharges.
decompose_holon(h: holon, p: perturbation) -> ensemble { \ }

# === holon_admissible — the fractal-well-formedness bilateral ===
#
# Bilateral verdict that the holon satisfies fractal-composition
# structural invariants:
#
#   1. base_peer well-formed at @peer altitude (three-field
#      {home, lead_of, kind} coherent per @peer discipline).
#   2. interior ensemble discharges @dance.dance_locked at the
#      interior's coupling + order-parameter altitude.
#   3. aggregate_ref content-addresses under @mirror/store; the
#      ref IS composable via @glue.compose with other holons at
#      the exterior altitude.
#   4. altitude enum is monotone-nested: if THIS holon carries
#      sub-holons in interior, each sub-holon's altitude is
#      strictly less than THIS holon's altitude (fractal
#      recursion terminates cleanly).
#
# Splinter-pole: all four hold; holon IS fractally well-formed;
# ready for exterior @dance-ensemble consumption.
# Narcissus-pole: any sub-invariant fails; holon lift refused.
bilateral holon_admissible {
  sentinel "holon=fractal-composition-well-formed"
  arity 1
}
holon_admissible(h: holon, p: perturbation) -> verdict { \ }

out @peer/holon
out altitude
out holon
out compose_holon
out decompose_holon
out holon_admissible
