# Path-namespace property: this file at `shards/kintsugi.mirror`
# declares `@kintsugi` and only that.

prism @kintsugi {
  focus kintsugi
  project kintsugi
  split kintsugi
  shift kintsugi
  settle kintsugi
}

out @kintsugi
