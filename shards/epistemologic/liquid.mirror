---

in @prism
in @meta
in @glass
in @epistemologic
in @epistemologic/property
in @epistemologic/pact

prism @epistemologic/liquid {
  focus liquid
  project liquid
  split liquid
  shift liquid
  settle liquid
}

# === liquid_qualifier — a single refinement qualifier (theory §2.1) ===
#
# Per math §2.1: one predicate + arity at the qualifier-fragment
# altitude. Body forward-promised per `[[feedback-craft-not-deliver]]`;
# discharge via the deferred-by-design canonical spec + subspecies
# landings.
type liquid_qualifier = ref

# === qualifier_set — finite Q at an altitude (theory §2.1 + §2.2) ===
#
# Per math §2.1 + §2.2: a finite set of liquid_qualifiers at a
# given altitude. Q_mirror = landed `@epistemologic/property/*` +
# `@epistemologic/pact/*` predicates (~40 as of 2026-07-05).
# Newtyped per `[[feedback-no-bare-types]]`.
type qualifier_set = [liquid_qualifier]

# === refinement_predicate — conjunction of qualifiers (theory §2.1) ===
#
# Per math §2.1: a conjunction of qualifiers over a value_var +
# base_type. The substrate-decl'd form of a refinement-type
# refinement. Body forward-promised.
type refinement_predicate = ref

# === liquid_claim — doc_claim viewed through refinement lens (theory §2.1) ===
#
# Per math §2.1: alias for doc_claim viewed through the refinement-
# type lens. The input to the @epistemologic/liquid/extraction
# subspecies. Newtyped per `[[feedback-no-bare-types]]`; the alias
# to `doc_claim` names the subspecies coupling at the type level.
type liquid_claim = ref

# === liquid_verdict — theory-altitude verdict carrier ===
#
# Per math §2.1 verdict_at_doc_altitude + extraction subspecies
# extraction_verdict (`shards/epistemologic/liquid/extraction.
# mirror:139-157`). At extraction subspecies altitude discharges
# to `satisfiable | unsatisfiable | partial | unextractable`; at
# theory altitude carries additionally a decidable-fragment
# marker forward-promised at canonical-spec altitude.
type liquid_verdict = ref

# === refine — refinement-predicate composition (theory §2 axiom) ===
#
# Per math §2: refinement_predicate × refinement_predicate →
# refinement_predicate. Discharges the ∧ composition axiom
# (finite qualifier_set union). Body forward-promised; discharge
# via qualifier_set union at the canonical-spec altitude.
refine(p: refinement_predicate, q: refinement_predicate) -> refinement_predicate { \ }

# === implies — refinement-predicate implication (theory §2 axiom) ===
#
# Per math §2 + Reed spec §5: refinement_predicate ⇒
# refinement_predicate via spectral Laplacian eigenvalue check.
# The substrate-honest replacement for SMT (SOTA LiquidHaskell /
# Flux / F* use SMT; mirror uses spectral). Body forward-promised;
# discharge via property-Laplacian eigenvalue procedure at
# canonical-spec altitude.
implies(p: refinement_predicate, q: refinement_predicate) -> verdict { \ }

# === decidable — decidability boundary discharge (theory §6.1) ===
#
# Per math §6.1 theorem + Seam `20d0c13` §5 C2 correction: the
# refinement-predicate fragment is decidable at shard-decl
# altitude (sub-Turing per recognition #107); extraction from
# arbitrary text is @io-boundary Turing-complete. This action
# discharges the decidability verdict for a given
# refinement_predicate. Body forward-promised.
decidable(p: refinement_predicate) -> verdict { \ }

out @epistemologic/liquid
out liquid_qualifier
out qualifier_set
out refinement_predicate
out liquid_claim
out liquid_verdict
out refine
out implies
out decidable
