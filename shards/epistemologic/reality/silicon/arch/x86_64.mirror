in @prism
in @meta
in @io
in @epistemologic
in @epistemologic/reality
in @epistemologic/reality/silicon
in @epistemologic/reality/silicon/arch
in @epistemologic/property
in @epistemologic/property/content_addressed

# @epistemologic/reality/silicon/arch/x86_64
#
# The x86_64 architecture as a typed carrier. Companion to
# @epistemologic/reality/silicon/arch/arm64 — same shape, x86_64-specific
# variants. Observer-relative: names what the observer sees when
# they look at an x86_64 silicon substrate.
#
# Per docs/specs/shard-design.md §4: this grammar is one of the four
# type carriers the @mirror/shard.shard record composes from. The
# silicon field of a shard holds an x86_64 (or arm64) value; Fate's
# |\> tournament reads that field as part of its input set when
# deciding which AVX subset and memory pattern produce the locally-
# optimal Au binary.
#
# Per docs/insights/2026-05-25-pipe-hole-and-au-binary.md: the
# x86_64 ISA splits into wide bands the tournament must pick across:
# AVX2 vs AVX-512 is the load-bearing branch for FP-heavy workloads;
# AVX-512 VNNI is the further branch for INT8 inference; AES-NI and
# BMI1/2 are scalar-side optimizations. This carrier names them so
# the tournament has typed handles instead of stringly tags.
#
# Same tick-1 discipline as arm64: carriers ship now; detect() body
# is a Fate-resolved hole filled at boot via tournament against
# @code/kernel/x86_64.
#
# Substrate-pull placement (2026-06-06, Mara's reality family migration):
# moved from shards/epistemologic/silicon/arch/ to shards/epistemologic/reality/silicon/arch/
# under the @epistemologic/reality family root.
# Path-namespace property: this file at
# `shards/epistemologic/reality/silicon/arch/x86_64.mirror` declares
# `@epistemologic/reality/silicon/arch/x86_64` and only that.

prism @epistemologic/reality/silicon/arch/x86_64 {
  focus x86_64
  project x86_64
  split x86_64
  shift x86_64
  settle x86_64
}

# ISA extensions. SSE2 is the AMD64 baseline (every x86_64 has it);
# SSE4_2 brings string ops and CRC32; AVX/AVX2 are the 256-bit
# SIMD generations; AVX512F is the foundation tier of AVX-512;
# AVX512_VNNI adds the INT8 dot-product instructions used in
# quantized inference; BMI1/BMI2 are scalar bit manipulation; AES_NI
# is hardware AES rounds. Each variant is a typed flag; the running
# silicon either has the extension or does not.
type extension =
    sse2
  | sse4_2
  | avx
  | avx2
  | avx512f
  | avx512_vnni
  | bmi1
  | bmi2
  | aes_ni

# Vendor. Closed sum: Intel and AMD. The substrate has not yet
# touched VIA/Zhaoxin; adding them is one variant when the
# deployment surface needs it.
type vendor = intel | amd

# Microarchitecture. Concrete core identifier. The `generic`
# variant is the conservative fallback for unrecognized cores;
# Fate's tournament treats it as the worst-case subset (no
# AVX-512 assumptions, BMI-free codegen path).
type micro =
    zen3
  | zen4
  | sapphire_rapids
  | emerald_rapids
  | generic

# The x86_64 carrier. Five fields, parallel shape to arm64:
# extensions present, vendor, microarch, pointer width. No ISA
# generation field because x86_64 has no analogue to ARMv8.x point
# releases — the relevant feature-level information lives in the
# extensions list, where the tournament reads it.
type x86_64 = {
  extensions: [extension],
  vendor:     vendor,
  micro:      micro,
  pointer:    u32,
}

requires content_addressed(x86_64)

# Detection primitive. Reads CPUID via the running OS. On Linux:
# @io.exec("cat", ["/proc/cpuinfo"]) surfaces the flags line. On
# Darwin x86_64 (Rosetta or pre-AS hardware): @io.exec("sysctl",
# ["-n", "machdep.cpu.features", "machdep.cpu.leaf7_features"])
# surfaces SSE/AVX/AVX-512. Body is a Fate-resolved hole filled at
# boot via tournament against @code/kernel/x86_64.
detect() -> x86_64 { \ }

# Literal property. Same discipline as arm64.literal: re-detect,
# content-address, compare. Same silicon, same OID, pass.
property literal(s: x86_64) -> verdict { \ }

out @epistemologic/reality/silicon/arch/x86_64
out x86_64
out extension
out vendor
out micro
out detect
out literal
