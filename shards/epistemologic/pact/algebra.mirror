# pact_algebra generated by 15 LANDED bilateral generators (keyword_matches_depth,
# symbol_canonical_form, parent_acyclic, is_load_bearing_in_std,
# gate_matches_diff_closure, operator_matches_composition_primitive, bilateral,
# benchmark, keywords, dissonance_partials_match_ast_breadth, composition_closed,
# path_matches_namespace, syntax_substrate_native, substrate_source_in_shards,
# keyword_matches_path_root) quotiented by composition_closed identities.
#
# === Family placement ===
#
# Species shard-decl composing over LANDED @epistemologic/pact family-root.
# Sixteenth shard under @epistemologic/pact — the 15 LANDED bilateral generators
# + this algebra-carrier that composes over them.
#
# === Pre-AI prior art ===
#
#   Free monoid over        Mac Lane 1971 Categories for the Working
#     bilateral generators   Mathematician §I.1. Associative composition
#                            with identity element (e_Clear).
#   LOVE-monoid combine     Rec #92 Mara 2026-08-22 (Transparency<P>
#                            monoid combine at bilateral-verdict altitude).
#
# Spec context: docs/math/2026-09-09-mara-mirror-nl-emergence-canonical-math-foundation.md
#               §4 (Utterance-as-composition-of-pact-injunctions).
#               docs/specs/2026-09-09-mara-mirror-nl-emergence-canonical-spec.md §3
#               (this shard-decl body).
# Substrate decisions: [[architecture-shards-as-substrate-source]],
#                      [[architecture-prism-as-trait-as-everything]],
#                      [[feedback-no-bare-types]],
#                      [[feedback-substrate-already-had-the-word]].
# Related shards: 15 shards/epistemologic/pact/*.mirror LANDED bilateral
#                 generators; algebra/metalogue.mirror (Utterance ancestor).
# Path-namespace property: this file at `shards/epistemologic/pact/algebra.mirror`
# declares `@epistemologic/pact/algebra` per `@epistemologic/pact/path_matches_namespace`.

source @arxiv/category-theory/mac-lane-1971

# === pact_algebra carrier ===
#
# Per Mara 2026-09-09 math §4.1 Def M4.1 + §4.2 Def M4.3.
#
# Identity contract: byte-equality on the underlying algebra element.
type pact_algebra = ref

# === pact_compose action ===
#
# Per Mara 2026-09-09 math §3.1 + §4.1 Property M4.2: pact-algebra composition
# operator (𝓟_pact, ∘, e_Clear) is a monoid per Mac Lane 1971 §I.1 + Rec #92
# LOVE-monoid combine at pact-altitude.
#
# Given two pact_algebra elements a and b, return their composition
# a ∘ b per bilateral-verdict composition discipline. Non-commutative in
# general per LANDED algebra_morphism composition non-commutativity at
# shards/algebra/metalogue.mirror line 100.
#
# Body discharges at the realisation boundary composing over LANDED
# 15 pact bilaterals.
pact_compose(a: pact_algebra, b: pact_algebra) -> pact_algebra { \ }

# === pact_algebra_well_formed bilateral ===
#
# Bilateral verdict that a pact_algebra element is structurally well-formed:
# generated from the 15 LANDED typed generators; satisfies composition_closed
# identity; associativity per Mac Lane 1971.
#
# Fifteen requires clauses bind each LANDED bilateral verdict at
# shards/epistemologic/pact/<name>.mirror. Order is arbitrary; associativity
# is guaranteed per composition_closed LANDED.
pact_algebra_well_formed(a: pact_algebra) -> verdict
requires composition_closed(a)
requires bilateral(a)
requires parent_acyclic(a)
requires is_load_bearing_in_std(a)
requires gate_matches_diff_closure(a)
requires operator_matches_composition_primitive(a)
requires benchmark(a)
requires keywords(a)
requires dissonance_partials_match_ast_breadth(a)
requires path_matches_namespace(a)
requires syntax_substrate_native(a)
requires substrate_source_in_shards(a)
requires keyword_matches_path_root(a)
requires keyword_matches_depth(a)
requires symbol_canonical_form(a)
{ \ }

out @epistemologic/pact/algebra
out pact_algebra
out pact_compose
out pact_algebra_well_formed
