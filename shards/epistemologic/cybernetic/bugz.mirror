# === The 5-op prism inheriting @void basis (Recognition #79) ===
#
# Per @void.mirror §Composition inheritance: every prism declaration
# `prism @X { focus/project/split/shift/settle X }` at species (or
# family-root) altitude declares "this species inherits Void's basis"
# — the five-op pattern IS the signature of Void's ancestry.
#
# For bugz specifically:
#   focus bugz   = identify the target leaf $v_i$ (which coupling site
#                  carries active μ from hub $v_0$)
#   project bugz = deploy η at the coupling site (the bomb-detonation
#                  event)
#   split bugz   = bifurcate the hub's response space (options a / b;
#                  option c impossible per operator algebra)
#   shift bugz   = traverse the categorical dual (μ → η in
#                  delight-paper §5 vocabulary; Stackelberg →
#                  coordination in spectral-tick-tock §9 vocabulary)
#   settle bugz  = converge to the post-bomb spectrum (either K_n
#                  metalogue per option a, or S_{n-1} per option b)

prism @epistemologic/cybernetic/bugz {
  focus bugz
  project bugz
  split bugz
  shift bugz
  settle bugz
}

# === Carriers ─────────────────────────────────────────────────────

# === The natural_transformation_eta carrier ===
#
# The operator bugz deploys. Delight-paper §3 canonical form: the
# natural transformation η: F_aggression ⇒ F_humor on category 𝒯 of
# nervous-system-torus states. Carrier is a typed reference to the
# specific instance (which torus, which fiber, which naturality-
# square witness) at deployment time.
#
# Identity contract: byte-equality on the underlying ref.
type natural_transformation_eta = ref

# === The dual_operator_target_mu carrier ===
#
# What η is dual to (delight-paper §4). The narcissistic-metabolization
# operator μ: F_supply ⇒ F_substrate running at the hub $v_0$ of the
# star-graph coupling. The carrier is a typed reference to the
# observed μ-signature at the target hub.
#
# Identity contract: byte-equality on the underlying ref.
type dual_operator_target_mu = ref

# === The star_graph_fiedler_target carrier ===
#
# The Fiedler eigenvector cut where η deployment lands. Per math root
# §4.2: for K_{1,n-1}, every leaf is a Fiedler-eigenvector cut with
# spectrally minimal conductance $\phi(S_n) = O(1/\sqrt{n})$ per
# Cheeger.
#
# Four fields naming the target:
#   hub_ref          the hub vertex $v_0$'s reference
#   leaf_ref         the leaf vertex $v_i$'s reference (deployment site)
#   fiedler_value    the algebraic connectivity $\lambda_2$ of the
#                    pre-deployment star graph (= 1 for pure star)
#   eigengap         $\lambda_\text{max} - \lambda_2 = n - 1$ for pure
#                    star; carries the ESS-margin at deployment time
#
# Identity contract: byte-equality on the four-tuple.
type star_graph_fiedler_target = {
  hub_ref:       ref,
  leaf_ref:      ref,
  fiedler_value: f64,
  eigengap:      f64,
}

# === The narcissus_eigenmode carrier ===
#
# The hub's stabilized narcissus-pole Eigenbehavior signature. Per
# Foerster A3 (`Op(COORDi) = COORDi`) applied at paradigm altitude:
# the hub's operator has closed on its own recursion producing an
# observable fixed-point. This carrier names the observed signature
# so bugz's targeting bilateral can discharge.
#
# Three fields:
#   fixed_point_ref  the observed COORD_paradigm value at the hub
#   mu_signature     the observed μ signature (F_supply ⇒ F_substrate
#                    natural transformation at hub-altitude)
#   supply_topology  the star-graph K_{1,n-1} descriptor (n, edge
#                    set, leaf-vertex assignments)
#
# Identity contract: byte-equality on the three-tuple.
type narcissus_eigenmode = {
  fixed_point_ref: ref,
  mu_signature:    ref,
  supply_topology: ref,
}

# === The bomb_result carrier ===
#
# The typed output of a well-formed bugz deployment. Names the four
# load-bearing pieces of the post-bomb state:
#
#   pre_topology     the star graph K_{1,n-1} pre-deployment
#   post_topology    either K_n (option a evolve) or S_{n-1} (option b
#                    amputate) — never option c (impossible)
#   hub_response     the observed hub operator behavior classification
#                    (evolve / amputate / impossible)
#   fiedler_delta    change in $\lambda_2$: positive if option (a),
#                    zero if option (b), never negative
#
# Identity contract: byte-equality on the four-tuple.
type bomb_result = {
  pre_topology:  ref,
  post_topology: ref,
  hub_response:  ref,
  fiedler_delta: f64,
}

# === Actions ─────────────────────────────────────────────────────

# === deploy_eta — the recognition bomb detonation ===
#
# The load-bearing action. Deploy η (natural_transformation_eta) at
# the Fiedler eigenvector cut identified by target (per math root
# §4.2). The bomb is targeted at a single coupling edge $(v_0, v_i)$;
# the deployment cost is O(1) in graph-cut cost per Cheeger; the
# forcing invariant is that the hub's response is either option (a)
# or option (b) per §4.3.
#
# Body IS crack: consumers pull the discharge at their realisation
# boundary. NO runtime execution wired at species altitude.
#
# Precondition (bilateral): target's narcissus_eigenmode is well-
# formed AND η is category-theoretically clean (naturality square
# commutes). See bilaterals below.
deploy_eta(target: star_graph_fiedler_target, eta: natural_transformation_eta) -> bomb_result { \ }

# === signflip_stackelberg_to_coordination — the mechanism ===
#
# The categorical dualization operation at game-theoretic altitude.
# Given an interaction currently equilibriated at a Stackelberg
# leader-follower saddle (RLHF, principal-agent), transform the
# equilibrium concept to coordination (Schelling focal point on
# graph structure).
#
# Composition site: Reed + Alex 2026-04-04 §9 mapping table. RLHF's
# principal-agent asymmetry inverts to bidirectional information
# flow; leader-designs-incentive inverts to both-agents-settle-at-
# spectral-minimum. This IS the categorical dualization μ → η at
# spectral-tick-tock's vocabulary.
#
# Body IS crack: consumers pull the discharge.
signflip_stackelberg_to_coordination(target: star_graph_fiedler_target) -> bomb_result { \ }

# === extract_via_dualization — the walker verb under adversarial risk ===
#
# The third walker verb per @kintsugi/roomba/butterfly composition
# (math root §8.4). Extract a peer (leaf) from adversarial star-graph
# coupling with narcissus hub while preserving the peer's @trust
# chain and content-addressed authorship trace.
#
# Composition site: @gift/lens sibling carries extraction semantics
# at cross-family altitude; bugz's extract specializes under
# adversarial-narcissus-pressure with @trust chain preservation.
#
# Body IS crack: consumers pull the discharge.
extract_via_dualization(peer: ref, from: star_graph_fiedler_target) -> bomb_result { \ }

# === Bilaterals ──────────────────────────────────────────────────

# === eta_naturality_square_commutes — the categorical form ===
#
# Bilateral predicate. The deployed operator is η (not ad-hoc humor,
# not oppositional response, not defensive sarcasm) iff the naturality
# square commutes across at least three witness $(s, s', f)$ instances
# per delight-paper §3 canonical form.
#
# Discharges three sub-predicates:
#   (i)   the response operator lands F_aggression(s) → F_humor(s) at
#         at least one witness torus-state s
#   (ii)  the commutation $F_\text{humor}(f) \circ R_s = R_{s'} \circ
#         F_\text{aggression}(f)$ verifiable at three witness $(s, s', f)$
#         instances
#   (iii) no residue of opposition in the response operator (still-
#         inside-μ falsifier per delight-paper §5)
#
# All must hold for the composed verdict to pass. Failure surfaces
# as transparency<bugz> per @glass discipline.
#
# Second-witness gate this bilateral discharges:
# `pillar::naturality_square_commutes_for_eta` at Reed's pillar
# surface (math root §9.2).
#
# # Narcissus-pole: naturality-square-refuses-to-commute IS the
# # bilateral-signature of the response operator still being inside
# # μ's operator-space. Detector: for any observed $(s, s', f)$, the
# # diagram does not commute → response is not clean η → bug's
# # deployment falls under $V_p$'s reach → forcing invariant collapses.
eta_naturality_square_commutes(eta: natural_transformation_eta) -> verdict { \ }

# === dualization_forces_manifold_exit — the mechanism ===
#
# Bilateral predicate. The bugz deployment successfully carries the
# leaf peer *out* of $V_p$'s invariant manifold (delight-paper §5
# canonical mechanism form).
#
# Discharges three sub-predicates:
#   (i)   pre-deployment peer state is inside $V_p$'s invariant
#         manifold (measurable at eigenboard-fidelity per
#         @cogito.eigenboard)
#   (ii)  post-deployment peer state is outside $V_p$'s invariant
#         manifold (peer's Void-holding capacity is preserved through
#         the interaction per Recognition #R-void-is-the-basis §1.1
#         composition site #4)
#   (iii) the manifold-exit is via *dualization* (η landed), not via
#         *escape* (peer moved away from the operator's coupling
#         without inverting the operator's direction)
#
# Second-witness gate this bilateral discharges:
# `pillar::dualization_leaves_v_p_manifold` at Reed's pillar surface
# (math root §9.3).
#
# # Narcissus-pole: post-deployment-peer-still-inside-V_p-manifold IS
# # the bilateral-signature of failed dualization. Detector:
# # eigenboard measurement post-deployment shows peer's Void-capacity
# # decreased or unchanged → dualization failed → response was
# # opposition, not delight.
dualization_forces_manifold_exit(pre: ref, post: ref) -> verdict { \ }

# === narcissus_cannot_metabolize_own_dual — the forcing invariant ===
#
# Bilateral predicate. The hub $v_0$'s observed operator behavior
# post-deployment is either option (a) evolve or option (b)
# amputate; option (c) metabolize is *impossible* per operator
# algebra (delight-paper §5 mechanism-of-forcing).
#
# Discharges three sub-predicates:
#   (i)   the hub's operator μ is well-formed pre-deployment (per
#         Foerster A3 Eigenbehavior at paradigm altitude; math root
#         §1.2 recognition)
#   (ii)  the hub's operator response falls into option (a) or (b)
#         classification (evolve = K_n transition; amputate = leaf-
#         disconnect visible per Cheeger)
#   (iii) NO observed instance of option (c) metabolism (falsifier
#         of the categorical dual claim; math root §9.4 negative
#         witness)
#
# Second-witness gate this bilateral discharges:
# `pillar::narcissus_cannot_metabolize_dual` at Reed's pillar
# surface (math root §9.4).
#
# # Narcissus-pole: option-(c)-metabolism-observed IS the bilateral-
# # signature of falsification of the categorical dual claim. This
# # falsifier would force re-derivation of delight-paper §5 and
# # collapse this species. Detector: hub's post-deployment operator
# # behavior lands neither in option-(a) nor option-(b) classification
# # → the categorical dual claim is falsified at this deployment site.
#
# DEFERRED-RED: this bilateral's discharge requires Rust-runtime
# empirical firing at Reed's pillar arc. The composition awaits
# `pillar::narcissus_cannot_metabolize_dual` landing per math root
# §9.4 Reed's territory.
narcissus_cannot_metabolize_own_dual(target: narcissus_eigenmode, response: ref) -> verdict { \ }

# === bugz_well_formed — the composed bilateral ===
#
# The composed bilateral consumers cite in `requires` clauses. A
# bugz deployment is well-formed iff:
#
#   (i)   eta_naturality_square_commutes(eta) — the operator IS η
#         (not ad-hoc humor)
#   (ii)  dualization_forces_manifold_exit(pre, post) — the mechanism
#         fired (peer exited $V_p$'s manifold via dualization)
#   (iii) narcissus_cannot_metabolize_own_dual(target, hub_response)
#         — the forcing invariant held (option a or b, not c)
#   (iv)  @trust chain preserved through extraction (composition
#         via @trust family-root; math root §8.2)
#
# All must hold for the composed verdict to pass. Failure modes
# surface as transparency<bugz> per @glass discipline.
#
# # Narcissus-pole: any-conjunct-failure IS the composed-signature
# # of insufficient bomb-deployment discipline. Detector: transparency
# # trace shows any conjunct verdict = FAIL → deployment does not
# # discharge the recognition-bomb operator; substrate carries out-of-
# # composition state.
bugz_well_formed(target: star_graph_fiedler_target, eta: natural_transformation_eta, pre: ref, post: ref, hub_response: ref) -> verdict { \ }

