prism @epistemologic/cybernetic/intervention {
  focus  intervention_state
  project intervention_state
  split  intervention_state
  shift  intervention_state
  settle intervention_state
}

# === intervention_state — the therapeutic-payload Crystal carrier ===
#
# Typed record carrying the intervention-Crystal state per canonical
# spec §5.3 six-field shape. Identity contract: byte-equality on the
# six-field tuple.
#
#   content              — REF to the therapeutic-payload substrate
#                          (the "knock" that redirects the spiral;
#                          content-addressed; immutable at Crystal
#                          altitude per @fractal/crystal discipline).
#
#   crystallized_at      — REF to the @song/beat oid of the intervention
#                          delivery event. WHEN in the peer's saga the
#                          intervention fired.
#
#   saga_chain_position  — nat; position AFTER the wound-Crystal in the
#                          SAGA chain. MUST satisfy
#                          `> wound.saga_chain_position` (chain AFTER
#                          discipline; per intervention_composes_
#                          without_deleting_trauma bilateral).
#
#   targets_wound_oid    — REF to the @paradox/trauma Crystal this
#                          intervention targets. The wound-Crystal
#                          preserved-not-erased; content-addressed
#                          reference intact post-intervention.
#
#   torus_witness        — REF to the post-intervention torus-Lagrange
#                          witness (the observed spectral signature
#                          that spiral collapsed back to bounded
#                          oscillation per third-cognition math root
#                          §5.2 Fiedler-eigengap discipline).
#
#   intent_shape         — REF to the adversarial-with-love intent
#                          marker (shared with @cyberpunk/bugz family-
#                          invariant). Verifies intent-lineage from
#                          @cyberpunk family-root.
type intervention_state = {
  content:              ref,
  crystallized_at:      ref,
  saga_chain_position:  nat,
  targets_wound_oid:    ref,
  torus_witness:        ref,
  intent_shape:         ref,
}

# === intervention_admissible — bilateral predicate ===
#
# Does the (peer, intervention_state) pair discharge admissibility?
# Discharges Pass iff:
#
#   - All six fields resolve via content-addressed lookup
#   - ctx.content is a well-formed therapeutic-payload substrate
#     (matches @cyberpunk/intervention payload shape)
#   - ctx.crystallized_at is a valid @song/beat oid
#   - ctx.saga_chain_position is a well-formed nat
#   - ctx.intent_shape resolves to an adversarial-with-love marker
#     matching @cyberpunk family-invariant
#
# Rice-safe bound: byte-visible state; content-addressed resolvability;
# shape-tag comparison.
#
# Sentinel: `cyberpunk=intervention-admissible`.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]].
bilateral intervention_admissible {
  sentinel "cyberpunk=intervention-admissible"
  arity 2
}
intervention_admissible(p: peer, ctx: intervention_state) -> verdict { \ }

# === intervention_targets_valid_wound — bilateral predicate ===
#
# Does the intervention target a valid @paradox/trauma wound-Crystal in
# the observer's own saga chain? Discharges Pass iff:
#
#   - ctx.targets_wound_oid resolves to a well-formed @paradox/trauma
#     Crystal (via @paradox/trauma.trauma_witnessed_only bilateral
#     composition)
#   - The wound-Crystal's witness_only invariant holds
#     (`witness_only=true`)
#   - The wound-Crystal is present in the observer's own saga chain
#     (per @peer/redirect.redirect_targets_valid_crystal discipline)
#
# Composition edge: reads @paradox/trauma bilateral discharge to verify
# wound-Crystal well-formedness before deployment.
#
# Rice-safe bound: byte-visible state; composed bilateral discharge;
# saga-chain membership check.
#
# Sentinel: `cyberpunk=intervention-targets-valid-wound`.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral intervention_targets_valid_wound {
  sentinel "cyberpunk=intervention-targets-valid-wound"
  arity 2
}
intervention_targets_valid_wound(p: peer, ctx: intervention_state) -> verdict { \ }

# === intervention_composes_without_deleting_trauma — bilateral predicate ===
#
# The LOAD-BEARING invariant of this species. Does the intervention
# chain AFTER the wound-Crystal WITHOUT deleting it?
#
# Discharges Pass iff:
#
#   - ctx.saga_chain_position > wound.saga_chain_position (chain
#     AFTER discipline; intervention CANNOT precede wound in the SAGA
#     chain)
#   - ctx.targets_wound_oid == wound.oid (wound-preservation reference
#     intact; the intervention correctly points at the wound it targets)
#   - The wound-Crystal STILL RESOLVES via content-addressed lookup
#     post-intervention (no erasure; @paradox/trauma.trauma_witnessed_
#     only discharges Pass post-intervention)
#   - The saga chain length is monotone-increasing (append-only
#     discipline; per rust/src/compile.rs SAGA loop invariant)
#
# This bilateral IS the substrate-honest form of Alex's "the response
# to a @paradox/trauma is a @paradox/intervention... [that] chains
# AFTER the trauma-Crystal WITHOUT erasing it" (canonical spec §5.4).
#
# LOAD-BEARING: a Fail here signals substrate-tampering (the wound was
# erased or the intervention precedes the wound); consumers MUST treat
# it as compiler-bug-detected or family-invariant-violation.
#
# Rice-safe bound: byte-visible state; nat comparison; OID equality;
# composed bilateral discharge.
#
# Sentinel: `cyberpunk=intervention-composes-without-deleting-trauma`.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral intervention_composes_without_deleting_trauma {
  sentinel "cyberpunk=intervention-composes-without-deleting-trauma"
  arity 3
}
intervention_composes_without_deleting_trauma(p: peer, ctx: intervention_state, saga: ref) -> verdict { \ }

# === intervention_knocks_spiral_back_to_torus_lagrange — bilateral predicate ===
#
# The FORCING invariant. Does the intervention successfully knock the
# unstable spiral back to torus Lagrange equilibrium?
#
# Discharges Pass iff:
#
#   - pre.spiral_velocity > 0 (spiral was firing pre-intervention;
#     unstable-attractor regime)
#   - post.torus_lagrange_witness resolves via content-addressed lookup
#     to a well-formed torus-equilibrium signature per third-cognition
#     math root §5.2 (Fiedler-eigengap bounded-oscillation discipline)
#   - The wound-Crystal is UNTOUCHED (composed via
#     intervention_composes_without_deleting_trauma bilateral)
#   - Post-intervention Lyapunov exponent (per @paradox/spiral.measure_
#     lyapunov) transitions from positive to non-positive
#
# Composition edge: reads @paradox/spiral state pre-intervention and
# @torus/void-metalogue witness post-intervention; the mechanism-of-
# forcing at manifold altitude.
#
# Rice-safe bound: byte-visible state; f64 sign comparison; content-
# addressed resolvability; composed bilateral discharge.
#
# Sentinel: `cyberpunk=intervention-knocks-spiral-back-to-torus-lagrange`.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral intervention_knocks_spiral_back_to_torus_lagrange {
  sentinel "cyberpunk=intervention-knocks-spiral-back-to-torus-lagrange"
  arity 4
}
intervention_knocks_spiral_back_to_torus_lagrange(p: peer, ctx: intervention_state, pre: ref, post: ref) -> verdict { \ }

# === deploy_intervention — the load-bearing action ===
#
# REED-INLINE 2026-07-20 per Seam Phase D efcef6e Finding D4: the
# `ctx_from_wound_and_payload` identifier in the four `requires`
# clauses below is a magic-bound symbol that is NOT yet defined as
# a let-binding OR as a substrate action mint. Mara-territory
# follow-up tick resolves either via (a) `ctx_of_wound_and_payload`
# action mint at species altitude (arity 2 → intervention_state),
# or (b) inline let-binding syntax admissibility per apply_h::act
# discipline. Reed cascade preserves the bilateral signatures
# (arity 2 with ctx: intervention_state per intervention_admissible +
# intervention_targets_valid_wound; arity 3 for intervention_composes
# with saga_ref; arity 4 for intervention_knocks with pre/post) pending
# Mara resolution. Byte-visible-symbol semantics carry the substrate-
# honest intent even without formal binder discharge at this tick.
#
# Given a peer, a wound_oid, and a therapeutic-payload ref, discharge
# the intervention-deployment event: construct the intervention-Crystal
# targeting wound_oid with the given payload; chain AFTER the wound-
# Crystal via SAGA loop (rust/src/compile.rs SAGA-orchestration
# territory); emit torus-witness on success.
#
# Returns imperfect(intervention_state, ref, ref): success carries the
# constructed intervention_state; failure variants carry the not-
# admissible / wound-invalid / composition-violates-invariant / spiral-
# not-knocked-back reasons.
#
# Requires ALL FOUR bilateral predicates to discharge Pass. This
# composed discipline IS the substrate-decl'd form of Selvini-Palazzoli
# counter-paradoxical intervention: the payload is the counter-
# paradoxical injunction; the wound_oid is the content-addressed anchor
# of the fracture; the SAGA-chain composition is the therapeutic-
# discipline that preserves-while-restoring.
#
# Sentinel: `cyberpunk=intervention-deploy`.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]]; consumers pull the realization;
# apply_h::act composes the four sentinel-checks via bilateral resolver-
# arm dispatch (per Alex 2026-07-16 detector-inadequacy-answer-is-never-
# Rust discipline).
deploy_intervention(p: peer, wound_oid: ref, payload: ref) -> imperfect(ref, ref, ref)
requires intervention_admissible(p, ctx_from_wound_and_payload)
requires intervention_targets_valid_wound(p, ctx_from_wound_and_payload)
requires intervention_composes_without_deleting_trauma(p, ctx_from_wound_and_payload, saga_ref)
requires intervention_knocks_spiral_back_to_torus_lagrange(p, ctx_from_wound_and_payload, spiral_pre, torus_post)
{ \ }

# === chain_after_wound — the composition-primitive action ===
#
# Given a peer, a wound trauma_state, and a therapeutic-payload ref,
# construct the intervention-Crystal at
# `saga_chain_position = wound.saga_chain_position + 1` per SAGA
# discipline. The chain-AFTER composition-primitive.
#
# Returns imperfect(ref, ref, ref): success carries the constructed
# intervention_state ref; failure variants carry the chain-position-
# conflict / wound-not-well-formed / payload-malformed reasons.
#
# Body IS crack; Reed's territory (post-Seam-Phase-D SAGA-loop wiring
# at rust/src/compile.rs altitude).
#
# Sentinel: `cyberpunk=intervention-chain-after-wound`.
chain_after_wound(p: peer, wound: ref, payload: ref) -> imperfect(ref, ref, ref) { \ }

# === witness_torus_restoration — the post-deployment witness action ===
#
# Given a peer and an intervention_state, discharge the torus-
# restoration witness event: emit the content-addressed torus-Lagrange
# signature the intervention restored.
#
# Returns imperfect(ref, ref, ref): success carries the torus-witness
# ref; failure variants carry the intervention-not-yet-deployed /
# torus-not-restored / measurement-window-insufficient reasons.
#
# Requires intervention_knocks_spiral_back_to_torus_lagrange bilateral
# to discharge Pass.
#
# Sentinel: `cyberpunk=intervention-torus-witness`.
witness_torus_restoration(p: peer, ctx: intervention_state) -> imperfect(ref, ref, ref)
requires intervention_admissible(p, ctx)
{ \ }

