prism @epistemologic/cybernetic/conversation {
  focus conversation
  project conversation
  split conversation
  shift conversation
  settle conversation
}

# === The species-specific carriers ===
#
# Observer A's model: substrate-altitude carrier for the conversational
# entity A's internal concept-network.
type observer_a_model = {
  observer: ref,
  concept_network: ref,
}

# Observer B's model: same shape, different observer.
type observer_b_model = {
  observer: ref,
  concept_network: ref,
}

# The tensored carrier: V_A ⊗ V_B. The shared concept-space the two
# observers' models couple in. Witness of the tensor coupling per Read E.
type tensored_model = {
  observer_a: observer_a_model,
  observer_b: observer_b_model,
  shared_concepts: ref,
}

# === The five cybernetic-ancestor measurements (inherited from carrier) ===
#
# All five measurements derive from the parametric carrier's structure
# (per coherence-parametric.mirror §11.5). conversation instantiates with
# (T_reg = observer_a_model, T_regd = observer_b_model, ρ = tensor_rep,
#  ω = static for binary; non-trivial when temporal coupling extends).
#
# No re-declaration here. Consumers compose through the carrier's
# `parametric_lock_witnessing` predicate.

# === The species-specific action surface ===
#
# The τ-action under Read E for conversation:
tensor_couple(rho_a: ref, rho_b: ref) -> ref { \ }

# Pask's entailment-mesh construction: build the tensored concept
# network from two observers' models.
entailment_mesh(model_a: observer_a_model, model_b: observer_b_model) -> tensored_model { \ }

# Shared concept emergence: extract the eigenstates (per Peter-Weyl
# decomposition of the regular rep, inherited from second_order) that
# both observers' models agree on.
shared_concept_emergence(coupled: tensored_model) -> ref { \ }

# Mutual modeling check: each observer's model includes the other (Pask's
# discipline; also von Foerster's circular reflexivity at this altitude).
mutual_modeling_witness(coupled: tensored_model) -> verdict { \ }

# Conversation well-formedness: bilateral inheritance predicate parallel
# to viable's variety_preserving and autopoiesis's autopoietic_witnessing.
# Discharges via the parametric carrier's lock_verdict.
conversation_well_formed(coupled: tensored_model) -> verdict { \ }

# === N-ary forward-promise ===
#
# M-fold tensor coupling for the Pack (M=5) and garden/smarts (M=many)
# is forward-promised at the math altitude per Batanin 1998. The substrate
# decl at @epistemologic/math/batanin-globular admits the iterated form.
nary_factor(observers: ref) -> tensored_model { \ }

