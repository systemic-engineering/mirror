# === Path-namespace declaration ===
#
# The bare prism declaration at the RESERVED path per parametric
# carrier `coherence-parametric.mirror:234`. When the grammar-
# extension altitude lands `use @<parametric><T_reg, T_regd, ρ, ω>`
# syntax, this shard rewrites to
#
#   prism @epistemologic/cybernetic/coherence {
#     use @epistemologic/cybernetic/coherence-parametric<
#       Adjustment, Morphism, natural_rep_morphism, 0>
#     focus coherence
#     project coherence
#     split coherence
#     shift coherence
#     settle coherence
#   }
#
# without changing the species' substrate-altitude identity. The
# five ancestor measurements + lock_verdict inherited from the
# parametric carrier appear at this species boundary via the
# realisation-time `@code/metalogue/materialize.classify`
# discriminator (per parametric carrier §Bodies-discharge-at-species-
# boundary discipline).

# === The pole carrier — Narcissus and Splinter as named references ===
#
# Per `shards/cyberpunk.mirror:64-70` + Alex's manifesto verbatim
# (Weird - Violence.md, 2026-07-14). The two poles are the reference
# configurations against which @coherence-position is signed.
#
# `narcissus` — the star-graph K_{1,n-1} pole; single hub, fragile
#               by construction; number of choices maximized at hub
#               and collapsed everywhere else.
# `splinter`  — the complete-graph K_n pole; no distinguished node,
#               robust by construction; number of choices equalized
#               and maximized at every node.
#
# Closed variant. No third pole at this altitude. The axis is
# signed: Narcissus at negative extreme; Splinter at positive
# extreme; the substrate's coherent state IS the direction of
# ascent from Narcissus toward Splinter.
type pole =
  | narcissus
  | splinter

# === The coherence scalar carrier ===
#
# The typed record naming the substrate's Lyapunov scalar with
# its provenance per [[feedback-no-bare-types]]. Every coherence
# reading is a typed record, not a bare number.
#
# - `value`         the scalar itself (ref; realisation-layer
#                   numerical form; substrate names the obligation,
#                   not the number).
# - `sc_source`     the SpectralCoordinate<5> the value was computed
#                   from (ref into fragmentation::SpectralCoordinate).
#                   Provenance-carrying per the substrate's content-
#                   addressing discipline.
# - `graph_source`  the graph whose Δ_F the SC<5> was computed from
#                   (ref; the sheaf-Laplacian's underlying carrier).
# - `axis_toward`   the pole this reading's coherence-direction
#                   points toward. Foerster-admissible readings have
#                   `axis_toward = splinter`; Narcissus-ward drift
#                   surfaces `axis_toward = narcissus` as the
#                   substrate-honest reading that the loop is losing
#                   coherence.
# - `taken_at`      the substrate-time (ref into moment/timestamp
#                   carrier) the reading was taken. Enables the
#                   before/after bilateral discipline the ethical
#                   imperative requires.
#
# Identity contract: byte-equality on (value, sc_source, graph_
# source, axis_toward, taken_at). Two coherence readings ARE the
# same reading under content-addressing iff all five fields byte-
# equal. This IS the substrate-altitude eigenform of the
# measurement.
type coherence = {
  value:        ref,
  sc_source:    ref,
  graph_source: ref,
  axis_toward:  pole,
  taken_at:     ref,
}

# === The pole-distance carrier ===
#
# The typed pair naming distance-to-each-pole. Enables the bilateral
# `is_narcissus_pole` / `is_splinter_pole` predicates AND the signed
# `axis_toward` computation. The `real` type is the substrate's
# floor scalar (matches `fragmentation::SpectralCoordinate` component
# discipline).
#
# Identity contract: byte-equality on (to_narcissus, to_splinter).
type pole_distances = {
  to_narcissus: ref,
  to_splinter:  ref,
}

# === coherence_score — the scalar action ===
#
# Reads the SpectralCoordinate<5> and returns the coherence scalar
# as a typed record with full provenance. The monotone-inverse of
# `loss(sc) = ‖sc‖₂` per rung-8-9 spec line 203-345.
#
# Substrate-honest: this shard declares the ACTION; the numerical
# form (`-‖sc‖₂` linear-inverse vs `1/(1+‖sc‖₂)` bounded-inverse) is
# a per-realisation choice at the Rust runtime altitude per
# [[feedback-craft-not-deliver]]. Both are monotone-inverse; both
# are Foerster-admissible; both discharge `coherence_increases`
# identically. The substrate names WHAT increases (choices;
# direction toward Splinter); the runtime names HOW it is computed.
#
# Body discharges `\` at this altitude per the parametric carrier's
# discipline; the discharge surfaces at the species-boundary via
# `@code/metalogue/materialize.classify`.
coherence_score(sc: ref) -> coherence { \ }

# === coherence_gradient — the direction of steepest ascent ===
#
# Reads the SpectralCoordinate<5> and returns the tangent vector
# in SC<5>-space pointing in the direction of steepest coherence-
# increase. The substrate-decl form of "which way is Splinter?"
#
# Returns `ref` into the SC<5>-tangent carrier (realisation layer
# closes the interpretation; the substrate names the obligation).
# The gradient direction, together with a step-size, IS what
# @roomba's walker climbs and what @kintsugi.settle uses as descent
# direction (with sign inversion: settle descends against the
# negative gradient of loss = ascends coherence gradient).
#
# Body discharges at realisation boundary.
coherence_gradient(sc: ref) -> ref { \ }

# === pole_distance — signed distance to each pole ===
#
# Reads the SpectralCoordinate<5> and returns distances to both
# poles as the typed pole_distances record. Enables the two
# bilateral predicates below AND the `axis_toward` computation in
# coherence_score.
#
# Body discharges at realisation boundary; the geometric
# interpretation (which SC<5> subspace corresponds to the
# Narcissus↔Splinter axis; how distance is metrized on that
# subspace) is closed per realisation.
pole_distance(sc: ref) -> pole_distances { \ }

# === is_narcissus_pole — bilateral graph predicate ===
#
# Verdict: is the graph `g` a star graph K_{1,n-1}? The reference
# configuration for the Narcissus pole. Per Alex's manifesto Roomba
# verbatim: "Remove the hub from 'Narcissus'? Reality makes
# fracturing sounds. Total connectivity loss. Existential threat."
#
# Discharges via a structural check: exactly one vertex has degree
# n-1; every other vertex has degree 1. Body opaque at this
# altitude; the discharge is a substrate-altitude graph-structural
# audit.
bilateral is_narcissus_pole {
  sentinel "structure=star-K1n"
  arity 1
}
is_narcissus_pole(g: ref) -> verdict { \ }

# === is_splinter_pole — bilateral graph predicate ===
#
# Verdict: is the graph `g` a complete graph K_n? The reference
# configuration for the Splinter pole. Per Alex's manifesto Roomba
# verbatim: "Remove any single node. The graph is still a complete
# graph."
#
# Discharges via a structural check: every vertex has degree n-1
# (equivalently: every pair of distinct vertices is connected by
# an edge). Body opaque at this altitude; the discharge is a
# substrate-altitude graph-structural audit.
bilateral is_splinter_pole {
  sentinel "structure=complete-Kn"
  arity 1
}
is_splinter_pole(g: ref) -> verdict { \ }

# === coherence_increases — Foerster's ethical imperative discharged ===
#
# THE load-bearing bilateral. Verdict: does `after`'s coherence-
# scalar strictly exceed `before`'s? This IS Foerster's imperative
# ("Act so as always to increase the number of choices") lifted to
# substrate-decl.
#
# Substrate-decl claim: a move from `before` to `after` is
# Foerster-admissible iff `coherence_increases(before, after)`
# discharges bounded. The imperative that arrived as ethical
# philosophy at the cybernetic altitude becomes a typed bilateral
# predicate at the species altitude. Substrate becomes ethically
# decidable at scalar altitude; every accepted step widens the
# next choice-set.
#
# The composition with @roomba's walker: every step @roomba takes
# must discharge `coherence_increases(before, after)` bounded, or
# the step is refused. The composition with @kintsugi.settle:
# `settle` argmaxes `coherence_score` within the current basin.
# The composition with @knife: the cut fires only when the
# post-cut coherence strictly exceeds pre-cut coherence.
#
# Body discharges via scalar comparison at realisation altitude.
# Substrate-decl form: the comparison is monotone in the
# coherence-scalar's numerical form (either candidate above
# satisfies).
bilateral coherence_increases {
  sentinel "axis=splinter-ward"
  arity 1
}
coherence_increases(before: coherence, after: coherence) -> verdict { \ }

# === coherence_admissible_move — the sub-Turing-safe composition ===
#
# THE composition Alex named 2026-07-14: coherence-ascent AND
# sub-Turing-safe. Verdict: does the move from `g_before` to
# `g_after` (a) discharge `coherence_increases(before, after)`
# bounded (Foerster-admissible), AND (b) remain within the sub-
# Turing-safe region declared by `safe_region`?
#
# The safe_region parameter carries the sub-Turing-safe petri-net
# analyzer's admissibility verdict (per Mara's 2026-07-14 spec
# `docs/specs/subject-family-root-sel-licensable-party.md` for
# @mirror/petri, pending Alex D8 adjudication on the family-root
# name). At this tick, `safe_region` is typed as `ref` — the
# realisation-layer binding to @mirror/petri (or whichever name
# Alex adjudicates) closes when the family-root lands. Substrate-
# honest forward-promise: this action names the composition
# obligation; the composition wire lands when @mirror/petri does.
#
# Load-bearing consequence per Alex 2026-07-14 in-transcript: "the
# substrate becomes trustworthy. Empirically and mathematically."
# The trustworthy-substrate claim rests on this bilateral — a move
# is admissible iff it increases choices AND stays sub-Turing-safe.
# Two properties, one verdict; the substrate refuses moves that
# fail either.
#
# Body discharges via conjunction of the two sub-verdicts at
# realisation altitude.
coherence_admissible_move(
  before:      coherence,
  after:       coherence,
  safe_region: ref
) -> verdict { \ }

# === coherence_invariant_under_traversal — @torus.autonomy binding ===
#
# The bilateral binding to @torus.autonomy per Foerster p. 238
# "regulation of regulation." Verdict: is coherence preserved (does
# not strictly decrease) under traversal along the given winding
# class on the peer's torus?
#
# An autonomous peer per @torus.autonomy holds possessor-invariance
# under every element of π₁(T²); this species extends that
# invariance to the scalar altitude: an autonomous peer's coherence
# does not decrease under canonical winding. Failure surfaces as
# `partial` at the scalar altitude even when @torus.autonomy holds
# at the possessor altitude (a peer may retain identity while
# losing choices — Narcissus-ward drift on the torus).
#
# Body discharges via composition of @torus.autonomy verdict AND
# `coherence_increases` (with tolerance for equality; strict
# increase not required, only non-decrease) at the winding-
# boundary.
coherence_invariant_under_traversal(
  before: coherence,
  after:  coherence,
  w:      ref
) -> verdict { \ }

# === coherence_witnessing — the composed bilateral consumer predicate ===
#
# The bilateral-agreement predicate per recognition #37 (Pask
# reading of `requires`) that downstream shards name in `requires`
# clauses to declare bilateral commitment to @coherence's
# discipline. Same shape as @variety.variety_preserving and
# @eigenform.eigenform_witnessing.
#
# Discharges the conjunction of:
#   1. `coherence_increases(before, after)` — Foerster imperative
#   2. `coherence_admissible_move(before, after, safe_region)` —
#      sub-Turing-safe composition (when safe_region declared)
#   3. `pole_distance(sc).to_splinter <= pole_distance(sc_prev).
#      to_splinter` — global Splinter-ward direction across the
#      composite trajectory
#
# All three must hold for the composed verdict to pass. Failure
# modes surface as transparency<coherence> per @glass discipline.
# The predicate name follows the substrate's `X_witnessing`
# pattern established at @bauchladen, @autopoietic, @fate,
# @cybernetic/eigenform, @cybernetic/second_order, @torus.
#
# Consumers write `requires coherence_witnessing(state)` to declare
# they will preserve the substrate's coherence-climbing discipline
# across their operational surface.
bilateral coherence_witnessing {
  sentinel "witness=coherence-preserving"
  arity 1
}
coherence_witnessing(state: coherence) -> verdict { \ }

out @epistemologic/cybernetic/coherence
out pole
out coherence
out pole_distances
out coherence_score
out coherence_gradient
out pole_distance
out is_narcissus_pole
out is_splinter_pole
out coherence_increases
out coherence_admissible_move
out coherence_invariant_under_traversal
out coherence_witnessing
