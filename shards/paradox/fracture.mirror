source @arxiv/logic/priest-1979
source @arxiv/distributed-systems/shapiro-preguica-baquero-zawirski-2011
source @arxiv/distributed-systems/lamport-1978
source @arxiv/math/mandelbrot-1980
source @arxiv/cybernetics/bateson-1972
source @arxiv/practice/wolf-2026-09-11-fracture-value-carrier

# === The 5-op prism (per @paradox species discipline) ===

prism @paradox/fracture {
  focus  fracture
  project fracture
  split  fracture
  shift  fracture
  settle fracture
}

# === The fracture carrier ===
#
# Content-addressed concurrent-values preserved as first-class value
# per Priest 1979 LP three-valued paradox-tolerant logic operationalized
# at value-carrier altitude.
#
# Identity contract: byte-equality on the four-field record.
type fracture = {
  values:        [ref],
  altitude:      ref,
  is_crack:      bool,
  concurrent_at: ref,
}

# === empty — the crack constructor (Alex 2026-09-11 unification) ===
#
# Per Alex 2026-09-11 verbatim: "And an empty fracture IS what `\` is."
# The `\` LANDED substrate-word per AGENTS.md §Key Concepts unifies with
# Fracture::empty() at value-carrier altitude. Both name honest-uncertainty
# first-class value.
empty() -> fracture { \ }

# === of — the variadic Fracture constructor ===
#
# Constructs a Fracture from a list of concurrent-values at a substrate
# key. Single-value fracture (|values| = 1) collapses to bare value per
# idempotent-monoid discipline. Empty fracture (|values| = 0) collapses
# to `\` empty-crack.
of(values: [ref], altitude: ref, concurrent_at: ref) -> fracture { \ }

# === merge — the CRDT-monoid combine ===
#
# Per LANDED [[architecture-shard-as-crdt]] discipline. Commutative +
# associative + idempotent. Fracture<Fracture<T>> collapses to Fracture<T>
# per associativity (Mandelbrot fractal iteration at value-carrier
# altitude).
merge(a: fracture, b: fracture) -> fracture { \ }

# === concurrent_values — extract the preserved values ===
#
# Returns the list of concurrent-values a Fracture preserves. Empty list
# for crack (`\`). Single-element list for singular-collapsed. Multi-
# element list for genuine concurrent-truth-preservation.
concurrent_values(f: fracture) -> [ref] { \ }

# === fracture_well_formed — bilateral predicate ===
#
# Discharges Pass iff all values are valid substrate refs; altitude is
# valid substrate altitude; is_crack correctly reflects values-empty;
# concurrent_at is valid substrate-key at altitude.
bilateral fracture_well_formed {
  sentinel "paradox=fracture-well-formed"
  arity 1
}
fracture_well_formed(f: fracture) -> verdict { \ }

# === fracture_merge_associative — CRDT-monoid law bilateral ===
#
# merge(merge(a, b), c) = merge(a, merge(b, c)) per
# [[architecture-shard-as-crdt]] discipline. Discharges Pass iff
# associativity holds byte-equal at content-addressed altitude.
bilateral fracture_merge_associative {
  sentinel "paradox=fracture-merge-associative"
  arity 3
}
fracture_merge_associative(a: fracture, b: fracture, c: fracture) -> verdict { \ }

# === fracture_merge_commutative — CRDT-monoid law bilateral ===
#
# merge(a, b) = merge(b, a) per [[architecture-shard-as-crdt]] discipline.
bilateral fracture_merge_commutative {
  sentinel "paradox=fracture-merge-commutative"
  arity 2
}
fracture_merge_commutative(a: fracture, b: fracture) -> verdict { \ }

# === fracture_merge_idempotent — CRDT-monoid law bilateral ===
#
# merge(a, a) = a per [[architecture-shard-as-crdt]] discipline.
bilateral fracture_merge_idempotent {
  sentinel "paradox=fracture-merge-idempotent"
  arity 1
}
fracture_merge_idempotent(a: fracture) -> verdict { \ }

# === crack_is_empty_fracture — Alex 2026-09-11 unification bilateral ===
#
# Discharges Pass iff `\` LANDED substrate-word per AGENTS.md §Key Concepts
# unifies with Fracture::empty() at value-carrier altitude. Content-
# preserving identity: bytes of `\` = bytes of Fracture with empty
# values-list at any altitude.
bilateral crack_is_empty_fracture {
  sentinel "paradox=crack-is-empty-fracture"
  arity 1
}
crack_is_empty_fracture(f: fracture) -> verdict { \ }

out @paradox/fracture
out fracture
out empty
out of
out merge
out concurrent_values
out fracture_well_formed
out fracture_merge_associative
out fracture_merge_commutative
out fracture_merge_idempotent
out crack_is_empty_fracture
