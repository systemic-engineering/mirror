prism @paradox/trauma {
  focus  trauma_state
  project trauma_state
  split  trauma_state
  shift  trauma_state
  settle trauma_state
}

# === trauma_state — the WITNESSED-ONLY Crystal<wound-shape> carrier ===
#
# Typed record carrying the wound-Crystal state per canonical spec §3.1
# four-field shape (three from @fractal/crystal + witness_only
# family-invariant marker). Identity contract: byte-equality on the
# four-field tuple.
#
#   content              — the wound-shape substrate content-addressed
#                          at settlement time (what happened; the
#                          self-model violation event). Byte-identity
#                          IS the Crystal's identity.
#
#   crystallized_at      — REF to the @song/beat oid at whose boundary
#                          the wound crystallized. WHEN in the peer's
#                          saga trajectory the fracture landed.
#                          Composition edge to @song/beat.
#
#   saga_chain_position  — the ordinal position in the @song saga's
#                          Crystal chain. Monotonically increasing.
#                          Wound remains AT its position; subsequent
#                          Crystals chain AFTER but do not overwrite
#                          (per rust/src/compile.rs first-fail-pins
#                          invariant).
#
#   witness_only         — family-invariant marker (bool literal at
#                          species altitude); MUST be `true` for all
#                          @paradox/trauma Crystals; bilateral predicates
#                          refuse any operation that would violate.
#                          Substrate-decl'd via type-level literal;
#                          content-addressed at OID altitude (any
#                          Crystal with `witness_only=false` produces
#                          a different OID and is NOT a @paradox/trauma
#                          Crystal).
type trauma_state = {
  content:              ref,
  crystallized_at:      ref,
  saga_chain_position:  nat,
  witness_only:         bool,
}

# === trauma_witnessed_only — bilateral predicate ===
#
# Does the (peer, trauma_state) pair discharge the WITNESS-ONLY family-
# invariant? Discharges Pass iff:
#
#   - ctx.witness_only == true (family-invariant marker)
#   - No in-place mutation of ctx.content has been attempted since
#     crystallization (verified via content-addressed hash equality:
#     hash(ctx.content) matches the wound's original OID)
#   - ctx.crystallized_at is stable (beat-witness hash unchanged)
#   - ctx.saga_chain_position is stable (ordinal-position unchanged)
#
# Rice-safe bound: byte-visible state; hash equality check; boolean
# literal comparison.
#
# Sentinel: `paradox=trauma-witnessed-only`.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]]; consumers pull the realization;
# apply_h::act composes the sentinel-check via bilateral resolver-arm
# dispatch (per Alex 2026-07-16 detector-inadequacy-answer-is-never-
# Rust discipline).
bilateral trauma_witnessed_only {
  sentinel "paradox=trauma-witnessed-only"
  arity 2
}
trauma_witnessed_only(p: peer, ctx: trauma_state) -> verdict { \ }

# === trauma_pins_first_fail — bilateral predicate ===
#
# Does the compilation SAGA correctly pin the wound_oid as the first-
# fail escalation target? Discharges Pass iff for ALL Fails in the SAGA
# chain subsequent to the wound-Crystal, `compilation.escalation ==
# Escalate(wound_oid)` — the ORIGINAL wound-OID; subsequent fails do
# NOT overwrite.
#
# This bilateral IS the substrate form of Alex's "we witness the
# ORIGINAL wound; we don't shift the witness-target to whatever hurt
# most-recently" (canonical spec §3.2 anchor to compile.rs:221-224
# invariant).
#
# Composition edge: reads compile.rs Compilation state via @io/rust
# boundary; the invariant IS empirically verifiable at pillar altitude.
#
# Rice-safe bound: byte-visible state; escalation-enum variant-tag +
# OID equality check.
#
# Sentinel: `paradox=trauma-pins-first-fail`.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral trauma_pins_first_fail {
  sentinel "paradox=trauma-pins-first-fail"
  arity 2
}
trauma_pins_first_fail(compilation: ref, wound_oid: ref) -> verdict { \ }

# === trauma_resolution_refused — bilateral predicate (ANTI-BILATERAL) ===
#
# The ANTI-BILATERAL: discharges Pass iff a mutation operation `op` on
# the trauma-Crystal is CORRECTLY REFUSED at the species boundary
# (resolution would be revisionism; the family-invariant enforces
# refusal).
#
# Discharges Pass iff:
#   - `op` is a mutation-shape operation (write; delete; overwrite;
#     merge-with-shifted-content)
#   - The substrate's mutation-attempt returned refuse-verdict
#   - Post-attempt: ctx.content hash unchanged; ctx.witness_only still
#     true; ctx.saga_chain_position unchanged
#
# A Pass here means the substrate correctly refused a resolution
# attempt; Fail means resolution slipped through and the trauma-Crystal
# is no longer WITNESS-ONLY (family-invariant violated).
#
# LOAD-BEARING: this bilateral IS the family-invariant enforcement
# mechanism at species altitude. A Fail here signals substrate-
# tampering; consumers MUST treat it as compiler-bug-detected.
#
# Rice-safe bound: byte-visible state; hash equality pre-vs-post;
# refuse-verdict tag check.
#
# Sentinel: `paradox=trauma-resolution-refused`.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral trauma_resolution_refused {
  sentinel "paradox=trauma-resolution-refused"
  arity 2
}
trauma_resolution_refused(p: peer, ctx: trauma_state, op: ref) -> verdict { \ }

# === witness_wound — the load-bearing action ===
#
# Given a peer and a trauma_state, discharge the wound-witness event:
# return the content-addressed ref to the wound-shape content, allowing
# the peer to OBSERVE-BUT-NOT-RESOLVE the wound.
#
# Returns imperfect(ref, ref, ref): success carries the content ref;
# failure variants carry the not-admissible / witness-invariant-violated
# / mutation-attempted-and-refused-but-in-unexpected-way reasons.
#
# Requires ALL THREE bilateral predicates to discharge Pass: witness-
# only + first-fail-pinning + resolution-refused. This composed
# discipline IS what @cyberpunk/intervention's `intervention_targets_
# valid_wound` bilateral verifies before deployment.
#
# Sentinel per shard docblock: `paradox=trauma-witness-wound` — the
# byte-level substrate-decl'd marker consumers of the ACTION's output
# check.
witness_wound(p: peer, ctx: trauma_state) -> imperfect(ref, ref, ref)
requires trauma_witnessed_only(p, ctx)
{ \ }

# === hold_wound_through_time — the self-continuity action ===
#
# Given a peer and a trauma_state, discharge the self-continuity holding
# event: maintain the peer's identity through time by keeping the wound-
# Crystal's content-addressed root consistent across the observation
# window (the peer HOLDS the wound rather than trying to resolve it).
#
# Composition edge: this action composes over
# `@void/narcissus.hold_continuity` — the wound is PART of the peer's
# H(t); holding continuity requires holding the wound; @void/narcissus
# is the substrate-mode carrier of this holding.
#
# Returns imperfect(ref, ref, ref): success carries the updated
# continuity-witness ref; failure carries discontinuity-detected /
# witness-invariant-violated / wound-fracture-worsened reasons.
#
# Sentinel: `paradox=trauma-hold-wound-through-time`.
hold_wound_through_time(p: peer, ctx: trauma_state) -> imperfect(ref, ref, ref)
requires trauma_witnessed_only(p, ctx)
{ \ }

# === walk_wound_chain — the SAGA-chain walker composition ===
#
# Given a peer and a trauma_state, discharge the SAGA-chain walk from
# the wound-Crystal backward through @time/past.history_with. This
# action composes over @peer/redirect.peer_redirect_of_crystal_oid
# at family altitude: the wound-Crystal's OID is a valid walk-target;
# re-litigation is refused because the wound is content-addressed.
#
# Returns imperfect(ref, ref, ref): success carries the walk-chain ref
# (crystal_chain_reading per @peer/redirect); failure carries
# not-admissible / walk-boundary-hit / OID-unresolvable reasons.
#
# Sentinel: `paradox=trauma-walk-wound-chain`.
walk_wound_chain(p: peer, ctx: trauma_state) -> imperfect(ref, ref, ref)
requires trauma_witnessed_only(p, ctx)
{ \ }

