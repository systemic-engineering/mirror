prism @glue {
  focus correspondence
  project correspondence
  split correspondence
  shift correspondence
  settle correspondence
}

# === The morphism carrier ===
#
# A typed record per [[feedback-no-bare-types]] naming a single
# translation surface between two prisms (spectral triples). The
# morphism IS the substrate-decl atom of @glue; each correspondence
# admits a finite (possibly singleton) family of morphisms; the
# correspondence's restriction selects the admissible subset; @fate
# picks one morphism within that subset when translation fires.
#
# - `kind`               the typed ref naming the morphism class
#                        (e.g., `@arxiv/math/kasparov-1981.kk_cycle`,
#                        `@cascade/compile`, `@spectral/metalogue/
#                        tomm.transmit`); determines the Mesland-
#                        category morphism shape.
# - `source_signature`   the typed shape of the source-side input
#                        the morphism consumes; structurally bound
#                        to the source_prism's algebra A_source.
# - `target_signature`   the typed shape of the target-side output
#                        the morphism produces; structurally bound
#                        to the target_prism's algebra A_target.
# - `differential`       the ref naming the morphism's differential
#                        operator (the D_E in Mesland's (E, D_E, φ)
#                        KK-cycle data); per spec §3.3 of spectral-
#                        metalogue.md this IS the [D_F, a] commutator
#                        the morphism issues across the correspondence.
#
# Identity contract: byte-equality on (kind, source_signature,
# target_signature, differential). Two morphisms with byte-equal
# fields ARE the same morphism under content-addressing.
type morphism = {
  kind:              ref,
  source_signature:  ref,
  target_signature:  ref,
  differential:      ref,
}

# === The correspondence carrier ===
#
# The Mesland correspondence record. Per Mesland 2013: a
# correspondence from triple T1 to triple T2 is a triple (E, D_E,
# φ) where E is an (A_T1, A_T2)-correspondence, D_E is an unbounded
# operator on E, and φ is a ∗-homomorphism A_T1 → End(E). The
# substrate-altitude lift carries this structure as a typed record.
#
# - `source_prism`       the ref naming the source spectral triple
#                        (the source-side prism whose state the
#                        translation consumes); per Mesland's T1.
# - `target_prism`       the ref naming the target spectral triple
#                        (the target-side prism whose state the
#                        translation produces); per Mesland's T2.
# - `morphism_kind`      the typed ref naming the morphism class
#                        admissible between source and target; sibling
#                        shape to the morphism.kind field; per
#                        [[feedback-no-bare-types]].
# - `restriction`        the typed restriction surface defining
#                        which morphisms within morphism_kind are
#                        admissible for this correspondence; the
#                        structural witness that downstream @fate
#                        rolls cannot land outside the typing.
#                        Sibling shape to @fate's restricted_state_
#                        space carrier; the correspondence's
#                        restriction IS @fate's space when @glue
#                        consults @fate.
#
# Identity contract: byte-equality on (source_prism, target_prism,
# morphism_kind, restriction). Two correspondences with byte-equal
# fields ARE the same correspondence under content-addressing.
type correspondence = {
  source_prism:    ref,
  target_prism:    ref,
  morphism_kind:   ref,
  restriction:     restricted_state_space,
}

# === The translation_outcome carrier ===
#
# The typed result of @glue applying a morphism via @fate. The
# outcome carries the translated payload + the witness data
# documenting WHICH morphism @fate selected. Lands as a crystal in
# the @bauchladen tray under `@fate/algebra/morphism` per spec §5
# of `bauchladen-autopoietic-fate.md` (the @fate.algebra path-
# namespace; morphism-selection crystals).
#
# - `correspondence`     the ref of the correspondence the translation
#                        was performed under (the structural witness
#                        of the typing surface).
# - `selected_morphism`  the OID of the morphism @fate selected from
#                        the correspondence's admissible set; sibling
#                        shape to @fate's dice_roll.selected_oid.
# - `payload`            the translated payload; the substrate ref
#                        naming the target-side state the morphism
#                        produced from the source-side input.
# - `transparency`       the residual opacity per @glass's
#                        `transparency<correspondence>` carrier;
#                        reports any opacity introduced by the
#                        translation (e.g., loss-lens residuals when
#                        the morphism is a @cascade species; bounded-
#                        commutator residuals when the morphism is a
#                        @spectral/metalogue/tomm species).
#
# Identity contract: byte-equality on (correspondence, selected_
# morphism, payload). Two translation_outcomes with byte-equal
# fields ARE the same outcome under content-addressing.
type translation_outcome = {
  correspondence:    ref,
  selected_morphism: oid,
  payload:           ref,
  transparency:      transparency(correspondence),
}

# === propose — enumerate admissible morphisms between two prisms ===
#
# Given a source prism ref and a target prism ref, returns the list
# of correspondences admissible between them. The enumeration is
# typed: each returned correspondence carries the (morphism_kind,
# restriction) tuple specifying which morphisms within the kind are
# admissible.
#
# Multiple correspondences may exist between the same (source,
# target) pair — this is the Mesland-category multi-morphism
# structure (per Mesland 2013 §3). The propose action returns the
# full family; downstream @fate consultation via translate selects
# one morphism within one correspondence.
#
# Body discharges per-realisation at the morphism boundary. Same
# shape as @fate.roll, @autopoietic.tick, @bauchladen.crystallize
# (declarative obligation discharged at the species boundary).
propose(source: ref, target: ref) -> [correspondence] { \ }

# === translate — apply the correspondence via @fate ===
#
# THE LOAD-BEARING ACTION. Given a correspondence + a payload,
# consults @fate to select WHICH morphism within the correspondence's
# admissible set to apply; applies the selected morphism to the
# payload; returns the translation outcome wrapped in @glass's
# imperfect carrier (the @io-boundary discipline; per
# [[architecture-alignment-as-boundary-mathematics]]).
#
# The five-step structural form per `bauchladen-autopoietic-fate.md`
# §4.5:
#
#   1. The correspondence carries (source_prism, target_prism,
#      morphism_kind, restriction); the restriction defines the
#      typed @fate algebra A.
#   2. @glue invokes @fate.roll(restriction, hole) where hole is
#      derived from (payload, target_signature, altitude).
#   3. @fate's dice roll selects one morphism's OID from A within
#      the restriction's typed bound (the dice cannot land outside
#      the typing per @fate.dice_roll_constrained).
#   4. @glue applies the selected morphism to the payload; the
#      morphism's differential operator computes the target-side
#      output.
#   5. The translation_outcome is wrapped in imperfect (residual
#      opacity surfaced via transparency<correspondence>); the
#      outcome lands as a crystal in the @bauchladen tray under
#      `@fate/algebra/morphism`.
#
# The composition with @fate is structurally non-trivial: @glue
# does NOT compute the translation directly; @glue carries the
# typed surface; @fate picks the morphism. This is what makes
# @glue.translate distinct from a deterministic compile or a pure
# function — the underdetermined morphism selection is the
# substrate-pull-honest reading of the morphism-category structure.
#
# Body discharges per-realisation at the morphism boundary; the
# realisation MUST honor the translation_uses_fate(translate)
# requires obligation — the action invokes @fate, not a direct
# deterministic compute.
translate(c: correspondence, payload: ref) -> imperfect<translation_outcome, ref, transparency(correspondence)>
requires morphism_well_typed(c)
requires translation_uses_fate(translate)
requires restriction_preserved(c, payload)
{ \ }

# === compose — categorical composition of correspondences ===
#
# The Kasparov intersection product at the substrate altitude. Given
# two correspondences c1 (source_prism → middle_prism) and c2
# (middle_prism → target_prism), returns the composed correspondence
# c2 ∘ c1 (source_prism → target_prism).
#
# The composition is NON-COMMUTATIVE in general — per the
# curvature 2-form Ω = dω + ½[ω, ω] (curvature-and-tomm.md §5),
# the [ω, ω] cross-term that lives where altitude transitions
# happen makes c2 ∘ c1 ≠ c1 ∘ c2 in general. This is the structural
# reason categorical composition matters at the substrate altitude:
# the substrate's morphism family carries non-trivial composition
# structure that downstream prisms (in particular @kintsugi for
# transformation chains and @reflection for altitude transitions)
# must respect.
#
# The composed correspondence carries the composed restriction:
# the morphism @fate selects when @glue.translate is invoked on
# (c2 ∘ c1, payload) must satisfy BOTH c1.restriction and c2.
# restriction. The substrate-pull-honest reading: composition
# tightens the typing surface, never relaxes it.
#
# Body discharges per-realisation at the morphism boundary; the
# realisation MUST honor the morphism_well_typed predicate on the
# returned composed correspondence (the composition cannot produce
# an ill-typed correspondence).
compose(c1: correspondence, c2: correspondence) -> correspondence
requires morphism_well_typed(c1)
requires morphism_well_typed(c2)
{ \ }

# === The requires obligations ===
#
# Downstream shards declare bilateral agreement (per recognition
# #37, the Pask-agreement reading of `requires`) with the @glue
# discipline by writing the obligations below. The bilateral
# commitment: the @glue-importing prism commits to discharging
# the obligations; the consumer commits to surfacing violations
# at the species boundary.

# Per Mesland 2013 §3: a correspondence (E, D_E, φ) is
# mathematically valid iff E is an (A_T1, A_T2)-correspondence,
# D_E is an unbounded operator on E, and φ is a ∗-homomorphism
# A_T1 → End(E). The substrate-altitude form: the morphism_kind
# admits morphisms whose source_signature is in A_T1 and whose
# target_signature is in A_T2; the restriction's algebra slot
# matches source_prism's algebra; the restriction's hilbert slot
# matches target_prism's state space. Inheritor shards discharge
# by verifying the structural alignment.
morphism_well_typed(c: correspondence) -> verdict { \ }

# Per spec §4.5 of `bauchladen-autopoietic-fate.md`: @glue's
# translate action invokes @fate (not a direct deterministic
# compute). The substrate-pull-honest discipline that distinguishes
# @glue from a function; the translation MUST consult @fate to
# select the morphism within the correspondence's admissible set.
# Inheritor shards discharge by verifying the translate action's
# body invokes @fate.roll (or an equivalent species-altitude @fate
# consultation).
translation_uses_fate(action: ref) -> verdict { \ }

# Per Mesland's correspondence axioms + the substrate's typed
# restriction surface: the translation must respect the
# correspondence's restriction. The payload at the source side
# must be in the restriction's algebra A_source; the morphism
# selected by @fate must respect the γ + J + tray symmetry
# restrictions (per recognitions #101 + #102). Inheritor shards
# discharge by verifying the payload + morphism selection are
# within the typed bound; the obligation closes the substrate-
# decl loop that @fate.dice_roll_constrained opened — @fate
# checks the dice is in the restricted state space; @glue
# checks the payload + restriction are mutually coherent.
restriction_preserved(c: correspondence, payload: ref) -> verdict { \ }

# === The glue_witnessing inheritance predicate ===
#
# `glue_witnessing(c)` is the predicate consumer shards name in a
# `requires` clause to declare bilateral commitment (per recognition
# #37, the Pask-agreement reading of `requires`) that the
# correspondence `c` IS a valid @glue morphism — i.e., the
# correspondence satisfies all three obligations above conjointly:
# morphism_well_typed + translation_uses_fate + restriction_preserved.
#
# Sibling to:
#   - `fate.fate_witnessing(roll)` (the dice-roll inheritance
#     predicate this shard's translate actions discharge via the
#     translation_uses_fate clause).
#   - `autopoietic.autopoietic_closure_holds(prism)` (the prism-
#     class inheritance predicate this shard's instances honor
#     via `in @autopoietic`).
#   - `bauchladen.bauchladen_witnessing(crystal)` (the crystal-
#     altitude inheritance predicate this shard's emitted
#     translation_outcomes honor transitively via the @fate/
#     algebra/morphism crystallization).
#   - `cascade.cascade_well_defined(lens, source, p)` (the cross-
#     language @glue species inheritance predicate; @cascade
#     species discharge cascade_well_defined as the species-
#     altitude form of glue_witnessing).
#
# Forward-promised inheritors:
#
#   - `@spectral/metalogue/tomm` (the spectral-altitude species
#     per recognition #100): Tomm probes ARE @glue species at the
#     spectral-metalogue altitude; the tomm.transmit action IS
#     @glue.translate at the spectral altitude; the species
#     discharges glue_witnessing for each transmit.
#   - `@cascade/code/<src>/<tgt>` species (the cross-language @glue
#     species per recognition #95): @cascade.compile IS
#     @glue.translate at the code-translation altitude; each
#     @cascade species discharges glue_witnessing for each compile.
#   - `@cascade/code/formal/prose` (yesterday's P4 437d061): the
#     formal/prose @glue species; the formal↔prose morphism IS
#     @glue.translate at the mid-altitude code ↔ NL boundary;
#     discharges glue_witnessing for each formal/prose transit.
#   - `@glue/kintsugi/<source>/<target>` (forward-promised):
#     @kintsugi's per-step morphism selections ARE @glue.translate
#     at the transformation altitude; the @glue × @kintsugi × @fate
#     composition at P8 grounds @io/algebra.
#   - `@glue/reflection/<source-altitude>/<target-altitude>`
#     (forward-promised per [[architecture-reflection-thinks-in-
#     spectral-questions]]): Reflection's altitude selection IS
#     @glue.translate at the meta-pipeline altitude.
#   - `@glue/pack/<from-agent>/<to-agent>` (forward-promised per
#     recognition #103): Pack-handoffs ARE @glue.translate at the
#     runtime-agent altitude; the Pack-Mesland category's morphisms
#     discharge glue_witnessing.
#
# No `requires glue_witnessing(...)` clauses are added at THIS
# shard. The family-root declares the predicate; consumers add
# the clauses when they pull. Per [[feedback-craft-not-deliver]]
# the species sub-shards follow when consumers pull.
glue_witnessing(c: correspondence) -> verdict { \ }

out @glue
out morphism
out correspondence
out translation_outcome
out propose
out translate
out compose
out morphism_well_typed
out translation_uses_fate
out restriction_preserved
out glue_witnessing
