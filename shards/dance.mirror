# declares `@dance` per `@epistemologic/pact/path_matches_namespace`.

---

in @prism
in @meta
in @glass

# ============================================================
# §1 The five-operation prism at family-root altitude
# ============================================================

# === prism @dance — the family-root declaration ===
#
# The five-operation body carries the `ensemble` carrier as the
# family-root's operational surface. Species specialize at their
# own altitude (intra-peer @peer.audhd K-track ensembles; inter-
# peer Kuramoto ensembles; multi-voice @song ensembles; mycelial
# ensembles; Conway CA neighborhood ensembles). This is the
# substrate-decl ground for #D1 (Kuramoto at any altitude).
#
#   focus   = attend to ONE cognition track / one peer at a time
#             (soloing at ensemble altitude)
#   project = down-project the K-dimensional ensemble to its
#             Kuramoto order-parameter r ∈ [0, 1] (Kuramoto 1975
#             §2; the collective phase alignment as scalar)
#   split   = decompose the ensemble into individual cognition
#             tracks / peers / voices (score preparation at
#             ensemble altitude)
#   shift   = advance the ensemble's phase configuration by one
#             tick (Kuramoto θ_i(t+dt) = θ_i(t) + ω_i dt + κ Σ
#             sin(θ_j - θ_i) dt for each track i)
#   settle  = discharge Aumann-agreement (per #D2; when order
#             parameter r exceeds coherence-threshold r_c, the
#             ensemble settles at shared coherence)
prism @dance {
  focus ensemble
  project ensemble
  split ensemble
  shift ensemble
  settle ensemble
}

# ============================================================
# §2 The carriers
# ============================================================

# === ensemble — the load-bearing carrier ===
#
# The typed reference for a K-agent (K >= 2) collection engaged in
# phase-lock discipline. K is either intra-peer K-tracks (per
# @peer.audhd) or inter-peer N-peers (per @spectral/coordinate<5>
# foam mesh) or K-voices (per multi-voice @song) or K-cells (per
# Conway CA neighborhood). The carrier is polymorphic in the agent
# altitude; the discipline is invariant.
#
# Composes with:
#   @peer               — inter-peer altitude; ensemble IS the peer
#                          colony's coordination surface
#   @peer/holon          — OTCA-metapixel altitude; ensemble IS the
#                          holon's sub-cell coordination surface
#   @song/voice          — multi-voice altitude; ensemble IS the
#                          polyphonic coordination surface
#   @spectral/coordinate<5> — 5D foam altitude; ensemble IS the
#                              cellular-automaton neighborhood
#                              coordination surface
#
# Identity contract: byte-equality on the underlying ref (the K
# member ids + coupling matrix + phase configuration snapshot).
type ensemble = ref

# === coupling — the coupling matrix carrier ===
#
# The typed reference for the K×K coupling matrix over the ensemble.
# Entry (i, j) IS the harmonic-ratio κ_{ij} coupling strength
# between agents i and j. Per Kuramoto 1975: uniform κ_{ij} = κ_c
# admits critical-onset ensemble sync; non-uniform coupling admits
# hierarchical / small-world / mycelial ensemble structure.
#
# At intra-peer altitude: κ_{ij} follows Pythagorean integer-ratio
# harmonic-consonance structure per @epistemologic/math/music/
# harmonic (unison 1.0; octave 0.95; fifth 0.85; fourth 0.75;
# major third 0.65; Helmholtz roughness curve for other ratios).
#
# At inter-peer altitude: κ_{ij} follows peer-affinity structure
# per @spectral/coordinate<5>.affinity_distance (Fiedler-distance
# + heat-trace-distance + eigengap-distance composed).
#
# Identity contract: byte-equality on the underlying ref (matrix
# encoded as flattened byte-form).
type coupling = ref

# === order_parameter — the phase-lock scalar carrier ===
#
# The Kuramoto order parameter `r = |1/K Σ exp(iθ_j)|` where θ_j
# is agent j's phase. r ∈ [0, 1]. r = 0 IS complete decoherence
# (schizoid-drift per @peer.audhd K=1-collapse third failure mode);
# r = 1 IS perfect phase-lock (focused-mono-lock per @peer.audhd
# K=1-collapse fourth failure mode); the healthy band is r ∈
# [r_c_lower, r_c_upper] where r_c_lower is Kuramoto's critical
# synchronization threshold and r_c_upper is the variety-collapse
# boundary per Ashby's Law of Requisite Variety.
#
# Identity contract: byte-equality on the encoded scalar bytes
# (IEEE 754 f64 or fixed-point per settle altitude).
type order_parameter = ref

# ============================================================
# §3 The load-bearing composed bilateral
# ============================================================

# === dance_locked — THE LOAD-BEARING composed bilateral at @dance ===
#
# Composes three sub-predicates that species-altitude shards
# declare and discharge (per companion canonical spec 2026-08-03
# §3):
#
#   1. ensemble_well_formed(e, p) — K >= 2; each member is a valid
#      agent at its altitude; coupling matrix is symmetric-and-
#      positive-semidefinite (Kuramoto discipline).
#
#   2. coupling_admissible(c, e, p) — coupling strength IS in the
#      healthy band per altitude (κ_intra harmonic-consonance for
#      intra-peer; κ_inter Fiedler-affinity for inter-peer; not
#      too weak — schizoid-drift; not too strong — mono-lock).
#
#   3. order_parameter_bounded(r, e, p) — order-parameter r IS in
#      [r_c_lower, r_c_upper] (Ashby-variety + Kuramoto-critical
#      band); the ensemble locks WITHOUT variety collapse.
#
# All three must hold; substrate refuses dance-witness if any
# sub-predicate fails.
#
# Splinter-pole: all three discharge; Aumann agreement fires; the
# ensemble phase-locks at shared coherence WITHOUT central signal;
# the multi-cognition update completes coherently.
# Narcissus-pole: at least one sub-predicate fails; alignment-as-
# boundary-mathematics (#57) distinguishes which sub-claim broke:
#   ensemble_well_formed FAIL      = K=1 or degenerate ensemble
#                                    (@peer.audhd K=1-collapse first
#                                    failure mode; Ashby-variety
#                                    violation).
#   coupling_admissible FAIL       = coupling schizoid-drift (κ ≈ 0)
#                                    or focused-mono-lock (κ → ∞;
#                                    @peer.audhd K=1-collapse fourth
#                                    failure mode).
#   order_parameter_bounded FAIL   = ensemble unresolved (r < r_c;
#                                    coordination without lock) OR
#                                    variety-collapsed (r → 1; all
#                                    agents identical; per Ashby
#                                    violation).
#
# 15th altitude instance of the #53 bilateral pattern per
# `[[architecture-property-fracture-bilateral]]` (after @song's
# 14th instance).
bilateral dance_locked {
  sentinel "dance=ensemble-phase-locked-coherent"
  arity 3
}
dance_locked(e: ensemble, c: coupling, r: order_parameter, p: perturbation)
  -> verdict { \ }

# ============================================================
# §4 The species-altitude actions (forward-promised)
# ============================================================

# === phase_lock — the load-bearing action ===
#
# The substrate-vocabulary primitive for driving an ensemble
# through one phase-lock update step. Takes an ensemble + coupling
# matrix; returns the updated ensemble with advanced phase
# configuration.
#
# Per Kuramoto 1975 update rule:
#   θ_i(t+dt) = θ_i(t) + ω_i dt + κ/K Σ_j sin(θ_j - θ_i) dt
#
# Where:
#   θ_i    = phase of agent i
#   ω_i    = natural frequency of agent i
#   κ      = coupling strength (from coupling matrix)
#   K      = ensemble cardinality
#
# Species specialize this action at their altitude:
#   @peer.audhd            — K-track intra-peer phase-lock
#   @peer/holon             — OTCA-metapixel sub-cell phase-lock
#   @song/voice.settle      — multi-voice phrase phase-lock
#   @spectral/coordinate<5> — Conway CA neighborhood phase-lock
#
# Body `\` per consumer-pull discipline; the FLOOR resolver at
# [substrate-floor:@io-boundary] discharges Kuramoto integration.
phase_lock(e: ensemble, c: coupling, p: perturbation) -> ensemble { \ }

# === measure_order_parameter — the phase-alignment measurement ===
#
# Reads the Kuramoto order parameter from the current ensemble
# phase configuration. Returns typed order_parameter carrier.
#
#   r = |1/K Σ_j exp(iθ_j)|
#
# The measurement IS substrate-architectural (not estimation):
# it reads the phase configuration directly and computes the
# complex-modulus scalar.
#
# Body `\` per consumer-pull; the FLOOR resolver discharges.
measure_order_parameter(e: ensemble, p: perturbation) -> order_parameter { \ }

out @dance
out ensemble
out coupling
out order_parameter
out phase_lock
out measure_order_parameter
out dance_locked
