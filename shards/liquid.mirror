---

in @prism
in @meta
in @glass
in @epistemologic
in @epistemologic/liquid

# === liquid_lens — the parametric refinement lens carrier ===
#
# The typed carrier for one @liquid(@X) specialization. Per
# `[[feedback-no-bare-types]]` the operator's produce a typed lens,
# not a bare ref. Fields:
#
#   substrate  — the @X substrate the lens specializes to
#                 (ref to a family-root or species shard-decl).
#   theory     — the @epistemologic/liquid theory-carrier the lens
#                 composes refinements from (ref to the theory
#                 species-decl at `shards/epistemologic/liquid.
#                 mirror`).
#   qualifier_set
#              — the finite set Q of liquid_qualifiers the lens
#                 admits at the substrate's altitude. Per math §2.2
#                 Q_mirror = landed `@epistemologic/property/*` +
#                 `@epistemologic/pact/*` predicates (~40 as of
#                 2026-07-05); for other @X substrates the
#                 qualifier_set is specialization-specific.
type liquid_lens = {
  substrate:      ref,
  theory:         ref,
  qualifier_set:  ref,
}

# === compose — the @liquid(@X) composition action ===
#
# Per the parametric-lens discipline: given a substrate @X, produce
# a liquid_lens specializing @epistemologic/liquid theory to @X.
# The composition IS the operator's substrate-decl'd application.
# Body forward-promised per `[[feedback-craft-not-deliver]]`;
# discharge at the deferred-by-design canonical spec + spec-altitude
# landings.
compose(x: ref) -> liquid_lens { \ }

# === refine — lift a refinement predicate through the lens ===
#
# Given a liquid_lens (a specialized @liquid(@X)) and a
# refinement_predicate at the theory altitude, produce the
# substrate-specific refinement the lens carries. Body forward-
# promised.
refine(lens: liquid_lens, p: ref) -> ref { \ }

# === extract — pull refinement predicates FROM the substrate ===
#
# Given a liquid_lens (a specialized @liquid(@X)) and a substrate
# observation (a ref to bytes/state at the @X altitude), produce
# the refinement_predicate the substrate carries. This IS the
# recovery direction Alex 2026-07-17 named as `@liquid(@silicon)`
# for the extraction-from-binary novel discipline; more generally
# it names the recovery direction across all @liquid(@X) lenses.
# Body forward-promised; discharge at spec-altitude + empirical
# @liquid(@silicon) landing at future arc.
extract(lens: liquid_lens, observation: ref) -> ref { \ }

# === project — back-project refinements onto the substrate ===
#
# Given a liquid_lens and a refinement_predicate the lens carries,
# project the predicate ONTO the substrate view. Companion action
# to extract; when composed as `extract |> project` produces the
# @mirror/liquid.project(file, [ref]) → imperfect pattern at
# mirror altitude (Reed 2026-06-04 grammar-decl at
# `boot/std/mirror/liquid.mirror:27-28`). Body forward-promised.
project(lens: liquid_lens, p: ref) -> ref { \ }

out @liquid
out liquid_lens
out compose
out refine
out extract
out project
