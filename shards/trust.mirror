# === The 5-op prism inheriting @void basis ===
#
# Per Recognition #79 + shards/void.mirror §Composition inheritance
# discipline: every family-root inherits Void's 5-op basis; naming
# the inheritance below is what makes @trust a family-root at duality
# altitude.

prism @trust {
  focus  trust_chain_step
  project trust_chain_step
  split  trust_chain_step
  shift  trust_chain_step
  settle trust_chain_step
}

# === The trust_chain_step carrier ===
#
# Substrate-decl'd typed record naming the content-addressed
# authorization step at either altitude. Concrete instantiation
# deferred to species-decl per two-tick discipline (@trust/chain
# + @trust/ssh + @trust/passkey species forward-promised per
# canonical spec §12).
#
# Two well-known instantiations (per canonical spec §2 table):
#
# SSH-side:
#   step_oid          — git commit SHA-1/SHA-256
#   auth_proof        — ed25519 signature (opaque bytes at @io/crypto)
#   predecessor_oid   — parent commit OID (option; None at chain root)
#   content_root      — git tree OID
#
# Passkey/PRF-side:
#   step_oid          — spectral_state SHA-512 hash
#   auth_proof        — PRF output (HMAC-SHA-256 opaque bytes)
#   predecessor_oid   — previous spectral_state OID (option; None at
#                        genesis per bridge §"The Tick Button")
#   content_root      — (prev_state || prf_output || entropy) hash
#                        input triple
#
# Identity contract: byte-equality on the (step_oid, auth_proof,
# predecessor_oid, content_root) tuple. Fields typed `ref` at
# family-root altitude; species-decl'd refinement at @trust/ssh +
# @trust/passkey species.

type trust_chain_step = {
  step_oid:        ref,
  auth_proof:      ref,
  predecessor_oid: ref,
  content_root:    ref,
}

# === chain_terminates_at_root — the load-bearing bilateral ===
#
# The substrate-decl'd invariant every @trust chain traversal must
# discharge per canonical spec §5. Every chain-step's traversal MUST
# reach a @subject root within finite steps where each intermediate
# step is content-addressed + each transition is authorization-
# proof-verified + no cycle exists + root's actor_kind is admissible
# per SEL §1.
#
# Splinter-pole: the chain terminates at `root` within finite
# steps; each intermediate step is content-addressed; each transition
# is authorization-proof-verified (SSH signature via @io/crypto.
# ed25519_verify OR PRF output via @io/webauthn.verify_prf); no
# cycle exists; root's actor_kind is human_a (or historical_witness_r
# per subject.mirror §Landing 5+ deceased-ancestor discipline).
#
# Narcissus-pole: the chain claims termination at `root` but a
# step's content-hash doesn't verify OR the authorization proof is
# absent OR a cycle exists OR the terminating @subject-instance's
# actor_kind is not admissible.
#
# Rice-safe bound: reads only byte-visible state (content-hash
# comparison via @io/crypto, signature/PRF verification, chain-step
# tag traversal). No program-semantics inspection.
#
# Body discharges at species altitude (@trust/chain species forward-
# promised per canonical spec §12 forward-promise 1). `\`-obligation-
# blocked per [[feedback-craft-not-deliver]]; consumers pull the
# realization via apply_h::act bilateral resolver-arm dispatch.
#
# Sentinel per shard docblock: `trust=chain-terminates-at-<altitude>-
# root` where altitude ∈ {ssh, passkey}. Arity 2.

bilateral chain_terminates_at_root {
  sentinel "trust=chain-terminates-at-root"
  arity 2
}
chain_terminates_at_root(step: trust_chain_step, root: subject) -> verdict { \ }

