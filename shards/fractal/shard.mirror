# === The 5-op prism inheriting @void basis (Recognition #79) ===
#
# For @fractal/shard specifically:
#   focus shard_state    = identify the (address, query, target) tuple
#                           at which a shard was materialized
#   project shard_state  = deploy the materialization operation
#                           (query the possibility space; return the
#                           settled shard at the derived position)
#   split shard_state    = bifurcate query-space (different queries
#                           over the same target family may yield
#                           different sections; same query at
#                           different addresses yields different
#                           shards)
#   shift shard_state    = traverse the fractal self-similarity
#                           lattice: shards contain shards; a shift
#                           enters a sub-shard's coordinate frame
#   settle shard_state   = materialize the settled shard into the
#                           substrate store; content-addressed;
#                           immutable at species altitude

prism @fractal/shard {
  focus  shard_state
  project shard_state
  split  shard_state
  shift  shard_state
  settle shard_state
}

# === shard_state — the vessel-of-inference carrier ===
#
# Typed record carrying the settled inference output at species-decl
# altitude. Identity contract: byte-equality on the four-field tuple.
#
# The position is NOT an explicit field — position is DERIVED from
# the (target, through) pair. For a content-addressed request, the
# @<address> IS the position; the position_of morphism reads it
# from the query.
#
#   address              — REF to the shard's content-address in the
#                           @uuid/spectral 128-bit identity space.
#                           This IS the shard's byte-identity; two
#                           shards with the same address ARE the
#                           same shard by content-addressing. Per
#                           Alex 2026-07-23: for clearly content-
#                           addressed crystals, position may just be
#                           this @<address>.
#
#   target               — REF to the family-root the shard was
#                           inferred FOR. Names the shape-of-thing
#                           the @peer asked the substrate for
#                           ("give us something of that shape").
#                           Family-root altitude ref; the family
#                           may be @fractal/crystal (asking for a
#                           settled crystal), @sheaf-anything, or
#                           any substrate-decl'd family.
#
#   through              — REF to the @code/mq optical query that
#                           restricted the possibility space. The
#                           query's AST sub-tree (focus / project /
#                           split / shift / settle sub-nodes) IS
#                           the optical restriction. Empty query
#                           addresses the whole space; fully-
#                           content-addressed query returns a
#                           single point.
#
#   provenance           — REF to the crystallization witness chain:
#                           an ordered list of @uuid/spectral/time
#                           annotation-addresses naming the beats
#                           at which the shard was composed. The
#                           witness chain records who inferred +
#                           when + through which query; downstream
#                           consumers verify by walking the chain.
type shard_state = {
  address:      ref,
  target:       ref,
  through:      ref,
  provenance:   ref,
}

# === shard_content_addressed — bilateral predicate ===
#
# Does the (peer, shard_state) pair discharge content-addressing?
# Discharges Pass iff:
#
#   - ctx.address resolves via content-addressed lookup to a well-
#     formed @uuid/spectral 128-bit identity
#   - the hash of the shard's serialized content matches
#     ctx.address (byte-identity is enforced by content-addressing)
#   - two shards with the same ctx.address have byte-equal
#     shard_state records at every other field (content-addressing
#     is bijective on shard identity)
#
# Rice-safe bound: byte-visible state; content-addressed hash
# equality check. Sentinel: `fractal=shard-content-addressed`.
#
# LOAD-BEARING: this bilateral IS the content-addressing invariant
# at species altitude. A Fail here signals substrate-tampering or
# hash collision (@uuid/spectral space collision is astronomically
# unlikely given the 128-bit identity; a Fail signals substrate
# corruption).
bilateral shard_content_addressed {
  sentinel "fractal=shard-content-addressed"
  arity 2
}
shard_content_addressed(p: peer, ctx: shard_state) -> verdict { \ }

# === shard_is_sheaf_section — bilateral predicate ===
#
# Does the (peer, shard_state) pair discharge the sheaf-section
# invariant? Discharges Pass iff:
#
#   - ctx.target resolves to a family-root the substrate declares
#     as the shape-of-thing being inferred
#   - ctx.through resolves to a well-formed @code/mq query whose
#     optical restriction is admissible against ctx.target's
#     possibility space
#   - the shard IS a section of the sheaf whose base space is
#     ctx.target's possibility space and whose stalks are the
#     addressable crystals at each @<address>; the section
#     satisfies locality (the value at ctx.address is determined
#     by ctx.through's restriction) and gluing (compatible with
#     overlapping section restrictions)
#
# Composition edge: this bilateral consumes @subject/visibility/
# sheaf.section_admissible at the possibility-space sheaf altitude.
# The shard's sheaf-section role is declarative here; the
# operational discharge lands at Reed post-mint territory when
# @fractal/shard.materialize composes over the sheaf's section_at
# operation.
#
# Rice-safe bound: byte-visible state; content-addressed
# resolvability; typed-query well-formedness check. Sentinel:
# `fractal=shard-is-sheaf-section`.
bilateral shard_is_sheaf_section {
  sentinel "fractal=shard-is-sheaf-section"
  arity 2
}
shard_is_sheaf_section(p: peer, ctx: shard_state) -> verdict { \ }

# === shard_position_derived_from_query — bilateral predicate ===
#
# Does the (peer, shard_state) pair discharge the position-derivation
# invariant? Discharges Pass iff:
#
#   - the position_of morphism applied to ctx.through returns a
#     SpectralCoordinate<5> region whose address-set contains
#     ctx.address (the query addresses this shard)
#   - for content-addressed queries (queries whose optical
#     restriction resolves to a single @<address>), the returned
#     region is a single point equal to ctx.address (position IS
#     the address)
#   - the derivation is deterministic: identical queries return
#     identical positions (position-from-query is a total
#     function, not a random draw)
#
# Rice-safe bound: byte-visible state; morphism-output equality
# check; query AST inspection is bounded by query depth (queries
# are finite typed trees). Sentinel:
# `fractal=shard-position-derived-from-query`.
#
# LOAD-BEARING: this bilateral encodes Alex 2026-07-23 verbatim
# ("the position would be derived from the query") at substrate-
# decl altitude. Consumers can cite this in `requires` clauses to
# guarantee that position is not an independent parameter but a
# query-derived quantity.
bilateral shard_position_derived_from_query {
  sentinel "fractal=shard-position-derived-from-query"
  arity 2
}
shard_position_derived_from_query(p: peer, ctx: shard_state) -> verdict { \ }

# === materialize — the load-bearing action ===
#
# Given a peer, a target family-root, and a @code/mq optical query,
# discharge the materialize event: run the substrate's inference
# (@fate tournament over the query-restricted possibility space),
# crystallize the settled result, and emit a shard_state whose
# address is the content-address of the settled crystal, whose
# target and through match the inputs, and whose provenance carries
# the crystallization witness chain.
#
# Returns imperfect(shard_state, ref, ref): success carries the
# materialized shard_state; failure variants carry not-admissible /
# empty-query-result / target-not-declared / provenance-witness-
# missing reasons.
#
# Requires all three bilaterals to discharge Pass on the materialized
# shard_state (content-addressing + sheaf-section + position-derived
# invariants all hold on emit).
#
# Composes over prismqueer::Crystal at operational altitude (Reed
# post-mint territory). The `settle` sub-op of @code/mq is the
# crystallization boundary at which this action fires.
#
# Sentinel: `fractal=shard-materialize`.
materialize(p: peer, target: ref, through: ref) -> imperfect(shard_state, ref, ref)
requires shard_content_addressed(p, ctx)
requires shard_is_sheaf_section(p, ctx)
requires shard_position_derived_from_query(p, ctx)
{ \ }

# === address_of — the address projection action ===
#
# Given a peer and a shard_state, discharge the address-read event:
# return the @uuid/spectral 128-bit content-address of the shard.
# The address IS the shard's byte-identity; two calls with byte-
# equal shard_state records return byte-equal addresses.
#
# Returns imperfect(ref, ref, ref): success carries the address
# ref; failure carries not-admissible reasons (typically ctx not
# content-addressed).
#
# Sentinel: `fractal=shard-address-of`.
address_of(p: peer, ctx: shard_state) -> imperfect(ref, ref, ref)
requires shard_content_addressed(p, ctx)
{ \ }

# === sheaf_section_of — the sheaf-section projection action ===
#
# Given a peer and a shard_state, discharge the sheaf-section-read
# event: return the section_at_stalk carrier witnessing the shard's
# role as a section of the possibility-space sheaf.
#
# Composes over @subject/visibility/sheaf.section_at at the
# realisation layer: the returned section_at_stalk carries
# crystal_ref = ctx.address, sheaf_ref resolves to the possibility-
# space sheaf for ctx.target, and projected_value is the shard's
# materialized content.
#
# Returns imperfect(ref, ref, ref): success carries the section_at_
# stalk ref; failure carries not-admissible / sheaf-not-well-formed
# reasons.
#
# Sentinel: `fractal=shard-sheaf-section-of`.
sheaf_section_of(p: peer, ctx: shard_state) -> imperfect(ref, ref, ref)
requires shard_is_sheaf_section(p, ctx)
{ \ }

