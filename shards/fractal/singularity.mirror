# === The 5-op prism inheriting @void basis (Recognition #79) ===
#
# Per @void.mirror §Composition inheritance: every prism declaration
# `prism @X { focus/project/split/shift/settle X }` at species altitude
# declares "this species inherits Void's basis" — the five-op pattern
# IS the signature of Void's ancestry.
#
# For @fractal/singularity specifically:
#   focus singularity_state    = identify the observer + target pair
#                                 at which a collapse fires
#   project singularity_state  = deploy the collapse operation
#                                 (tree → Artifact; may write a
#                                 witness-Lens commit if optic_kind
#                                 is Lens; identity-clone if Iso)
#   split singularity_state    = bifurcate observer-space (different
#                                 observers → different commit SHAs;
#                                 same target OIDs at Iso; same Lens-
#                                 target OIDs at Lens)
#   shift singularity_state    = traverse the optic-kind lattice
#                                 (Iso → Lens → Prism → Traversal;
#                                 partial-measurement rungs forward-
#                                 promised)
#   settle singularity_state   = follow the Lens-target back to the
#                                 original tree; reconstruct Self from
#                                 the Artifact per settle(artifact)

prism @fractal/singularity {
  focus  singularity_state
  project singularity_state
  split  singularity_state
  shift  singularity_state
  settle singularity_state
}

# === singularity_state — the observer/target/optic carrier ===
#
# Typed record carrying the singularity-observation state. Identity
# contract: byte-equality on the three-field tuple.
#
# Note: the source `Fractal<E, H>` and Committer types at fragmentation
# altitude are expressed here at ref-altitude with content-addressed
# dispatch (mirror's grammar carries type-generic content at ref-
# altitude per @fractal/crystal precedent). Downstream Rust consumers
# at `rust/fractal/src/singularity.rs` (Reed post-mint territory)
# express the concrete types as Rust generics per the fragmentation
# source shape.
#
#   observer     — REF to the observer (the Committer at Lens altitude;
#                   trivial/absent at Iso altitude where collapse=clone
#                   and no witness metadata is written). Composition
#                   edge: MARA doctrine (witnessed=committer-in-hash-
#                   not-tree). At Iso: MAY be Oid::GENESIS (no observer;
#                   identity collapse). At Lens: MUST resolve to a
#                   well-formed committer-ref.
#
#   target_ref   — REF to the substrate being observed (the Fractal<E, H>
#                   tree at fragmentation altitude). Content-addressed;
#                   byte-identity IS the target's identity. The Lens-
#                   target OID that `settle` follows back.
#
#   optic_kind   — REF to the optic-hierarchy discriminator naming
#                   which rung of the Iso/Lens/Prism/Traversal ladder
#                   this observation-instance inhabits. Byte-equality
#                   on the discriminator ref determines the
#                   information-recovery bound this instance discharges.
type singularity_state = {
  observer:    ref,
  target_ref:  ref,
  optic_kind:  ref,
}

# === singularity_collapse_is_deterministic — bilateral predicate ===
#
# Does the (peer, singularity_state) pair discharge collapse-
# determinism? Discharges Pass iff:
#
#   - Two collapse invocations at the same (observer, target_ref,
#     optic_kind) tuple produce byte-equal Artifact-refs (content-
#     addressed collapse is replay-stable)
#   - The Lens-target OID (if optic_kind == Lens) matches the target_ref
#     (Lens-target IS the observed substrate; observer-independent)
#   - No non-deterministic sources are consumed by the collapse
#     operation (timestamps at Lens altitude are supplied by the
#     WitnessedSingularity carrier's `timestamp` field; NOT sampled
#     at collapse-time)
#
# Rice-safe bound: byte-visible state; content-addressed hash equality
# check. Sentinel: `fractal=singularity-collapse-deterministic`.
#
# LOAD-BEARING: content-addressed collapse must be replay-stable;
# fragmentation source guarantees this via deterministic Fractal
# encoding + deterministic Lens-target derivation (target OID = original
# tree's content OID). A Fail here signals substrate-tampering or
# non-deterministic encoding drift.
bilateral singularity_collapse_is_deterministic {
  sentinel "fractal=singularity-collapse-deterministic"
  arity 2
}
singularity_collapse_is_deterministic(p: peer, ctx: singularity_state) -> verdict { \ }

# === singularity_settle_recovers_source — bilateral predicate ===
#
# Does the (peer, singularity_state) pair discharge the settle-
# recovery invariant? Discharges Pass iff:
#
#   - Given `artifact = collapse(ctx)`, `settle(artifact)` produces a
#     value whose content-addressed OID matches ctx.target_ref (at Iso
#     altitude: byte-identity recovery; at Lens altitude: at-least-
#     Lens recovery — the target OID is exactly reconstructable)
#   - The information-recovery bound respects the optic-hierarchy
#     rung declared by ctx.optic_kind (Iso: full recovery; Lens:
#     focused-total recovery; Prism: partial-may-fail; Traversal:
#     accumulated-partial across a chain)
#
# Rice-safe bound: byte-visible state; content-addressed hash equality
# check; optic-kind discriminator dispatch. Sentinel:
# `fractal=singularity-settle-recovers-source`.
#
# LOAD-BEARING: the inverse operation is written by the forward
# operation itself (per fragmentation research doc §Unitarity as self-
# encoding). Collapse doesn't destroy information — it writes the
# information needed for recovery into the commit at the moment of
# collapse. A Fail here signals firewall-condition (per fragmentation
# research doc §Open: the firewall problem) — the OPEN research
# question re-surfaces at empirical firing time.
bilateral singularity_settle_recovers_source {
  sentinel "fractal=singularity-settle-recovers-source"
  arity 2
}
singularity_settle_recovers_source(p: peer, ctx: singularity_state) -> verdict { \ }

# === singularity_observer_independence_at_iso — bilateral predicate ===
#
# Does the (peer, singularity_state) pair discharge observer-
# independence at Iso altitude? Discharges Pass iff:
#
#   - ctx.optic_kind == Iso
#   - Two collapse invocations at (observer_a, target_ref, Iso) and
#     (observer_b, target_ref, Iso) with observer_a != observer_b
#     produce byte-equal Artifact-refs (identity collapse is observer-
#     independent; no witness metadata written)
#
# Trivially discharges Pass when ctx.optic_kind != Iso (this bilateral
# is Iso-specific; non-Iso instances discharge via
# `singularity_observer_dependence_at_lens` below).
#
# Rice-safe bound: byte-visible state; content-addressed hash equality
# check; discriminator-kind dispatch. Sentinel:
# `fractal=singularity-observer-independence-at-iso`.
#
# LOAD-BEARING: the Iso rung of the optics hierarchy IS unitarity in
# the physics parallel (per fragmentation research doc §Iso: The
# Identity Singularity — "a black hole with zero mass; no event
# horizon; full recovery because nothing happened"). At Iso, observer
# has zero effect on the collapse artifact.
bilateral singularity_observer_independence_at_iso {
  sentinel "fractal=singularity-observer-independence-at-iso"
  arity 2
}
singularity_observer_independence_at_iso(p: peer, ctx: singularity_state) -> verdict { \ }

# === singularity_observer_dependence_at_lens — bilateral predicate ===
#
# Does the (peer, singularity_state) pair discharge observer-
# dependence at Lens altitude per MARA doctrine? Discharges Pass iff:
#
#   - ctx.optic_kind == Lens
#   - Two collapse invocations at (observer_a, target_ref, Lens) and
#     (observer_b, target_ref, Lens) with observer_a != observer_b
#     produce DIFFERENT commit SHAs (observer is in the commit)
#   - The two collapses produce IDENTICAL Lens-target OIDs (target is
#     observer-independent; same tree → same Lens-target regardless
#     of witness)
#
# This bilateral encodes MARA doctrine directly: witnessed=committer-
# in-hash-not-tree. The observer is part of the COMMIT (the event
# horizon; observer-dependent) NOT part of the TREE (the interior;
# observer-independent). Content OID is the interior; commit SHA is
# the event horizon; the type system enforces this separation.
#
# Trivially discharges Pass when ctx.optic_kind != Lens (this bilateral
# is Lens-specific; non-Lens instances discharge via
# `singularity_observer_independence_at_iso` above).
#
# Rice-safe bound: byte-visible state; content-addressed hash equality
# + inequality checks; discriminator-kind dispatch. Sentinel:
# `fractal=singularity-observer-dependence-at-lens`.
#
# LOAD-BEARING: this bilateral IS the MARA doctrine at species
# altitude. Fragmentation tests `different_observers_produce_different_
# commits` + `different_observers_same_lens_target` +
# `complementarity_different_observers_same_interior` empirically
# discharge this invariant at fragmentation altitude. This bilateral
# names the invariant at substrate-decl altitude so consumers cite it
# in `requires` clauses under compositional discipline.
bilateral singularity_observer_dependence_at_lens {
  sentinel "fractal=singularity-observer-dependence-at-lens"
  arity 2
}
singularity_observer_dependence_at_lens(p: peer, ctx: singularity_state) -> verdict { \ }

# === collapse — the load-bearing action ===
#
# Given a peer and a singularity_state, discharge the collapse event:
# emit the content-addressed ref to the Artifact produced by the
# collapse operation. At Iso altitude, the Artifact is a clone of
# the target tree (identity collapse; no dimensional reduction). At
# Lens altitude, the Artifact is a commit whose node is a Lens
# targeting the original tree's content OID (the observer is in the
# commit; the Lens carries the way back).
#
# Returns imperfect(ref, ref, ref): success carries the Artifact ref;
# failure variants carry not-admissible / non-deterministic-encoding-
# detected / observer-not-well-formed reasons.
#
# Requires collapse-determinism bilateral to discharge Pass (content-
# addressed collapse is replay-stable substrate discipline).
#
# Sentinel: `fractal=singularity-collapse`.
collapse(p: peer, ctx: singularity_state) -> imperfect(ref, ref, ref)
requires singularity_collapse_is_deterministic(p, ctx)
{ \ }

# === settle — the inverse action ===
#
# Given a peer and an Artifact ref, discharge the settle event: emit
# a content-addressed ref to the reconstructed singularity_state
# whose target_ref matches the Artifact's Lens-target OID (at Lens
# altitude) or the Artifact's identity-clone (at Iso altitude).
#
# The inverse operation is written by the forward operation itself
# (per fragmentation research doc §Unitarity as self-encoding).
# `settle` reads the Lens-target OID from the Artifact commit and
# follows the target back to the original tree.
#
# Returns imperfect(ref, ref, ref): success carries the reconstructed
# state ref; failure variants carry not-a-lens / empty-lens / target-
# not-found / commit-not-found reasons (mirroring fragmentation
# `SingularityError` variants).
#
# Requires settle-recovery bilateral to discharge Pass (the recovery
# bound MUST respect the optic-hierarchy rung).
#
# Sentinel: `fractal=singularity-settle`.
settle(p: peer, artifact: ref) -> imperfect(singularity_state, ref, ref)
requires singularity_settle_recovers_source(p, artifact)
{ \ }

