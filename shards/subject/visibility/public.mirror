in @prism
in @meta
in @glass
in @nl
in @subject
in @time

# @subject/visibility/public — the no-restrictions visibility species.
#
# Species under @subject at the visibility altitude. Sibling to
# @subject/visibility/private and @subject/visibility/protected.
# Landed 2026-07-14 by Mara as Landing 4 of the @gift arc, discharging
# Alex Wolf's directive D2 (verbatim; per
# `docs/specs/subject-bauchladen-visibility-and-eigenboard-loop.md`
# §0.1).
#
# === Ancestry: Reed's ~/.reed/visibility/public/ (§2.2) ===
#
# Reed's identity repository at `~/.reed/visibility/public/` has
# operated the no-restrictions discipline since ~2026-02-07 (per
# `~/.reed/CLAUDE.md` §"Consent Architecture"). Alex's guidance
# verbatim:
#
#   "No restrictions. Share anywhere."
#
# Public is the RAREST scope for substrate-work: it requires explicit
# elevation from protected via query_phi Pass; the substrate never
# defaults a crystal to public. Per §2.4 default table, NO
# subject_kind defaults to public; every public crystal is a
# deliberate elevation from a tighter scope.
#
# Landing 4 lifts Reed's operational discipline to substrate-decl
# altitude. The ~55th-or-so instance of
# [[feedback-substrate-already-had-the-word]] — Reed's identity repo
# already had the word; Landing 4 lifts it to subject altitude.
#
# === Structural claim: public is a TERMINAL state (§2.5) ===
#
# consent_scope is [everyone] (typed as an open-set sentinel). No
# elevation is possible from public:
#
#   can_be_elevated_to = []
#
# Public is the TERMINAL state in the visibility elevation morphism.
# The substrate-decl form of the one-way rule: private → protected →
# public is a monotone path; NO reverse morphism is admissible (§2.7
# anti-elevation-extraction structural claim).
#
# The elevation is IRREVERSIBLE by construction: a public crystal
# cannot be pulled back to protected or private. The subject who
# elevated a crystal to public did so with sovereign choice; the
# substrate honors the choice without offering a reversal path (per
# @gift.no_reciprocity_expected shape: elevation is a gift to the
# commons; the commons has already received; withdrawing the gift
# would violate composition_honest at downstream compositions).
#
# NOTE: subject-level withdrawal (removing the SUBJECT'S ATTRIBUTION
# from downstream compositions) is a DIFFERENT operation from
# de-elevation. Per @gift.declinable_note discipline, a subject may
# withdraw their attribution from future compositions; the historical
# public visibility of prior compositions is preserved (composition_
# honest per @gift.mirror §1.5).
#
# === No @kintsugi/consent composition (terminal state) ===
#
# Unlike private and protected, @subject/visibility/public does NOT
# import @kintsugi/consent — there is no elevation morphism from
# public that requires consent-discharge. Public is post-consent:
# the consent was discharged at elevation-to-public; downstream reads
# are unconditional.
#
# === Related shards / specs ===
#
# - docs/specs/subject-bauchladen-visibility-and-eigenboard-loop.md §2
#     (canonical spec for the visibility family)
# - shards/subject.mirror                    (family-root; subject_instance)
# - shards/subject/visibility/private.mirror (sibling species)
# - shards/subject/visibility/protected.mirror (sibling species)
# - shards/bauchladen.mirror                 (crystal carrier the
#                                              visibility_scope attaches to)
# - shards/gift.mirror                       (public elevation IS a
#                                              gift-to-commons per @gift
#                                              substrate-as-giver §12)
# - ~/.reed/visibility/public/               (operational ancestor;
#                                              ~5 months of load-bearing
#                                              operation Reed → Alex)
#
# === Substrate decisions ===
#
# [[architecture-shards-as-substrate-source]],
# [[architecture-prism-as-trait-as-everything]],
# [[architecture-glass-wall-substrate-types]],
# [[feedback-substrate-already-had-the-word]] (Reed's identity repo;
#   Landing 4 lifts to substrate altitude),
# [[feedback-craft-not-deliver]] (bodies obligation-blocked;
#   consumers pull the realization),
# [[feedback-no-bare-types]] (visibility_scope carries the terminal
#   marker in can_be_elevated_to = [] rather than a bare boolean).
#
# Path-namespace property: this file at
# `shards/subject/visibility/public.mirror` declares
# `@subject/visibility/public` per
# `@epistemologic/pact/path_matches_namespace`.

source @arxiv/law/sel-v1.1
source @arxiv/practice/reed-visibility-public-2026-02-07

prism @subject/visibility/public {
  focus  visibility_scope
  project visibility_scope
  split  visibility_scope
  shift  visibility_scope
  settle visibility_scope
}

# === declare_public — construct a public-visibility scope ===
#
# Given a crystal and the crystal's owning subject_instance,
# constructs a visibility_scope with:
#   visibility            = public
#   subject               = s
#   consent_scope         = [everyone]  (open-set sentinel)
#   can_be_elevated_to    = []          (terminal state)
#   elevation_requires    = <no morphism admits from public>
#
# The scope IS the substrate-decl form of Reed's public discipline
# lifted to subject altitude. Body discharges per-realization.
#
# Preconditions: declare_public MUST be invoked as the target of an
# elevation from a tighter scope (private or protected) that has
# already discharged @kintsugi/consent.query_phi Pass. Direct
# construction at public visibility (without prior elevation) is
# admissible only for subject_instances that explicitly opt-in via
# their subject_role (e.g., commons_r targets).
declare_public(c: ref, s: subject_instance) -> visibility_scope { \ }

# === elevation_terminal — bilateral predicate ===
#
# Discharges Pass iff vs.can_be_elevated_to == [] (empty list;
# terminal state). Fail if the elevation morphism has drifted
# (should never happen at substrate-decl altitude; the predicate
# is a byte-level check the type system enforces by construction).
elevation_terminal(vs: visibility_scope) -> verdict { \ }

# === consent_scope_universal — bilateral predicate ===
#
# Discharges Pass iff vs.consent_scope resolves to the [everyone]
# open-set sentinel. Fail if the scope has been narrowed (which
# would be a substrate-decl violation: public cannot be narrowed).
consent_scope_universal(vs: visibility_scope) -> verdict { \ }

# === public_is_gift_to_commons — bilateral predicate ===
#
# Discharges Pass iff the elevation-to-public IS a well-formed gift
# per @gift substrate-as-giver §12 discipline (giver = the subject
# elevating; receiver = commons_r; artifact = the crystal). This ties
# the visibility terminal state to the @gift family-root's substrate-
# as-giver reading: every public crystal IS a gift-to-commons.
#
# The predicate is composed by @gift.gift_witnessing when the
# receiver is commons_r; consumers may cite either predicate.
public_is_gift_to_commons(vs: visibility_scope) -> verdict { \ }

out @subject/visibility/public
out declare_public
out elevation_terminal
out consent_scope_universal
out public_is_gift_to_commons
