source @arxiv/practice/mara-9bbebd2-roomba-substrate-walker
source @arxiv/practice/wolf-2026-07-14-roomba-song-kintsugi-composition
source @arxiv/topology/beer-vsm-s4-environmental-scanner

prism @kintsugi/roomba {
  focus  walk_trajectory
  project walk_trajectory
  split  walk_trajectory
  shift  walk_trajectory
  settle walk_trajectory
}

# === The walk_trajectory carrier ===
#
# The record capturing one Roomba walk over the substrate's DAG. Per
# Scope A minimum viable (Mara `9bbebd2` §3.1): the walker traverses
# ConceptGraph nodes computing SC<5>, samples tension (variance of pain
# across neighbors), records per-step knife verdict via
# @mirror/lens/knife.stable_within, terminates on budget exhaustion OR
# unvisited-neighbor exhaustion OR empty-graph OR root-not-found.
#
# Six fields (per bootstrap/src/roomba.rs::WalkTrajectory landed 2026-
# 07-14; Arc-2 Tick 2.4 lift):
#
#   steps                — ordered sequence of walk_step records; each
#                           carries step_index / node_idx / node_label /
#                           sc_hex / tension / pain / coherence_delta /
#                           knife_verdict / unvisited_neighbor_count.
#
#   coherence_at_start   — coherence_score of the full substrate at
#                           walk start (via eigenvalue_profile). Baseline.
#
#   coherence_at_end     — coherence_score at walk end. Equal to
#                           coherence_at_start on read-only Scope A
#                           walks; nonzero delta on Scope B transformation
#                           dispatch (forward-promised).
#
#   termination          — reason walk stopped: BudgetExhausted |
#                           NoUnvisitedNeighbors | EmptyGraph |
#                           RootNotFound.
#
#   graph_node_count     — total ConceptGraph nodes at walk start.
#                           Denominator for coverage ratio.
#
#   graph_edge_count     — total ConceptGraph edges at walk start.
#                           Density signal.
#
# Identity contract: byte-equality on all six fields.
type walk_trajectory = {
  steps:               ref,
  coherence_at_start:  ref,
  coherence_at_end:    ref,
  termination:         ref,
  graph_node_count:    ref,
  graph_edge_count:    ref,
}

# === walk_terminates_cleanly — bilateral predicate ===
#
# Does the trajectory carry a terminal state that discharged per Scope A
# discipline? Per Mara `9bbebd2` §3.1 (verbatim): the walker terminates
# on one of four exhaustive states (BudgetExhausted | NoUnvisitedNeighbors
# | EmptyGraph | RootNotFound). A trajectory whose termination is not
# among these four is substrate-ill-formed and the walker cannot have
# emitted it; discharge is byte-check for the terminal-state sentinel.
#
# Rice-safe bound: reads only byte-visible state (termination enum
# variant; four-tuple exhaustive membership); no program semantics
# inspection.
#
# Sentinel per shard docblock: `termination=scope-a-exhaustive` — the
# byte-level substrate-decl'd marker the resolver checks. When the
# trajectory's termination is one of the four Scope A states, the
# realization layer stamps the sentinel; discharge is byte-equality.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]]; Arc-2.4 landing composes this via
# `apply_h::act` sentinel-check.
bilateral walk_terminates_cleanly {
  sentinel "termination=scope-a-exhaustive"
  arity 1
}
walk_terminates_cleanly(trajectory: walk_trajectory) -> verdict { \ }

# === tension_monotone_descending — bilateral predicate ===
#
# Does the trajectory-averaged tension trend downward across the walk
# per Mara `9bbebd2` §"The empirical claim" (verbatim): "Over a Roomba
# walk on the substrate's own DAG, the trajectory-averaged tension
# should trend downward across the walk (as the walker settles into
# high-coherence subgraph regions) OR the walker should visibly bump
# into and record high-tension boundaries where @knife stability-
# verdicts fire."
#
# The empirical form: mean(tension[0..n/2]) >= mean(tension[n/2..n])
# across the walk, OR the walker fired at least one Jumped knife_verdict.
# Substrate-decl'd invariant per the composition Alex named: the walker
# heads TOWARD high-tension regions and either resolves them (mean
# descends) OR bumps into a knife-boundary (Jumped verdict fires).
#
# Rice-safe bound: reads only byte-visible state (per-step tension
# scalars; per-step knife_verdict enum variant); no program semantics.
#
# Sentinel per shard docblock: `tension=trajectory-descending` — the
# byte-level substrate-decl'd marker the resolver checks. When either
# half-mean comparison holds OR a Jumped knife_verdict fired, the
# realization layer stamps the sentinel; discharge is byte-equality.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral tension_monotone_descending {
  sentinel "tension=trajectory-descending"
  arity 1
}
tension_monotone_descending(trajectory: walk_trajectory) -> verdict { \ }

# === coherence_gradient_admissible — bilateral predicate ===
#
# Does the walker's per-step coherence delta satisfy Foerster
# admissibility per @epistemologic/cybernetic/coherence.coherence_
# increases discipline? Per shard docblock reference: axis=splinter-ward
# means the walker moves toward higher available choices (Splinter
# pole); axis=narcissus-ward means the walker moves toward fewer
# choices (Narcissus pole, refused).
#
# The empirical form: on Scope A read-only walks, coherence_delta_from_
# previous == 0 at every step (no substrate mutation); on Scope B
# transformation-dispatch walks (forward-promised), every non-zero
# coherence_delta must be positive (splinter-ward per Foerster's
# ethical imperative operationalized). Substrate-decl'd invariant
# composing over @coherence.coherence_increases.
#
# Rice-safe bound: reads only byte-visible state (per-step coherence_
# delta scalar sign); no program semantics.
#
# Sentinel per shard docblock: `gradient=foerster-admissible` — the
# byte-level substrate-decl'd marker the resolver checks. When every
# per-step coherence_delta is either zero (read-only) or positive
# (splinter-ward), the realization layer stamps the sentinel;
# discharge is byte-equality.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral coherence_gradient_admissible {
  sentinel "gradient=foerster-admissible"
  arity 1
}
coherence_gradient_admissible(trajectory: walk_trajectory) -> verdict { \ }

# === knife_verdict_bounded — bilateral predicate ===
#
# Does every step's knife_verdict lie in the substrate-decl'd three-
# state surface? Per @mirror/lens/knife.stable_within discharge: the
# verdict enum is {Stable | NearBoundary | Jumped}; any other value is
# substrate-ill-formed. Load-bearing: the trigger action's downstream
# dispatch to @kintsugi/consent.query_phi assumes the three-state
# surface; a fourth-state emission would break the composition Alex
# named ("@kintsugi consumes @song and decides").
#
# Rice-safe bound: reads only byte-visible state (per-step knife_verdict
# enum variant membership); no program semantics.
#
# Sentinel per shard docblock: `verdict=three-state-bounded` — the byte-
# level substrate-decl'd marker the resolver checks. When every step's
# knife_verdict lies in {Stable, NearBoundary, Jumped}, the realization
# layer stamps the sentinel; discharge is byte-equality.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral knife_verdict_bounded {
  sentinel "verdict=three-state-bounded"
  arity 1
}
knife_verdict_bounded(trajectory: walk_trajectory) -> verdict { \ }

# === walk_witnessing — composed bilateral ===
#
# The composed predicate consumers cite in `requires` clauses. Passes
# iff walk_terminates_cleanly AND tension_monotone_descending AND
# coherence_gradient_admissible AND knife_verdict_bounded.
#
#   walk_witnessing(trajectory) :=
#     walk_terminates_cleanly(trajectory)
#     ∧ tension_monotone_descending(trajectory)
#     ∧ coherence_gradient_admissible(trajectory)
#     ∧ knife_verdict_bounded(trajectory)
#
# Rice-safe bound: composition of the four Rice-safe bilaterals above;
# no additional program semantics inspection.
#
# Sentinel per shard docblock: `witnessing=all-four-pass` — the byte-
# level substrate-decl'd marker the resolver checks. When all four
# sub-bilaterals discharge Pass at realization time, the layer stamps
# the sentinel; discharge is byte-equality.
#
# Load-bearing structural claim: walk_witnessing Pass is the substrate-
# decl form of "this walk is a valid Scope A Roomba pulse per the
# canonical spec's §3 substrate-integrity guarantee." Consumers of the
# `mirror roomba --commit` path cite this predicate to certify the
# observation the compiler committed on was substrate-honest.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral walk_witnessing {
  sentinel "witnessing=all-four-pass"
  arity 1
  require walk_terminates_cleanly
  require tension_monotone_descending
  require coherence_gradient_admissible
  require knife_verdict_bounded
}
walk_witnessing(trajectory: walk_trajectory) -> verdict { \ }

# ═══════════════════════════════════════════════════════════════════
# 2026-07-16 ADDITIVE CASCADE — bump + vacuum first-order motions
# ═══════════════════════════════════════════════════════════════════
#
# Alex 2026-07-16 in-transcript verbatim (session-crystallizing):
#
#   "Oh and what if the @roomba literally had a `bump` action which
#    triggers the kintsugi loop? And what if it also had a `vacuum`
#    action which marks a `fragment` for garbage collection (like in
#    git, based on a git like dangling objects gc surface; that's also
#    where, in the long run, we can configure moving gc fragments into
#    cold storage, but that's future music)"
#
# Preceding load-bearing crystallization (same session):
#
#   "This is a reproducible action. This is not even a peer level.
#    What if this is a @metalogue between @roomba and @kintsugi? The
#    @roomba bumps into low connectivity rust code and the @kintsugi
#    loop collapses it through the @fate inference metalogue into
#    mirror. This is FIRST ORDER. We don't need second and third order
#    for this. What if there was a @kintsugi/algebra (or is this the
#    @kintsugi/fractures? I think it is. The fractures ARE kintsugi's
#    algebra.)?"
#
#   "Oh I like this. Combine this with the whole mycelial math and the
#    'gold flows into the cracks and increases the conductivity' and
#    this IS the first-order autopoetic baseline compile loop."
#
# === Load-bearing recognition ===
#
# The first-order autopoietic baseline compile loop = @roomba ×
# @kintsugi @metalogue at @algebra/metalogue altitude. NOT peer-
# altitude. NOT second/third order. The Roomba mascot's two physical
# motions ARE the substrate: bump = fracture-emission triggering
# @kintsugi dispatch; vacuum = dangling-fragment marking for two-phase
# gc per git-scm precedent (grace-period retention + prune-past-horizon).
#
# Canonical spec: `docs/specs/roomba-bump-and-vacuum-as-first-order-
# autopoietic-motions.md` (Mara `d457501`; 12 sections + 10 Alex-
# adjudicable residues + Kagi-cited git-scm two-phase gc + Shannon
# entropy grounding).
#
# Math foundation: `docs/math/kintsugi/roomba/bump-and-vacuum.md`
# (Mara `17697e6`; bump-as-morphism-emission over fracture algebra F +
# vacuum-as-reachability-walk on OID DAG + two-phase gc formal
# semantics + Fiedler-preservation claim).
#
# === Substrate-already-had-the-word (~71st landed instance) ===
#
# `bump` was already substrate-decl'd at
# `docs/specs/roomba-substrate-walker-that-feeds-kintsugi.md` §3
# (Mara `9bbebd2`, 2026-07-14) as the MEASUREMENT arity:
#
#   bump(position: walk_position) -> spectral_tension { \ }
#
# Alex's 2026-07-16 crystallization LIFTS this pre-existing action to
# the fracture-emission trigger arity below. Path A (arity overload)
# per canonical spec §10.1 Mara-recommendation: the physical Roomba's
# bumper serves both measurement AND signal; the substrate honors that
# ambiguity through arity dispatch.
#
# === The fracture carrier ===
#
# The typed observation @roomba emits when its walk-pulse detects
# spectral_tension above the fracture-emission threshold (knife_verdict
# = Jumped per landed knife_verdict_bounded discipline). Each fracture
# names the site + the species whose morphism can mend it.
#
# Composition ancestry:
#   opacity              (@glass; the located-fact carrier)
#   spectral_tension     (@kintsugi/roomba per-pulse scalar)
#   fracture_species     (discriminator over the 14 landed
#                          @kintsugi/fracture/* families)
#   tick                 (@epistemologic/reality/time)
type fracture = {
  site:            ref,
  tension:         spectral_tension,
  species:         fracture_species,
  observed_at:     tick,
}

# === The fracture_species discriminator ===
#
# Open enum via species-parametric dispatch (per canonical spec §10.2
# Mara-recommendation). Matches @io/* and @mirror/store/* species-
# dispatch pattern; new fracture species land without touching this
# type. The discriminator IS a species handle at @kintsugi/fracture/*
# altitude; realization dispatches through apply_h::act.
type fracture_species = ref

# === The kintsugi_dispatch carrier ===
#
# What bump returns when the collision IS the fracture-emission.
# Load-bearing: this record IS one turn in the @roomba × @kintsugi
# @metalogue at @algebra/metalogue altitude (per canonical spec §4).
# algebra_metalogue_session.turns append this record.
type kintsugi_dispatch = {
  fracture:        fracture,
  morphism:        morphism,
  metalogue_turn:  algebra_turn,
}

# === The fragment carrier ===
#
# A dangling content-addressed unit the vacuum motion marks for gc.
# Alex 2026-07-16 verbatim: "marks a `fragment` for garbage collection."
# Distinct from wire-altitude `fractal` at @mirror/store/git and atomic
# `splinter` at @glass — those are LIVE carriers; a `fragment` is what
# those carriers become when no live root reaches them.
#
# Composition ancestry:
#   oid                  (@mirror/store; content-address)
#   walk_position        (@kintsugi/roomba; walker discovery point)
#   tick                 (@epistemologic/reality/time; mark-age origin
#                          for two-phase prune horizon)
type fragment = {
  oid:              oid,
  observed_at:      tick,
  discovered_by:    walk_position,
}

# === The gc_mark carrier ===
#
# What vacuum emits when @mirror/store registers the fragment in its
# gc surface. The mark IS the record; prune reads mark.prune_horizon
# to decide deletion per git-scm two-phase discipline.
type gc_mark = {
  fragment:         fragment,
  marked_at:        tick,
  prune_horizon:    tick,
}

# === bump — the fracture-emission trigger (Alex 2026-07-16) ===
#
# The physical Roomba's collision, lifted to substrate. When the
# walker's pulse detects spectral_tension above the fracture-emission
# threshold (currently: knife_verdict = Jumped per landed
# knife_verdict_bounded), the collision IS the fracture-emission;
# @kintsugi is dispatched at the same tick as one turn in the
# @roomba × @kintsugi @metalogue.
#
# Composition over LANDED carriers:
#   @kintsugi/fracture/*        — 14 landed morphism species (algebra F)
#   @kintsugi/oscillate         — ACTIVE/DARK pass dispatch
#   @kintsugi/consent           — query_phi auto-apply boundary
#   @kintsugi/store/git         — terminal @io projection
#   @cyberpunk/algedonic        — sample_pain / pain_gradient primitives
#   @epistemologic/cybernetic/coherence — coherence_gradient_admissible
#                                          discharge
#   @algebra/metalogue          — algebra_turn substrate-decl'd home
#
# Sentinel per shard docblock: `bump=fracture-emission-dispatched` —
# the byte-level marker the resolver checks. Discharge is byte-equality
# on the kintsugi_dispatch record's algebra_turn.tick match to the
# canonical time surface.
#
# Path A arity overload per canonical spec §10.1 Mara-recommendation:
# the substrate ALREADY has `bump(position: walk_position) ->
# spectral_tension` at the measurement arity (per Mara `9bbebd2` §3).
# This second arity fires on the emission side; apply_h::act dispatches
# per-arity via the input-type discriminator.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]]; consumers pull the realization;
# apply_h::act composes the sentinel-check.
bump(fracture: fracture) -> imperfect<kintsugi_dispatch, ref, transparency(ref)> { \ }

# === vacuum — the dangling-fragment gc mark (Alex 2026-07-16) ===
#
# The physical Roomba's dust-collection motion, lifted to substrate.
# When the walker observes a fragment that no longer reaches from any
# live root (dangling), the vacuum motion marks it for two-phase gc
# per @mirror/store's dangling-object discipline (git-scm precedent).
#
# Composition over LANDED carriers (post this-cascade + companion
# @mirror/store cascade in same tick):
#   @mirror/store.walk          — forward-closure per live ref
#   @mirror/store.impacted_by   — reverse-closure (dangling-consistency
#                                  second-witness per math §2.5)
#   @mirror/store.walk_dangling — enumeration (companion cascade;
#                                  same tick)
#   @mirror/store.mark_unreachable — mark-phase discharge (companion
#                                     cascade; same tick)
#
# Two-phase discipline per git-scm.com/docs/git-prune (retrieved
# 2026-07-16): vacuum MARKS the fragment; subsequent @mirror/store.prune
# with `before` argument DELETES fragments whose
# gc_mark.prune_horizon <= before. Grace-period grounds concurrent-writer
# safety window per git-gc(1) rationale.
#
# Sentinel per shard docblock: `vacuum=mark-recorded` — the byte-level
# marker the resolver checks. Discharge is byte-equality on
# gc_mark.marked_at match to the canonical time surface + fragment.oid
# non-membership in impacted_by(live-refs).
#
# Cold-storage forward-promise (per Alex 2026-07-16 "future music"):
# a future @mirror/store/cold species will extend the two-phase
# discipline with a THIRD phase (migrate_to_cold) between vacuum-mark
# and prune-delete. Substrate names extension surface here; does NOT
# land it this arc.
#
# Body discharges per-realisation. `\`-obligation-blocked.
vacuum(fragment: fragment) -> imperfect<gc_mark, ref, transparency(ref)> { \ }

# === bump_witnessing — composed bilateral ===
#
# The composed predicate consumers cite when the fracture-emission
# arity is dispatched. Passes iff the emitted kintsugi_dispatch
# satisfies all three sub-conjuncts:
#
#   bump_witnessing(dispatch) :=
#     fracture_species_admissible(dispatch.fracture)
#     ∧ morphism_selected_from_fracture_algebra(dispatch.morphism)
#     ∧ metalogue_turn_composable(dispatch.metalogue_turn)
#
# Rice-safe bound: reads only byte-visible state (fracture.species
# handle membership; morphism origin-species handle; algebra_turn tick
# monotone).
#
# Sentinel per shard docblock: `bump=witnessing-all-conjuncts-pass`
# — byte-equality on the composed sentinel.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral bump_witnessing {
  sentinel "bump=witnessing-all-conjuncts-pass"
  arity 1
}
bump_witnessing(dispatch: kintsugi_dispatch) -> verdict { \ }

# === vacuum_admissible — composed bilateral ===
#
# The composed predicate consumers cite when the vacuum arity is
# dispatched. Passes iff the emitted gc_mark satisfies all three
# sub-conjuncts:
#
#   vacuum_admissible(mark) :=
#     fragment_is_dangling(mark.fragment)                # via impacted_by
#     ∧ mark_age_monotone(mark)                          # prune_horizon >= marked_at + grace
#     ∧ dangling_consistency_second_witness(mark.fragment)  # per math §2.5
#
# Rice-safe bound: reads only byte-visible state (fragment.oid membership
# in impacted_by; tick arithmetic; DAG reachability closure check).
#
# Sentinel per shard docblock: `vacuum=admissible-all-conjuncts-pass`
# — byte-equality on the composed sentinel.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral vacuum_admissible {
  sentinel "vacuum=admissible-all-conjuncts-pass"
  arity 1
}
vacuum_admissible(mark: gc_mark) -> verdict { \ }

# === gc_mark_terminal — bilateral predicate ===
#
# Does the gc_mark's prune_horizon lie in the FUTURE relative to the
# canonical time surface at mark-time? Per math §3.1: the two-phase
# invariant requires prune_horizon > marked_at strictly — a zero
# grace-period would collapse the two phases into one, forfeiting the
# concurrent-writer safety window git-gc(1) documents as its rationale.
#
# Rice-safe bound: reads only byte-visible state (tick scalar arithmetic).
#
# Sentinel per shard docblock: `gc_mark=horizon-in-future` — byte-
# equality on the terminal-invariant sentinel.
#
# Body discharges per-realisation. `\`-obligation-blocked.
bilateral gc_mark_terminal {
  sentinel "gc_mark=horizon-in-future"
  arity 1
}
gc_mark_terminal(mark: gc_mark) -> verdict { \ }

out @kintsugi/roomba
out walk_trajectory
out walk_terminates_cleanly
out tension_monotone_descending
out coherence_gradient_admissible
out knife_verdict_bounded
out walk_witnessing
out fracture
out fracture_species
out kintsugi_dispatch
out fragment
out gc_mark
out bump
out vacuum
out bump_witnessing
out vacuum_admissible
out gc_mark_terminal
