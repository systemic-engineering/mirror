# === The 5-op prism inheriting @void basis (Recognition #79) ===
#
# For @kintsugi/fracture/inport specifically:
#   focus inport_fracture    = identify the (shard_position,
#                              invoked_symbol, missing_family_root)
#                              tuple at which the sheaf-inclusion
#                              invariant fails
#   project inport_fracture  = deploy the detect operation
#                              (walk shard bodies, grep-compare
#                              invoked symbols vs declared imports)
#   split inport_fracture    = bifurcate candidate correction-space
#                              (each candidate `in @<family_root>`
#                              insertion is one arm of @fate's split)
#   shift inport_fracture    = traverse the fracture-sibling lattice
#                              (this species vs other @kintsugi/
#                              fracture/* siblings; shift enters an
#                              adjacent fracture's frame)
#   settle inport_fracture   = crystallize the tournament winner as
#                              a @fractal/shard carrying the inserted
#                              `in` statement; discharge via @kintsugi/
#                              mend at import-block top

prism @kintsugi/fracture/inport {
  focus  inport_fracture
  project inport_fracture
  split  inport_fracture
  shift  inport_fracture
  settle inport_fracture
}

# === The inport_fracture carrier ===
#
# Typed record naming ONE shard-position where a symbol is invoked
# without a matching `in @<family_root>` declaration. Consumed by
# `propose_correction` + `discharge`; produced by `detect`. The unit-
# of-repair for the roomba's per-pulse fracture-emission at sheaf-
# inclusion altitude.
#
# Four fields:
#
#   shard_position       — REF to the shard where the fracture fires
#                           (path + import-block offset). The mend
#                           will insert the `in` statement at this
#                           position's import-block top.
#
#   invoked_symbol       — REF to the invoked symbol whose family-root
#                           is unimported. Content-addressed identity:
#                           two records with the same
#                           (shard_position, invoked_symbol) name the
#                           same fracture. Byte-visible in shard body.
#
#   missing_family_root  — REF to the family-root `@X` derived from
#                           `invoked_symbol` by prefix extraction.
#                           This IS the shard the missing `in @X`
#                           statement would import.
#
#   suggested_in_statement — REF to the fully-formed `in @X` line
#                           to insert. Byte-precision: leading
#                           whitespace + `in ` + family_root + `\n`.
#                           The mend's byte-splice payload.
#
# Identity contract: byte-equality on (shard_position,
# invoked_symbol). Two records name the same fracture iff both
# fields byte-match; missing_family_root + suggested_in_statement
# are DERIVED from these two under a total function.
type inport_fracture = {
  shard_position:         ref,
  invoked_symbol:         ref,
  missing_family_root:    ref,
  suggested_in_statement: ref,
}

# === inport_fracture_witnessed — bilateral predicate (arity 2) ===
#
# Is the fracture mechanically detectable at the given position?
# The FIRST discharge conjunct: the invoked_symbol exists at the
# named shard_position AND its family-root is NOT in the shard's
# import block.
#
# Discharges Pass iff:
#   - shard_position resolves via @io/fs.read to a well-formed
#     shard body
#   - invoked_symbol appears byte-visibly in the shard body at
#     some offset > import-block-end
#   - family_root(invoked_symbol) NOT ∈ imported_family_roots(shard)
#     (finite-set-membership; grep-decidable)
#
# Rice-safe at whole-tick altitude: reads only byte-visible state
# (shard body bytes + import-block-parse output; substring
# containment); no program semantics. See math foundation §5.
#
# Sentinel: `inport=fracture-witnessed`.
bilateral inport_fracture_witnessed {
  sentinel "inport=fracture-witnessed"
  arity 2
}
inport_fracture_witnessed(p: peer, ctx: inport_fracture) -> verdict { \ }

# === inport_correction_is_valid_in_statement — bilateral predicate (arity 2) ===
#
# Is the suggested correction a well-formed `in @<family_root>`
# statement? The SECOND discharge conjunct: the proposed byte-splice
# would produce a syntactically-valid import-block entry.
#
# Discharges Pass iff:
#   - suggested_in_statement byte-starts with `in @` prefix
#   - the `@<family_root>` portion resolves to a substrate-declared
#     family-root (grep against `shards/**/*.mirror` for a matching
#     `@X` species-decl)
#   - the statement byte-ends with `\n` (import-block line-shape)
#   - inserting the statement at import-block top produces a shard
#     whose import block still parses under @meta discipline
#
# Rice-safe at whole-tick altitude: byte-visible state; family-root
# existence check against finite shards/ tree; grammar-parse of
# candidate byte-string (finite depth).
#
# Sentinel: `inport=correction-valid-in-statement`.
bilateral inport_correction_is_valid_in_statement {
  sentinel "inport=correction-valid-in-statement"
  arity 2
}
inport_correction_is_valid_in_statement(p: peer, ctx: inport_fracture) -> verdict { \ }

# === inport_discharge_restores_sheaf_inclusion — bilateral predicate (arity 2) ===
#
# Does the discharge restore the sheaf-inclusion invariant at the
# fracture position? The THIRD discharge conjunct: after the mend
# fires, the fracture no longer witnesses at that position.
#
# Discharges Pass iff:
#   - after `discharge(fracture)` succeeds, re-running
#     inport_fracture_witnessed on the same (shard_position,
#     invoked_symbol) tuple returns Fail (the fracture no longer
#     detects)
#   - the shard body's non-import bytes are byte-identical before
#     and after discharge (the mend touches ONLY the import block;
#     the shard body is preserved)
#   - the shard's remaining fractures (if any) are byte-visibly
#     distinct from the just-discharged one (no side-effect on
#     other fracture sites)
#
# Rice-safe at whole-tick altitude: composition of two Rice-safe
# reads (before-state + after-state) + byte-equality check on
# body bytes; no program semantics.
#
# Sentinel: `inport=discharge-restores-sheaf-inclusion`.
#
# LOAD-BEARING: this bilateral encodes Alex 2026-07-23 verbatim
# ("`in` imports a shard, hence a sheaf, hence CREATES the geometric
# space") at substrate-decl altitude. The invariant IS: after
# discharge, the section over the union of opened charts is well-
# formed at ctx.shard_position.
bilateral inport_discharge_restores_sheaf_inclusion {
  sentinel "inport=discharge-restores-sheaf-inclusion"
  arity 2
}
inport_discharge_restores_sheaf_inclusion(p: peer, ctx: inport_fracture) -> verdict { \ }

# === detect action (fracture-emission surface) ===
#
# THE LOAD-BEARING DETECTION ACTION. Reads a shard's bytes; extracts
# import-block declared family-roots; extracts invoked symbols from
# the shard body; emits one inport_fracture record per invoked
# symbol whose family-root is unimported. Returns empty list when
# the fixed-point holds (every invoked symbol's family-root is
# declared in the import block).
#
# Algorithm (per docs/specs/kintsugi-fracture-inport-sheaf-inclusion-
# compile-invariant.md §3 detection pseudocode):
#
#   detect(shard_position):
#     bytes = @io/fs.read(shard_position.path)
#     import_block = parse_import_block(bytes)
#     declared = { family_root(entry) : entry in import_block }
#     invoked  = extract_invoked_symbols(bytes, after=import_block.end)
#     records = []
#     for sym in invoked:
#       root = family_root(sym)
#       if root not in declared:
#         suggested = compose_in_statement(root)
#         record = inport_fracture {
#           shard_position:         shard_position,
#           invoked_symbol:         sym,
#           missing_family_root:    root,
#           suggested_in_statement: suggested,
#         }
#         if inport_fracture_witnessed(p, record) == Pass:
#           records.append(record)
#     return records
#
# Composition surface:
#   @io/fs.read(shard_position.path)              — read shard bytes
#   parse_import_block(bytes)                     — @meta discipline
#   extract_invoked_symbols(bytes, after)         — @nl grep
#   inport_fracture_witnessed(p, record)          — witnessing conjunct
#
# Rice-safe bound at whole-tick altitude: reads only byte-visible
# state (shard body bytes; substring containment); no program
# semantics. See math §5 mechanical-decidability proof.
#
# Body `\`-obligation-blocked per [[feedback-craft-not-deliver]];
# Reed post-mint follow-up wires the roomba composition edge that
# dispatches this action per bump-pulse.
#
# Sentinel: `inport=detect`.
detect(p: peer, shard_position: ref) -> imperfect(ref, ref, ref)
requires inport_fracture_witnessed(p, ctx)
{ \ }

# === propose_correction action (fate-tournament dispatch) ===
#
# THE LOAD-BEARING PROPOSAL ACTION. Reads one inport_fracture record;
# dispatches @fate.roll tournament over the candidate correction-
# space (each candidate is one possible `in @<family_root>` statement
# shape); returns the winning candidate ref.
#
# For a grep-decidable fracture (this species), the candidate space
# is a singleton: the fracture's `missing_family_root` field UNIQUELY
# determines the correction. The tournament degenerates to identity
# selection. The action shape is preserved for composition with the
# autopoietic-loop math (Mara #152) which requires @fate as one arm
# of the six-step loop.
#
# Algorithm:
#
#   propose_correction(fracture):
#     candidates = [ fracture.suggested_in_statement ]
#     winner = @fate.roll(candidates, restriction=fracture.shard_position)
#     if inport_correction_is_valid_in_statement(p, fracture) != Pass:
#       return failure("correction not well-formed")
#     return winner
#
# Composition surface:
#   @fate.roll(candidates, restriction)         — tournament dispatch
#   inport_correction_is_valid_in_statement(p, fracture)  — validity
#                                                            guard
#
# Rice-safe bound: byte-visible state; @fate.roll on singleton
# candidate space is deterministic-identity; validity guard is
# grep-decidable.
#
# Body `\`-obligation-blocked; Reed post-mint composes @fate.roll
# resolver-arm at apply_h::act altitude.
#
# Sentinel: `inport=propose-correction`.
propose_correction(p: peer, ctx: inport_fracture) -> imperfect(ref, ref, ref)
requires inport_correction_is_valid_in_statement(p, ctx)
{ \ }

# === discharge action (fracture-resolution surface) ===
#
# THE LOAD-BEARING RESOLUTION ACTION. Reads one inport_fracture
# record + a proposed correction ref; composes over @kintsugi/mend.mend
# to crystallize the correction as a @fractal/shard and byte-splice
# the shard's import block via @io/fs.mutate_at at import-block top.
# Returns @glass.verdict.
#
# Algorithm (per docs/specs/kintsugi-fracture-inport-sheaf-inclusion-
# compile-invariant.md §4 resolution pseudocode):
#
#   discharge(fracture, correction):
#     # Guard: only proceed if the witnessing bilateral passes
#     if inport_fracture_witnessed(p, fracture) != Pass:
#       return failure("fracture no longer witnesses; skip discharge")
#
#     # Compose @kintsugi/mend to crystallize correction as a shard
#     mend_state = {
#       fracture_position: fracture.shard_position,
#       target:            @kintsugi/fracture/inport,
#       through:           correction,
#     }
#     produced_shard = @kintsugi/mend.mend(p, mend_state)
#     if produced_shard.status != success:
#       return failure("mend refused; fracture preserved")
#
#     # Byte-splice the produced shard's suggested_in_statement
#     # at import-block top via @io/fs.mutate_at (insertion at
#     # offset = 0 with non-empty replacement).
#     bytes = @io/fs.read(fracture.shard_position.path)
#     position = import_block_top_position(bytes)
#     mutate = @io/fs.mutate_at(
#       fracture.shard_position.path,
#       position,
#       fracture.suggested_in_statement,
#     )
#     if mutate.status != success:
#       return failure("mutate_at refused; file preserved")
#
#     # Verify the discharge restored sheaf-inclusion
#     if inport_discharge_restores_sheaf_inclusion(p, fracture) != Pass:
#       return failure("discharge did not restore invariant")
#
#     return pass
#
# Composition surface:
#   @kintsugi/mend.mend(p, mend_state)          — crystallize
#                                                  correction as shard
#   @io/fs.read(fracture.shard_position.path)   — read shard bytes
#   @io/fs.mutate_at(path, position, replacement) — byte-splice
#                                                    insertion
#   inport_fracture_witnessed(p, fracture)      — pre-guard
#   inport_discharge_restores_sheaf_inclusion(p, fracture) — post-verify
#
# Rice-safe bound at whole-tick altitude: composition of Rice-safe
# reads + byte-splice + Rice-safe post-verify.
#
# Body `\`-obligation-blocked; Reed post-mint composes this via
# apply_h::act sentinel-check arm. The realisation composes over
# @kintsugi/mend + @io/fs at the boundary; the driver code does NOT
# encode inport semantics — only sentinel dispatch.
#
# Sentinel: `inport=discharge`.
discharge(p: peer, ctx: inport_fracture, correction: ref) -> verdict
requires inport_fracture_witnessed(p, ctx)
requires inport_correction_is_valid_in_statement(p, ctx)
requires inport_discharge_restores_sheaf_inclusion(p, ctx)
{ \ }

