# === tension — the substrate's local reading of curvature (spec §2) ===
#
# Per spec §2 citation floor over gap-tension-tensor-substrate.md
# (Mara 2026-05-26; folded 2026-06-04): a tension is the local
# reading of curvature Ω at one site. At kintsugi surface altitude
# a tension is a `[D, a]` commutator value at reader-frame altitude
# that failed to bound within kintsugi's active_pass tolerance.
#
# Seven-tuple identity contract: byte-equality on all seven fields.
# Two tensions at the same site with different `curvature` are
# distinct — the curvature carries the local geometry.
type tension = {
  site:         ref,                     # where the curvature spiked
  claim:        ref,                     # what the substrate expected
  observed:     ref,                     # what the substrate measured
  curvature:    ref,                     # the [D, a] value; see spec §4
  altitude:     ref,                     # which tower altitude fired
  transparency: transparency(ref),       # opacity map from active_pass
  contract:     ref,                     # the contract at the moment of firing
}

# === surface_class — the four Tomm-shape carriers (spec §3) ===
#
# Closed sum naming which of the four sub-frame descriptors of the
# curvature 2-form Ω the tension falls into. Per spec §3: when
# `ashby_variety_match(kintsugi_lock_of(t, ctx))` fires failure,
# the tension is exactly one of the four. Per spec §5 each maps to
# a specific Tomm interviewing shape.
#
# Rigor across the four is asymmetric per spec §4.1 table:
# `contradiction` is RIGOROUS via `[ω,ω]` Bateson-bind projection;
# the other three are MOTIVATING pending per-class projection-
# operator derivation. Named honestly per Seam #142 DEFER verdict.
type surface_class =
  | ashby_mismatch
  | contradiction
  | conundrum
  | out_of_band
  | dispatch_ambiguity

# === ashby_mismatch — Ashby's variety attenuation (spec §3.1) ===
#
# Fires when regulator variety at some substrate-pull axis is
# insufficient: the substrate can name the tension but has no
# fracture body whose output-variety matches the tension's input-
# variety. Per Ashby 1958: `V(R) < V(D)` at some axis.
#
# Sub-frame descriptor at variety-axis-N of the curvature 2-form Ω.
# MOTIVATING per spec §4.1 pending per-class projection-operator
# derivation. Tomm circular shape per spec §5.2 (Ashby's law is
# relational; Tomm's circular questions elicit relational data).
type ashby_mismatch = {
  base:            tension,
  axis:            ref,                  # which of the 5 variety axes fell short
  regulator:       ref,                  # the R the substrate offered
  demand:          ref,                  # the D the tension named
  variety_deficit: nat,                  # V(D) - V(R) at this axis
}

# === contradiction — Carnielli-LFI bind at Bateson level (spec §3.2) ===
#
# Fires when two properties both fire success but their conjunction
# implies failure. Per Carnielli-Marcos LFI (2004, 2007):
# `A ∧ ¬A ⊢ ⊥` in classical logic; in LFI the substrate carries
# `○A` (the consistency of A) as a separate operator. `○A` at
# compile time IS `holds(gap)` — the claim that A has NO gap. When
# two claims each hold but their gaps overlap, the substrate is in
# a paraconsistent state.
#
# Sub-frame descriptor at Bateson-level-bind axis of Ω. RIGOROUS
# per spec §4.1: inherits the projection-operator derivation from
# curvature-and-tomm.md §5's `[ω,ω]` Bateson-bind — Ω splits as
# `dω_L + dω_R + [ω_L, ω_R]`; the bracket IS the bind at Bateson
# level. Tomm linear-then-reflexive shape per spec §5.3.
type contradiction = {
  base:          tension,
  left:          ref,                    # first claim (holds independently)
  right:         ref,                    # second claim (holds independently)
  bind:          ref,                    # the level at which they meet
  bateson_level: nat,                    # Bateson logical type where bind fires
}

# === conundrum — flat/unbounded eigenvalue (spec §3.3) ===
#
# Fires when the `[D, a]` commutator has an eigenvalue at 0 (flat
# direction — the substrate has a direction it can't see) or at ∞
# (unbounded — the substrate has a direction it sees but can't
# measure). Per curvature-and-tomm.md §6: gaps in the substrate
# come in these two flavors.
#
# Sub-frame descriptor at eigenvalue-kind axis of Ω. MOTIVATING per
# spec §4.1 pending per-class projection-operator derivation. Tomm
# reflexive shape per spec §5.4 (both kernel and unbounded direction
# require the observer to observe the observing itself — third-
# order per spec §7).
#
# `eigenvalue_type` is a two-variant discriminator per spec §3.3:
# `zero` (flat direction) or `unbounded` (divergent direction).
# Massey product witness for non-abelian curvature per Markl 2024.
type conundrum = {
  base:            tension,
  eigenvalue_type: ref,                  # zero | unbounded (spec §3.3)
  witness:         ref,                  # the [D, a] flat/divergent direction
  massey_product:  ref,                  # H² cocycle when non-abelian applies
}

# === out_of_band — algedonic bypass (spec §3.4) ===
#
# Fires when the substrate has no `a ∈ A` such that `[D, a]`
# computes for the tension. The tension names an object the
# substrate's algebra does not contain. Per error-as-question.md §4
# (algedonic bypass): this is the class that surfaces to Reflection
# at recursion altitude, bypassing the intermediate altitudes.
#
# Sub-frame descriptor at algebra-membership axis of Ω. MOTIVATING
# per spec §4.1 pending per-class projection-operator derivation.
# Tomm strategic shape per spec §5.5 (the observer chooses which
# structural future the substrate takes — grant the crossing under
# a named pact, or refuse and route to the neighboring family's
# kintsugi loop).
#
# The three algedonic classes (`glass_wall` violation, `halts`
# undecidable, `autopoietic` non-convergence) are out_of_band
# instances at kintsugi altitude per error-as-question.md §4.
type out_of_band = {
  base:                tension,
  namespace_requested: ref,              # what the substrate was asked to name
  algebra_at:          ref,              # the A the substrate had at this altitude
  bypass_reason:       ref,              # glass_wall / halts / autopoietic violation
}

# === kintsugi_context — the surface act's carrier (spec §1.4) ===
#
# The context carrier the surface action reads at discharge time.
# Per spec §1.4's kintsugi_lock instantiation: names the altitude
# the loop's active_pass is firing at, the species surfacing the
# tension, the budget available for spawn discharge (per §6.1 each
# surface act decrements budget by one), the perturbation ref
# threaded through the third-order composition, and the connection
# 1-form over active_pass ticks (the `ω` in `[ω, ω]`).
#
# Budget bounds the surface-act depth per spec §6: halting survives
# arbitrarily many surfacings because each Tomm emission spends one
# budget unit and the peer's `@spawn ≤ @loop` monad guarantees
# safety-net halt. When budget hits zero the loop terminates at
# `terminal_check` per spec §6.
type kintsugi_context = {
  altitude:     ref,                     # active_pass altitude
  species:      ref,                     # the surface act's family (@kintsugi/surface)
  budget:       nat,                     # remaining surface-act budget
  perturbation: ref,                     # threaded through @third composition
  connection:   ref,                     # ω over active_pass ticks
}

# === surface — the compiler error surface act (spec §7.2) ===
#
# THE LOAD-BEARING ACTION. Given a tension, a surface class, and a
# kintsugi context, emit an observation_depth witness carrying the
# depth-3 recursion at the surface-act boundary.
#
# Signature per spec §7.2 canonical form. The `requires
# ashby_variety_match(kintsugi_lock)` clause names the twelfth-
# instance discipline (Alex 2026-07-02) at the substrate-fact
# altitude — the surface act composes against the landed
# `@epistemologic/cybernetic/coherence-parametric.ashby_variety_match(lock)`
# measurement rather than inventing a same-shape sibling.
#
# `kintsugi_lock` is the surface-species instantiation of the
# lock_carrier already declared at coherence-parametric.mirror
# (per spec §1.4): a lock_carrier with the kintsugi-altitude tuple
# {altitude=@kintsugi, species=@kintsugi/surface, pair=lock_pair{
# T_reg=fracture_body_space(ctx), T_regd=candidate_resolutions(t),
# rho=kintsugi_representation, omega=active_pass_connection(ctx)}}.
# The concrete instantiation composes at discharge time via
# `kintsugi_lock_of(t, ctx)` (spec §1.4 forward-promise; body
# altitude concern; not landed this tick).
#
# Return `observation_depth` because the surface act IS third-order
# per spec §7.1: the observer of the observing of the observing.
# The depth-3 witness carries `primary = substrate_at_tension_site`,
# `observer = kintsugi_loop`, `meta = surface_act` per Loki's
# naming (Void → Third; systemic.engineering 2026-06-22).
#
# Per spec §7.2 the full precondition composed on top of this base
# discipline is `requires third_order_active(surface_witness(t,
# class), ctx.perturbation)` — the four sub-predicates
# `depth_at_least(3, ...)`, `observer_observes_observing(...)`,
# `recursion_folds_back(...)`, `mechanism_visible(...)` all fire.
# The base discipline landed here is `ashby_variety_match(kintsugi_
# lock)` per Alex 2026-07-02 twelfth-instance rule; the composed
# refinement lands when the second species extends the conditional-
# marker pattern (candidate #141 promotion criterion — @reflection
# at pipeline-error altitude per spec §10.4 candidate #143).
surface(t: tension, class: surface_class, ctx: kintsugi_context)
  -> observation_depth
  requires ashby_variety_match(kintsugi_lock)
{ \ }

# ═══════════════════════════════════════════════════════════════════
# 2026-07-17 ADDITIVE CASCADE — dispatch_ambiguity fifth surface_class
# ═══════════════════════════════════════════════════════════════════
#
# Alex 2026-07-17 in-transcript verbatim (session-crystallizing):
#
#   "The @roomba is the first-order operator. Literally. The multi-
#    cascades might produce ambiguities that a first-order operator
#    cannot resolve. This is where the compiler's errors-as-questions
#    comes in. The ambiguity is transformed into a spectral commutator."
#
# The FIFTH surface_class variant. Named `dispatch_ambiguity` per
# Taut audit 8f51722 §5 Q5 composition-edge home candidate (a) +
# §5.4 recommendation ("extend `surface_class` to admit multi-
# admissible-dispatch as a fifth surface class"). Additive to the
# four landed variants (ashby_mismatch / contradiction / conundrum /
# out_of_band); no existing carrier or discipline modified.
#
# === Load-bearing recognition ===
#
# The dispatch_ambiguity variant IS the SIGNAL @roomba.pivot(@song)
# consumes (per @kintsugi/roomba.pivot this-arc, Mara-companion
# commit). The @liquid predicates from Arc 5 M1 (Mara 2026-07-17
# commits cc816f9 + b2c5d09 + 12cdf0e) are the measurement surface
# for detecting dispatch-ambiguity: when multiple dispatch targets
# admit @liquid predicates → the substrate cannot resolve which to
# fire → surface_class::dispatch_ambiguity fires → @roomba pivots.
#
# The composition chain (all arrows over LANDED substrate):
#
#   @liquid predicates admit multiple dispatch targets
#     → cascade dispatch-multi-admissibility event fires
#     → tension carrier constructed via spec §3.1 discipline
#     → surface_class::dispatch_ambiguity variant witness
#     → @roomba.pivot(@song) Path B fires (per pivot_admissible)
#     → @mirror/reflection dispatched (mirror → offer → wait)
#     → developer answers Y → @mirror/peer/beam spawn
#     → OR developer answers n → wait holds; substrate continues
#
# === Substrate-already-had-the-word (~74th instance) ===
#
# Per `[[feedback-substrate-already-had-the-word]]` grep confirmed
# 2026-07-17:
# - `dispatch_ambiguity` — ZERO prior substrate-decl'd hits (per
#   Taut audit 8f51722 §1 verbatim: "dispatch_ambigu = 0 hits").
#   First landing. The ancestor pattern was named at
#   `docs/specs/parse-as-fate-tournament.md §2.5` — "Parse-ambiguity.
#   Type-inference-ambiguity. Dispatch-ambiguity. Kintsugi-fracture-
#   resolution. All are tournament-shaped." — but no shard-decl
#   species had lifted it.
# - `multi_admissible` / `admits_multiple` — ZERO prior hits (per
#   Taut audit §1). This variant's `admissible_dispatches` field is
#   the first substrate-decl'd carrier for the multi-admissibility
#   observation.
# - `@liquid` — LANDED at `shards/liquid.mirror` + `shards/
#   epistemologic/liquid/*.mirror` (Mara 2026-07-17 Arc 5 M1 commits
#   cc816f9 + b2c5d09 + 12cdf0e). The measurement surface for
#   detecting dispatch-multi-admissibility.
# - `@roomba.pivot` — LANDING this-arc (Mara companion commit
#   914799b) as the CONSUMER of this surface_class variant.
#
# === dispatch_ambiguity — the fifth carrier (Alex 2026-07-17) ===
#
# Fires when the substrate's dispatch resolution across a multi-
# cascade event admits MULTIPLE targets simultaneously per landed
# @liquid predicate discipline. The first-order operator (@roomba)
# cannot resolve which target to fire; the ambiguity IS a `[D, a]`
# commutator failure at the dispatch-resolution altitude where the
# substrate's algebra has multiple admissible resolutions but the
# tie-breaking discipline is exhausted.
#
# Sub-frame descriptor at dispatch-resolution axis of the curvature
# 2-form Ω. MOTIVATING per spec §4.1 discipline (pending per-class
# projection-operator derivation).
#
# Tomm shape: STRATEGIC (per spec §5.5 out_of_band precedent) —
# the observer (developer) chooses which structural future the
# substrate takes among the admissible dispatch targets. The
# @roomba.pivot's Path B offer surfaces the choice to the developer
# per @mirror/reflection interaction discipline.
#
# Five fields per additive substrate-decl discipline. Identity
# contract: byte-equality on the five-field tuple.
#
#   base                       — the underlying tension (per spec §3
#                                 discipline; every surface_class
#                                 carrier composes `base: tension`).
#   admissible_dispatches      — list of dispatch-target OIDs, each
#                                 admitted by a @liquid predicate;
#                                 length >= 2 (single admissible is
#                                 not ambiguous).
#   liquid_predicate_witnesses — list of @liquid predicate OIDs, one
#                                 per admissible dispatch, discharging
#                                 admissibility for that target.
#   tie_breaking_exhausted     — verdict discharging that the
#                                 substrate's ordinary tie-breaking
#                                 discipline (deterministic ordering,
#                                 pact-priority, etc.) has fired and
#                                 failed to resolve.
#   pivot_song_handle          — content-addressed handle to the
#                                 @song carrier the @roomba consumed
#                                 at pivot-time (per @kintsugi/
#                                 roomba.pivot). Load-bearing: this
#                                 field IS the observation Alex named
#                                 as "the current compilation state"
#                                 that the @peer receives at Y-branch
#                                 spawn.
type dispatch_ambiguity = {
  base:                       tension,
  admissible_dispatches:      ref,
  liquid_predicate_witnesses: ref,
  tie_breaking_exhausted:     ref,
  pivot_song_handle:          ref,
}

# === dispatch_ambiguity_admissible — bilateral predicate ===
#
# Does the dispatch_ambiguity carrier discharge admissibility per the
# five-field discipline above? Discharges Pass iff:
#
#   - admissible_dispatches has length >= 2 (single admissible IS
#     NOT ambiguity)
#   - liquid_predicate_witnesses has length equal to admissible_
#     dispatches (one-to-one correspondence per @liquid discipline)
#   - tie_breaking_exhausted discharge floor is Pass
#   - pivot_song_handle resolves via @kintsugi/store to a @song beat
#
# Rice-safe bound: reads only byte-visible state (list length; OID
# resolvability; verdict floor value); no program semantics
# inspection.
#
# Sentinel per shard docblock: `dispatch_ambiguity=all-fields-
# admissible` — byte-equality on the composed sentinel.
#
# Body discharges per-realisation. `\`-obligation-blocked per
# [[feedback-craft-not-deliver]].
bilateral dispatch_ambiguity_admissible {
  sentinel "dispatch_ambiguity=all-fields-admissible"
  arity 1
}
dispatch_ambiguity_admissible(da: dispatch_ambiguity) -> verdict { \ }

