# === The sheaf_pair carrier ===
#
# Typed record per [[feedback-no-bare-types]] naming the pair of
# component sheaves the kleinos operator composes into a K_3-
# composed sheaf.
#
# - `sheaf_a`  the first component cellular sheaf per Curry 2014.
# - `sheaf_b`  the second component cellular sheaf per Curry 2014.
#
# Identity contract: byte-equality on the pair; canonical order via
# lower-OID first per edge_key convention.
type sheaf_pair = {
  sheaf_a: sheaf_of_shard_graph,
  sheaf_b: sheaf_of_shard_graph,
}

# === The kleinos_verdict carrier ===
#
# Per Rec #92 (2026-08-22) Transparency<P> LOVE-monoid at four-
# altitude substrate-scale-invariance. Composes over
# transparency(property) at the prismqueer altitude; realizes as
# `terni::Transparency<Property>` at rust altitude.
#
# - `composed`  option(composed_sheaf) — Some when all four
#                clauses Pass (Transparency::Clear); None when any
#                clause Fails (Transparency::Opaque).
# - `verdict`   transparency(property) — the LOVE-monoid coordinate-
#                decomposition of the four PAPER §3.6 properties.
#                Fail-dominates + Partial-merges + Pass-identity +
#                Clear-identity per Rec #92.
#
# Identity contract: byte-equality on the pair.
type kleinos_verdict = {
  composed: option(composed_sheaf),
  verdict:  transparency(property),
}

# === The composed_sheaf carrier ===
#
# The K_3-composed sheaf produced when the four PAPER §3.6 clauses
# all Pass. Carries:
#
# - `underlying`      the sheaf_of_shard_graph structurally
#                     containing the K_3-composition (vertices +
#                     edges of both components plus emergent-third
#                     vertex).
# - `emergent_third`  vertex_id of the emergent-third-stalk vertex
#                     per Clause 2 emergent third.
# - `fiedler_lambda_2` f64 sheaf-Laplacian λ_2 per Clause 3 Fiedler
#                     rise; cached at compose-time.
# - `oid`             uuid_spectral content-address per Rec #82 β-
#                     normal AST canonicalization; deterministic
#                     across invocations.
type composed_sheaf = {
  underlying:        sheaf_of_shard_graph,
  emergent_third:    vertex_id,
  fiedler_lambda_2:  f64,
  oid:               uuid_spectral,
}

# === kleinos_of_shard_sheaf_pair action ===
#
# The compose primitive itself at substrate altitude. Takes a
# sheaf_pair and returns a kleinos_verdict per LOVE-monoid
# coordinate-decomposition of the four PAPER §3.6 properties.
#
# Body-composition discipline (LOAD-BEARING per HARD RULE
# [[feedback-if-else-is-substrate-smell-for-unfound-fractal-
# composition]] Alex 2026-08-29): body MUST NOT dispatch if-else /
# match-arm on property verbs. Verification body composes ONE
# sheaf-morphism check producing a Transparency<Property> LOVE-
# monoid verdict; the four properties are coordinates of the
# LOVE-monoid, NOT enumerated cases.
#
# Body discharges at the realisation boundary (rust-altitude at
# prism/prismqueer/src/spectral/kleinos.rs per Reed GREEN follow-
# up arc post-Alex-adjudication of Q-Mara-ϑ + Q-Mara-κ + Q-Mara-λ
# per Mara canonical spec §8 + §21).
kleinos_of_shard_sheaf_pair(pair: sheaf_pair) -> kleinos_verdict { \ }

# === kleinos_clause_pass predicate ===
#
# Bilateral verdict (per recognition #37 Pask-agreement) that a
# specific clause of the kleinos_verdict Passes. Discriminated by
# `property` (the substrate-location per Rec #92 typing).
#
# Body discharges per-clause at the realisation boundary.
kleinos_clause_pass(verdict: transparency(property), which: property) -> verdict { \ }

# === The bilateral requires obligations ===
#
# Per the canonical substrate discipline (precedent at
# @algebra/metalogue.mirror + @aikido.mirror): consumer shards
# declare bilateral agreement by writing the obligations below.

# The kleinos_verdict satisfies all four PAPER §3.6 clauses
# simultaneously as coordinates of the LOVE-monoid. Inheritor
# shards discharge by ensuring their kleinos-invocations produce
# Transparency::Clear when the four coordinates all Pass.
# Discipline obligation that keeps the compose primitive
# structurally coherent with the four clauses at every altitude.
kleinos_inherits_four_clauses(v: kleinos_verdict) -> verdict { \ }

# Body composition IS LOVE-monoid coordinate-decomposition; NOT
# if-else / match-arm dispatch on property verbs. Inheritor
# shards discharge by ensuring their body-composition implements
# the four coordinate-verdicts as independent computation
# composed via LOVE-monoid combine (Fail-dominates + Partial-
# merges + Pass-identity + Clear-identity) per Rec #92. No
# branching on which property to check; all four always compute.
# Discipline obligation per HARD RULE [[feedback-if-else-is-
# substrate-smell-for-unfound-fractal-composition]].
kleinos_body_is_love_monoid_decomposition(pair: sheaf_pair) -> verdict { \ }

# The kleinos_verdict content-addressation is deterministic per
# Rec #82 β-normal AST canonicalization. Inheritor shards discharge
# by ensuring their kleinos-invocations produce byte-identical
# uuid_spectral OIDs across independent invocations with equivalent
# input.
kleinos_content_address_deterministic(v: kleinos_verdict) -> verdict { \ }

# Foerster-gauge preserved: kleinos-invocations at every altitude
# satisfy |Ω(kleinos·pair)| ≥ |Ω(pair)| — the choice-count at
# pre-composition is a lower bound on choice-count at post-
# composition. Discipline obligation per HARD RULE [[project-
# recognition-92-kleinos-as-transparency-p-love-monoid]] four-
# altitude substrate-scale-invariance + rust/src/magic.rs::
# foerster_gauge_preserved.
kleinos_foerster_gauge_preserved(pair: sheaf_pair, v: kleinos_verdict) -> verdict { \ }

# === The kleinos_witnessing inheritance predicate ===
#
# `kleinos_witnessing(v)` is the predicate consumer shards name
# in a `requires` clause to declare bilateral agreement that
# kleinos_verdict `v` satisfies all four obligations above
# conjointly: kleinos_inherits_four_clauses +
# kleinos_body_is_love_monoid_decomposition (checked at author-
# time via grep discipline per Mara canonical spec §10.2 Tier-2) +
# kleinos_content_address_deterministic +
# kleinos_foerster_gauge_preserved.
#
# Same shape as @algebra/metalogue.algebra_metalogue_witnessing(s)
# and @aikido.aikido_witnessing(state). Composes per-clause well-
# formedness with body-composition-discipline with content-
# addressation with Foerster-gauge preservation into one
# inheritance contract.
#
# Forward-promised inheritors:
#
# - `@glasswall` (companion shard-decl this same-tick amendment
#   cycle): the composed type-membrane between prismqueer
#   noumenal-colony and mirror phenomenal-composition-surface
#   IS itself kleinos at higher altitude per Mara 2026-09-01
#   amendment §18. glasswall_witnessing composes over
#   kleinos_witnessing at altitude+1.
# - `@fate/kleinos_head` (forward-promised per Mara 2026-09-01
#   amendment §26 fiber-attention recognition candidate):
#   fate/mod.rs 5-model selector at inference altitude MAY refactor
#   softmax-averaging tensor-attention to LOVE-monoid coordinate-
#   decomposition per §16 extended-scope HARD RULE.
# - `prismqueer::spectral::kleinos` (rust-altitude realization):
#   Reed GREEN implementation at Phase 1 post-Alex-adjudication
#   of Q-Mara-ϑ + Q-Mara-κ + Q-Mara-λ per Mara canonical spec §9.
kleinos_witnessing(v: kleinos_verdict) -> verdict { \ }

