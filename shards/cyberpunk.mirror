# === The cybernetic_state carrier ===
#
# A typed reference per [[feedback-no-bare-types]] naming the
# substrate-altitude cybernetic state. The substrate-architectural
# object the @cyberpunk family operates on. Species (eigenform,
# distinction, viable, autopoiesis, etc.) refine this carrier with
# species-altitude shapes.
#
# Identity contract: byte-equality on the underlying ref.
type cybernetic_state = ref

# === The recursion_lock carrier ===
#
# A typed reference naming the recursion-lock primitive per recognition
# #63. The principal 2-groupoid bundle structure the family-root
# carries. Species shards refine this for per-altitude recursion-lock
# discharge.
#
# Identity contract: byte-equality on the underlying ref.
type recursion_lock = ref

# === tower_close action ===
#
# The substrate-vocabulary action that verifies a cybernetic_state
# closes its recursion-lock tower per recognition #63. The substrate-
# architectural primitive: a cybernetic state IS coherent IFF its
# recursion-lock tower closes per the canonical-rep witnesses (5+
# species per yesterday's audit).
#
# Body discharges at the realisation boundary; species sub-prisms
# (eigenform via fixed-point witness; distinction via Spencer-Brown
# cross; viable via Beer S3/S4; etc.) implement per-altitude tower
# closure.
tower_close(s: cybernetic_state) -> verdict { \ }

# === cybernetic_coherence predicate ===
#
# Bilateral verdict predicate consumer shards name in a `requires`
# clause per recognition #37 (Pask agreement). The substrate-
# architectural commitment that a cybernetic state maintains coherence
# across its species altitudes — the recursion-lock tower's tower-
# closing discharge.
#
# Same shape as @magic's invariant_preserved, @frame's
# bounded_commutator_check. Consumer species (and the @smarts
# integration) name this when they require the @cyberpunk family's
# discipline to discharge.
cybernetic_coherence(s: cybernetic_state) -> verdict { \ }

out @cyberpunk
out cybernetic_state
out recursion_lock
out tower_close
out cybernetic_coherence
