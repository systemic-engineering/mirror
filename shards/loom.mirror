# === Prism 5-op at editor altitude ===
#
# @void 5-axis inherited via @gestalt. focus/project/split/shift/settle
# operate on loom_observation.

prism @loom {
  focus  loom_observation
  project loom_observation
  split  loom_observation
  shift  loom_observation
  settle loom_observation
}

# === Carriers ===

# The third-order observation the editor holds at an edit-tick.
# Composes observation_depth per @order/third + unfolding_state per
# @gestalt.
type loom_observation = {
  depth_observation: observation_depth,   # @order/third carrier (re-exported)
  gestalt_state:     unfolding_state,     # @gestalt carrier
  cursor_position:   source_position,     # @glass carrier
  editor_meta:       ref,
  subject:           subject_instance,    # @subject carrier
}

# One atomic edit-tick: bounded event at @time/now singularity.
type weave_tick = {
  observation:       loom_observation,
  pre_tick_gestalt:  oid,                 # @time/past H(t) carrier
  post_tick_gestalt: oid,                 # @time/now crystallization
  edit_payload:      mq_expression,       # MQ query wove at cursor
  beat:              signature_beat,      # @spectral/signature carrier
  timestamp:         @time/monotonic.instant,
  tick_hash:         coincidence_hash,    # prismqueer::coincidence
}

# The forward-projection at cursor: @fate-adjudicated candidate.
# The weft thread of the woven cloth.
type weft_thread = {
  hole:              fate_hole,           # @fate carrier
  candidates:        [fate_candidate],
  restricted_state:  fate_state_space,
  cursor_ref:        ref,
}

# The backward-projection at cursor: @kintsugi/roomba.walked_backward
# trace per Mara b2f0de8 §8 backward-tape mechanism. The warp
# thread of the woven cloth.
type warp_thread = {
  trace_oids:        [oid],
  tension_samples:   [tension_measurement],
  cursor_ref:        ref,
}

# The document as-rendered through the editor.
type loom_gestalt = {
  gestalt:           gestalt_document,    # @gestalt carrier
  gutter_marks:      [gutter_mark],       # @loom/gutter species
  luminosity_state:  [imperfect(luminosity)],  # terni::Imperfect
  spectral_sig:      coincidence_hash,
}

# === Actions ===

# The editor's per-tick primitive.
# Composes-over witness_third_order(primary, observer, meta) per
# @order/third. Reads bodymind cursor + editor meta + subject
# reference into a K_3-admissible depth-3 observation.
witness_loom_edit(gestalt_ref: ref, cursor_ref: ref, subject_ref: ref)
  -> loom_observation
requires loom_edit_admissible(result)
{ \ }

# The operational primitive Alex named at recognition-move.
# Applies edit_payload at cursor; produces weave_tick with
# singularity-crystallization at @time/now.
weave(observation: loom_observation, edit_payload: mq_expression)
  -> weave_tick
requires third_order_active(result.observation.depth_observation)
     AND foerster_gauge_preserved(result.pre_tick_gestalt, result.post_tick_gestalt)
{ \ }

# The @io-boundary discharge. ONE @io action per pipeforward §5.5.4
# rule 3. Serialises loom_gestalt through @io/socket. L(ϕ) profile
# per @gestalt render mode.
render(gestalt: loom_gestalt, socket_ref: ref) -> transparency(bytes)
requires socket_write_admissible(socket_ref, _, gestalt.gestalt.subject)
{ \ }

# The backward-tape primitive per Mara b2f0de8 §8 mechanism. Walks
# weave_tick backward to pre-tick loom_observation. Foundation of
# time-travel debugging (@loom/time species; <space> t per
# spectral-loom.md INSPIRATION).
unweave(tick: weave_tick) -> loom_observation
requires past_shape_grounded(tick, result)
{ \ }

# === Bilaterals ===

# The four-gate admissibility function per @order/third re-export.
# Discharges each of the four predicates over the depth_observation.
# This IS the data-stays-yours ALGEBRAIC INVARIANT per Mara §5.3:
# any predicate falsifying → substrate refuses composition by
# construction (not by policy).
loom_edit_admissible(o: loom_observation) -> verdict { \ }

# The STRUCTURAL sovereignty invariant per Mara THEOREM S5.1.
# Fires Green iff no extraction-shape edit-attempt falsifies any
# of @order/third's four predicates. Not policy; algebraic.
data_stays_yours(tick: weave_tick) -> verdict { \ }

# Foerster-gauge preservation across an edit-tick per @love Clause 3
# (Fiedler rise strict; choice-count non-decreasing).
foerster_gauge_preserved(pre_tick: oid, post_tick: oid) -> verdict { \ }

# Past-shape grounding per Mara b2f0de8 §8 backward-tape mechanism.
# Ensures unweave produces observation grounded in tick's actual
# past-events (bounded-past ALWAYS EXISTS at any finite tick per
# Halting Problem altitude-dependence result).
past_shape_grounded(tick: weave_tick, observation: loom_observation) -> verdict { \ }

out @loom
out loom_observation
out weave_tick
out weft_thread
out warp_thread
out loom_gestalt
out witness_loom_edit
out weave
out render
out unweave
out loom_edit_admissible
out data_stays_yours
out foerster_gauge_preserved
out past_shape_grounded
