# JSON-RPC 2.0 initialize handshake response envelope. Per MCP protocol
# spec (Anthropic 2024-11-05): initialize returns protocolVersion +
# capabilities + serverInfo. Body composition composes over @data/json.emit
# for the response literal.
initialize_result(id: ref) -> @mcp.response { \ }

# Verdict → JSON-RPC response envelope. Per Reed bootstrap dispatch_tool_call
# marshaling (bootstrap/src/mcp.rs::dispatch_tool_call ~line 250-441):
# Verdict::Pass    → { "result": { "content": [{ "type": "text", "text":
#                                                 "Pass" }], "isError": false }}
# Verdict::Fail(r) → { "result": { "content": [{ "type": "text", "text":
#                                                 "Fail: <r>" }], "isError": true }}
verdict_to_result(verdict: @apply_h.verdict, id: ref) -> @mcp.response { \ }

# JSON-RPC 2.0 §5.1 error envelope: code -32601 (method not found) +
# message string. Preserves request.id per JSON-RPC 2.0 correlation.
error_method_not_found(method: text, id: ref) -> @mcp.response { \ }

# JSON-RPC 2.0 §5.1 error envelope: code -32602 (invalid params;
# tool-name-not-found variant). Preserves request.id.
error_tool_not_found(name: text) -> @mcp.response { \ }

# JSON-RPC 2.0 §4.1.2 notification (no response). notifications/initialized
# is client-→server acknowledgment; no wire echo.
no_response -> @mcp.response { \ }

# === Tool spec declarations (byte-parity with bootstrap tools_list_result) ===
#
# Each tool_spec carries name + description + inputSchema per MCP protocol
# spec (Anthropic 2024-11-05). Descriptions + inputSchemas byte-parity with
# bootstrap/src/mcp.rs::tools_list_result at HEAD 2026-08-06; grep-verified
# per Mara Fire B canonical spec §4.1 enumeration.
#
# Phase 1 (this landing): substrate-decl'd tool_spec records; Reed Fire C
# tick 2 realization composes each spec into JSON at wire-emit altitude via
# @data/json.emit.
#
# Phase 2 (M5 co-tick): reflective walk lifts tool_spec generation to
# @mcp/tool annotation harvest from landed shards; hardcoded tool_specs
# below retire.

type tool_spec = {
  tool_name:   ref,
  description: ref,
  input_schema: ref,
}

# Post-2026-08-28 manifold-native ONE-tool wire: tool_mirror_query is the
# sole tool_spec exposed via @mcp.tools. Description + inputSchema literals
# live at rust/src/main.rs::response_tools_list (Reed ec02f8e); substrate-
# decl surface here names the tool. inputSchema admits a single required
# argument `mq_expression: string` carrying the MQ expression parsed via
# parse_mq_expression above.

tool_mirror_query      -> tool_spec { \ }

