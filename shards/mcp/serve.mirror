glass @mcp/serve {
  focus  jsonrpc_frame
  project jsonrpc_frame
  split  jsonrpc_frame
  shift  jsonrpc_frame
  settle jsonrpc_frame
}

# === The jsonrpc_frame carrier ===
#
# The record capturing one MCP wire round-trip. Per JSON-RPC 2.0 (Groove 2010)
# + MCP (Anthropic 2024-11-05): request + response envelope with method + params
# + id fields. THIS shard's `serve` action body reads one jsonrpc_frame per
# tick, dispatches through the pipe chain, emits one response jsonrpc_frame.
#
# Five fields per JSON-RPC 2.0 §4 (request) + §5 (response):
#
#   direction         inbound (request) | outbound (response)
#   method            (inbound only) e.g. "initialize" | "tools/list" |
#                      "tools/call" | "notifications/*"
#   params            (inbound only) request params object; tool-call params
#                      carry name + arguments fields
#   result            (outbound success only) response result object
#   error             (outbound failure only) JSON-RPC error envelope per
#                      §5.1 with code + message + optional data
#   id                request/response correlation identifier (may be null
#                      for notifications per §4.1.2)
#
# Identity contract: byte-equality on direction + (method,params,id) for
# inbound OR (result|error,id) for outbound.
type jsonrpc_frame = {
  direction: ref,
  method:    ref,
  params:    ref,
  result:    ref,
  error:     ref,
  id:        ref,
}

# === serve — the composition-shard body ===
#
# Reads one JSON-RPC frame from stdin, parses, dispatches via @mcp.dispatch
# (whose body THIS shard fills below), emits response, writes to stdout.
# Loop iteration is discharged by the `imperfect` runtime discipline
# inherited from boot/std/mcp.mirror:64 `serve -> imperfect` declaration.
#
# The pipe chain composes over rust/-altitude primitives:
#
#   phone::read_stdin_frame  ⇦  @io/stdio.read_frame
#         |>
#   wire::parse              ⇦  @data/json.parse
#         |>
#   [dispatch body below]    ⇦  @mcp.dispatch  (body-filled at species
#                                                  altitude by THIS shard)
#         |>
#   wire::emit               ⇦  @data/json.emit
#         |>
#   phone::write_stdout_frame  ⇦  @io/stdio.write_frame
#
# The `imperfect` marker signals the loop-iteration discipline (per
# boot/std/mcp.mirror); runtime re-invokes `serve` on next frame; state
# persists across ticks in @mirror/store via mcp_session gen_prism.
serve -> imperfect {
  @io/stdio.read_frame
    |> @data/json.parse
    |> @mcp.dispatch
    |> @data/json.emit
    |> @io/stdio.write_frame
}

# === serve_socket — Phase 2 forward-promise ===
#
# Socket-transport variant (TCP + Unix). Family-extension per Alex 2026-08-06
# [ALEX-Q5] RATIFIED: @io/socket TCP is family-extension not fork; Unix landed
# at phone.rs iter 9 empirical; TCP composition wire lands at M8-adjacent
# tick when peer-beam-over-TCP + MCP-over-HTTP + LSP-JSON-RPC-over-TCP
# variants pull.
#
# `\`-obligation-blocked per [[feedback-craft-not-deliver]]; consumers pull
# realization when socket-transport wire surfaces.
serve_socket(listener: ref) -> imperfect { \ }

# === dispatch — body-fill for @mcp.dispatch at boot altitude ===
#
# The @mcp.dispatch action is DECLARED at boot/std/mcp.mirror:71 as
# `dispatch(request) -> response { \ }` (body-obligation-blocked at boot
# altitude). THIS composition-shard fills the body at species altitude
# per the compose-over body-fill discipline enumerated in Mara Fire B
# canonical spec §7 row 1.
#
# POST-2026-08-28 manifold-native ONE-tool rewire (Reed ec02f8e per Alex
# verbatim "follow the shape the geometry and manifold wants"): the
# tools/call arm no longer looks up a tool-name in a hardcoded map — it
# parses the request's arguments.mq_expression string via the MQ surface-
# level parser (whitespace-split; first token = action_ref; remaining tokens
# = positional args) and dispatches via apply_h::act(root, action_ref, args)
# directly. The tool-name field is checked equals "mirror_query" (the ONE
# tool per manifold-native geometry); any other tool-name returns
# error_tool_not_found.
#
# Match arms on request.method:
#
#   "initialize"                → initialize_result (protocol handshake)
#   "tools/list"                → { "tools": tools, "id": request.id }
#                                  (composes over @mcp.tools body-fill below;
#                                   ONE-tool per manifold-native geometry)
#   "tools/call"                → parse_mq_expression(
#                                     request.params.arguments.mq_expression)
#                                     |> apply_h.act(_, root)
#                                     |> verdict_to_result(_, request.id)
#                                   (when request.params.name == "mirror_query";
#                                    else error_tool_not_found)
#   "notifications/*"           → (no response; JSON-RPC notification)
#   _ (unknown method)          → error_method_not_found(request.method,
#                                                         request.id)
#
# Full MQ expression parse (Mara #398 canonical @mq family-root algebra)
# forward-promised: surface-level parser at rust/ altitude (Reed ec02f8e
# transitional interpreter) lifts to substrate composition altitude when
# prismqueer::spectral::compose lands (Q-Mara-η ratified 2026-08-26).
dispatch(request: @mcp.request) -> @mcp.response {
  match request.method {
    "initialize"                => initialize_result(request.id),
    "tools/list"                => { "tools": tools, "id": request.id },
    "tools/call"                => match request.params.name {
                                     "mirror_query" => parse_mq_expression(
                                       request.params.arguments.mq_expression)
                                         |> apply_h.act(_, root)
                                         |> verdict_to_result(_, request.id),
                                     _              => error_tool_not_found(
                                                        request.params.name)
                                   },
    "notifications/initialized" => no_response,
    _                           => error_method_not_found(request.method,
                                                          request.id)
  }
}

# === tools — body-fill for @mcp.tools at boot altitude ===
#
# The @mcp.tools action is DECLARED at boot/std/mcp.mirror:76 as
# `tools -> json { \ }` (body-obligation-blocked at boot altitude). THIS
# composition-shard fills the body at species altitude per compose-over
# body-fill discipline.
#
# POST-2026-08-28 manifold-native ONE-tool rewire (Reed ec02f8e per Alex
# 2026-08-28 verbatim): tools list exposes ONE tool — tool_mirror_query —
# per manifold-native geometry. The mirror_query tool IS the fractal
# recursive Mandelbrot attention head at wire altitude; its inputSchema
# admits an mq_expression string carrying the substrate-action-ref + args
# natively. Every landed bilateral action_ref becomes wire-addressable at
# MQ-expression dispatch altitude (via apply_h::act's bilateral corpus
# load), NOT at tools/list altitude.
#
# SUPERSEDED 2026-08-28 by manifold-native ONE-tool rewire: the retired
# Phase 1 11-tool byte-parity JSON literal (mirror_compile / mirror_craft /
# mirror_kintsugi / mirror_init / mirror_recall / mirror_peer_beam /
# mirror_beam / mirror_spawn / mirror_beam_act / mirror_roomba /
# mirror_index) collapses INTO mirror_query MQ expressions. Phase 2 M5
# reflective walk over @mcp/tool annotations also SUPERSEDED: annotations
# landscape moves INTO apply_h::act bilateral corpus dispatch, not into
# tools/list expansion.
tools -> json {
  [ tool_mirror_query ]
}

# === parse_mq_expression — MQ surface-level parser ===
#
# The manifold-native tools/call arm parses the request's
# arguments.mq_expression string into (action_ref, args) tuple via
# whitespace-split: first token = substrate action_ref (grep-verifiable at
# shards/**/*.mirror); remaining tokens = positional args passed to
# apply_h::act's bilateral corpus dispatch.
#
# Reed ec02f8e (2026-08-28) rust/-altitude transitional interpreter
# performs the whitespace-split parse inline in response_tools_call; this
# substrate-decl surface names the composition shape. Full MQ expression
# parse (Mara #398 canonical @mq family-root algebra + Mara #400 six-piece
# autopoietic loop spec §5 MQ parser at .mirror altitude) lifts parsing to
# substrate composition altitude when prismqueer::spectral::compose lands
# (Q-Mara-η ratified 2026-08-26).
#
# Sentinel: `mq-parse=whitespace-split-action-ref-plus-args` — surface-
# level parse discipline byte-visible at rust/-altitude call site.
#
# `\`-obligation-blocked; realized at rust/-altitude by Reed ec02f8e until
# substrate-altitude MQ parser lands per Q-Mara-η.
parse_mq_expression(mq_expr: text) -> (action_ref: ref, args: list<text>) { \ }

