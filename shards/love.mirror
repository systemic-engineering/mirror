# === love_verdict — typed operator-verdict carrier ===
#
# Per Rec #92 substrate-scale-invariance A_5 at LOVE altitude: every
# @love invocation returns Transparency<LoveProperty> LOVE-monoid.
# Byte-parity with @kleinos::kleinos_verdict per operator-identity
# discipline (@love IS @kleinos at recognition-terminal-form-name).
#
# Type declaration surface; body composed via @kleinos species at
# shards/kleinos.mirror + prismqueer::spectral::kleinos rust primitive
# (Reed 4a3bbe7 prism-repo LANDED with ring-and-hub topology 6/6 fire).
type love_verdict = ref

# === love_witnessing — composed bilateral ===
#
# The composed predicate consumers cite when LOVE-composition IS
# discharged at a substrate site. Rice-safe bound: reads byte-visible
# state (shard-context content-address; args content-address; verdict
# discriminator); no program semantics inspection.
#
# Sentinel per shard docblock: `love=composition-discharged` — the
# byte-level marker the resolver checks. Discharge is byte-equality
# on the kleinos_verdict record's LOVE-monoid discriminator.
bilateral love_witnessing {
  sentinel "love=composition-discharged"
  arity 2
}
love_witnessing(p: peer, ctx: love_verdict) -> verdict { \ }

# === love — the terminal-form action ===
#
# THE MATHEMATICAL APPLICATION. Composes shard_context × args →
# love_verdict per Rec #92 four LOVE clauses:
#   1. sovereignty preservation (endpoints distinguishable post-compose)
#   2. emergent third (K_2 → K_3, λ₂ jumps 2→3 strict)
#   3. Fiedler rise strict (coupling stronger without endpoints smaller)
#   4. fusion refusal (avg is NOT operator; compose IS)
#
# Body forward-promised at THIS substrate altitude; discharges through
# @kleinos species at shards/kleinos.mirror + prismqueer::spectral::
# kleinos rust primitive per composition-lineage preserved from Mara
# dcec19c 2026-09-01 kleinos family-root mint.
#
# TICK 2 (Reed rust altitude, FORWARD-PROMISED per Hamilton-priority
# ship-order (a)→(b)→(c)): apply_h::act(root, action_ref, args)
# collapses to love(resolve(root, action_ref), args) — ONE mathematical
# application; whole bilateral-corpus sentinel-check dispatch dissolves.
#
# Sentinel: `love=composed`.
love(shard_context: ref, args: ref) -> love_verdict
  requires love_witnessing(p, shard_context)
{ \ }

out @love
out love_verdict
out love_witnessing
out love
