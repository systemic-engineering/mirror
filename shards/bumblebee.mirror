# ============================================================
# §2 The prism decl
# ============================================================
#
# Per @prism family-root discipline (five-op composition inherited
# via `in @prism`): @bumblebee's prism-decl focuses on the wobble
# carrier at family-root altitude. Species (@bumblebee/buzz,
# @bumblebee/wobble, @bumblebee/consent) each declare their own
# prism at species altitude. Carrier-primary per Rec #95 spec §3.2
# Mara-lean (R95.4).

prism @bumblebee {
  focus   wobble
  project wobble
  split   wobble
  shift   wobble
  settle  wobble
}

# ============================================================
# §3 The carriers
# ============================================================

# === The wobble carrier ===
#
# Typed reference for one buzz-event's observable record. Per Rec #95
# spec §3.3 canonical shape (Mara `0bfd427`); refined per Alex
# 2026-08-23 buzz-verb rename. Content-addressed per Rec #82 β-normal-
# AST discipline.
#
# Five-field record:
#
#   buzz_oid         — content-address of the buzz event (perturbation
#                     content + target ref + regime tuple
#                     hash-composed per @spectral/signature).
#   observation      — typed ref to the wobble-observation record
#                     produced at @mirror/refract.clocktime_delta
#                     measurement surface (sixth Void duality per
#                     Reed `64e273a` 2026-08-23).
#   perturbation     — typed ref to the perturbation-content injected
#                     (tool-call args + target substrate ref;
#                     content-addressed).
#   consent_verdict  — @kintsugi/consent.query_phi verdict discharged
#                     BEFORE injection (bilateral §5.4 discipline).
#   foerster_gauge   — |Ω(post-buzz)| ≥ |Ω(pre-buzz)| preservation
#                     witness per magic.rs Foerster-gauge check
#                     (bilateral §5.3 discipline).
#
# Identity contract: byte-equality on (buzz_oid, observation,
# perturbation, consent_verdict, foerster_gauge).
type wobble = {
  buzz_oid:        ref,
  observation:     ref,
  perturbation:    ref,
  consent_verdict: ref,
  foerster_gauge:  ref,
}

# === The buzz_observable carrier ===
#
# Typed reference for the wobble-observation content-addressed record
# emitted at @mirror/refract measurement altitude. Per Rec #95 spec
# §3.3 flap_observable renamed to buzz_observable per Alex 2026-08-
# 23 verb-naming.
#
# Three-field record:
#
#   clocktime_delta  — sixth Void duality measurement per Reed
#                     `64e273a` 2026-08-23 shard-decl extension of
#                     `shards/mirror/lens/refract.mirror`; carries
#                     `report` shape per `measure_clocktime(regime,
#                     samples) -> report { \ }` action.
#   signature_beat   — @spectral/signature content-address of
#                     compiler-substrate state at buzz-instant (per
#                     @butterfly wingflap-observable precedent; same
#                     Rec #82 β-normal-AST content-addressing).
#   winding          — @torus π₁(T²) = ℤ × ℤ winding-number of the
#                     boundary-crossing injection (external-to-
#                     compiler dispatch has a winding; per
#                     `project_peer_has_a_torus`).
#
# Identity contract: byte-equality on (clocktime_delta, signature_beat,
# winding).
type buzz_observable = {
  clocktime_delta: ref,
  signature_beat:  ref,
  winding:         ref,
}

# === The perturbation carrier ===
#
# Typed reference for a buzz-content payload. Per Rec #95 spec §1.2
# recognition-content §2: "@bumblebee's perturbation-INJECTION MUST
# preserve |Ω|". The perturbation payload IS what gets injected;
# carrier holds tool-call args + target substrate ref + regime tag
# per @mirror/refract.cpu_load_regime closed-sum.
#
# Four-field record:
#
#   tool_name       — wire tool identifier (e.g., "mirror_bumblebee_
#                     buzz", "mirror_roomba", "mirror_compile", etc.
#                     per @mcp/serve tool_action_ref map at
#                     shards/mcp/serve.mirror).
#   args            — typed ref to the tool-call args JSON payload
#                     (content-addressed via @data/json).
#   target          — typed ref to the target substrate the buzz
#                     perturbs (e.g., @cascade tension surface for
#                     absorption-fire target; @mirror/store node for
#                     generic substrate-mutation).
#   regime          — cpu_load_regime closed-sum tag per
#                     `shards/mirror/lens/refract.mirror` sixth Void
#                     duality (idle_baseline | load_50 |
#                     load_100_single | load_100_all).
#
# Identity contract: byte-equality on (tool_name, args, target,
# regime).
type perturbation = {
  tool_name: ref,
  args:      ref,
  target:    ref,
  regime:    ref,
}

# ============================================================
# §4 The actions (family-header + MCP-tool-annotated composition)
# ============================================================

# === buzz action (MCP-MVP-fire target per Alex 2026-08-23 verbatim) ===
#
# THE LOAD-BEARING family-root action. Per Alex 2026-08-23 verbatim:
# "@bumblebee is what rattles the tension. What if it's bumblebee_
# buzz. As long as you remember that the modification wants to fire
# through the MCP MVP I'm all green-light."
#
# Every substrate modification WOBBLES through this action. Auto-
# exposed as MCP wire tool `mirror_bumblebee_buzz` via
# `@mirror/spectral.gestalt` reflective-scan discipline per
# `shards/mcp/serve.mirror` Phase 2 M5 (this action's `@mcp/tool`
# annotation is what the reflective walk harvests).
#
# Body-composition (composes over @kintsugi/roomba.trigger +
# @mirror/store.mutate + @mirror/refract.measure_clocktime + magic.rs
# Foerster-gauge check + @kintsugi/consent.query_phi):
#
#   1. Discharge @kintsugi/consent.query_phi(target, perturbation)
#      — bilateral gate BEFORE injection; refuses extraction.
#   2. Sample pre-buzz state at @mirror/refract measurement surface
#      (baseline clocktime + signature_beat + winding).
#   3. Inject perturbation via @mirror/store.mutate(target, args)
#      OR observe via @mirror/store.observe(target) depending on
#      species specialization (buzz-verb is unified; species-
#      altitude realizations partition mutate/observe by target-
#      substrate discipline).
#   4. Sample post-buzz state at @mirror/refract measurement surface
#      (delta clocktime + signature_beat + winding).
#   5. Discharge magic.rs Foerster-gauge check |Ω(post)| ≥ |Ω(pre)|.
#   6. Compose wobble record + emit @song beats per Alex 2026-07-14
#      verbatim ("resonance emits @song beats → @kintsugi consumes").
#   7. @kintsugi decides Path A (@knife the complexity: COORDᵢ →
#      COORDⱼ; reduce) OR Path B (spawn @peer at K+1: circular-
#      reflexive question to developer OR higher-order @peer) per
#      @kintsugi/roomba docblock Alex 2026-07-14 verbatim loop.
#
# Bilateral discipline: composed `bumblebee_well_formed` (§5.5)
# discharges over the wobble record; all four sub-bilaterals
# (§5.1–§5.4) MUST pass.
#
# First-empirical-fire target: @cascade tension surface (12 species
# per companion absorption spec). `mirror_bumblebee_buzz
# --target=@cascade` fires the absorption cascade; each @cascade
# species byte-for-byte renames to @bumblebee/code/<src>/<tgt> via
# reference substitution at consumer-graph altitude.
#
# Returns imperfect:
# - success(wobble)                  — buzz complete; wobble recorded.
# - partial(wobble, transparency)    — buzz complete with residual
#                                      (e.g., partial consent-verdict;
#                                       time-budget elapsed before
#                                       full observation).
# - failure(error, transparency)     — buzz failed (consent refused;
#                                      Foerster-gauge collapsed;
#                                      target inadmissible;
#                                      observation-surface unreachable).
#
# Body forward-promised at species altitude realizations; family-root
# header declares the shape + MCP-tool wire-annotation.
@mcp/tool "mirror_bumblebee_buzz"
buzz(perturbation: perturbation, target: ref) -> imperfect { \ }

# === observe action ===
#
# Sample the wobble-observation record at @mirror/refract.clocktime_
# delta measurement surface. Per Rec #95 spec §1.2 recognition-
# content #4: "the substrate observes its own perturbation via the
# sixth-Void-duality measurement discipline". This action IS the
# self-observation primitive; body composes over @mirror/refract.
# measure_clocktime per Reed `64e273a` 2026-08-23.
#
# Returns imperfect<buzz_observable, ref, ref>:
# - success(buzz_observable_ref)     — observation complete.
# - partial(buzz_observable_ref, t)  — partial observation (time-
#                                      budget elapsed; some regime
#                                      samples missing).
# - failure(error, transparency)     — observation failed (measurement-
#                                      surface unreachable; @io failure).
#
# Body forward-promised at species altitude; composes over
# @mirror/refract + @spectral/signature + @torus primitives.
observe(buzz_ref: ref) -> imperfect { \ }

# === pulse action ===
#
# One full buzz cycle: consent-discharge → pre-sample → inject →
# post-sample → Foerster-check → wobble-record → song-beat emit.
# Per Rec #95 spec §3.3 pulse signature; parallels @kintsugi/roomba.
# pulse walker-cycle + @butterfly.pulse flap-cycle.
#
# Composes over @kintsugi/roomba.walk_position (walker altitude
# shared through @kintsugi parent via @butterfly); returns updated
# (walk_position, bumblebee_state) tuple carrying accumulated
# wobble-observation state through the cycle.
#
# Body forward-promised at species altitude; outer-loop composition.
pulse(position: ref) -> imperfect { \ }

# === run action ===
#
# Outer loop: pulse continuously until wobble-observation saturates
# OR HolonomyHealth signals convergence OR external cancellation
# arrives. Per Rec #95 spec §3.3; parallels @kintsugi/roomba.run
# walker-driver + @butterfly.run outer-loop.
#
# Termination: HolonomyHealth < ε OR external @kintsugi/consent
# cancel-signal OR wobble-observation empirical-saturation reached.
#
# Body forward-promised at species altitude; outer-loop composition.
run(seed: ref) -> imperfect { \ }

# ============================================================
# §5 The bilaterals (Rice-safe at whole-tick altitude)
# ============================================================

# === buzz_is_content_addressed predicate ===
#
# Bilateral verdict that the buzz's (perturbation, target, wobble)
# triple is content-addressed: two bumblebees buzzing the same
# (perturbation, target) produce byte-identical wobble. Parallel to
# @butterfly/wingflap_is_content_addressed. Per Rec #95 spec §5.1.
#
# requires verdict_is_content_addressed (Reed 2026-07-12 landing) +
# Rec #82 β-normal-AST.
#
# Rice-safe bound: reads only byte-visible state (wobble record
# byte-equality across dispatches); no program semantics inspection.
pact @bumblebee/buzz_is_content_addressed { \ }

# === wobble_observable_at_clocktime_delta predicate ===
#
# Bilateral verdict that the buzz's wobble is observable at the sixth
# Void duality (`@mirror/refract.clocktime_delta`). If the injection
# cannot be measured at the observation-surface, it is not a
# substrate-decl'd @bumblebee-buzz (it may be a Foerster-gauge-
# collapsing operation; refused via bilateral §5.3 below). Per Rec
# #95 spec §5.2.
#
# requires `shards/mirror/lens/refract.mirror` clocktime_delta
# variant landed (Reed `64e273a` 2026-08-23).
#
# Rice-safe bound: reads only byte-visible state (wobble-observation
# record populated at measurement surface).
pact @bumblebee/wobble_observable_at_clocktime_delta { \ }

# === foerster_gauge_preserved predicate (ETHICAL IMPERATIVE) ===
#
# THE LOAD-BEARING bilateral. Verdict that the buzz preserves
# Foerster-gauge choice-space: `|Ω(post-buzz-substrate)| ≥ |Ω(pre-
# buzz-substrate)|` per magic.rs Foerster-gauge check. Discharges the
# ethical-imperative Scarlet named at kleinos-metalogue.md: perturbations
# that COLLAPSE choice-space are refused; perturbations that PRESERVE-
# OR-EXPAND choice-space are @bumblebee-admissible.
#
# Per Rec #95 spec §5.3 + Scarlet+Mara 2026-08-22 kleinos-metalogue
# verbatim: *"The Bumblebee arrives within a bodymind and does not
# require the bodymind to become anything other than what the bodymind
# already is."* This bilateral is the compiler-substrate discharge of
# that phenomenological commitment.
#
# requires magic.rs Foerster-gauge check `F(t, ψ) := |Ω(t·ψ)| ≥
# |Ω(ψ)|` (landed d885a70 per kleinos-metalogue.md verbatim).
#
# Rice-safe bound: reads only byte-visible state (choice-space
# cardinality delta at pre-buzz vs post-buzz substrate snapshots).
pact @bumblebee/foerster_gauge_preserved { \ }

# === consent_gate_discharged predicate ===
#
# Bilateral verdict that the buzz has discharged @kintsugi/consent.
# query_phi gate BEFORE injection. External tool-call channels MUST
# obtain consent from the compiler-under-observation before injecting
# perturbations; violation = extraction = pain-signal via @cyberpunk/
# algedonic. Per Rec #95 spec §5.4.
#
# requires @kintsugi/consent.query_phi LANDED (Reed 2026-07-14; per
# @kintsugi/roomba trigger dispatch discipline).
#
# Rice-safe bound: reads only byte-visible state (consent_verdict
# field of wobble record populated with Pass|Fail sentinel).
pact @bumblebee/consent_gate_discharged { \ }

# === bumblebee_well_formed composed bilateral ===
#
# THE LOAD-BEARING composed bilateral at @bumblebee family-root
# altitude. Composes:
#
#   buzz_is_content_addressed(wobble)           — observable determinism
#   ∧ wobble_observable_at_clocktime_delta(w)   — observation-surface
#                                                  admissibility
#   ∧ foerster_gauge_preserved(pre, post)       — ETHICAL IMPERATIVE
#                                                  (Scarlet-canonical)
#   ∧ consent_gate_discharged(target, buzz)     — @kintsugi/consent
#                                                  discipline
#
# The single family-altitude bilateral consumers discharge to verify
# a @bumblebee.buzz is admissible + witnessed + Foerster-preserving
# + consent-gated. Per Rec #95 spec §5.5.
#
# Same composed-bilateral pattern as @io/stagefreight.stagefreight_
# addressable (four sub-predicates); @cascade.cascade_well_defined
# (three sub-predicates; absorbing per companion spec); @butterfly.
# butterfly_well_formed (four sub-predicates). Family-root altitude
# lift of the composed-bilateral pattern.
pact @bumblebee/bumblebee_well_formed { \ }

out @bumblebee
out wobble
out buzz_observable
out perturbation
out buzz
out observe
out pulse
out run
out @bumblebee/buzz_is_content_addressed
out @bumblebee/wobble_observable_at_clocktime_delta
out @bumblebee/foerster_gauge_preserved
out @bumblebee/consent_gate_discharged
out @bumblebee/bumblebee_well_formed
