# ============================================================
# §2 The prism decl
# ============================================================

# Per @prism family-root discipline (five-op composition inherited
# via `in @prism`): @butterfly's prism-decl focuses on the sensitivity
# carrier at family-root altitude. Species (@butterfly/wingflap,
# @butterfly/mutation, @butterfly/coverage) each declare their own
# prism at species altitude.

prism @butterfly {
  focus   sensitivity
  project sensitivity
  split   sensitivity
  shift   sensitivity
  settle  sensitivity
}

# ============================================================
# §3 The carriers
# ============================================================

# === The sensitivity carrier ===
#
# Typed reference for a test-suite's or substrate's sensitivity to
# perturbation. Per Lorenz 1963 sensitive-dependence + Offutt-Untch
# 2001 mutation-score (per math foundation §3.1). Byte-visible; total
# function of (perturbation_set, target, verdict-fold).
#
# Four-field record:
#
#   score        — sensitivity metric in [0, 1] per math foundation
#                  §3.2 `sensitivity_of_test_suite`. 1 = maximally
#                  sensitive (every perturbation kills); 0 = blind
#                  (every perturbation survives silently).
#   witnessed    — typed ref to the mutant-set witnessed at this
#                  score (content-addressed per Rec #82 β-normal-AST;
#                  byte-equality on OID).
#   verdict_fold — typed ref to the PropertyVerdict merge_with fold
#                  over the sample-cohort (per prismqueer::liquid::
#                  pillar::forall §7.3 math foundation).
#   lyapunov     — typed ref to the empirical Lyapunov-exponent
#                  estimate over the beat-chain Hamming distance
#                  (per math foundation §3.4 FORWARD-PROMISED
#                  connection to sensitivity-compiler-testing 2025
#                  discrete Lyapunov exponent framework).
#
# Identity contract: byte-equality on (score, witnessed, verdict_fold,
# lyapunov).
type sensitivity = {
  score:        ref,
  witnessed:    ref,
  verdict_fold: ref,
  lyapunov:     ref,
}

# === The wingflap carrier ===
#
# Per Lorenz 1972 AAAS talk verbatim ("Predictability: Does the Flap
# of a Butterfly's Wings in Brazil set off a Tornado in Texas?").
# One K=1 perturbation event: mutation applied, verdict-delta observed.
# Content-addressed triple (mutation, target, verdict_kill) per math
# foundation §4.3.
#
# Five-field record:
#
#   mutation      — typed ref to the mutation applied (per
#                   @butterfly/mutation species; op + site + kind).
#   target_oid    — content-address of the unmutated target (Rec #82
#                   β-normal-AST OID).
#   baseline_oid  — content-address of the verdict on the unmutated
#                   target (per @epistemologic/property/
#                   verdict_is_content_addressed; Reed 2026-07-12).
#   features      — typed ref to spectral state at wingflap time
#                   ([f64; 16] per math foundation §4.3; SC-coord
#                   projection at instant t).
#   fate_bias     — typed ref to Fate distribution guiding pick
#                   ([f64; 5] over Abyss/Introject/Cartographer/
#                   Explorer/Fate models; math foundation §4.5
#                   fourth-consumer-surface).
#
# Identity contract: byte-equality on (mutation, target_oid,
# baseline_oid, features, fate_bias).
type wingflap = {
  mutation:     ref,
  target_oid:   ref,
  baseline_oid: ref,
  features:     ref,
  fate_bias:    ref,
}

# === The trace_delta carrier ===
#
# The observable produced by a wingflap. Per math foundation §4.3
# @kintsugi/butterfly type; carries the beat-chain divergence witness
# that discharges kill_of_mutant bilateral.
#
# Five-field record:
#
#   baseline_trace  — signature_beat chain root for unmutated run
#                     (per @spectral/signature; Reed `f211ee48`
#                     2026-07-16 landing).
#   mutant_trace    — signature_beat chain root for mutated run.
#   divergence_beat — option<ref> to the first beat where OIDs
#                     disagree (nothing() if traces are identical
#                     modulo content-address; mutant survived).
#   hamming         — u64 Hamming distance on beat chain (per math
#                     foundation §3.4; empirical Lyapunov-exponent
#                     input).
#   verdict_kill    — bool discriminating kill(m,S)=1 (mutant killed;
#                     verdict changed) from kill(m,S)=0 (mutant
#                     survived silently; test suite blind at site).
#
# Identity contract: byte-equality on (baseline_trace, mutant_trace,
# divergence_beat, hamming, verdict_kill).
type trace_delta = {
  baseline_trace:  ref,
  mutant_trace:    ref,
  divergence_beat: ref,
  hamming:         ref,
  verdict_kill:    bool,
}

# ============================================================
# §4 The actions (family-header only; species bodies forward-promised)
# ============================================================

# === flap action ===
#
# [Note: family-root altitude uses bare verb `flap` for the wingflap-
# perturbation action. The carrier `wingflap` (§3) is the OBSERVABLE
# record produced BY a flap event; the action is the VERB that
# produces it. Species-altitude `@butterfly/wingflap.wingflap_of_
# mutation` per math foundation §4.3 preserves the composition-
# primitive naming convention at species altitude.]
#
# One K=1 perturbation event at the current @mirror/store position.
# Fate-biased selection of the mutation to test; applies it to target;
# runs the test suite; returns the trace_delta observable. Per math
# foundation §4.3 signature `wingflap_of_mutation(mutation) ->
# trace_delta`; lifted to family-root altitude with mutation carrier
# resolved through `@butterfly/mutation` species.
#
# Bilateral bias polarity: REPULSIVE (per
# @butterfly/fate_bias_is_repulsive predicate below). Fate.tick output
# biases the mutation-pick TOWARD regions of high mutant-survival
# density (where the test suite is blind); this is the inverse-
# frequency polarity that distinguishes @butterfly from @roomba's
# attractive stigmergy.
#
# Returns imperfect<ref, ref, ref>:
# - success(trace_delta_ref) — wingflap complete; observable produced.
# - partial(trace_delta_ref, transparency) — wingflap complete with
#   residual (e.g., partial verdict-fold; time-budget-elapsed before
#   full sample-cohort processed).
# - failure(error, transparency) — wingflap failed (mutation
#   inadmissible at site; target refused compilation; verdict-fold
#   panicked).
#
# Body forward-promised at species altitude (`@butterfly/wingflap` in
# a subsequent tick); consumes @butterfly/mutation + @kintsugi/roomba's
# walk_position + @fate.tick + @spectral/signature.
flap(mutation: ref, target: ref) -> imperfect { \ }

# === sensitivity action ===
#
# Compute the test-suite sensitivity metric over a mutation set. Per
# math foundation §3.2 `sensitivity_of_test_suite(S, T, M) -> f64 in
# [0,1]`; classical mutation-score (Offutt-Untch 2001) renamed to
# surface the geometric content (Lorenz's "sensitive dependence").
#
# Composes over pillar::forall verdict-fold per math foundation §3.3:
#
#   sensitivity(S, T, M) = |{ m ∈ M(T) : forall<Input, |x| verdict(S,m,x)>
#                              ≠ forall<Input, |x| verdict(S,T,x)> }|
#                          ─────────────────────────────────────────
#                                          |M(T)|
#
# requires mutation_set_bounded(M): the mutation set MUST be finite
# per bounded Offutt-Jia 2010 operator taxonomy (bilateral discharged
# via @butterfly/mutation species).
#
# Returns imperfect<ref, ref, ref>:
# - success(sensitivity_ref) — score computed; ref resolves to
#   sensitivity record (§2 carrier).
# - partial(sensitivity_ref, transparency) — partial coverage (some
#   mutants elided by time or admissibility budget).
# - failure(error, transparency) — sensitivity failed (mutation set
#   empty; target refused compilation; verdict-fold undefined).
#
# Body forward-promised at species altitude (`@butterfly/coverage`);
# consumes @butterfly/mutation + @epistemologic/property/
# verdict_is_content_addressed.
sensitivity(suite: ref, target: ref, mutations: ref) -> imperfect { \ }

# === kill action ===
#
# Byte-equality check on the content-addressed verdict pair (baseline,
# mutant). Per math foundation §2.4: mutation kill/survive is a byte-
# comparison on the content-addressed verdict; NOT a statistical
# estimate. Stronger than Lorenz's finite-precision divergence witness.
#
# requires verdict_is_content_addressed (Reed 2026-07-12 landing):
# the verdict MUST be a total function of (spec_oid, target_oid,
# inputs_oid).
#
# Returns bool:
# - true — mutant killed (verdict changed under mutation).
# - false — mutant survived (verdict unchanged; test suite blind at
#   this mutant).
#
# Body forward-promised at species altitude (`@butterfly/coverage`);
# consumes @spectral/signature beat-chain byte-comparison primitive.
kill(mutant_oid: ref, suite: ref) -> bool { \ }

# === pulse action ===
#
# One full flap cycle: pick mutation per Fate bias, apply, run suite,
# record trace_delta, emit signature_beat marker (kill or survive) at
# walker position. Per math foundation §4.3 pulse signature; parallels
# @kintsugi/roomba.pulse walker-cycle.
#
# Composes over walk_position from @kintsugi/roomba (walker altitude
# shared through @kintsugi parent); returns updated (walk_position,
# butterfly_state) tuple carrying the accumulated coverage state
# through the cycle.
#
# Body forward-promised at species altitude (`@butterfly/wingflap`);
# outer-loop composition; discharges monotone coverage bilateral
# (@butterfly/coverage_monotone_nondecreasing) at each pulse.
pulse(position: ref) -> imperfect { \ }

# === run action ===
#
# Outer loop: pulse continuously until coverage saturates OR
# HolonomyHealth signals fate-tournament convergence. Per math
# foundation §5.2 ten-step @evolution loop; parallels @kintsugi/
# roomba.run walker-driver.
#
# Termination: HolonomyHealth < ε OR coverage_of_mutant_set = 1.0
# (per math foundation §5.3 fixed-point closure via Knaster-Tarski).
#
# Body forward-promised at species altitude; outer-loop composition.
run(seed: ref) -> imperfect { \ }

# ============================================================
# §5 The bilaterals (Rice-safe at whole-tick altitude)
# ============================================================

# === wingflap_is_content_addressed predicate ===
#
# Bilateral verdict that the wingflap's (mutation, target, verdict)
# triple is content-addressed: two butterflies wingflapping the same
# (mutation, target) produce byte-identical trace_delta. Per math
# foundation §4.3 pact @kintsugi/butterfly/wingflap_is_content_
# addressed; lifted to family-root altitude.
#
# requires verdict_is_content_addressed (Reed 2026-07-12 landing).
pact @butterfly/wingflap_is_content_addressed { \ }

# === coverage_monotone_nondecreasing predicate ===
#
# Bilateral verdict that coverage over the accumulated mutant set only
# ever increases (or stays; never decreases). Parallel to @kintsugi/
# roomba's tension_monotone_descending discipline. Per math foundation
# §4.3 pact @kintsugi/butterfly/coverage_monotone_nondecreasing.
#
# Grounds the Knaster-Tarski fixed-point argument (@evolution algebra
# §5.3): monotone operator over bounded state space admits fixed
# point via monotone-convergence.
pact @butterfly/coverage_monotone_nondecreasing { \ }

# === fate_bias_is_repulsive predicate ===
#
# Bilateral verdict that Fate.tick output bias polarity must be
# REPULSIVE over prior butterfly observations (inverse-frequency),
# not attractive (as @roomba is). Sentinel-check via apply_h::act
# sees the bias flag and admits/rejects. Per math foundation §4.3
# pact @kintsugi/butterfly/fate_bias_is_repulsive.
#
# This is the LOAD-BEARING duality-preserving bilateral: violation
# collapses @butterfly into @roomba (both attractive; no probe of
# untested region). The predicate DEFENDS the walker-perturbation
# duality that math foundation §4.1 established.
pact @butterfly/fate_bias_is_repulsive { \ }

# === kill_verdict_bounded predicate ===
#
# Bilateral verdict that kill(m, S) ∈ {0, 1}; sensitivity ∈ [0, 1];
# coverage_of_mutant_set ∈ [0, 1]. Bounded, decidable, byte-
# comparison-computable. Per math foundation §4.3 pact
# @kintsugi/butterfly/kill_verdict_bounded.
pact @butterfly/kill_verdict_bounded { \ }

# === butterfly_well_formed composed bilateral ===
#
# THE LOAD-BEARING composed bilateral at @butterfly altitude. Composes:
#
#   wingflap_is_content_addressed(wf)   -- observable determinism
#   ∧ coverage_monotone_nondecreasing(w) -- monotonicity discipline
#   ∧ fate_bias_is_repulsive(bias)       -- duality-with-@roomba preserved
#   ∧ kill_verdict_bounded(k)            -- range-check discipline
#
# The single family-altitude bilateral consumers discharge to verify
# a @butterfly wingflap is admissible + witnessed + monotone +
# duality-preserving.
pact @butterfly/butterfly_well_formed { \ }

out @butterfly
out sensitivity
out wingflap
out trace_delta
out flap
out kill
out pulse
out run
out @butterfly/wingflap_is_content_addressed
out @butterfly/coverage_monotone_nondecreasing
out @butterfly/fate_bias_is_repulsive
out @butterfly/kill_verdict_bounded
out @butterfly/butterfly_well_formed
