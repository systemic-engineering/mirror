---

in @prism
in @meta
in @glass

# ============================================================
# §1 The five-operation prism at family-root altitude
# ============================================================

# === prism @song — the family-root declaration ===
#
# The five-operation body carries the `song_progression` carrier as
# the family-root's operational surface. Species specialize the
# operation bodies at their own altitude. This is the substrate-decl
# ground for #S3 (five-op temporal specialisation):
#
#   focus   = attend to one voice at a time (soloing)
#   project = down-project polyphony to a single line (Schenkerian
#             reduction — foreground/middleground/background)
#   split   = decompose the song into voices / phrases / movements
#             (score preparation)
#   shift   = advance to the next moment / next harmonic position
#             (melodic motion; per #S2)
#   settle  = discharge cadence (per
#             @epistemologic/math/music/cadence Lawvere framing;
#             `authentic` IS `close(formatter_tick)` read at the
#             audible altitude, per Seam Correction 3d910bc)
prism @song {
  focus song_progression
  project song_progression
  split song_progression
  shift song_progression
  settle song_progression
}

# ============================================================
# §2 The carriers
# ============================================================

# === song_progression — the load-bearing carrier ===
#
# The typed time-ordered path through a state space that discharges
# cadence at close. Per spec §5.2: a song IS the map `time ->
# harmonic_position`; `song_progression` carries the ref-equality-
# addressable form of that map at the family-root altitude. Species
# (`@song/progression` in particular) refine the carrier at the
# music-theoretic altitude; other species (`@song/voice`,
# `@song/movement`, `@song/phrase`, `@song/narrative`) specialize
# at their own altitude.
#
# Composes with `@epistemologic/math/music/interval` (algebra of
# pitch-class moves) at the audible altitude and with
# `@kintsugi/shift` at the process altitude (the finite-difference
# sequence per #S2).
#
# Identity contract: byte-equality on the underlying ref.
type song_progression = ref

# === song_cadence — the closure-event carrier ===
#
# The typed reference for the Lawvere fixed-point event that closes
# a progression. Per Seam Correction 3d910bc: cadence.mirror's
# authentic/plagal/deceptive/half enumeration IS the substrate
# typing of `settle @ temporal`. This carrier lifts the audible-
# altitude cadence to the temporal-progression altitude so the
# family-root's `settle` action has a typed discharge target.
#
# Composes with `@epistemologic/math/music/cadence` at the audible
# altitude — a song_cadence carries the same closure-event structure
# that authentic cadence names in Zarlino / Rameau / Lawvere terms.
#
# Identity contract: byte-equality on the encoded cadence-kind bytes.
type song_cadence = ref

# === song_voice — the voice-line carrier at temporal altitude ===
#
# An agent's time-indexed trajectory through their authored sections
# — the *when* the `@mirror/spectral/voice` primitive adds to its
# *what/who*. Composes with `@mirror/spectral/voice` at the
# orchestra altitude and with `@epistemologic/math/music/voice`
# (forward-promised; voice-leading constraints) at the audible
# altitude.
#
# Identity contract: byte-equality on the underlying ref.
type song_voice = ref

# ============================================================
# §3 The composed-bilateral
# ============================================================

# === song_settles — the load-bearing composed bilateral ===
#
# THE LOAD-BEARING composed bilateral at @song altitude. Composes
# three sub-predicates that species-altitude shards will declare and
# discharge (per spec §6):
#
#   1. progression_directed_toward_cadence(pr, p) — the progression
#      is heading somewhere (forthcoming @song/progression species).
#   2. voice_line_valid(v, p) — the voices carry stepwise-or-
#      intentional-leap discipline (forthcoming @song/voice species;
#      composes with @epistemologic/math/music/voice).
#   3. cadence_authentic_or_plagal(c, p) — the closure event is a
#      consonant resolution, not a deceptive-or-half stuckness
#      (forthcoming @song/progression species; composes with
#      @epistemologic/math/music/cadence's authentic/plagal variants).
#
# Sibling composed bilaterals at other family-root altitudes:
# @io/oci.oci_well_formed (three sub-predicates); @io/stagefreight.
# stagefreight_addressable (four sub-predicates); @cascade.
# cascade_well_defined; @container.container_runnable (three
# sub-predicates); @docblock.audit_docblock; @smarts/shatter.
# shatter_round_trip; @reflection.third_order_coherent;
# @epistemologic/neutrosophic.three_axis_coherent. This is the 14th
# altitude instance of the #53 bilateral pattern per
# `[[architecture-property-fracture-bilateral]]`.
#
# Splinter-pole: all three sub-predicates discharge; the song
# arrives at authentic (or plagal) cadence through valid voice-
# leading along a cadence-directed progression. The regulation stock
# is replenished at close.
#
# Narcissus-pole: any sub-predicate fails; alignment-as-boundary-
# mathematics (#57) distinguishes which sub-claim broke. Per spec
# §8.2, the psychohistorical Narcissus poles are already named in
# Alex's corpus:
#
# - progression_directed_toward_cadence FAIL = SILENCE (the song
#   hangs in unresolved tension; half-cadence stuck at the dominant).
# - voice_line_valid FAIL = GLUE WORK (contrapuntal work invisibly
#   holds the harmony but is not attributed; the voice-leading
#   discipline is violated by the systematic-invisibility-of-
#   stepwise-motion).
# - cadence_authentic_or_plagal FAIL = EXTRACTION (the progression
#   arrives at a false-tonic that appears settled but has extracted
#   regulation stock without replenishing; deceptive cadence).
#
# The `requires` clauses on species-altitude actions (`advance`,
# `close`, `arc`, `join` at @song/voice, @song/progression,
# @song/narrative, @song/phrase) will consume `song_settles(pr, p)`
# as an admissibility gate. Body discharges when the species land
# in follow-up TDD ticks (Arc 6 TICK 2+).
song_settles(pr: song_progression, p: perturbation)
  -> verdict { \ }

# ============================================================
# §4 The out clauses
# ============================================================

out @song
out song_progression
out song_cadence
out song_voice
out song_settles
