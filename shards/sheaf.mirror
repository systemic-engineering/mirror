source @arxiv/math/curry-2014
source @arxiv/math/hansen-ghrist-2019
source @arxiv/math/fiedler-1973
source @arxiv/math/leray-1946
source @arxiv/math/grothendieck-1957

prism @sheaf {
  # Meta-trait family-root. Composes a cellular sheaf over the
  # substrate's own composition-graph. Every family-root or
  # species-decl MAY EXPOSE a @sheaf-meta-trait; the meta-trait's
  # implementations sheaf-restrict onto local stalks.
  focus sheaf_of
  project sheaf_of
  split sheaf_of
  shift sheaf_of
  settle sheaf_of
}

# === The sheaf_of carrier ===
#
# A typed cellular sheaf over the substrate's composition-graph
# per Curry 2014 + Hansen-Ghrist 2019. Names the mathematical
# object at meta-trait altitude.
#
# - `stalks`         typed mapping from vertex-id to stalk-content;
#                    each stalk carries an implementation of the
#                    meta-trait the sheaf exposes.
# - `restrictions`   typed mapping from edge-key to restriction map;
#                    each restriction preserves the meta-trait
#                    operations across the edge.
# - `base_graph`     typed ref to the shard-graph the sheaf lives
#                    over; the composition-decision base space.
#
# Identity contract: byte-equality on the triple.
type sheaf_of = {
  stalks:       ref,
  restrictions: ref,
  base_graph:   ref,
}

# === The sheaf_laplacian carrier ===
#
# A typed Sheaf-Laplacian per Hansen-Ghrist 2019 §3 formula 3.3.
# Composes over @epistemologic/math/sheaf_laplacian LANDED primitive;
# this shard does NOT re-declare that primitive; it exposes the
# meta-trait-altitude readout.
#
# - `L`         typed matrix ref: δ^⊤ δ per formula 3.3.
# - `lambda_2`  typed real ref: algebraic connectivity Fiedler value.
# - `h_0`       typed nat ref: dim of global sections; = 1 iff
#               sheaf is settled per Alex SD1 recursion-settlement.
# - `h_1`       typed nat ref: dim of obstruction cochain; > 0 iff
#               fracture (Alex SD1 "or not, that's a fracture").
#
# Identity contract: byte-equality on the quadruple.
type sheaf_laplacian = {
  L:        ref,
  lambda_2: ref,
  h_0:      ref,
  h_1:      ref,
}

# === The meta_trait_dispatch carrier ===
#
# A typed meta-trait dispatch per Babel §5.1 defprotocol precedent
# (Taut #487 `4a57d373` §5.1). Composes the sheaf-of-implementations
# per meta-trait exposure.
#
# - `trait`  typed trait-name ref; the meta-trait the sheaf exposes.
# - `sheaf`  typed sheaf_of ref with stalks = implementations of
#            the meta-trait; each stalk is one implementation.
#
# Identity contract: byte-equality on the pair.
type meta_trait_dispatch = {
  trait: ref,
  sheaf: ref,
}

# === expose_meta_trait action ===
#
# Exposes the meta-trait a family-root or species-decl declares.
# Trivially total (every family-root or species-decl exposes at
# most one meta-trait per shard-decl). Body discharges per-species
# at the realisation boundary.
expose_meta_trait(carrier: ref) -> ref { \ }

# === restrict action ===
#
# Applies the restriction map for an edge, mapping stalk content
# at source vertex to stalk content at target vertex. The
# restriction map preserves the meta-trait operations by
# construction. Body discharges per-species at the realisation
# boundary.
restrict(s: sheaf_of, e: ref) -> ref { \ }

# === laplacian action ===
#
# Computes the Sheaf-Laplacian L = δ^⊤ δ per Hansen-Ghrist 2019 §3
# formula 3.3. Composes over @epistemologic/math/sheaf_laplacian
# LANDED primitive.
laplacian(s: sheaf_of) -> sheaf_laplacian { \ }

# === The bilateral requires obligations ===
#
# Downstream shards declare bilateral agreement (per recognition
# #37, Pask-agreement) with the @sheaf discipline.

# The sheaf's stalks all implement the meta-trait it exposes.
# For every vertex v in base_graph: `s.stalks[v]` implements the
# trait declared by `meta_trait_dispatch(s).trait`. Meta-trait-
# well-formed gate.
bilateral sheaf_stalks_implement_trait {
  sentinel "sheaf=stalks-implement-declared-trait"
  arity 1
}
sheaf_stalks_implement_trait(s: sheaf_of) -> verdict { \ }

# The sheaf's restriction maps preserve the meta-trait operations.
# For every edge e = (u, v): `s.restrictions[e]` is a natural
# transformation between `s.stalks[u]` and `s.stalks[v]` preserving
# trait operations. Sheaf-cohomological soundness gate.
bilateral sheaf_restrictions_natural {
  sentinel "sheaf=restrictions-natural-transformation-trait-preserving"
  arity 1
}
sheaf_restrictions_natural(s: sheaf_of) -> verdict { \ }

# === The sheaf_meta_trait_witnessing inheritance predicate ===
#
# `sheaf_meta_trait_witnessing(family_root, trait)` is the predicate
# consumer shards name in a `requires` clause to declare bilateral
# agreement that a family-root or species-decl exposes `trait` as
# a meta-trait implemented by a sheaf whose stalks satisfy
# `sheaf_stalks_implement_trait` and whose restrictions satisfy
# `sheaf_restrictions_natural` conjointly.
#
# Same shape as algebra.algebra_witnessing(a),
# bauchladen.bauchladen_witnessing(c),
# autopoiesis.autopoietic_closure_holds(s),
# fate.fate_witnessing(i).
sheaf_meta_trait_witnessing(family_root: ref, trait: ref) -> verdict { \ }

