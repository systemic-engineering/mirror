# ============================================================
# §1 The five query verbs (five-op prism at query altitude)
# ============================================================
#
# Per Mara Definition M1.5 + Theorem M2.1: MQ's five verbs
# specialize the @prism five-op algebra AT query-language altitude.
# Each verb is a Kleisli-composable operator returning result<T>
# with residual-ambiguity-resolution discipline.
#
# Alex Q+96.2 residue: query-variant naming adjudicated as post-
# collapse `{focus, project, split, shift, settle}` per Mara §15
# reshape recommendation #1. Drops `_query` suffix from boot
# INSPIRATION; zoom → shift + refract → settle collapse per five-op
# prism discipline.

# === focus — narrow the substrate to a subgraph ===
#
# focus(path) navigates the substrate graph to `path` and returns
# the subgraph rooted there. Composes with context monoid: pushes
# focus-frame onto context stack. Fiedler + eigenboard state
# reads at focus-boundary.
#
# Sentinel: `mq=focus`.
focus(path: ref) -> result<subgraph>
requires path_admissible(path)
{ \ }

# === project — filter + view via typed pattern ===
#
# project(source, pattern) applies a typed mq_pattern to the
# source subgraph and returns matched nodes as a view. Pattern
# checked against source's grammar per Lemma M5.1 (patterns
# typed-against-graph-shape guarantee).
#
# Sentinel: `mq=project`.
project(source: query, pattern: mq_pattern) -> result<view>
requires pattern_type_checked(source, pattern)
{ \ }

# === split — enumerate variants with bounded depth ===
#
# split(options, depth) enumerates variants over the option-set to
# bounded depth. Total by construction (Def M1.5 + Lem M3.1): depth
# bound guarantees termination.
#
# Sentinel: `mq=split`.
split(options: [ref], depth: u32) -> result<[variant]>
{ \ }

# === shift — basis-transformation on query subject ===
#
# shift(subject, transform) applies a basis-transformation to the
# query subject. Per PAPER_2D §4.3.5 Kramers-Wannier bridge: shift
# IS the basis-transformation op at query altitude. Absorbs boot
# INSPIRATION `zoom_query` variant per collapse discipline.
#
# Sentinel: `mq=shift`.
shift(subject: query, transform: text) -> result<query>
{ \ }

# === settle — crystallize query into settled result ===
#
# settle(query) crystallizes an in-flight query into a settled
# result. Composition anchor with @mirror/refract measurement-lens:
# settle-boundary IS where spectral resonance verdict fires. Per
# Alex 2026-08-23 "spectrally resonant" discipline: settle checks
# result satisfies convergence-criterion via @mirror/refract
# transparency-verdict.
#
# Absorbs boot INSPIRATION `refract_query` variant per collapse
# discipline.
#
# Sentinel: `mq=settle`.
settle(query: query) -> result<settlement>
requires result_ambiguity_resolved(query)
{ \ }

# ============================================================
# §2 The pipe — typed Kleisli composition
# ============================================================
#
# Per Mara Theorem M6.1 + Mara reshape recommendation #3: the pipe
# operator `|>` formalized as explicit typed action carrying
# Kleisli-composition semantics at query-language altitude.
#
# Each stage's result<T> threads into the next stage; ambiguity
# accumulates via Transparency<P> monoid composition (Rec #92
# §4.1 Prop M4.1). Clear ∘ Clear = Clear; Clear ∘ Opaque =
# Opaque; Opaque ∘ Clear = Opaque; Opaque ∘ Opaque = Opaque
# (accumulated K-T questions); Dark absorbs.
#
# Sentinel: `mq=pipe`.
|>(left: query, right: query) -> query
{ \ }

# ============================================================
# §3 Query AST — the sum type
# ============================================================
#
# Per Mara Def M1.1: query as sum type composed from the five
# verbs + intent-hole variant. Self-referential AST: intent's
# `resolved: option(query)` field carries Fate-tournament
# resolution result (which may itself be another intent, until
# fixed-point per Prop M1.10).

type query = focus_q | project_q | split_q | shift_q | settle_q | intent_q

type focus_q {
  path: ref,
  loss: bool,
  eigenboard: bool,
}

type project_q {
  source: query,
  pattern: mq_pattern,
  filters: [filter],
  ordering: [order],
  limit: option(u32),
}

type split_q {
  options: [ref],
  depth: u32,
}

type shift_q {
  subject: query,
  transform: text,
}

type settle_q {
  query: query,
  resonance_predicate: option(mq_pattern),
}

# intent_q — the self-referential intent-hole per Alex 2026-08-23
# recognition. `intent: text` carries natural-language intent; `\`
# action runs Fate-tournament resolution; `resolved: option(query)`
# carries resolved AST which may itself be another intent_q until
# fixed-point (per Prop M1.10 Lawvere-1969-diagonal-fixed-point).
type intent_q {
  intent: text,
  resolved: option(query),
}

# ============================================================
# §4 Result algebra — Transparency<T> with Karl-Tomm ambiguity
# ============================================================
#
# Per Alex 2026-08-23 verbatim teaching + Rec #92 kleinos-
# Transparency<P> LOVE-monoid composition:
#
#   result<T> = Clear(T) | Opaque(T, karl_tomm) | Dark(karl_tomm)
#
# - **Clear(T)**: query ambiguity resolved totally → first-order
#   data T alone
# - **Opaque(T, karl_tomm)**: ambiguity resolved partially → first-
#   order data T + second-order Karl-Tomm question at altitude+1
# - **Dark(karl_tomm)**: query cannot dispatch at all → Karl-Tomm
#   question only (no data)
#
# Monoid composition per Rec #92 Cor M2.C1: (result<T>, compose,
# Clear, Opaque(∅)) forms LOVE-monoid. Clear is identity; Opaque
# accumulates K-T questions; Dark absorbs.
#
# Karl-Tomm question emitted at altitude+1 above dispatched query
# altitude per Tomm 1987-88 Interventive Interviewing III circular-
# reflexive form. Foerster-imperative-compatible: K-T question
# widens questioner's option-space; monotonically-non-decreasing
# choice-count per Theorem M2.1 Ψ3.

type result<T> = clear(T)
              | opaque(T, karl_tomm)
              | dark(karl_tomm)

# === Karl-Tomm question carrier ===
#
# Circular-reflexive question emitted when query ambiguity does
# not resolve totally. Per Tomm 1988 Interventive Interviewing III
# discipline: question is at altitude+1 above dispatched query,
# structurally invites option-space widening rather than lineal
# answer-collapse.
type karl_tomm {
  question:      text,           # the circular-reflexive question
  altitude:      u32,            # altitude+1 above dispatched query
  ambiguity_ref: ref,            # what specifically is unresolved
  suggestions:   [query],        # candidate resolutions (Fate-
                                 # tournament runner-ups + adjacent
                                 # graph paths per Cor M8.C4 axis 3)
  fate_verdict:  option(ref),    # Fate-tournament verdict-ref if
                                 # `\` action was dispatched
}

# === karl_tomm construction — the ambiguity-to-question mapping ===
#
# Given an ambiguity_ref + dispatched query altitude, construct a
# circular-reflexive Karl-Tomm question at altitude+1. Composes
# over @nl for question-text generation + Fate tournament for
# candidate-suggestion enumeration.
#
# Sentinel: `mq=karl-tomm`.
karl_tomm(ambiguity_ref: ref, query_altitude: u32) -> karl_tomm
{ \ }

# ============================================================
# §5 Intent-interpretation via Fate tournament
# ============================================================
#
# Per Mara Theorem M4.1 + boot INSPIRATION: `\` action is the
# intent-hole. Natural-language intent → Fate tournament runs over
# candidate query-shapes → result<query> with Transparency<P>
# ambiguity-resolution.
#
# Fate tournament per `boot/std/fate/tournament.mirror`: 90-
# parameter softmax inference substrate. Winner is Clear;
# runner-ups become Opaque suggestions; no candidate above
# threshold is Dark.

# === \ — the intent-hole ===
#
# Alex writes natural language intent. Fate runs a tournament
# to find the best interpretation. The query resolves to concrete
# operations, OR returns Opaque with K-T question if ambiguity
# persists, OR Dark if no candidate above threshold.
#
# Example: `\ find the function that handles authentication`
#   → Fate tournament
#   → Clear(project @code/rust |> pattern[kind=fn, name~=auth])
#     if unambiguous winner
#   → Opaque(top-candidate, karl_tomm("which auth surface —
#     login-flow OR session-refresh OR OAuth-callback?",
#     altitude+1, [candidates]))
#     if two-plus candidates above threshold
#   → Dark(karl_tomm("no candidates found; are you looking for
#     substrate that doesn't exist, or a name I'm not recognizing?",
#     altitude+1))
#     if no candidate above threshold
#
# Sentinel: `mq=intent-hole`.
\(intent: text) -> result<query>
{ \ }

# === resolve_intent — explicit typed intent-resolution action ===
#
# Per Mara §15 reshape recommendation #5: extend `resolve_intent`
# as explicit typed-carrier composing text-intent + context →
# Fate-verdict-shaped query resolution.
#
# Sentinel: `mq=resolve-intent`.
resolve_intent(intent: text, context: context) -> fate<query>
{ \ }

# ============================================================
# §6 Pattern algebra — CSS-flavored typed selectors
# ============================================================
#
# Per Mara Definitions M1.7-M1.9 + Cor M5.2: pattern algebra IS
# where LQ-shape (predicate-dispatch returning verdict) dissolves
# into MQ. Patterns typed-against-graph-shape (Lem M5.1). Bindings
# via `$name` captures with same-name-twice-means-equality
# discipline. `patterns_exhaustive` returns verdict (LQ-shape);
# `apply_pattern` returns imperfect (verdict-shape).
#
# CSS ↔ mirror mapping (unchanged from boot INSPIRATION):
#
#   tag                  type/variant head
#   *  or  _             wildcard
#   [k=v]                field-equals predicate (literal or $bound)
#   [k]                  has-field predicate
#   [k^="x"]             starts-with (string-typed fields only)
#   [k*="x"]             contains-substring
#   [k$="x"]             ends-with
#   #oid                 content-address match
#   .ns                  grammar-tag predicate (@code/llvm, etc.)
#   a > b                direct child
#   a b                  any descendant
#   a + b                immediately following sibling
#   a ~ b                any following sibling
#   :has(s)              contains-descendant
#   :not(s)              negation
#   :is(a, b)            union
#   :first :last :nth(n) position
#   a, b                 alternation (selector list)

type mq_pattern = head_pattern
                | sequence_pattern
                | union_pattern
                | predicate_pattern

type head_pattern = type_ref(ref)
                  | wildcard
                  | binding(ref)

type child_relation = direct | descendant | next_sibling | any_sibling

type sequence_pattern {
  left:     mq_pattern,
  relation: child_relation,
  right:    mq_pattern,
}

type union_pattern {
  options: [mq_pattern],
}

type predicate_pattern {
  head:       mq_pattern,
  predicates: [predicate],
}

type predicate = attribute_pred | pseudo_class

type attribute_pred = field_eq(ref, value)
                    | field_eq_bound(ref, ref)
                    | field_starts(ref, text)
                    | field_contains(ref, text)
                    | field_ends(ref, text)
                    | field_present(ref)

type pseudo_class = has(mq_pattern)
                  | not_(mq_pattern)
                  | is_([mq_pattern])
                  | first
                  | last
                  | nth(u32)

type binding_env {
  bindings: [binding_entry],
}

type binding_entry {
  name:  ref,
  value: ref,
}

# === parse_pattern — tokens → typed pattern ===
#
# Sentinel: `mq=parse-pattern`.
parse_pattern(tokens) -> mq_pattern
{ \ }

# === apply_pattern — value + pattern → imperfect(bindings) ===
#
# Sub-Turing per Lem M5.1: patterns are finite trees; matching
# bounded by depth.
#
# Sentinel: `mq=apply-pattern`.
apply_pattern(value, pattern: mq_pattern) -> imperfect
{ \ }

# === patterns_exhaustive — verdict-return (LQ-shape absorbed) ===
#
# Does this set of patterns cover every reachable shape of the
# given type? Used by @mirror/match to discharge the
# `requires exhaustive(...)` obligation. LQ-shape (predicate
# dispatch → verdict) dissolves here per Reed 2026-08-23 call +
# Mara Cor M5.2 validation.
#
# Sentinel: `mq=patterns-exhaustive`.
patterns_exhaustive(patterns: [mq_pattern], typ: ref) -> verdict
{ \ }

# ============================================================
# §7 Sigil literal — ~mq"..." typed compile-time parsed
# ============================================================
#
# `~mq"<query>"` is a typed mq literal. The validator parses the
# content against the @mq grammar at compile time; the literal
# carries a parsed `query`, not a raw text blob. Per AGENTS.md
# §Sigil Naming: ~mq is canonical (a name, not shorthand) —
# siblings of ~jq, ~sql, ~json.
type mq_literal(text) = @sigil("mq")

template render(s: mq_literal) -> query { parse(s.block) }

# ============================================================
# §8 Context monoid — session-persistent state
# ============================================================
#
# Per Mara Lem M1.13 + §15 reshape recommendation #4: context
# monoid extended with push_query + push_verdict for verdict-
# accumulation across queries within session.
#
# Navigation vocabulary:
#   .   here (current context)
#   ..  back (pop context)
#   ~   home (reset to root)
#   @   author (grammar origin)
#   ^   last crystal
#   HEAD current session

type context {
  stack:      [frame],
  session:    ref,
  eigenboard: eigenboard_state,
}

type frame {
  operation: query,
  scope:     ref,
  tick:      u32,
  verdict:   option(verdict),   # verdict-accumulation per
                                # Mara §15 reshape #4
}

type eigenboard_state {
  fiedler: f64,
  nodes:   u32,
  edges:   u32,
  loss:    f64,
}

# === context monoid actions ===
push_query(ctx: context, operation: query) -> context { \ }
push_verdict(ctx: context, verdict: verdict) -> context { \ }
pop(ctx: context) -> context { \ }
reset(ctx: context) -> context { \ }

# ============================================================
# §9 Suggestions surface — structural + predictive
# ============================================================
#
# After each query, compute suggestions. Structural (always):
# adjacent nodes, high-eigenvalue neighbors. Predictive (with
# spectral-db): Reflection predicts next query. Composes with
# Karl-Tomm question emission at ambiguity boundary (§4).

type suggestion {
  query:      text,
  reason:     text,
  confidence: f64,
}

suggest(ctx: context, eb: eigenboard_state) -> [suggestion] { \ }

# ============================================================
# §10 Parse + compile
# ============================================================

template parse(input: text) -> query
template compile(query, context) -> result

# ============================================================
# §11 Bilateral predicates
# ============================================================

# === path_admissible ===
#
# Is the substrate path well-formed + reachable? Splinter-pole:
# path resolves to a node in @mirror/store's content-addressed
# graph.
bilateral path_admissible {
  sentinel "mq=path-admissible"
  arity 1
}
path_admissible(p: ref) -> verdict { \ }

# === pattern_type_checked ===
#
# Is the pattern type-compatible with the source's grammar? Per
# Lem M5.1: patterns are typed against the value's declared shape;
# the parser rejects patterns asking for node kinds the type
# doesn't have.
bilateral pattern_type_checked {
  sentinel "mq=pattern-type-checked"
  arity 2
}
pattern_type_checked(source: query, pattern: mq_pattern) -> verdict
{ \ }

# === result_ambiguity_resolved ===
#
# LOAD-BEARING per §4 Karl-Tomm discipline. Verdict:
#   Pass    → result IS Clear(T) → dispatch first-order data alone
#   Partial → result IS Opaque(T, K-T) → dispatch data + K-T question
#   Fail    → result IS Dark(K-T) → dispatch K-T question alone
#
# Composed bilateral: this IS the discriminator that determines
# which discharge-shape the query produces.
bilateral result_ambiguity_resolved {
  sentinel "mq=result-ambiguity-resolved"
  arity 1
}
result_ambiguity_resolved(q: query) -> verdict { \ }

# === query_well_formed ===
#
# Composed bilateral for the family-root altitude. Verdicts
# well-formedness by composing sub-predicates:
#   1. query AST is valid (parses per Def M1.1)
#   2. every pattern in the query is type-checked (Lem M5.1)
#   3. every path reference is admissible (path_admissible)
#   4. context stack is monotone-accumulating (Lem M1.13)
#   5. Foerster-gauge preserved through composition (Thm M2.1 Ψ3)
bilateral query_well_formed {
  sentinel "mq=well-formed"
  arity 1
}
query_well_formed(q: query) -> verdict { \ }

