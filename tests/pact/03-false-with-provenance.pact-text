# Vector 03: false (statuses only; `because` is out of this slice).
# Transcribed by hand from tests/pact/03-false-with-provenance.json
# at 5babfbad (blob 3d9a97d091215dba2686b828b88ad1b486c1f69f); oracle: oracles.md.
rule ready ready(?a) requires application(?a), answered(?a, alex, yes)
rule send send(?a) requires ready(?a), pdf_stands_alone(?a), dates_only(?a), not reader_tracking(?a)
fact application(a1)
fact pdf_stands_alone(a1)
fact dates_only(a1)
query send(a1)
