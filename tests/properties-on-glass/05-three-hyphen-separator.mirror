#
# Expected: tokenize OK (one settlement_separator at the documented
#           line); parse OK; resolve OK.

in @io
in @epistemologic/property/halts

grammar @test/05/separator {
  glass to @io {
    property halts
  }
}

---

# This file hasn't been settled yet. The below-`---` region is empty.
