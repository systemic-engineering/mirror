-- simplified.mirror -- the kintsugi result
--
-- Original had 18 types, 3 actions, 6 anti-patterns.
-- Simplified to 3 types, 1 action, 0 anti-patterns.

in @prism

-- status (was: status = state = condition, 3 redundant aliases)
type status = active | inactive | pending | dormant

-- node (was: base -> level1 -> level2 -> level3, 4 deep nesting levels)
type node {
  id: id,
  name: string,
  description: string
}

-- Removed: orphan_alpha, orphan_beta, orphan_gamma (dead types)
-- Removed: wrapped_id, wrapped_name, wrapped_value (wrappers inlined)
-- Removed: maybe_id, maybe_name (double-optional flattened and unused)
-- Removed: state, condition (redundant aliases of status)
-- Removed: level1, level2, level3 (flattened into node)

action process(
  id: id,
  name: string,
  status: status,
  value: f64
) {
  emit result {
    id: id,
    processed: true
  }
}

-- Removed: do_process, perform_process (duplicates of process)
