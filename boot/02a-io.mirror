in @prism
in @meta
in @actor
in @sigil
in @file

type mut(block) != iso
type effect = mut(block)
type io(effect) != observation

type path(text)
type content(block)
type channel(actor, actor)

grammar @io < @sigil {
  # Sigil naming follows AGENTS.md § Sigil Naming: no single-character
  # sigils. The prefix IS the canonical name of the typed literal.
  type file(path) = @sigil("file")
  type dir(path)  = @sigil("dir")
  type uri(path)  = @sigil("uri")

  # ~file"<path>": validator asserts the path exists. Failure halts
  # the compile with a precise error.
  template render(s: file) -> path { @file.exists(s.block) }

  # ~dir"<path>": validator asserts the path exists AND is a directory.
  # Same failure mode as ~file. The directory check is one extra hop
  # past @file.exists; both ride the same kintsugi ladder.
  template render(s: dir) -> path { @file.exists(s.block) |> @file.is_dir }

  io read(path) => imperfect
  io write(path, content) => imperfect
  io send(channel, message) => imperfect
  io spawn(actor) => process
  io stop(process) => imperfect
}

out io
out effect
out mut
out path
out content
out channel
out @io
