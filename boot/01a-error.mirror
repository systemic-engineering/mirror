in @prism
in @nl

grammar @loss {
  type loss = {
    bits: f64,
    source: ref,
    measurement: measurement,
  }

  type measurement = shannon | fiedler | cheeger | entropy | mixing
}

grammar @error {
  type error = {
    grammar: ref,
    name: ref,
    message: nl,
    location: location,
    loss: loss,
  }

  type location = {
    file: ref,
    line: u64,
    column: u64,
  }

  type severity = fatal | warning | info

  type diagnostic = {
    error: error,
    severity: severity,
    suggestion: nl,
  }
}

# @imperfect declaration retired — substrate-pull-correct version lives in
# shards/glass.mirror as the three-constructor union `success(a) | partial(a, l) | failure(e, l)`.
# Per task #126 (Transparency-as-Lens) + glass.mirror floor.

out loss
out measurement
out error
out location
out severity
out diagnostic
