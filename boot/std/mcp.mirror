in @prism
in @io
in @data/json
in @mirror/compile
in @beam

grammar @mcp {
  # MCP server as mirror grammar.
  # reads JSON-RPC from stdin, dispatches, writes to stdout.
  type request = { method: text, params: json, id: json }
  type response = { result: json, id: json }

  serve -> imperfect {
    @io.read(stdin) |> @data/json.parse |> dispatch |> @data/json.emit |> @io.write(stdout)
  }

  dispatch(request) -> response { \ }

  # tool listing
  tools -> json { \ }

  # fate: resolve a \ hole, store at refs/fate/<hole_oid>.
  # Reflection's perturbation surface — any agent with MCP can seed the eigenboard.
  fate(hole_oid: text, resolution: text) -> imperfect { \ }
}

out serve
out dispatch
out tools
out fate
