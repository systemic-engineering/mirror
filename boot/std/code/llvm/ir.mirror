in @prism
in @code/llvm

-- @code/llvm/ir: LLVM IR syntax mapped to the five operations.
--
-- Maps LLVM IR constructs to the five operations:
--   define   -> zoom    (function definition — transform, cross levels)
--   type     -> split   (type definition — one of many, structural variants)
--   module   -> focus   (module-level metadata — source_filename, target, datalayout)
--   declare  -> project (external declaration — extract a view, import boundary)
--   global   -> project (@name = ... global/constant — named projection into memory)
--   call     -> zoom    (function call — transform within a body, cross levels)
--   br       -> split   (branch — control flow fork, one of many paths)
--   ret      -> refract (return — settle, produce result, done)
--
-- The grammar detection gap: the bootstrap seed's grammar_for_file()
-- does not map the .ll extension. LLVM IR files currently tokenize
-- through the default grammar (which catches 'type' only).
-- This grammar is the correct mapping. Extension routing is a
-- bootstrap constraint, not a grammar constraint.

grammar @code/llvm/ir {
  in @code/llvm

  -- ── Module level ─────────────────────────────────────────────────
  --
  -- Module metadata is a lens on the compilation context.
  -- source_filename, target datalayout, target triple.
  -- Focus narrows: look closer at where this IR came from.

  focus module

  -- ── Type definitions ──────────────────────────────────────────────
  --
  -- %struct.foo = type { ... }
  -- Type definitions enumerate structural variants.
  -- Split: one of many possible shapes in the type universe.

  split type

  -- ── External declarations ─────────────────────────────────────────
  --
  -- declare noundef i32 @printf(ptr, ...) local_unnamed_addr
  -- Declarations project an external interface into local scope.
  -- The function exists elsewhere; this is the view from here.

  project declare

  -- ── Global constants and variables ───────────────────────────────
  --
  -- @.str = private unnamed_addr constant [4 x i8] c"run\00", align 1
  -- @__stderrp = external local_unnamed_addr global ptr, align 8
  -- Globals project named memory locations into the module's scope.

  project global

  -- ── Function definitions ──────────────────────────────────────────
  --
  -- define dso_local void @main(i32 %0, ptr %1) { ... }
  -- A function definition crosses levels: source intent → machine ops.
  -- Zoom: transform at scale.

  zoom define

  -- ── Function calls ────────────────────────────────────────────────
  --
  -- %42 = call i32 @strcmp(ptr %40, ptr %41)
  -- A call site invokes a transformation within a function body.
  -- Zoom: the same crossing, recursively applied.

  zoom call

  -- ── Branches ─────────────────────────────────────────────────────
  --
  -- br i1 %cond, label %bb.true, label %bb.false
  -- br label %bb.next
  -- Branches fork control flow into one of many paths.
  -- Split: the structural fork, the choice point.

  split br

  -- ── Returns ───────────────────────────────────────────────────────
  --
  -- ret i32 0
  -- ret void
  -- A return settles the function: result produced, frame closed.
  -- Refract: done. crystal.

  refract ret
}

out @code/llvm/ir
