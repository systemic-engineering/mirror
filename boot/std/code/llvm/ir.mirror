in @prism
in @code/llvm

-- @code/llvm/ir: LLVM IR syntax mapped to the five operations.
--
-- Top-level structural tokenization. Function bodies are preserved
-- verbatim (opaque to kintsugi). The kintsugi reductions operate
-- at the module level: reorder, deduplicate, eliminate.
--
-- Maps LLVM IR top-level constructs to the five operations:
--   define          -> zoom    (function definition — transform, cross levels)
--   declare         -> project (external declaration — extract a view)
--   type            -> split   (%name = type { ... } — structural variant)
--   global          -> project (@name = ... — synthetic, sigil-driven)
--   metadata        -> split   (!name = !{...} — synthetic, sigil-driven)
--   target          -> focus   (target datalayout, target triple)
--   source_filename -> focus   (source provenance)
--   module          -> focus   (module asm and other module-level forms)
--   attributes      -> split   (attributes #N = { ... } groups)
--
-- The C tokenizer recognises three sigil prefixes at line start:
--   @<id> = ...     -> project (mapped to the `global` keyword)
--   %<id> = type    -> split   (mapped to the `type` keyword)
--   !<id> = ...     -> split   (mapped to the `metadata` keyword)
--
-- Lines starting with `;` are LLVM IR comments and are skipped.

grammar @code/llvm/ir("ll") {
  in @code/llvm

  -- ── Module-level metadata (focus: look closer at provenance) ─────

  focus target
  focus source_filename
  focus module

  -- ── Type definitions (split: structural variants) ────────────────
  --
  -- %struct.foo = type { i32, ptr, [16 x i8] }
  -- Recognised via the % sigil at line start.

  split type

  -- ── External declarations (project: import boundary) ─────────────
  --
  -- declare noundef i32 @printf(ptr, ...) local_unnamed_addr

  project declare

  -- ── Function definitions (zoom: cross levels) ────────────────────
  --
  -- define dso_local void @main(i32 %0, ptr %1) { ... body ... }
  -- The body between { } is preserved verbatim.

  zoom define

  -- ── Globals and constants (project: named memory) ────────────────
  --
  -- @.str = private unnamed_addr constant [4 x i8] c"run\00", align 1
  -- @__stderrp = external local_unnamed_addr global ptr, align 8
  -- Recognised via the @ sigil at line start.

  project global

  -- ── Attribute groups (split: enumerated groups) ──────────────────
  --
  -- attributes #0 = { nounwind ssp uwtable(sync) ... }

  split attributes

  -- ── Module metadata (split: named metadata records) ──────────────
  --
  -- !llvm.module.flags = !{!0, !1, !2}
  -- !0 = !{i32 2, !"SDK Version", [2 x i32] [i32 14, i32 4]}
  -- Recognised via the ! sigil at line start.

  split metadata
}

out @code/llvm/ir
