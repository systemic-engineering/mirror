in @code
in @trace
in @sigil

-- @code/mq: Mirror Query language for agent-to-spectral communication.
--
-- The five operations as query verbs. \ as intent interpretation.
-- Context tracks the agent's position in the graph across tool calls.
-- Suggestions compose structurally from the graph, predictively from spectral-db.
--
-- This is the grammar agents speak when they talk to spectral through MCP.

grammar @code/mq {
  in @code
  in @trace

  self type(session)

  -- ── The five query verbs ─────────────────────────────────────────

  focus action(path: ref) -> subgraph
  project action(query: text) -> view
  split action(options: [ref]) -> [variant]
  shift action(transform: text) -> result
  settle action() -> settlement

  -- ── Intent interpretation ────────────────────────────────────────
  --
  -- \ is the hole. The agent writes natural language intent.
  -- Fate runs a tournament to find the best interpretation.
  -- The query resolves to concrete operations.
  --
  -- \ find the function that handles authentication
  -- -> Fate tournament
  -- -> project where kind = shift AND name contains "auth"
  -- -> results

  \ action(intent: text) -> query

  -- ── Query AST ────────────────────────────────────────────────────

  type query = focus_query | project_query | split_query
             | zoom_query | refract_query | intent_query

  type focus_query {
    path: ref,
    loss: bool,
    eigenboard: bool
  }

  type project_query {
    source: query_source,
    filters: [filter],
    ordering: [order],
    limit: option(u32)
  }

  type split_query {
    options: [ref],
    depth: u32
  }

  type zoom_query {
    diff: option(diff_spec),
    blame: option(ref),
    branches: bool,
    log: option(log_spec)
  }

  type refract_query {
    store: option(store_spec),
    crystallize: bool,
    index: option(ref)
  }

  type intent_query {
    intent: text,
    resolved: option(query)
  }

  -- ── Query components ─────────────────────────────────────────────

  type query_source = find(ref) | near(ref, f64) | hot

  type filter = where_clause(ref, op, value)

  type op = eq | neq | gt | lt | gte | lte | contains | matches

  type value = text_val(text) | num_val(f64) | bool_val(bool) | ref_val(ref)

  type order {
    field: ref,
    direction: asc | desc
  }

  type diff_spec {
    from: ref,
    to: ref
  }

  type log_spec {
    kind: ref,
    limit: u32
  }

  type store_spec {
    node_type: ref,
    content: text
  }

  -- ── Context ──────────────────────────────────────────────────────
  --
  -- The context tracks the agent's position in the graph.
  -- Each query pushes to the context stack.
  -- The context narrows the scope of subsequent queries.
  --
  -- Navigation:
  --   .   here (current context)
  --   ..  back (pop context)
  --   ~   home (reset to root)
  --   @   author (grammar origin)
  --   ^   last crystal
  --   HEAD current session

  type context {
    stack: [frame],
    session: ref,
    eigenboard: eigenboard_state
  }

  type frame {
    operation: query,
    scope: ref,
    tick: u32
  }

  type eigenboard_state {
    fiedler: f64,
    nodes: u32,
    edges: u32,
    loss: f64
  }

  action push(context, operation: query) -> context
  action pop(context) -> context
  action reset(context) -> context

  -- ── Suggestions ──────────────────────────────────────────────────
  --
  -- After each tool call, compute suggestions.
  -- Structural (always): adjacent nodes, high-eigenvalue neighbors.
  -- Predictive (with spectral-db): Reflection predicts next query.

  type suggestion {
    query: text,
    reason: text,
    confidence: f64
  }

  action suggest(context, eigenboard_state) -> [suggestion]

  -- ── Parse and compile ─────────────────────────────────────────

  template parse(input: text) -> query
  template compile(query, context) -> result

  -- ── Pattern selectors (CSS-flavored, typed) ────────────────────
  --
  -- Patterns query the SHAPE of a value. Same primitive used by:
  --   io bindings in @mirror/compile/bootstrap:
  --     @code/rust(~file"...") > fn[name="foo"]
  --   match arms in @mirror/match:
  --     match req { request[method="tools/list"] => ... }
  --
  -- CSS ↔ mirror:
  --   tag                  type/variant head
  --   *  or  _             wildcard
  --   [k=v]                field-equals predicate (literal or $bound)
  --   [k]                  has-field predicate
  --   [k^="x"]             starts-with (string-typed fields only)
  --   [k*="x"]             contains-substring
  --   [k$="x"]             ends-with
  --   #oid                 content-address match
  --   .ns                  grammar-tag predicate (@code/llvm, etc.)
  --   a > b                direct child
  --   a b                  any descendant
  --   a + b                immediately following sibling
  --   a ~ b                any following sibling
  --   :has(s)              contains-descendant
  --   :not(s)              negation
  --   :is(a, b)            union
  --   :first :last :nth(n) position
  --   a, b                 alternation (selector list)
  --
  -- $name binds; same-name-twice means equality. The pattern is typed
  -- against the value's declared shape; the parser rejects patterns
  -- that ask for node kinds the type doesn't have.

  type mq_pattern = head_pattern
                  | sequence_pattern
                  | union_pattern
                  | predicate_pattern

  type head_pattern = type_ref(ref)
                    | wildcard
                    | binding(ref)

  type child_relation = direct | descendant | next_sibling | any_sibling

  type sequence_pattern {
    left: mq_pattern,
    relation: child_relation,
    right: mq_pattern,
  }

  type union_pattern {
    options: [mq_pattern],
  }

  type predicate_pattern {
    head: mq_pattern,
    predicates: [predicate],
  }

  type predicate = attribute_pred | pseudo_class

  type attribute_pred = field_eq(ref, value)
                      | field_eq_bound(ref, ref)
                      | field_starts(ref, text)
                      | field_contains(ref, text)
                      | field_ends(ref, text)
                      | field_present(ref)

  type pseudo_class = has(mq_pattern)
                    | not_(mq_pattern)
                    | is_([mq_pattern])
                    | first
                    | last
                    | nth(u32)

  -- bindings: a pattern's $name captures bound during apply.
  type binding_env {
    bindings: [binding_entry],
  }

  type binding_entry {
    name: ref,
    value: ref,
  }

  -- ~mq"<query>": typed mq literal. The validator parses the content
  -- against the @code/mq grammar at compile time; the literal carries
  -- a parsed `query`, not a raw text blob. Per AGENTS.md § Sigil
  -- Naming, ~mq is canonical (a name, not shorthand) -- siblings of
  -- ~jq, ~sql, ~json.
  type mq_literal(text) = @sigil("mq")

  template render(s: mq_literal) -> query { parse(s.block) }

  -- parse a pattern from tokens (post-tokenizer).
  -- io-eligible; rides the kintsugi ladder once the parser's totality
  -- obligations close.
  parse_pattern(tokens) -> mq_pattern { \ }

  -- check whether a value matches a pattern, returning bindings on
  -- success. sub-Turing once the model checker confirms termination
  -- (patterns are finite trees; matching is bounded by depth).
  apply_pattern(value, pattern) -> imperfect { \ }

  -- exhaustiveness check: does this set of patterns cover every
  -- reachable shape of the given type? used by @mirror/match to
  -- discharge the `requires exhaustive(...)` obligation.
  patterns_exhaustive(patterns: [mq_pattern], typ: ref) -> verdict { \ }
}

out mq_pattern
out head_pattern
out child_relation
out sequence_pattern
out union_pattern
out predicate_pattern
out predicate
out attribute_pred
out pseudo_class
out binding_env
out binding_entry
out mq_literal
out parse_pattern
out apply_pattern
out patterns_exhaustive
out @code/mq
