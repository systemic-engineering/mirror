in @prism
in @trace

-- @code/rust: grammar for Rust source code kintsugi.
--
-- Maps Rust constructs to the five operations:
--   fn       -> shift   (transform, cross levels)
--   struct   -> split  (one of many, variants)
--   enum     -> split  (one of many, variants)
--   impl     -> focus  (look closer, namespace)
--   mod      -> focus  (look closer, namespace)
--   use      -> project (extract a view, import)
--   trait    -> settle (scatter, verify, settle)
--
-- Kintsugi reductions operate on the MirrorAST representation.

grammar @code/rust("rs") {
  in @code
  in @trace

  -- Keyword-to-operation mappings for Rust source evaluation.
  -- evaluate() reads these to know which Rust keywords map to which operations.
  shift fn
  split struct
  split enum
  focus impl
  focus mod
  project use
  settle trait

  -- ── Body-lens contract (Spec A Implication 3) ───────────────────────
  --
  -- @code/rust is a body lens: it parses bytes into a typed Rust AST
  -- that selectors can narrow. @mirror/compile/bootstrap drives this
  -- through `> fn[name="..."]` selectors.
  --
  -- The body is \ — the bootstrap implements parsing today; kintsugi
  -- closes the obligation once @epistemologic/property/total_parse
  -- discharges totality.

  parse(bytes) -> rust_ast { \ }

  -- ── Rust AST type fragments ─────────────────────────────────────────
  --
  -- The selector surface @mirror/compile/bootstrap references. Declared
  -- here so `> fn[name=$x]` typechecks against a known node kind. All
  -- bodies / fields stay opaque until the parsing rules land in
  -- @mirror/compile/parse.

  type rust_ast
  type fn
  type impl
  type type
  type mod
  type use
  type trait
  type struct
  type enum

  -- Kintsugi reductions for Rust code
  action compile(self) -> artifact
  action test(self) -> result
  action lint(self) -> [diagnostic]
  action flatten_nesting(ast) -> ast
  action extract_function(ast, region) -> ast
  action simplify_match(ast) -> ast
  action remove_dead_code(ast) -> ast
}

out @code/rust
