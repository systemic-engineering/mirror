in @prism

grammar @separator {
  # --- is structural. Above: declaration. Below: observation.
  type separator
  type declaration(ast)
  type observation(ast)
  type file = { declarations: [declaration], observations: [observation] }

  # split a file at ---
  split_at_separator(text) -> file { \ }
}

out separator
out declaration
out observation
out file
out split_at_separator
