in @prism

-- @nl/english: English tokenization as the five operations.
--
-- The tokenizer lives in mirror, not Rust. Fate resolves.
--
--   split   -> decompose: text into structure
--   focus   -> observe: what a token is
--   shift    -> transform: morphology, tense, inflection
--   settle -> verify: grammar rules, agreement, coherence
--   project -> filter: stop words, relevance, summary

grammar @nl/english {
  in @nl

  -- ── Structure levels ──────────────────────────────────────────────

  type token(text)
  type word(token)
  type sentence([word])
  type paragraph([sentence])
  type section([paragraph])

  -- ── Parts of speech ───────────────────────────────────────────────

  type pos = noun | verb | adjective | adverb
           | pronoun | preposition | conjunction
           | determiner | interjection

  type role = subject | predicate | object
            | modifier | complement

  -- ── split: decompose ──────────────────────────────────────────────

  split tokenize(nl) -> [token] { \ }
  split words(nl) -> [word] { \ }
  split sentences(nl) -> [sentence] { \ }
  split paragraphs(nl) -> [paragraph] { \ }
  split sections(nl) -> [section] { \ }

  -- ── focus: observe ────────────────────────────────────────────────

  focus tag(token) -> pos { \ }
  focus role(token, sentence) -> role { \ }
  focus lemma(word) -> word { \ }

  -- ── shift: transform ───────────────────────────────────────────────

  shift conjugate(word, tense) -> word { \ }
  shift pluralize(word) -> word { \ }
  shift singularize(word) -> word { \ }
  shift nominalize(word) -> word { \ }

  type tense = past | present | future
             | past_perfect | present_perfect | future_perfect

  -- ── settle: verify ───────────────────────────────────────────────

  settle check(sentence) -> imperfect { \ }
  settle agrees(word, word) -> imperfect { \ }
  settle coherent(paragraph) -> imperfect { \ }

  -- ── project: filter ───────────────────────────────────────────────

  project stop_words(nl) -> nl { \ }
  project summarize(nl) -> nl { \ }
  project keywords(nl) -> [word] { \ }
}

out @nl/english
