in @prism
in @kintsugi
in @ai/fate
in @fate/tournament
in @epistemologic

grammar @kintsugi/shatter {
  # recursive fracture at Fiedler zero crossings
  shatter(ast, level) -> [ast] {
    focus(fiedler) |> split(zero_crossings) |> project(partitions)
  }

  # settle bottom-up: tournament per piece, then compose
  settle_up([ast]) -> imperfect {
    @fate/tournament.tournament(elite(1).beam(8), pieces) |> shift(compose) |> settle
  }

  # the full pipeline: shatter → settle → reassemble
  fracture_and_repair(ast, level) -> imperfect {
    shatter(ast, level) |\> settle_up
  }
}

out shatter
out settle_up
out fracture_and_repair
