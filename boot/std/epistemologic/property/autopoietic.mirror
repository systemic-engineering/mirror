in @prism

# @epistemologic/property/autopoietic
#
# A type is autopoietic iff its self-reference closes via a content-
# addressing fixed point. Per Soto-Andrade & Varela 1984: the Lawvere
# fixed-point theorem is equivalent to autopoiesis. Per
# @epistemologic/math/lawvere.is_autopoietic: the verifier is one
# decidable check on the tick map.
#
# Mirror's contribution: content-addressing makes the fixed point
# CONSTRUCTIBLE, not just verifiable. The Banach contraction over hash
# space gives existence and uniqueness:
#
#   - Existence:    every Cauchy sequence of OIDs converges in the
#                   content-addressed metric (hash space is complete).
#   - Uniqueness:   a contraction has at most one fixed point
#                   (Banach's theorem).
#   - Contraction:  the tick map IS a contraction because hash
#                   composition is non-expansive (the substrate
#                   property the OID layer enforces).
#
# So `type gen_prism = { name: zoom(oid, gen_prism), ... }` has a
# unique fixed point: the OID that names a gen_prism whose name field
# IS that OID. The substrate exhibits the fixed point at construction
# time — not as a proof obligation, but as a witness.
#
# Per docs/insights/2026-05-25-parametric-types-and-fp-heritage.md
# section 6 (third extension): the autopoietic gen_prism is the
# typed actor whose state lives in the content-addressed substrate.
# Haskell's Generic + TypeRep + Cloud Haskell static dictionaries do
# not compose. Mirror's gen_prism is one grammar declaration; the
# autopoietic claim is verifiable as a Lawvere fixed point on the
# tick map. The substrate gives the proof.

grammar @epistemologic/property/autopoietic {

  # The type's self-reference closes via a content-addressing fixed
  # point. For a type T whose body refers to T (directly or through a
  # parametric like zoom(oid, T)), the OID of T's declaration is the
  # OID T's body resolves to. Verifier: compute the declaration's OID;
  # walk the body's self-references; check they resolve to the same
  # OID. Banach contraction guarantees the fixed point exists and is
  # unique.
  fixed_point_exists(type) -> verdict { \ }

  # The fixed point is unique. Banach's theorem applied to the hash
  # space: a contraction has at most one fixed point. The substrate
  # exhibits THE fixed point; this property verifies no second one
  # is reachable from any starting OID under the tick map.
  fixed_point_unique(type) -> verdict { \ }

  # The tick map is a contraction. Hash composition is non-expansive
  # (the substrate property). The tick map composes a hash with the
  # type's body; if the composition is a contraction in the hash-
  # space metric, Banach applies. This is the structural condition
  # that makes the existence + uniqueness theorems available.
  tick_is_contraction(type) -> verdict { \ }

  # The combined property: the type is autopoietic.
  # Pass iff fixed_point_exists and fixed_point_unique and
  # tick_is_contraction. Equivalent (Soto-Andrade & Varela 1984) to
  # @epistemologic/math/lawvere.is_autopoietic on the type's tick map.
  autopoietic(type) -> verdict { \ }
}

out fixed_point_exists
out fixed_point_unique
out tick_is_contraction
out autopoietic
out @epistemologic/property/autopoietic
