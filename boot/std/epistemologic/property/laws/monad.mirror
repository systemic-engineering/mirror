in @prism

# @epistemologic/property/laws/monad
#
# settle(T) is the verified-construction parametric form (Monad-shaped).
# Per docs/insights/2026-05-25-parametric-types-and-fp-heritage.md.
#
# Haskell's Monad laws lifted to mirror's type layer:
#
#   left identity:   return a >>= f  =  f a
#   right identity:  m >>= return    =  m
#   associativity:   (m >>= f) >>= g  =  m >>= (\x -> f x >>= g)
#
# Mirror's contribution beyond Haskell: content-addressing makes
# associativity FREE. The substrate concatenates oids associatively;
# the law is a theorem of the storage layer, not a convention the
# programmer must obey. Verification reduces to OID equality.
#
# Identity laws likewise: `return` is `crystallize` (the constructor),
# `>>=` is composition through the content-addressed graph. Building
# settle(T) IS the proof of having been T; the laws are properties
# of how the witness composes.
#
# This is the Monad-laws-at-composition-time framing from the design
# call: the laws are not checked per-callsite at v1.0; they are
# checked when settle(T) appears in a composition, and the content-
# addressed substrate enforces them structurally.

grammar @epistemologic/property/laws/monad {

  # Left identity: crystallize(a) refracted through f equals f(a).
  #
  # For a value `a` of type T and a function f: T -> settle(U),
  # building settle(crystallize(a)) and threading through f must
  # yield the same OID as applying f directly to a. The substrate's
  # crystallize is a left unit for settle composition.
  left_identity(type) -> verdict { \ }

  # Right identity: m refracted through crystallize equals m.
  #
  # For any settle(T) value m, refracting m through crystallize
  # must yield m's OID unchanged. crystallize is a right unit.
  right_identity(type) -> verdict { \ }

  # Associativity: (m >>= f) >>= g = m >>= (x -> f(x) >>= g).
  #
  # The composition of two settle steps is associative. Content-
  # addressing makes this free: oid concatenation is associative; the
  # storage layer cannot represent a non-associative composition
  # because the address of a chain depends only on its leaves.
  #
  # Per Alex 2026-05-25 design call: this is the "free at composition
  # time" property the settle(T) framing leverages.
  associativity(type) -> verdict { \ }

  # The combined property: settle(T) satisfies all three Monad laws.
  # Pass iff left_identity, right_identity, and associativity all pass.
  monad_laws(type) -> verdict { \ }
}

out left_identity
out right_identity
out associativity
out monad_laws
out @epistemologic/property/laws/monad
