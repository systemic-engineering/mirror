in @prism
in @epistemologic
in @error
in @nl

in @glass

grammar @epistemologic/property {
  # verdict is declared in @glass (the substrate floor):
  # `verdict = pass | partial(confidence) | failure(reason)`.
  # @epistemologic/property consumes the glass form; no redeclaration.

  # a property check: takes an AST node, returns verdict.
  # every concrete check is a named lambda.
  type check = (ast) -> verdict

  # run all properties inherited through `in`
  reflect(ast) -> [verdict] { \ }

  # check a single property
  check(ast, property) -> verdict { \ }
}

out reflect
out check
