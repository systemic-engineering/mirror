in @ci

-- @cd: continuous deployment grammar.
-- Uses @ci (which uses @git). Reads are templates. Writes are io.
-- Licensed Apache-2.0 (SPDX: Apache-2.0).

grammar @cd {
  in @ci

  type artifact {
    content_oid: SHA256,
    triple: @shatter,
    spec: @spec,
    target: ~f
  }

  template verify(artifact) -> Measurement
  template health(target) -> eigenstate

  io package(spec: @spec) -> artifact
  io stage(artifact, target) -> Measurement
}

out @cd
