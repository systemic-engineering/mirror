in @prism

grammar @nl("nl", "natural-language", "bare") {
  # the bare-@nl grammar: just-enough natural-language to carry
  # inline backticks, fenced code blocks with language tags, and
  # indented `mirror>` doctest prompts inside otherwise opaque
  # prose. cross-grammar lifts dispatch back to the host (or to a
  # tagged grammar). full CommonMark structure (headings, lists,
  # links) is the @nl/markdown follow-up tick, not this one.

  # legacy keyword mapping for parse_grammar compatibility.
  # @nl carries no operation keywords today — prose is everything
  # that isn't one of the three structural forms below.
  focus prose

  # ===== lexical primitives =====
  fixed whitespace        = repeat(charset(whitespace), 0, none)
  fixed not_newline       = repeat(charset(not_newline), 0, none)
  fixed until_newline     = until(literal("\n"))
  fixed until_backtick    = until(literal("`"))
  fixed until_fence       = until(literal("```"))
  fixed identifier        = repeat(charset(word_char), 1, none)

  # ===== inline backticks =====
  # `code` inside @nl lifts to the calling host grammar. the host
  # is whichever grammar invoked @nl via the Shift combinator. for
  # the meta-glass comment shift this is @mirror/glass; for rust
  # doc comments it's @code/rust; etc.
  fixed code_inline       = seq(literal("`"),
                                  @<host>(until_backtick),
                                  literal("`"))

  # ===== fenced code blocks =====
  # ```rust ... ```  lifts to @code/rust
  # ```mirror ... ``` lifts to @mirror/glass
  # ```      ... ``` (no tag) lifts to @<host>
  fixed fence_open        = seq(literal("```"), identifier, until_newline)
  fixed fence_open_bare   = seq(literal("```"), until_newline)
  fixed fence_close       = literal("```")
  fixed fence_tagged      = seq(fence_open,
                                  @<tagged>(until_fence),
                                  fence_close)
  fixed fence_bare        = seq(fence_open_bare,
                                  @<host>(until_fence),
                                  fence_close)
  fixed fenced_block      = choice(fence_tagged, fence_bare)

  # ===== doctest prompts =====
  # indented `mirror> <expr>` lifts the prompt body to the host
  # grammar; following non-prompt lines are expected output (kept
  # verbatim by @nl). the prompt indent must be at least 2 spaces.
  fixed doctest_indent    = repeat(literal(" "), 2, none)
  fixed doctest_prompt    = seq(doctest_indent, literal("mirror> "),
                                  @<host>(until_newline))

  # ===== prose = everything that isn't structural =====
  # bare bytes flow through as opaque prose. doctest output lines
  # (lines after a prompt that don't themselves start with the
  # prompt) are prose by default — the doctest harness in a later
  # tick adds the expected-output comparison.
  fixed prose             = until_newline

  # ===== @nl element = the three structural forms + prose =====
  fixed element           = choice(code_inline, fenced_block,
                                     doctest_prompt, prose)

  # ===== file root =====
  fixed file              = repeat(choice(whitespace, element), 0, none)
}

out @nl
