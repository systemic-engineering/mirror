in @prism
in @io
in @epistemologic/resolve
in @mirror/evaluate
in @mirror/store
in @code/llvm/emit
in @code/kernel
in @fragmentation

grammar @mirror/build {
  # the self-build pipeline
  # grammars → LLVM IR → object → binary

  build(spec, target) -> imperfect {
    collect(spec) |> evaluate |> emit(target) |> assemble |> link |> store
  }

  collect(spec) -> [ast] {
    @epistemologic/resolve.chain(spec) |> @mirror/evaluate.evaluate
  }

  emit([ast], target) -> text {
    @code/llvm/emit.emit_binary(ast, target)
  }

  assemble(text) -> bytes { @io.exec("llc", ["-filetype=obj"]) }

  link(bytes) -> binary { @io.exec("ld", ["-o", "mirror"]) }
}

out build
out collect
out emit
out assemble
out link
