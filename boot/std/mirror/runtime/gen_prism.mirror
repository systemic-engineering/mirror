in @prism
in @epistemologic/property/autopoietic
in @epistemologic/property/halts
in @mirror/spectral
in @hash/coincidence
in @beam
in @io

# @mirror/runtime/gen_prism: content-addressed autopoietic actors.
#
# A gen_prism is a name. The name points at a ref. The ref points at a crystal.
# The crystal is the current state. Sending a message reads the crystal,
# computes a new crystal, and advances the ref. The ancestor chain IS the
# history. The ref IS the identity. The crystal IS the state.
#
# No heap. No process. No supervisor. Liveness is the existence of the ref.
# A tick is a function: (state, message) -> (state, emissions). Pure.
# Replayable. Reproducible.
#
# Autopoietic by construction. Per the 2026-05-25 design call: the
# `name` field IS `zoom(oid, gen_prism)` — a content-addressed self-
# reference. The fixed point exists and is unique by Banach contraction
# over hash space; the substrate exhibits the fixed point at
# construction (not as a proof obligation, as a witness). Per Soto-
# Andrade & Varela 1984: this is equivalent to a Lawvere fixed point
# on the tick map. Per @epistemologic/property/autopoietic.autopoietic:
# the property that verifies the structural condition.
#
# This is the substrate beneath @spectral/spawn. Most things that want
# "a process" only need this — reload contracts, LSP buffers, MCP sessions,
# mirror-internal state.
#
# Spec: docs/specs/mirror-runtime-gen-prism.md
# Insight: docs/insights/2026-05-25-parametric-types-and-fp-heritage.md

grammar @mirror/runtime/gen_prism {

  # --- types ---------------------------------------------------------------

  # the identity. content-addressed self-reference: `name` is a
  # `zoom(oid, gen_prism)` — the OID of the gen_prism's own declaration
  # under the gen_prism shape. The fixed point exists (Banach
  # contraction on hash space) and is unique. The substrate exhibits it.
  #
  # `head` carries `zoom(oid, crystal)` — a content-addressed reference
  # to the current state crystal, typed by the crystal shape.
  type gen_prism = {
    name: zoom(oid, gen_prism),    # autopoietic self-reference
    ref:  text,                     # refs/gen_prism/<oid>
    head: zoom(oid, crystal),      # the current state crystal
    tick: u64,                      # number of messages applied (length of ancestor chain)
  }

  # the structural property: this type's self-reference closes via
  # content-addressing fixed point. Verifiable per
  # @epistemologic/property/autopoietic.autopoietic. When this passes,
  # the type's declaration has a unique fixed point in hash space and
  # the autopoietic claim holds structurally.
  property autopoietic() -> verdict {
    @epistemologic/property/autopoietic.autopoietic(gen_prism)
  }

  # the substrate's halting claim made load-bearing on this actor.
  # Per Alex's 2026-05-25 substrate decision: every reflexive
  # trajectory of a sub-Turing grammar terminates by disjunction of
  # (a) autopoietic settlement via @cogito.reflect's Lawvere fixed
  # point and (b) reduction exhaustion via @scheduler.reduction_budget
  # against the host shard's @epistemologic/silicon/compute_bound.
  # max_reductions. The tick's `\` body remains the runtime resolution
  # point; this contract is the structural condition any tick body
  # must satisfy. The is_copium thesis operationalized: mirror is
  # not Turing-complete, so Rice's theorem does not apply and the
  # halting check is decidable by construction.
  requires halts(gen_prism)

  # a message is any content-addressable value. crystals all the way down.
  # the receiver decides what to do with it.
  type message = {
    oid:  oid,            # content address of the message body
    kind: text,           # discriminator the receiver pattern-matches on
  }

  # the result of applying a message to a state. the new state replaces
  # the head; the emissions are notifications/beams pushed on the active
  # transport (LSP/MCP stdio, the bus, stdout).
  type tick_result = {
    state:      oid,            # new state crystal (the new head)
    emissions:  [json],         # JSON-RPC notifications or beams
    loss:       loss,           # observation: did the tick improve coherence?
  }

  # --- operations ----------------------------------------------------------

  # create a new gen_prism. autopoietic: the `name` parameter is the
  # content address of the gen_prism's own declaration under itself
  # (zoom(oid, gen_prism)); `initial_state` is the content address of
  # the initial crystal (zoom(oid, crystal)). The substrate's hash-
  # space contraction guarantees the name resolves to a unique fixed
  # point; the ref is derived from that OID, not a free-text label.
  spawn(name: zoom(oid, gen_prism), initial_state: zoom(oid, crystal)) -> gen_prism { \ }

  # the pure tick. takes a state crystal and a message; returns the next
  # state + emissions. resolves to grammar-defined behaviour at the \ —
  # each concrete gen_prism overrides this in its own grammar.
  tick(state: oid, message: message) -> tick_result { \ }

  # fire-and-forget. read head, apply tick, advance ref. emit any emissions.
  # CAS-safe: the ref update fails if head moved since we read it; the
  # caller retries.
  send(gp: gen_prism, message: message) -> imperfect {
    tick(gp.head, message)
      |> @mirror/spectral.crystallize
      |> @io.git_update_ref(gp.ref)
  }

  # synchronous send. the caller blocks until the new state is durable.
  # reply lives in the new state's body — the caller extracts it.
  call(gp: gen_prism, message: message) -> imperfect { \ }

  # walk the ancestor chain. each entry is one tick's state crystal.
  # history(gp, 10) returns the last 10 ticks newest-first.
  history(gp: gen_prism, depth: u64) -> [oid] {
    @io.git_log(gp.ref, depth)
  }

  # read the current state without advancing.
  observe(gp: gen_prism) -> oid { gp.head }

  # terminate: delete the ref. the crystals remain in git (history is
  # never lost; the gen_prism just ceases to exist as a live identity).
  terminate(gp: gen_prism) -> imperfect {
    @io.git_delete_ref(gp.ref)
  }
}

out gen_prism
out message
out tick_result
out spawn
out tick
out send
out call
out history
out observe
out terminate
out @mirror/runtime/gen_prism
