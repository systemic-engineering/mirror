in @prism
in @epistemologic
in @mirror/refract
in @mirror/execute

grammar @mirror/project {
  # project properties below --- in a .mirror file
  # above ---: declaration (programmer's)
  # below ---: observation (compiler's)
  project(file) -> imperfect { \ }

  # read the --- section from a file
  read_observations(file) -> [observation] { \ }

  # write observations below ---
  write_observations(file, [observation]) -> imperfect { \ }
}

out project
out read_observations
out write_observations
