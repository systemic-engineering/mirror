in @prism
in @git

# @mirror/store: content-addressed storage as grammar.
#
# Three operations. Same interface. Swappable backends.
# The `\` is the backend. Swap one `in` line, the entire storage changes.
# The grammars above don't notice. The contract holds.
#
# Backends:
#   @mirror/store/git         — default. git IS the store. refs/crystals/pinned/<oid>.
#   @mirror/store/nix         — when mirror is a nix provider. /nix/store/<oid>-name.
#   @mirror/store/bare        — bare filesystem; tiny / ephemeral deployments.
#   @mirror/store/sqlite      — single-file portable; mobile; offline-first.
#   @mirror/store/spectral-db — endgame. the graph IS the store. eigenvalues ARE addresses.
#
# Substrate placement (Alex 2026-05-26, corrective):
#
#   "@fragmentation is pure. @mirror/store owns `io`."
#
# The richer per-backend actions (pin, release, gc_roots,
# tombstone_check, promote, demote, last_referenced_at) live at
# the concrete `@mirror/store/<adapter>` altitude, because each
# touches the underlying persistence layer.

grammar @mirror/store {
  # store a crystal. return its content-addressed OID.
  store(crystal) -> oid { \ }

  # fetch a crystal by OID. imperfect carries the bytes or dark.
  fetch(oid) -> imperfect { \ }

  # exists: is this OID resolvable in the backend?
  exists(oid) -> bool { \ }
}

out store
out fetch
out exists
