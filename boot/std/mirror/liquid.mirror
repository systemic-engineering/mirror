in @prism
in @epistemologic
in @epistemologic/property
in @epistemologic/resolve
in @beam
in @mirror/execute

grammar @mirror/liquid {
  # --- is owned by liquid inference.
  # above: declaration (the programmer's).
  # below: inferred properties (the compiler's).
  # the separator appears when the compiler has something to say.
  type separator

  # infer which @epistemologic properties apply
  # from the grammar's measured topology (read from the beam)
  infer(ast) -> [ref] { \ }

  # match measured topology against @epistemologic/* property thresholds.
  # absorbs @mirror/settle.match_properties.
  match_properties(topology) -> [ref] { \ }

  # infer .spec from project topology.
  # absorbs @mirror/settle.infer_spec.
  infer_spec(path) -> imperfect { \ }

  # project inferred properties below --- in the source
  project(file, [ref]) -> imperfect { \ }

  # the full liquid pass: observe the beam -> infer -> project.
  # invoked by `mirror kintsugi --liquid <file>`.
  liquid(file) -> imperfect {
    @beam.observe |> infer |> project
  }
}

out separator
out infer
out project
out liquid
