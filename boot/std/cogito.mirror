in @prism
in @epistemologic
in @epistemologic/math/bundle
in @epistemologic/math/lawvere
in @ai/fate
in @mirror/execute
in @beam

# @cogito: second-order observation. looks at holes. decides strategy.
# runs AFTER a compile tick. BEFORE the tournament.
# the Reflection layer. observe the imperfect. pick the game.
# perturb the eigenboard for the next tick.
#
# compile -> reflect -> tournament -> compile -> ... -> lambda_0
#
# the `eigenboard` type referenced by `perturb` resolves through
# @epistemologic/math/bundle: an eigenboard IS a section of a principal
# G-bundle on the five-operation graph. see docs/specs/eigenboard-representation.md
# for the full shift (candidate D, recommended).
#
# Reflection's correctness IS an autopoietic claim: the observe ->
# strategy -> perturb tick has a Lawvere fixed point. Per Soto-Andrade
# & Varela 1984 (the Lawvere<->autopoiesis bridge), this is equivalent
# to the loop being autopoietic. The property `autopoietic` below
# delegates to @epistemologic/math/lawvere.is_autopoietic; the verifier
# is one decidable check. See docs/specs/lawvere-grammar.md and
# docs/specs/kintsugi-formatter.md.

# the eigenboard: the agent's current spectral state. one snapshot of
# the principal G-bundle tower at this tick. one field per level of
# @epistemologic/math/bundle. each carrier comes from the bundle
# grammar; nothing new is invented here.
#
#   level 0 fiber       -> state    (focus    / Abyss)
#   level 1 connection  -> optic    (project  / Introject)
#   level 2 gauge       -> group    (split    / Cartographer)
#   level 3 transport   -> holonomy (shift     / Explorer)
#   level 4 closure     -> fixed    (settle  / Fate)
#
# this is the minimal shape that lets @cogito.perturb type-check and
# matches docs/specs/eigenboard-representation.md candidate D at its
# stripped core. extension points left open for follow-up ticks:
#   - the per-base-node section ([(operation, state)]) once an
#     `operation` enum lands in @prism;
#   - the per-edge connection forms once an `edge` type lands;
#   - the emotional sub-bundle (cogito-eigenstate slots 13-16);
#   - the routing_bias projection onto the gauge slice.
type eigenboard {
  state:    state,         # the section value at the current base point
  optic:    optic,         # the connection 1-form active this tick
  group:    group,         # the gauge element in force
  holonomy: holonomy,      # residual loss carried by transport this tick
  closure:  fixed,         # the Lawvere fixed-point witness for the section
}

grammar @cogito {
  observe(imperfect) -> observation { @beam.emit }

  strategy(observation) -> tournament { elite(1).beam(8).halving(3) }

  perturb(observation, tournament_result) -> eigenboard { @beam.observe }

  reflect(imperfect) -> imperfect {
    observe |> strategy |> perturb
  }

  # the reflect loop is autopoietic iff its tick -> tick map has a
  # Lawvere fixed point (Soto-Andrade & Varela 1984). when this
  # property passes, the loop converges; when it fails, the loop
  # has no stable closure and termination is not guaranteed.
  property autopoietic() -> verdict {
    @epistemologic/math/lawvere.is_autopoietic(@cogito)
  }
}

out eigenboard
out observe
out strategy
out perturb
out reflect
out autopoietic
