in @prism
in @epistemologic
in @ai/fate
in @mirror/execute
in @mirror/trace
in @mirror/refract

# @cogito: second-order observation. looks at holes. decides strategy.
# runs AFTER a compile tick. BEFORE the tournament.
# the Reflection layer. observe the imperfect. pick the game.
# perturb the eigenboard for the next tick.
#
# compile -> reflect -> tournament -> compile -> ... -> lambda_0

grammar @cogito {
  observe(imperfect) -> observation { @mirror/trace.trace }

  strategy(observation) -> tournament { elite(1).beam(8).halving(3) }

  perturb(observation, tournament_result) -> eigenboard { @mirror/refract.measure }

  reflect(imperfect) -> imperfect {
    observe |> strategy |> perturb
  }
}

out observe
out strategy
out perturb
out reflect
