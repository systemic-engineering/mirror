in @prism
in @io

grammar @shatter {
  # if OID matches cached crystal, return it. Skip tokenization.
  cache(file, oid) -> ast { \ }
  # store a compiled crystal
  store(file, oid, ast) -> imperfect { \ }
  # invalidate when source changes
  invalidate(file) -> imperfect { \ }
}

out cache
out store
out invalidate
