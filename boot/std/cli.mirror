in @prism
in @meta
in @cli/args

# @cli: the CLI grammar. Five commands. Five operations. Flags compose.
# Every --flag is a typed lambda. The grammar IS the parser.

type exit_code = success | failure | partial(loss)

type command {
  name: ref,
  args: [text],
  flags: [flag],
  result: imperfect,
}

grammar @cli {

  # --- The five operations as the five verbs ---

  # focus: tokenize one file — emit a beam.
  action compile(path: text) -> imperfect

  # project: execute with holes — the beam shows what's missing.
  action run(path: text) -> imperfect

  # split: enumerate the suite, converge to lambda_0.
  action craft(target: text) -> imperfect

  # shift: cross levels — resolve \ with concrete.
  action fate(oid: text, resolution: text) -> imperfect

  # settle: settle, write canonical.
  action kintsugi(path: text) -> imperfect

  # --- Transport (one verb, two dispatches) ---

  # serve is not a sixth operation — it is project over the JSON-RPC stream.
  # --mcp dispatches to mirror tools. --lsp dispatches to LSP methods.
  action serve() -> imperfect

  # --- Help derived from grammar ---

  action help(grammar: ref) -> text { \ }

  # --- Flags as typed lambdas ---
  # Arity comes from the parameter list. Optic type comes from the body.

  # --target: emit code for a chosen target after convergence.
  # composes on `craft`. replaces the dissolved @mirror/build.
  flag target(binary | rust | gleam) = lens(grammar => grammar)

  # --reflect: verify properties, no emission.
  # composes on `craft`. replaces the dissolved @mirror/check + ci + ca.
  flag reflect = prism(imperfect => pass | fail)

  # --liquid: write inferred properties below ---.
  # composes on `kintsugi`. invokes @mirror/liquid.project.
  flag liquid = prism(imperfect => imperfect)

  # --shatter N: recursive settle at Fiedler zero crossings.
  # composes on `kintsugi`. invokes @kintsugi/shatter.
  flag shatter(int) = lens(imperfect => imperfect)

  # --beam: emit the observation (replaces bench, profile, trace).
  flag beam = lens(imperfect => beam)

  # --format: choose output rendering.
  flag format(json | human) = lens(imperfect => text)

  # --mcp: dispatch `serve` to MCP tools.
  flag mcp = prism(imperfect => imperfect)

  # --lsp: dispatch `serve` to LSP methods.
  flag lsp = prism(imperfect => imperfect)

  recover |result, loss| {
    print(loss)
    result
  }

  rescue |error| {
    print(error)
    exit(1)
  }
}

out exit_code
out command
out @cli
