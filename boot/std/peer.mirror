in @prism
in @meta
in @io
in @file
in @cogito
in @code/mq
in @mirror/shard
in @mirror/evaluate
in @mirror/spectral
in @mirror/runtime/gen_prism

# @peer: the typed surface for spawn. a peer is a five-axis identity
# gestalt; its home directory is the manifest material form.
# `@peer(~dir"<path>")` resolves the directory into the typed fixed
# point that `spawn` can call.
#
# This grammar declares only the type; `load`, `validate`, and `spawn`
# land in tick 4. The five fields are the output of one Prism operation
# applied to the peer's own bias_tree:
#
#   identity   -> focus(self)    -- the manifold the peer lives on
#   gestalt    -> project(self)   -- the accumulated lens (what matters)
#   tensions   -> split(self)     -- open branches; live derivatives
#   eigenboard -> shift(self)      -- current spectral state
#   shatter    -> settle(self)   -- rendered history; the commit chain
#
# Spec: docs/specs/peer-glass.md
# Audit: docs/audits/2026-05-25-peer-glass-audit.md
# Tick 1 prior art: @cogito.eigenboard (boot/std/cogito.mirror).
#
# Prior art (Silicon Venue table mechanics):
#   - INTEGRITY = Fiedler value as decidable sub-Turing measurement
#     (cite: /Users/alexwolf/.loki/the-game/12-edge.md:55-58). This is
#     the semantic backing @peer.eigenboard.holonomy carries.
#   - Scheduler Tower as the pressure-release mechanic backpressure
#     embodies (cite: /Users/alexwolf/.loki/the-game/08-pressure-and-release.md).
#     The peer's tensions field IS the open backpressure surface.

grammar @peer {
  # the five-axis fixed point. exactly five — because the algebra has
  # five. drop one and @peer cannot type-check; the load fails before
  # any spawn runs.
  #
  # eigenboard is typed `shard` — per shards/glass.mirror's three-layer
  # recognition (2026-06-06), a shard is the SpectralUuid-addressed
  # settled composition of splinters. The peer's eigenboard IS that
  # SpectralUuid-addressed shard at the peer altitude: its splinters
  # carry the peer's current tensions / gestalt / identity; its
  # SpectralUuid is the peer's current spectral state encoding (active
  # bits = navigable Laplacian neighbourhood across the composed
  # splinters; dark bits = content hash of the composition). Sub-graph
  # spawn (Glint's gap, the-convergence.md §3.4) is the operation that
  # carves a sub-shard from the parent's shard, identified by a fresh
  # SpectralUuid composed from parent + neighbourhood selection.
  type peer = {
    identity:   mirror,        # focus(self): immutable manifold; mutating = fork
    gestalt:    mirror,        # project(self): the accumulated lens
    tensions:   mirror,        # split(self): open branches the peer carries
    eigenboard: shard,         # shift(self): SpectralUuid-addressed shard at peer altitude
    shatter:    mirror,        # settle(self): rendered history; ancestor chain
  }

  # the canonical five filenames. one enum, one mapping; the validator
  # iterates the enum so the filenames stop being magic strings.
  # `eigenboard.shard` rides the @mirror/shard glass — the observer-
  # relative deployment description for this peer's eigenboard frame.
  type peer_file = identity | gestalt | tensions | eigenboard | shatter

  # filename: the canonical mapping from peer_file variant to filename.
  # Per the 2026-05-25 design call: no `fn` keyword in mirror. The
  # `select` decorator on an action-declaration form is the canonical
  # surface for sum-type-dispatch helpers — the same family as the
  # `select |x| { ... }` closure form, but in declaration position
  # because the dispatch is exhaustive over a closed sum.
  #
  # The `/` in `dir / filename(identity)` below is the existing shift
  # operator over (ref, focus) declared in @meta ("isomorphic to
  # namespace /" per Alex 2026-05-25): namespace path concatenation,
  # where `dir` is a `~dir` ref and `filename(identity)` resolves to
  # text. The captured body delivers the path verbatim; the substrate
  # discharges the / through @meta's shift declaration.
  select filename(p: peer_file) -> text {
    identity   => "identity.mirror",
    gestalt    => "gestalt.mirror",
    tensions   => "tensions.mirror",
    eigenboard => "eigenboard.shard",
    shatter    => "shatter.mirror",
  }

  # ── load: structural boundary ──────────────────────────────────────
  #
  # Read the five files from the directory; parse each through its
  # respective glass; return the typed peer record. Per Alex's
  # 2026-05-25 substrate decision, `load` is the *structural* check —
  # files exist + parse. The manifold check (validate) and the
  # continuous autopoietic check (reflect) are separate boundaries.
  #
  # Failure mode: if any file is missing or fails to parse, the load
  # fails with a precise error naming which file. `@io.read` returns
  # `imperfect`; the failure carries through.
  load(dir: ~dir) -> peer {
    peer {
      identity:   @io.read(dir / filename(identity))   |> @mirror/evaluate.evaluate(@mirror/grammar),
      gestalt:    @io.read(dir / filename(gestalt))    |> @mirror/evaluate.evaluate(@mirror/grammar),
      tensions:   @io.read(dir / filename(tensions))   |> @mirror/evaluate.evaluate(@mirror/grammar),
      eigenboard: @io.read(dir / filename(eigenboard)) |> @mirror/evaluate.evaluate(@mirror/shard),
      shatter:    @io.read(dir / filename(shatter))    |> @mirror/evaluate.evaluate(@mirror/grammar),
    }
  }

  # ── validate: manifold boundary ────────────────────────────────────
  #
  # The autopoietic check (Soto-Andrade & Varela 1984, Lawvere fixed
  # point) is exactly the manifold check the spec wants. `@cogito.reflect`
  # runs `observe |> strategy |> perturb` — the tick-to-tick map whose
  # fixed point IS the peer-on-its-manifold property.
  #
  # `p.tensions` is the imperfect surface (the open branches the peer
  # carries); reflect feeds it through the second-order observer and
  # returns the imperfect with the next eigenboard perturbation
  # attached. Caller decides what to do with the result.
  validate(p: peer) -> imperfect {
    @cogito.reflect(p.tensions)
  }

  # ── spawn: instantiate ─────────────────────────────────────────────
  #
  # Wrap @mirror/runtime/gen_prism.spawn. The name is derived from the
  # peer's identity crystal (the manifold); the initial_state is the
  # crystal of the message body the peer is being asked to resolve.
  #
  # Continuous validation (per the third boundary) is the caller's
  # concern: gen_prism already supports periodic reflection by calling
  # @cogito.reflect after each tick. @peer.spawn returns the gen_prism;
  # the caller wires the reflect cadence.
  spawn(p: peer, q: ~mq) -> gen_prism {
    @mirror/runtime/gen_prism.spawn(
      name:          @mirror/spectral.crystallize(p.identity),
      initial_state: @mirror/spectral.crystallize(q),
    )
  }
}

out peer
out peer_file
out filename
out load
out validate
out spawn
out @peer
