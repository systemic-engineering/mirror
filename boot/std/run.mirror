in @mirror
in @property

-- Run a mirror project: compile, verify, report.
-- Running IS verifying. The proof chain is the program.

type run_target = text

type run_result {
  compiled: [text],
  properties: verdict,
  loss: loss,
}

type verdict = pass | fail | partial

type loss = text

grammar @run {
  in @property

  -- Run the project: compile sources, check properties, report.
  action run(targets: [run_target]) -> imperfect {
    focus  targets
    project |target| craft(target)
    split  |compiled| properties(compiled)
    zoom   report(compiled, properties)
    refract crystal
  }

  -- Run with a specific target.
  action run_target(target: run_target) -> imperfect {
    focus  target
    zoom   craft(target)
    refract properties(crafted)
  }

  out run_target
  out run_result
  out verdict
  out loss
  out @run
}
